@page "/{slug}/admin/classes"
@model ChallengeBible.Web.Pages.Admin.ClassesModel
@using ChallengeBible.Web.Services
@* 확정 시안 A-반목록-단순(ADR 0093 반 관리 및 자동 생성 규칙): 해 없음 · 새친구반 · 미배정반(관리자만) · 정규 반 *@
@{ var slug = Model.Tenant.Current.Slug; }
<partial name="_AdminTop" model="Model.Tenant" />
<main class="admin gut"><div class="wrap wide">
    <h1>반</h1>
    @if (!string.IsNullOrEmpty(Model.OkMessage)) { <p class="okmsg" role="status">@Model.OkMessage</p> }

    <details class="pp-add" open="@(Model.Error is not null)"><summary class="btn p sm">+ 반 만들기</summary>
        <form method="post" asp-page-handler="Add" asp-route-slug="@slug" class="pp-form">
            @if (Model.Error is not null) { <p class="err" role="alert">@Model.Error</p> }
            <label>반 이름<input class="in" name="name" maxlength="50" placeholder="예: 1학년 1반, 납달리반" required /></label>
            <div class="row"><button type="submit" class="btn p sm">만들기</button></div>
        </form>
    </details>

    <div class="cls">
        @foreach (var c in Model.Rows.Where(r => r.IsNewcomer))
        {
            <a class="cl nc" href="/@slug/admin/classes/@c.Id">
                <span class="h"><b>@c.Name</b><span class="tag nc">기본</span><span class="n">@(c.Teachers.Count)명</span></span>
                <small>담당 @(c.Teachers.Count == 0 ? "없음 · 담당을 정해 주세요" : string.Join(" · ", c.Teachers)) · 새친구는 실제 반(또는 미배정반)에도 함께 보여요</small>
            </a>
        }
        <a class="cl un" href="/@slug/admin/classes/unassigned">
            <span class="h"><b>@ClassService.UnassignedName</b><span class="tag un">기본</span><span class="tag only">관리자만 보여요</span><span class="n">@(Model.Unassigned)명</span></span>
            <small>@(Model.Unassigned == 0 ? "반이 정해지지 않은 아이가 없어요" : "반이 정해지지 않은 아이 · 눌러서 반을 정해 주세요")</small>
        </a>
        @foreach (var c in Model.Rows.Where(r => !r.IsNewcomer))
        {
            <a class="cl" href="/@slug/admin/classes/@c.Id">
                <span class="h"><b>@c.Name</b><span class="n">@(c.Students)명</span></span>
                <small>@(c.Teachers.Count == 0 ? "선생님 없음 · 담임을 정해 주세요" : "선생님 " + string.Join(" · ", c.Teachers))</small>
            </a>
        }
    </div>
</div></main>
