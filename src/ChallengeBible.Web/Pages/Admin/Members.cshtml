@page "/{slug}/admin/members"
@model ChallengeBible.Web.Pages.Admin.MembersModel
@using ChallengeBible.Infrastructure.Data
@using ChallengeBible.Web.Pages.Admin
@* 소속 관리(ADR 0090): 줄을 펼쳐 역할 · 관리자 지정, 소속 탭에서 여러 명 골라 진급 보내기 *@
@{ var picking = Model.Tab == MembershipStatus.Approved; }
<partial name="_AdminTop" model="Model.Tenant" />
<main class="admin gut"><div class="wrap wide">
    <h1>소속 관리</h1>

    @if (!string.IsNullOrEmpty(Model.OkMessage)) { <p class="okmsg" role="status">@Model.OkMessage</p> }

    <nav class="seg" aria-label="상태">
        @foreach (var (key, label) in MembersModel.Tabs)
        {
            var n = Model.Counts.GetValueOrDefault(key);
            <a href="?Tab=@key" aria-current="@(key == Model.Tab ? "page" : "false")">@label <span class="num @(key == MembershipStatus.Requested && n > 0 ? "c" : "")">@n</span></a>
        }
    </nav>

    <form method="get" class="tools">
        <input type="hidden" name="Tab" value="@Model.Tab" />
        <input class="search" type="search" name="Q" value="@Model.Q" placeholder="이름 · 이메일로 찾기" aria-label="이름 · 이메일로 찾기" />
        <select class="sel" name="Role" aria-label="역할" onchange="this.form.submit()">
            <option value="">모든 역할</option>
            @foreach (var (code, name) in Model.RoleCodes) { <option value="@code" selected="@(Model.Role == code)">@name</option> }
            <option value="-" selected="@(Model.Role == "-")">학부모</option>
        </select>
        <button class="btn s sm" type="submit">찾기</button>
    </form>

    <ul class="list">
        @if (Model.Rows.Count == 0)
        {
            <li class="empty">@(Model.Tab == MembershipStatus.Requested ? "기다리는 신청이 없어요." : "찾는 사람이 없어요.")</li>
        }
        @foreach (var m in Model.Rows)
        {
            var self = m.UserName == Model.Me;
            var open = Model.ErrorFor == m.Id;
            <li class="row @(picking ? "pickable" : "")">
                @if (picking)
                {
                    if (m.Status == MembershipStatus.Approved) { <input type="checkbox" class="pick" name="pick" value="@m.Id" form="promo" checked="@Model.Picks.Contains(m.Id)" aria-label="@(m.DisplayName) 고르기" /> }
                    else { <span class="pick-sp"></span> }
                }
                @* 펼치지 않아도 바로 상세로 가는 링크(신청 중이 아닌 소속원만) *@
                @if (m.Status != MembershipStatus.Requested) { <a class="row-more" href="/@Model.Tenant.Current.Slug/admin/members/@m.Id" aria-label="@(m.DisplayName) 자세히 보기">자세히 →</a> }
                <details open="@open">
                    <summary class="line">
                        <span class="av">@(m.DisplayName.Length > 1 ? m.DisplayName[1..] : m.DisplayName)</span>
                        <span class="who"><b>@m.DisplayName @if (self) { <span class="tag">나</span> }</b>
                            <small>@m.Email@(m.Status == MembershipStatus.Requested ? $" · {m.RequestedUtc:M월 d일} 신청" : "")</small></span>
                        <span class="tags"><span class="tag">@m.RoleLabel@(m.Status == MembershipStatus.Requested ? " 희망" : "")</span>@if (m.IsAdmin) { <span class="tag r-TenantAdmin">관리자</span> }</span>
                        <span class="chev" aria-hidden="true">›</span>
                    </summary>
                    <div class="ed">
                        @if (open && Model.Error is not null) { <p class="err" role="alert">@Model.Error</p> }
                        <form method="post" asp-page-handler="@(m.Status == MembershipStatus.Requested ? "Approve" : "Save")" asp-route-slug="@Model.Tenant.Current.Slug"
                              asp-route-Tab="@Model.Tab" class="stack">
                            <input type="hidden" name="id" value="@m.Id" />
                            <div>
                                <h3>@(m.Status == MembershipStatus.Requested ? "승인할 역할" : "역할")</h3>
                                <select class="sel" name="roleCode" aria-label="역할">
                                    @foreach (var (code, name) in Model.RoleCodes) { <option value="@code" selected="@(m.RoleCode == code)">@name</option> }
                                    <option value="" selected="@(string.IsNullOrEmpty(m.RoleCode))">학부모</option>
                                </select>
                            </div>
                            <div class="acts">
                                <button type="submit" class="btn p sm">@(m.Status == MembershipStatus.Requested ? "승인" : "저장")</button>
                            </div>
                        </form>
                        @if (m.Status == MembershipStatus.Approved && !self)
                        {
                            <form method="post" asp-page-handler="Admin" asp-route-slug="@Model.Tenant.Current.Slug" asp-route-Tab="@Model.Tab" class="acts">
                                <input type="hidden" name="id" value="@m.Id" /><input type="hidden" name="admin" value="@(m.IsAdmin ? "false" : "true")" />
                                <button type="submit" class="btn s sm">@(m.IsAdmin ? "관리자 해제" : "이 부서 관리자로 지정")</button>
                            </form>
                        }
                        @if (m.Status == MembershipStatus.Approved && m.RoleCode == ChallengeBible.Web.Services.UserRole.StudentCode)
                        {
                            var linked = Model.Links.GetValueOrDefault(m.UserName) ?? [];
                            <div>
                                <h3>보호자 연결 <span>· 연결된 보호자는 미션 · 점수를 보기만 해요</span></h3>
                                @foreach (var g in Model.Guardians.Where(g => linked.Contains(g.UserName)))
                                {
                                    <form method="post" asp-page-handler="Unlink" asp-route-slug="@Model.Tenant.Current.Slug" asp-route-Tab="@Model.Tab" class="adminline">
                                        <input type="hidden" name="id" value="@m.Id" /><input type="hidden" name="guardian" value="@g.UserName" /><input type="hidden" name="student" value="@m.UserName" />
                                        <span>@g.Name</span><button type="submit" class="btn t">풀기</button>
                                    </form>
                                }
                                @{ var free = Model.Guardians.Where(g => !linked.Contains(g.UserName) && g.UserName != m.UserName).ToList(); }
                                @if (free.Count > 0)
                                {
                                    <form method="post" asp-page-handler="Link" asp-route-slug="@Model.Tenant.Current.Slug" asp-route-Tab="@Model.Tab" class="row">
                                        <input type="hidden" name="id" value="@m.Id" /><input type="hidden" name="student" value="@m.UserName" />
                                        <select class="sel" name="guardian" aria-label="연결할 보호자">@foreach (var g in free) { <option value="@g.UserName">@g.Name</option> }</select>
                                        <button type="submit" class="btn s sm">연결</button>
                                    </form>
                                }
                                else if (linked.Count == 0) { <p class="hint">이 부서에 보호자 역할을 가진 사람이 아직 없어요.</p> }
                            </div>
                        }
                        <div class="acts">
                            @if (m.Status != MembershipStatus.Requested) { <a class="btn t sm" href="/@Model.Tenant.Current.Slug/admin/members/@m.Id">자세히 보기 →</a> }
                            @if (m.Status == MembershipStatus.Requested)
                            {
                                <details class="ask"><summary class="btn d sm">거절</summary>
                                    <form method="post" asp-page-handler="Reject" asp-route-slug="@Model.Tenant.Current.Slug" asp-route-Tab="@Model.Tab">
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <span>@(m.DisplayName)님의 신청을 거절할까요?</span><button type="submit" class="btn dd sm">거절하기</button>
                                    </form>
                                </details>
                            }
                        </div>
                        @if (self) { <p class="hint">내 관리자 역할은 여기서 뺄 수 없어요.</p> }
                    </div>
                </details>
            </li>
        }
    </ul>
    @if (picking && Model.Rows.Count > 0)
    {
        <form method="post" id="promo" class="promo" asp-route-slug="@Model.Tenant.Current.Slug" asp-route-Tab="@Model.Tab">
            <h2 id="promoT">진급 보내기</h2>
            <p class="hint">보낼 아이를 위 목록에서 고르고, 받을 부서의 참여 코드를 넣어 주세요.@(Model.Picks.Count > 0 ? $" 지금 {Model.Picks.Count}명 골랐어요." : "")</p>
            <div class="row">
                <input class="in sm" name="code" value="@Model.PromoCode" placeholder="받을 부서 코드" aria-label="받을 부서 코드" maxlength="8" autocomplete="off" />
                <button type="submit" class="btn s sm" asp-page-handler="PromoteCheck">부서 확인</button>
            </div>
            @if (Model.PromoError is not null) { <p class="found bad" role="alert">@Model.PromoError</p> }
            @if (Model.PromoTarget is { } target)
            {
                <p class="found" role="status">받는 부서: @target.Name</p>
                <div class="warnbox">받는 부서 관리자가 승인하면 <b>점수 · 미션 기록이 그 부서로 옮겨지고</b> 이 부서에서는 빠져요(가족팀 자리 · 보호 관계는 지워져요). 승인 전까지는 여기서 계속 미션을 할 수 있어요. 성경 읽음 표시 · 책갈피 · 통독 진도는 그대로 남아요.</div>
                <div class="acts"><button type="submit" class="btn p sm" asp-page-handler="Promote">@(Model.Picks.Count)명 진급 요청 보내기</button></div>
            }
        </form>
    }
</div></main>
