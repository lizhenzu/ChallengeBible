@page "/{slug}/admin/members"
@model ChallengeBible.Web.Pages.Admin.MembersModel
@using ChallengeBible.Infrastructure.Data
@using ChallengeBible.Web.Pages.Admin
@* 확정 시안: 관리-소속관리-단독시안 (줄을 펼쳐 바로 처리, 소속 탭에서 여러 명 골라 반 바꾸기 · 진급 보내기) *@
@{ var picking = Model.Tab == MembershipStatus.Approved; }
<partial name="_AdminTop" model="Model.Tenant" />
<main class="admin gut"><div class="wrap wide">
    <h1>소속 관리</h1>

    @if (!string.IsNullOrEmpty(Model.OkMessage)) { <p class="okmsg" role="status">@Model.OkMessage</p> }

    <nav class="seg" aria-label="상태">
        @foreach (var (key, label) in MembersModel.Tabs)
        {
            var n = Model.Counts.GetValueOrDefault(key);
            <a href="?Tab=@key" aria-current="@(key == Model.Tab ? "page" : "false")">@label <span class="num @(key == MembershipStatus.Requested && n > 0 ? "c" : "")">@n</span></a>
        }
    </nav>

    <form method="get" class="tools">
        <input type="hidden" name="Tab" value="@Model.Tab" />
        <input class="search" type="search" name="Q" value="@Model.Q" placeholder="이름 · 이메일로 찾기" aria-label="이름 · 이메일로 찾기" />
        <select class="sel" name="Role" aria-label="역할" onchange="this.form.submit()">
            <option value="">모든 역할</option>
            @foreach (var r in Roles.All) { <option value="@r" selected="@(Model.Role == r)">@MembersModel.RoleLabel(r)</option> }
        </select>
        <select class="sel" name="Group" aria-label="반" onchange="this.form.submit()">
            <option value="">모든 반</option>
            @foreach (var g in Model.Groups) { <option selected="@(Model.Group == g)">@g</option> }
            <option value="-" selected="@(Model.Group == "-")">반 없음</option>
        </select>
        <button class="btn s sm" type="submit">찾기</button>
    </form>

    <ul class="list">
        @if (Model.Rows.Count == 0)
        {
            <li class="empty">@(Model.Tab == MembershipStatus.Requested ? "기다리는 신청이 없어요." : "찾는 사람이 없어요.")</li>
        }
        @foreach (var m in Model.Rows)
        {
            var self = m.AccountId == Model.Me;
            var open = Model.ErrorFor == m.MembershipId;
            <li class="row @(picking ? "pickable" : "")">
                @if (picking)
                {
                    if (m.Roles.Contains(Roles.Participant)) { <input type="checkbox" class="pick" name="pick" value="@m.MembershipId" form="promo" checked="@Model.Picks.Contains(m.MembershipId)" aria-label="@(m.DisplayName) 고르기" /> }
                    else { <span class="pick-sp"></span> }
                }
                <details open="@open">
                    <summary class="line">
                        <span class="av">@(m.DisplayName.Length > 1 ? m.DisplayName[1..] : m.DisplayName)</span>
                        <span class="who"><b>@m.DisplayName @if (self) { <span class="tag">나</span> }</b>
                            <small>@m.Email@(m.GroupLabel is null ? "" : $" · {m.GroupLabel}")@(m.Status == MembershipStatus.Requested ? $" · {m.RequestedUtc:M월 d일} 신청" : "")</small></span>
                        <span class="tags">@foreach (var r in m.Roles) { <span class="tag r-@r">@MembersModel.RoleLabel(r)@(m.Status == MembershipStatus.Requested ? " 희망" : "")</span> }</span>
                        <span class="chev" aria-hidden="true">›</span>
                    </summary>
                    <div class="ed">
                        @if (open && Model.Error is not null) { <p class="err" role="alert">@Model.Error</p> }
                        @if (m.Status != MembershipStatus.Suspended)
                        {
                            <form method="post" asp-page-handler="@(m.Status == MembershipStatus.Requested ? "Approve" : "Save")" asp-route-slug="@Model.Tenant.Current.Slug"
                                  asp-route-Tab="@Model.Tab" class="stack">
                                <input type="hidden" name="id" value="@m.MembershipId" />
                                <div>
                                    <h3>@(m.Status == MembershipStatus.Requested ? "승인할 역할" : "역할") <span>· 여러 개 가능</span></h3>
                                    <div class="rl">
                                        @foreach (var r in Roles.All)
                                        {
                                            var lockAdmin = self && r == Roles.TenantAdmin;
                                            <label class="@(lockAdmin ? "lock" : "")"><input type="checkbox" name="roles" value="@r" checked="@m.Roles.Contains(r)" disabled="@lockAdmin" />@MembersModel.RoleLabel(r)</label>
                                            @if (lockAdmin) { <input type="hidden" name="roles" value="@r" /> }
                                        }
                                    </div>
                                </div>
                                <div>
                                    <h3>반</h3>
                                    <input class="sel" name="group" value="@m.GroupLabel" list="groups" placeholder="반 없음" maxlength="50" aria-label="반" />
                                </div>
                                <div class="acts">
                                    <button type="submit" class="btn p sm">@(m.Status == MembershipStatus.Requested ? "승인" : "저장")</button>
                                </div>
                            </form>
                        }
                        @if (m.Status == MembershipStatus.Approved && m.Roles.Contains(Roles.Participant))
                        {
                            var linked = Model.Links.GetValueOrDefault(m.MembershipId) ?? [];
                            <div>
                                <h3>보호자 연결 <span>· 연결된 보호자는 미션 · 점수를 보기만 해요</span></h3>
                                @foreach (var g in Model.Guardians.Where(g => linked.Contains(g.MembershipId)))
                                {
                                    <form method="post" asp-page-handler="Unlink" asp-route-slug="@Model.Tenant.Current.Slug" asp-route-Tab="@Model.Tab" class="adminline">
                                        <input type="hidden" name="id" value="@m.MembershipId" /><input type="hidden" name="guardian" value="@g.MembershipId" />
                                        <span>@g.Name</span><button type="submit" class="btn t">풀기</button>
                                    </form>
                                }
                                @{ var free = Model.Guardians.Where(g => !linked.Contains(g.MembershipId) && g.MembershipId != m.MembershipId).ToList(); }
                                @if (free.Count > 0)
                                {
                                    <form method="post" asp-page-handler="Link" asp-route-slug="@Model.Tenant.Current.Slug" asp-route-Tab="@Model.Tab" class="row">
                                        <input type="hidden" name="id" value="@m.MembershipId" />
                                        <select class="sel" name="guardian" aria-label="연결할 보호자">@foreach (var g in free) { <option value="@g.MembershipId">@g.Name</option> }</select>
                                        <button type="submit" class="btn s sm">연결</button>
                                    </form>
                                }
                                else if (linked.Count == 0) { <p class="hint">이 부서에 보호자 역할을 가진 사람이 아직 없어요.</p> }
                            </div>
                        }
                        <div class="acts">
                            @if (m.Status != MembershipStatus.Requested) { <a class="btn t sm" href="/@Model.Tenant.Current.Slug/admin/members/@m.MembershipId">자세히 보기 →</a> }
                            @if (m.Status == MembershipStatus.Requested)
                            {
                                <details class="ask"><summary class="btn d sm">거절</summary>
                                    <form method="post" asp-page-handler="Reject" asp-route-slug="@Model.Tenant.Current.Slug" asp-route-Tab="@Model.Tab">
                                        <input type="hidden" name="id" value="@m.MembershipId" />
                                        <span>@(m.DisplayName)님의 신청을 거절할까요?</span><button type="submit" class="btn dd sm">거절하기</button>
                                    </form>
                                </details>
                            }
                            else if (m.Status == MembershipStatus.Approved && !self)
                            {
                                <details class="ask"><summary class="btn d sm">정지</summary>
                                    <form method="post" asp-page-handler="Suspend" asp-route-slug="@Model.Tenant.Current.Slug" asp-route-Tab="@Model.Tab">
                                        <input type="hidden" name="id" value="@m.MembershipId" />
                                        <span>@(m.DisplayName)님을 정지할까요? 모든 역할이 함께 멈추고 미션을 할 수 없어요.</span><button type="submit" class="btn dd sm">정지하기</button>
                                    </form>
                                </details>
                            }
                            else if (m.Status == MembershipStatus.Suspended)
                            {
                                <form method="post" asp-page-handler="Resume" asp-route-slug="@Model.Tenant.Current.Slug" asp-route-Tab="@Model.Tab">
                                    <input type="hidden" name="id" value="@m.MembershipId" />
                                    <button type="submit" class="btn p sm">정지 풀기</button>
                                </form>
                            }
                        </div>
                        @if (self) { <p class="hint">내 관리자 역할은 여기서 뺄 수 없어요.</p> }
                    </div>
                </details>
            </li>
        }
    </ul>
    @if (picking && Model.Rows.Any(r => r.Roles.Contains(Roles.Participant)))
    {
        <form method="post" id="promo" class="promo" asp-route-slug="@Model.Tenant.Current.Slug" asp-route-Tab="@Model.Tab">
            <h2 id="regroupT">반 바꾸기</h2>
            <p class="hint">위 목록에서 아이를 고르고 새 반을 넣어 주세요. 비우면 "반 없음"이에요.@(Model.Picks.Count > 0 ? $" 지금 {Model.Picks.Count}명 골랐어요." : "")</p>
            <div class="row">
                <input class="in sm" name="newGroup" value="@Model.NewGroup" list="groups" placeholder="새 반 (예: 사랑반)" aria-label="새 반" maxlength="50" />
                <button type="submit" class="btn s sm" asp-page-handler="Regroup">고른 아이 반 바꾸기</button>
            </div>
            @if (Model.RegroupError is not null) { <p class="found bad" role="alert">@Model.RegroupError</p> }

            <h2 id="promoT">진급 보내기</h2>
            <p class="hint">보낼 아이를 위 목록에서 고르고, 받을 부서의 참여 코드를 넣어 주세요.@(Model.Picks.Count > 0 ? $" 지금 {Model.Picks.Count}명 골랐어요." : "")</p>
            <div class="row">
                <input class="in sm" name="code" value="@Model.PromoCode" placeholder="받을 부서 코드" aria-label="받을 부서 코드" maxlength="8" autocomplete="off" />
                <button type="submit" class="btn s sm" asp-page-handler="PromoteCheck">부서 확인</button>
            </div>
            @if (Model.PromoError is not null) { <p class="found bad" role="alert">@Model.PromoError</p> }
            @if (Model.PromoTarget is { } target)
            {
                <p class="found" role="status">받는 부서: @target.Name</p>
                <div class="warnbox">받는 부서 선생님이 승인하면 <b>이 부서의 점수 · 기록이 모두 지워지고</b> 그 부서로 옮겨 가요. 승인 전까지는 여기서 계속 미션을 할 수 있어요. 성경 읽음 표시 · 책갈피 · 통독 진도는 그대로 남아요.</div>
                <div class="acts"><button type="submit" class="btn p sm" asp-page-handler="Promote">@(Model.Picks.Count)명 진급 요청 보내기</button></div>
            }
        </form>
    }
    <datalist id="groups">@foreach (var g in Model.Groups) { <option value="@g"></option> }</datalist>
</div></main>
