@page "/{slug}/admin/members/p/{pid:int}/link"
@model ChallengeBible.Web.Pages.Admin.PersonLinkModel
@using ChallengeBible.Web.Services
@* 계정 연결(2026-11-21 확정 시안 사람관리-쪼개기 ④, R-324): 같은 이름 계정 · 이름으로 찾기 → [연결] *@
@{
    var r = Model.Row!;
    var slug = Model.Tenant.Current.Slug;
    var detail = $"/{slug}/admin/members/p/{r.PersonId}";
}
<partial name="_AdminTop" model="Model.Tenant" />
<main class="admin gut w760"><div class="wrap pd">
    <a class="pd-back" href="@detail">‹ @r.Name</a>
    <h1>@r.Name — 계정 연결</h1>
    <p class="sub">이미 가입한 계정을 찾아 이 줄과 이어 줘요. 명부 줄: @r.Birthday · @(r.Phone1 ?? "연락처 없음")</p>
    @if (Model.Error is { } err) { <p class="err" role="alert">@err</p> }
    <form method="get" class="pd-find" role="search"><input class="in" name="Q" value="@Model.Q" placeholder="이름 · 아이디로 찾기" aria-label="계정 찾기" autocomplete="off" /><button type="submit" class="btn s">찾기</button></form>
    <p class="pd-sub">@(Model.Searched ? $"\"{Model.Q}\" 찾은 계정 {Model.Found.Count}개" : $"같은 이름 계정 {Model.Found.Count}개")</p>
    @foreach (var a in Model.Found)
    {
        <form method="post" class="pd-acc" onsubmit="return confirm('@(a.Name)(@(a.UserName)) 계정과 연결할까요?')">
            <input type="hidden" name="uid" value="@a.UserId" />
            <span class="n"><b>@a.Name <small>(@a.UserName)</small></b><small>@a.RoleLabel</small></span>
            <button type="submit" class="btn p sm">연결</button>
        </form>
    }
    @if (Model.Found.Count == 0) { <p class="hint">@(Model.Searched ? "이을 수 있는 계정이 없어요. 이 부서에 승인된 계정만 찾아요." : "같은 이름의 계정이 없어요. 위에서 이름이나 아이디로 찾아 보세요.")</p> }
    <p class="hint">연결하면 출석 · 생일 · 반 · 선물이 이 계정과 이어져요. 계정의 빈 명부 줄은 지워요. 잘못 연결하면 상세에서 [명부 연결 풀기]를 써요.</p>
    <div class="pd-foot"><a class="btn s" href="@detail">취소</a></div>
</div></main>
