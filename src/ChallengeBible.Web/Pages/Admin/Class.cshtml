@page "/{slug}/admin/classes/{id:int}"
@model ChallengeBible.Web.Pages.Admin.ClassModel
@using ChallengeBible.Web.Services
@* 확정 시안 H-반화면-새 · H-반화면-이름고치기(2026-11-12): 요약 머리 · 담임 카드 · 학생 카드 · 아래에 지우기. 버튼은 가운데 · 넓게 *@
@{
    var slug = Model.Tenant.Current.Slug;
    var d = Model.Detail!;
    var c = d.Class;
    var nameOpen = Model.Error is not null && Model.Ok is null && Model.ErrorFor == "name";
}
<partial name="_AdminTop" model="Model.Tenant" />
<main class="admin gut"><div class="wrap wide">
    <p class="lead"><a href="/@slug/admin/classes">← 반 목록</a></p>
    @if (!string.IsNullOrEmpty(Model.OkMessage)) { <p class="okmsg" role="status">@Model.OkMessage</p> }
    @if (Model.Error is not null) { <p class="err" role="alert">@Model.Error</p> }

    <div class="cd-head">
        <h1>@c.Name</h1>
        <div class="stat">
            @if (d.Teachers.Count == 0) { <span class="warn">@(c.IsNewcomer ? "담당 없음" : "선생님 없음")</span> }
            else { <span>@(c.IsNewcomer ? "담당" : "선생님") @string.Join(" · ", d.Teachers.Select(t => t.Name))</span> }
            <span>@(c.IsNewcomer ? "관리 중인 새친구" : "학생") @(d.Students.Count)명</span>
        </div>
        @if (!c.IsNewcomer)
        {
            <details class="cd-ren" open="@nameOpen"><summary class="ren">반 이름 고치기</summary>
                <form method="post" asp-page-handler="Name" asp-route-slug="@slug" class="cd-add">
                    <input class="in" name="name" value="@c.Name" maxlength="50" required aria-label="반 이름" />
                    <button type="submit" class="btn p sm">저장</button>
                </form>
            </details>
        }
        else { <span class="hint">기본 반이라 이름 · 지우기는 없어요</span> }
    </div>

    <section class="cd-card" aria-labelledby="tT">
        <h2 id="tT">@(c.IsNewcomer ? "새친구반 담당" : "담임 선생님") <small>@(c.IsNewcomer ? "교사 · 임원 · 관리자" : "교사만") · 한 반만</small></h2>
        @if (d.Teachers.Count == 0) { <p class="cd-empty">아직 @(c.IsNewcomer ? "담당이" : "담임이") 없어요. 아래에서 정해 주세요.</p> }
        else
        {
            <ul class="cd-people">
                @foreach (var p in d.Teachers)
                {
                    <li><b>@p.Name</b><small>@p.RoleLabel@(string.IsNullOrEmpty(p.Note) ? "" : " · " + p.Note)</small>
                        <button type="button" class="x" data-ask aria-label="@p.Name 빼기" title="빼기">×</button>
                        <div class="rm-ask hidden" role="alertdialog" aria-label="빼기 확인"><p>@(p.Name)을(를) @(c.IsNewcomer ? "담당에서" : "담임에서") 뺄까요?<small>다른 반을 맡을 수 있게 돼요.</small></p>
                            <div class="row2"><button type="button" class="btn s sm" data-cancel>취소</button>
                                <form method="post" asp-page-handler="Remove" asp-route-slug="@slug"><input type="hidden" name="person" value="@p.PersonId" /><button type="submit" class="btn dd sm">빼기</button></form></div></div></li>
                }
            </ul>
        }
        @if (d.TeacherCandidates.Count > 0)
        {
            <form method="post" asp-page-handler="Teacher" asp-route-slug="@slug" class="cd-add">
                <select class="sel" name="person" aria-label="넣을 @(c.IsNewcomer ? "담당" : "선생님")">@foreach (var p in d.TeacherCandidates) { <option value="@p.PersonId">@p.Name (@p.RoleLabel)</option> }</select>
                <button type="submit" class="btn p sm">넣기</button>
            </form>
        }
        else if (d.Teachers.Count == 0) { <p class="hint">넣을 수 있는 @(c.IsNewcomer ? "사람이" : "교사가") 없어요. 다른 반을 맡고 있으면 그 반에서 먼저 빼요.</p> }
    </section>

    @if (!c.IsNewcomer)
    {
        <section class="cd-card" aria-labelledby="sT">
            <h2 id="sT">학생 <small>@(d.Students.Count)명</small></h2>
            @if (d.Students.Count == 0) { <p class="hint" style="text-align:center">아직 학생이 없어요.</p> }
            <ul class="cd-people">
                @foreach (var p in d.Students)
                {
                    <li><b>@p.Name</b>@if (p.Newcomer) { <span class="tag nc">새친구</span> }<small>@(p.Linked ? "가입" : "가입 안 함")</small>
                        <button type="button" class="x" data-ask aria-label="@p.Name 빼기" title="빼기">×</button>
                        <div class="rm-ask hidden" role="alertdialog" aria-label="빼기 확인"><p>@(p.Name)을(를) @(c.Name)에서 뺄까요?<small>미배정반으로 가요. 출석 기록은 그대로예요.</small></p>
                            <div class="row2"><button type="button" class="btn s sm" data-cancel>취소</button>
                                <form method="post" asp-page-handler="Remove" asp-route-slug="@slug"><input type="hidden" name="person" value="@p.PersonId" /><button type="submit" class="btn dd sm">빼기</button></form></div></div></li>
                }
            </ul>
            <div class="cd-btns">
                <details class="cd-pick" open="@(Model.ErrorFor == "students")">
                    <summary class="btn p">+ 미배정반 펼쳐보기</summary>
                    @if (d.StudentCandidates.Count == 0) { <p class="hint" style="text-align:center">미배정반에 아이가 없어요.</p> }
                    else
                    {
                        <form method="post" asp-page-handler="Students" asp-route-slug="@slug" class="cd-picklist">
                            <ul class="ppl">
                                @foreach (var p in d.StudentCandidates) { <li><input type="checkbox" name="pick" value="@p.PersonId" aria-label="@p.Name 고르기" /><span><b>@p.Name</b> <small>@p.RoleLabel · @p.Birthday</small></span></li> }
                            </ul>
                            <button type="submit" class="btn p">선택한 아이 우리반으로 이동</button>
                        </form>
                    }
                </details>
                @if (d.Students.Count > 0) { <a class="btn s" href="/@slug/admin/classes/move?S=2&amp;F=@c.Id">이 반 아이 옮기기 →</a> }
            </div>
        </section>
        <div class="cd-danger">
            <details class="ask"><summary>이 반 지우기</summary>
                <form method="post" asp-page-handler="Delete" asp-route-slug="@slug">
                    <span>@(c.Name)을 지울까요? 학생은 미배정반으로 돌아가요.</span><button type="submit" class="btn dd sm">지우기</button>
                </form>
            </details>
        </div>
    }
    else
    {
        <section class="cd-card" aria-labelledby="ncT">
            <h2 id="ncT">관리 중인 새친구 <small>@(d.Students.Count)명</small></h2>
            @if (d.Students.Count == 0) { <p class="hint" style="text-align:center">관리 중인 새친구가 없어요.</p> }
            <ul class="cd-people">
                @foreach (var p in d.Students) { <li><b>@p.Name</b><small>@p.Note · @p.Birthday</small></li> }
            </ul>
            <p class="hint">새친구는 새친구반과 실제 반(또는 미배정반) 양쪽에 보여요. 등록 · 출석은 출석 → "새친구"에서 해요.</p>
        </section>
    }
</div></main>
<script>
    // × 를 누르면 그 줄 아래에 확인 상자(확정 시안 N): [빼기]를 눌러야 실제로 뺀다
    document.querySelectorAll('.cd-people [data-ask]').forEach(function (b) {
        b.addEventListener('click', function () {
            var li = b.closest('li'), box = li.querySelector('.rm-ask');
            document.querySelectorAll('.cd-people li.asking').forEach(function (o) { if (o !== li) { o.classList.remove('asking'); o.querySelector('.rm-ask').classList.add('hidden'); } });
            li.classList.toggle('asking'); box.classList.toggle('hidden');
        });
    });
    document.querySelectorAll('.cd-people [data-cancel]').forEach(function (b) {
        b.addEventListener('click', function () { var li = b.closest('li'); li.classList.remove('asking'); li.querySelector('.rm-ask').classList.add('hidden'); });
    });
</script>
