@page "/{slug}/admin/teams/stages"
@model ChallengeBible.Web.Pages.Admin.StagesModel
@* 부서 시상 기준(R-219, ADR 0093) — 확정 시안 관리-시상기준-10단계: 해 고르기 → 지금 쓰는 기준 띠 → 10단계(선물 켜기 · 금액) → 합계 · 저장 → 안내 *@
@{
    var slug = Model.Tenant.Current.Slug;
    var b = Model.Board;
    var self = $"/{slug}/admin/teams/stages";
    var yq = b.Year == b.ThisYear ? "" : $"?Y={b.Year}";
}
<partial name="_AdminTop" model="Model.Tenant" />
<main class="admin gut"><div class="wrap stg">
    <a class="stg-crumb" href="/@slug/admin/teams">‹ 가족팀</a>
    <h1>시상 기준</h1>
    <p class="lead">가족팀 · 친구팀 점수가 @b.Rows.FirstOrDefault()?.Points.ToString("N0")점을 넘을 때마다 선물을 고를 수 있어요. 단계마다 선물을 줄지, 얼마짜리까지 고를 수 있는지 정해요.</p>

    <nav class="stg-years" aria-label="해 고르기">
        <a href="@self" aria-current="@(b.Year == b.ThisYear ? "page" : "false")">올해 <small class="num">@b.ThisYear</small></a>
        <a href="@self?Y=@(b.ThisYear + 1)" aria-current="@(b.Year != b.ThisYear ? "page" : "false")">내년 <small class="num">@(b.ThisYear + 1)</small></a>
    </nav>

    @if (!string.IsNullOrEmpty(Model.OkMessage) && Model.Error is null) { <p class="okmsg" role="status">@Model.OkMessage</p> }

    <section class="stg-now @(b.Own ? "mine" : "")">
        @if (b.Own)
        {
            var off = b.Rows.Where(r => !r.On).Select(r => r.Points.ToString("N0")).ToList();
            <span class="k">@b.Year · 우리 부서 기준</span>
            <p>@(b.OnCount)단계에서 선물을 줘요.@(off.Count > 0 ? $" {string.Join(" · ", off)}점은 선물이 없어요." : "")</p>
        }
        else if (b.Year != b.ThisYear)
        {
            <span class="k">@b.Year · 아직 정하지 않았어요</span>
            <p>정하지 않으면 새해에 처음 값(모두 켬 · @(b.DefaultsText))을 써요. 미리 정해 두면 새해 첫날부터 우리 부서 기준이 적용돼요.</p>
        }
        else
        {
            <span class="k">@b.Year · 처음 값을 쓰고 있어요</span>
            <p>아직 우리 부서가 고치지 않았어요. @(b.Rows.Count)단계 모두 선물을 주고, @(b.DefaultsText)까지 골라요. 고치고 저장하면 우리 부서 기준이 돼요.</p>
        }
    </section>

    <form method="post" asp-route-slug="@slug" class="stg-form">
        <input type="hidden" name="year" value="@b.Year" />
        <ul class="c10" aria-label="선물 단계">
            @for (var i = 0; i < b.Rows.Count; i++)
            {
                var r = b.Rows[i];
                var f = Model.Form[i];
                var bad = Model.Bad.Contains(i);
                <li class="@(f.On ? "" : "off")" data-c10>
                    <div class="pt num">@r.Points.ToString("N0")<small>점</small></div>
                    <div class="mid">
                        <label class="sw"><input type="checkbox" name="on" value="@i" checked="@f.On" aria-label="@(r.Points.ToString("N0"))점 선물 주기" /><i></i><span data-on="선물 줌" data-off="선물 없음">@(f.On ? "선물 줌" : "선물 없음")</span></label>
                        @if (r.Given > 0) { <span class="given">🎁 @(r.Given)팀 받음</span> }
                    </div>
                    <div class="amt"><input type="text" name="amount" inputmode="numeric" value="@f.Amount" maxlength="12" aria-label="@(r.Points.ToString("N0"))점 선물 금액" aria-invalid="@(bad ? "true" : "false")" /><span>원</span></div>
                    @if (bad) { <p class="e">금액은 0 ~ @FamilyStageService.MaxAmount.ToString("N0")원 숫자로 써 주세요.</p> }
                </li>
            }
        </ul>
        <div class="c10-sum"><span>선물 주는 단계</span><b class="num" data-c10-sum>@Model.Form.Count(x => x.On)단계</b></div>
        @if (Model.Error is not null) { <p class="err" role="alert">@Model.Error</p> }
        <div class="c10-bar"><a class="btn s sm" href="@self?D=true@(b.Year == b.ThisYear ? "" : $"&Y={b.Year}")">처음 값으로</a><button type="submit" class="btn p sm">저장</button></div>
    </form>

    <p class="stg-note"><b>알아 두세요.</b> 끈 단계는 점수를 넘어도 선물을 고를 수 없어요. 금액은 그 단계에서 고를 수 있는 선물 한도예요. 이미 선물을 받은 팀이 있는 단계도 켜고 끄거나 금액을 바꿀 수 있어요(앞으로 받는 팀부터 적용). 가족팀과 친구팀은 같은 기준을 써요. “처음 값으로”는 칸만 채우고, 저장을 눌러야 바뀌어요.</p>
</div></main>
<script>
    // 스위치를 끄면 줄을 흐리게 하고 합계를 고친다(스크립트가 없어도 저장은 그대로 동작)
    (() => {
        const sum = document.querySelector('[data-c10-sum]');
        const paint = () => {
            let n = 0;
            document.querySelectorAll('[data-c10]').forEach((li) => {
                const box = li.querySelector('input[type=checkbox]');
                const label = li.querySelector('[data-on]');
                li.classList.toggle('off', !box.checked);
                label.textContent = box.checked ? label.dataset.on : label.dataset.off;
                if (box.checked) n++;
            });
            sum.textContent = n + '단계';
        };
        document.querySelectorAll('[data-c10] input[type=checkbox]').forEach((b) => b.addEventListener('change', paint));
    })();
</script>
