@page "/{slug}/admin/classes/move"
@model ChallengeBible.Web.Pages.Admin.ClassMoveModel
@using ChallengeBible.Web.Services
@* 확정 시안 반 이동 마법사(2026-11-12): 1 반 → 2 아이 → 3 보낼 곳(미배정반 · 다른 반 · 다른 부서) → 4 확인 *@
@{
    var slug = Model.Tenant.Current.Slug;
    string[] names = ["반", "아이", "보낼 곳", "확인"];
    var picked = Model.Picked;
    string Names(IEnumerable<ClassPerson> ps) => string.Join(" · ", ps.Select(p => p.Name));
}
<partial name="_AdminTop" model="Model.Tenant" />
<main class="admin gut"><div class="wrap wide">
    <h1>반 이동</h1>
    <p class="lead"><a href="/@slug/admin/classes">← 반 목록</a></p>
    @if (Model.Ok is not null) { <p class="okmsg" role="status">@(Model.Ok)명을 옮겼어요 · 이전 반 · 담임 정보는 꼬리표로 남았어요</p> }
    @if (Model.Error is not null) { <p class="err" role="alert">@Model.Error</p> }

    <div class="wz-steps" aria-label="단계">
        @for (var i = 0; i < 4; i++)
        {
            var n = i + 1;
            <span class="@(n < Model.S ? "done" : n == Model.S ? "on" : "")" aria-current="@(n == Model.S ? "step" : "false")"><i>@(n < Model.S ? "✓" : n)</i>@names[i]</span>
        }
    </div>

    @if (Model.S == 1)
    {
        <form method="get" asp-route-slug="@slug">
            <input type="hidden" name="S" value="2" />
            <p class="wz-q">어느 반 아이를 옮길까요?</p>
            <ul class="wz-pick">
                @foreach (var r in Model.Rows) { <li><label><input type="radio" name="F" value="@r.Id" required checked="@(Model.F == r.Id.ToString())" /> @r.Name<small>@(r.Students)명</small></label></li> }
                <li><label><input type="radio" name="F" value="@ClassMoveModel.FromUnassigned" required checked="@(Model.F == ClassMoveModel.FromUnassigned)" /> @ClassService.UnassignedName<small>@(Model.UnassignedCount)명</small></label></li>
            </ul>
            <div class="wz-nav"><button type="submit" class="btn p">다음 →</button></div>
        </form>
    }
    else if (Model.S == 2)
    {
        <p class="wz-sum">@Model.FromName@(Model.FromTeacher is null ? "" : " · 담임 " + Model.FromTeacher)</p>
        <form method="get" asp-route-slug="@slug">
            <input type="hidden" name="S" value="3" /><input type="hidden" name="F" value="@Model.F" />
            <p class="wz-q">누구를 옮길까요?</p>
            @if (Model.Kids.Count == 0) { <p class="hint">이 반에 아이가 없어요.</p> }
            else
            {
                <div class="wz-all"><span id="wzN">@(Model.Kids.Count)명 중 @(picked.Count)명 골랐어요</span><label><input type="checkbox" id="wzAll" /> 모두 고르기</label></div>
                <ul class="wz-pick">
                    @foreach (var k in Model.Kids)
                    {
                        <li><label><input type="checkbox" name="P" value="@k.PersonId" checked="@Model.P.Contains(k.PersonId)" /> @k.Name@if (k.Newcomer) { <span class="tag nc">새친구</span> }<small>@(k.Linked ? "가입" : "가입 안 함")</small></label></li>
                    }
                </ul>
            }
            <div class="wz-nav"><a class="btn s" href="?S=1&F=@Model.F">← 이전</a><button type="submit" class="btn p">다음 →</button></div>
        </form>
    }
    else if (Model.S == 3)
    {
        <p class="wz-sum">@Model.FromName → @(picked.Count)명(@Names(picked))</p>
        <form method="get" asp-route-slug="@slug">
            <input type="hidden" name="S" value="4" /><input type="hidden" name="F" value="@Model.F" />
            @foreach (var p in Model.P) { <input type="hidden" name="P" value="@p" /> }
            <p class="wz-q">어디로 보낼까요?</p>
            <ul class="wz-pick">
                @if (Model.FromId is not null)
                {
                    <li><label><input type="radio" name="D" value="@MoveDest.Unassigned" required checked="@(Model.D == MoveDest.Unassigned)" /> 이 부서 미배정반<small>연말 반 편성용</small></label></li>
                }
                <li><label><input type="radio" name="D" value="@MoveDest.Class" required checked="@(Model.D == MoveDest.Class)" /> 이 부서 다른 반</label>
                    <div class="sub"><select class="sel" name="T" aria-label="보낼 반">@foreach (var r in Model.Rows.Where(r => r.Id != Model.FromId)) { <option value="@r.Id" selected="@(Model.T == r.Id)">@r.Name</option> }</select></div></li>
                @if (Model.Depts.Count > 0)
                {
                    <li><label><input type="radio" name="D" value="@MoveDest.Dept" required checked="@(Model.D == MoveDest.Dept)" /> 다른 부서<small>그 부서 미배정반으로 · 승인 없음</small></label>
                        <div class="sub"><select class="sel" name="X" aria-label="보낼 부서">@foreach (var t in Model.Depts) { <option value="@t.TenantId" selected="@(Model.X == t.TenantId)">@t.Name</option> }</select></div></li>
                }
            </ul>
            <div class="wz-nav"><a class="btn s" href="?S=2&F=@Model.F@string.Concat(Model.P.Select(p => $"&P={p}"))">← 이전</a><button type="submit" class="btn p">다음 →</button></div>
        </form>
    }
    else
    {
        <p class="wz-q">이대로 옮길까요?</p>
        <div class="wz-ok">
            <b>@Model.FromName → @Model.DestText</b>
            <span>@(picked.Count)명: @Names(picked)</span>
            <span class="who">@(Model.FromId is null ? "미배정반에서 옮기면 있던 꼬리표가 그대로 따라가요." : $"이전 반 · 담임({Model.FromTeacher ?? "담임 없음"})은 꼬리표로 남아요.") 출석 기록은 그대로예요.@(Model.D == MoveDest.Dept ? " 승인 없이 바로 옮겨져요. 가입 안 한 아이도 명부째로 가요." : "")</span>
        </div>
        <form method="post" asp-route-slug="@slug">
            <input type="hidden" name="F" value="@Model.F" /><input type="hidden" name="D" value="@Model.D" />
            @if (Model.T is int t) { <input type="hidden" name="T" value="@t" /> }
            @if (Model.X is int x) { <input type="hidden" name="X" value="@x" /> }
            @foreach (var p in Model.P) { <input type="hidden" name="P" value="@p" /> }
            <div class="wz-nav"><a class="btn s" href="?S=3&F=@Model.F@string.Concat(Model.P.Select(p => $"&P={p}"))&D=@Model.D&T=@Model.T&X=@Model.X">← 이전</a><button type="submit" class="btn p">옮기기</button></div>
        </form>
    }
</div></main>
<script>
    // "모두 고르기"와 고른 수(2단계)
    (function () {
        const all = document.getElementById('wzAll'), n = document.getElementById('wzN');
        if (!all) return;
        const boxes = Array.from(document.querySelectorAll('input[name="P"][type="checkbox"]'));
        const show = () => { const c = boxes.filter(b => b.checked).length; n.textContent = boxes.length + '명 중 ' + c + '명 골랐어요'; all.checked = c === boxes.length; };
        all.addEventListener('change', () => { boxes.forEach(b => b.checked = all.checked); show(); });
        boxes.forEach(b => b.addEventListener('change', show));
        show();
    })();
</script>
