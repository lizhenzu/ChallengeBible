@{
    ViewData["Title"] = "불러오지 못했어요";
}
<main class="gut" style="max-width:760px;margin:0 auto">
@await Html.PartialAsync("~/Pages/Mission/_EmptyState.cshtml", ("M12 8v5M12 16.5v.5M3 20L12 4l9 16z", "불러오지 못했어요", "인터넷 연결을 확인하고\n다시 시도해 주세요.", "다시 시도", "javascript:location.reload()"))
@if (Model.ShowRequestId)
{
    <p style="text-align:center;font-size:11px;color:#7A8985;margin:0 0 24px">오류 번호 <code>@Model.RequestId</code></p>
}
</main>
