@model ChallengeBible.Web.Pages.Welcome.IndexModel
@using ChallengeBible.Web.Services
@* 부서 소개(웰컴) 화면 — 2026-11-24 새 퍼블리시본 「JAMSIL KIDS · v2」로 교체(ADR 0140). 순백 바탕 · 헤어라인 · 검정 헤비 제목 · 컬러 번호 2열 표.
   현재 있는 기능만 연결: 내 정보(계정) · 대표 사진 · 날짜 · 제목 · 예배 줄 · 주보 · 앨범 · 도전!!! 성경말씀으로 가기 · 소개(글 + 예배 안내) · 앱 설치 ·
   (로그인한 사람만) 1주일 후 다시 보기 · 다시 보지 않기. 퍼블리시본의 「이번 주 말씀」 · 「미션북」 칸은 아직 없는 기능이라 연결하지 않았다. *@
@{
    var slug = Model.Tenant.Current.Slug;
    var dept = PlatformTodayService.ShortDept(Model.Tenant.Current.Name);
    var it = Model.Item;
    var first = Model.Worship.FirstOrDefault();
    var addr = Model.Worship.Select(w => w.Address).FirstOrDefault(a => !string.IsNullOrWhiteSpace(a));
    var brand = slug.Replace('-', ' ').ToUpperInvariant();
    string Clock(TimeOnly t) => $"{(t.Hour < 12 ? "오전" : "오후")} {(t.Hour % 12 == 0 ? 12 : t.Hour % 12)}:{t.Minute:00}";
    string Day(byte d) => d == 0 ? "주일" : new[] { "일", "월", "화", "수", "목", "금", "토" }[d] + "요일";
    var ko = new System.Globalization.CultureInfo("ko-KR");
    var cards = ViewData["Cards"] as bool? == true;   // welcome2: 「오늘의 안내」를 색 카드 6칸으로(2026-11-24 사용자 요청)
    var today = Model.Today.ToString("yyyy년 M월 d일 ", ko) + (Model.Today.DayOfWeek == DayOfWeek.Sunday ? "주일" : Model.Today.ToString("dddd", ko));
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />   @* 퍼블리시본과 같은 글꼴(Pretendard) *@
<link rel="stylesheet" href="~/css/welcome.css" asp-append-version="true" />
<div class="wc2">
<main class="wc2-page">
    <header class="wc2-top">
        <b class="wc2-brand">@brand</b>
        <span class="wc2-tools">
            <a class="wc2-pill wc2-swap" href="/@slug/@(cards ? "welcome" : "welcome2")" aria-label="@(cards ? "표 모양으로 보기" : "카드 모양으로 보기")">@(cards ? "표로 보기" : "카드로 보기")</a>
            @if (Model.Member) { <a class="wc2-pill" href="/account"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.4" r="3.4"/><path d="M5.4 20.2c.5-3.3 3.2-5.4 6.6-5.4s6.1 2.1 6.6 5.4"/></svg>내 정보</a> }
            else { <a class="wc2-pill" href="/account/login"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.4" r="3.4"/><path d="M5.4 20.2c.5-3.3 3.2-5.4 6.6-5.4s6.1 2.1 6.6 5.4"/></svg>로그인</a> }
        </span>
    </header>

    <div class="wc2-hero">
        @if (it.PhotoStoredName is not null) { <img src="/@slug/welcome/photo?v=@it.UpdatedUtc.Ticks" alt="@dept 대표 사진" /> }
        else if (Model.Tenant.IsAdmin) { <a class="wc2-hint" href="/@slug/admin/intro"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="1.6"/><circle cx="8.6" cy="10" r="1.5"/><path d="m20 16-4.6-4.6L7 19"/></svg><span>단체사진</span><em>눌러서 사진 넣기</em></a> }
        else { <div class="wc2-hint"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="1.6"/><circle cx="8.6" cy="10" r="1.5"/><path d="m20 16-4.6-4.6L7 19"/></svg><span>단체사진</span></div> }
    </div>

    <section class="wc2-title">
        <p class="wc2-kicker">@today</p>
        <h1>@it.Title</h1>
        <p class="wc2-sub">@Model.Tenant.Current.Name@(first is null ? "" : $" · {Day(first.DayOfWeek)} {Clock(first.StartTime)}")</p>
    </section>

    <div class="wc2-sec"><h2>오늘의 안내</h2></div>
    @if (cards)
    {
    <nav class="wc2-cards" aria-label="오늘의 안내">
        <a class="wc2-card" style="--bg:#F6E9C8;--ink2:#B7852E" href="/@slug/bulletin"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.2 3.5h9.3l3.3 3.3v13.7H6.2z"/><path d="M15.2 3.6v3.4h3.5"/><path d="M8.8 10.4h6.4M8.8 13.4h6.4M8.8 16.4h4.1"/></svg><span class="lbl">이번 주 주보</span></a>
        <a class="wc2-card" style="--bg:#E3EBDA;--ink2:#6B7F57" href="/@slug/word"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6.4c-1.5-1.5-3.4-2.1-5.6-2.1H3.6v13.6h2.9c2.1 0 4 .5 5.5 1.9"/><path d="M12 6.4c1.5-1.5 3.4-2.1 5.6-2.1h2.8v13.6h-2.9c-2.1 0-4 .5-5.5 1.9"/><path d="M12 6.4v13.4"/></svg><span class="lbl">이번 주 말씀</span></a>
        <a class="wc2-card" style="--bg:#F4E0DD;--ink2:#B5706A" href="/@slug/album"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="1.8"/><circle cx="8.6" cy="10" r="1.5"/><path d="m20 16-4.6-4.6L7 19"/></svg><span class="lbl">@dept 앨범</span></a>
        <a class="wc2-card" style="--bg:#DFE7F5;--ink2:#4E70B8" href="/@slug/welcome?handler=Go"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.4 4.2h9.2v4.1a4.6 4.6 0 0 1-9.2 0z"/><path d="M7.4 5.6H4.9v1.4a3 3 0 0 0 3 3M16.6 5.6h2.5v1.4a3 3 0 0 1-3 3"/><path d="M12 12.9v3.4M8.6 19.8h6.8M9.6 19.8c0-1.6.9-2.6 2.4-2.6s2.4 1 2.4 2.6"/></svg><span class="lbl">도전<i>!!!</i>성경말씀</span></a>
        <a class="wc2-card" style="--bg:#E9E4F4;--ink2:#7A5FB8" href="/@slug/word-mission"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.2 10.6 12 4.1l7.8 6.5v9.3H4.2z"/><path d="M12 16.4c-1.9-1.2-2.9-2.2-2.9-3.3 0-.9.7-1.5 1.5-1.5.6 0 1.1.3 1.4.8.3-.5.8-.8 1.4-.8.8 0 1.5.6 1.5 1.5 0 1.1-1 2.1-2.9 3.3z"/></svg><span class="lbl">부모님과 함께하는 미션북</span><span class="sub">가정예배용</span></a>
        <a class="wc2-card" style="--bg:#F0E8DA;--ink2:#8A6A3C" href="#about"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6v3M10.6 4h2.8"/><path d="M12 5.8 6.4 9.9v10.5h11.2V9.9z"/><path d="M9.9 20.4v-4.8a2.1 2.1 0 0 1 4.2 0v4.8"/></svg><span class="lbl">@dept 소개</span></a>
    </nav>
    }
    else
    {
    <nav class="wc2-grid" aria-label="오늘의 안내">
        <a class="wc2-tile" style="--c:#1F9D55;--cbg:#E4F5EB" href="/@slug/bulletin">
            <span class="wc2-row"><span class="num">01</span><span class="go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
            <span class="lbl">이번 주 주보</span>
        </a>
        <a class="wc2-tile" style="--c:#2F6FE4;--cbg:#E6EEFC" href="/@slug/word">
            <span class="wc2-row"><span class="num">02</span><span class="go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
            <span class="lbl">이번 주 말씀</span>
        </a>
        <a class="wc2-tile" style="--c:#E8681F;--cbg:#FCEBDF" href="/@slug/album">
            <span class="wc2-row"><span class="num">03</span><span class="go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
            <span class="lbl">@dept 앨범</span>
        </a>
        <a class="wc2-tile" style="--c:#E04088;--cbg:#FAE3EE" href="/@slug/welcome?handler=Go">
            <span class="wc2-row"><span class="num">04</span><span class="go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
            <span class="lbl">도전<i>!!!</i>성경말씀</span>
        </a>
        <a class="wc2-tile" style="--c:#7A4BD0;--cbg:#EDE8FA" href="/@slug/word-mission">
            <span class="wc2-row"><span class="num">05</span><span class="go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
            <span class="lbl">부모님과 함께하는 미션북</span>
        </a>
        <a class="wc2-tile" style="--c:#0E8FA0;--cbg:#DDF1F3" href="#about">
            <span class="wc2-row"><span class="num">06</span><span class="go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
            <span class="lbl">@dept 소개</span>
        </a>
    </nav>
    }

    <section class="wc2-about" id="about" aria-label="@dept 소개">
        <h2>@dept 소개</h2>
        @if (it.Body is { } body) { <p class="wc2-intro">@body</p> }
        @foreach (var w in Model.Worship)
        {
            <div class="wc2-wb">
                <div>
                    <h3>@(w.Title ?? "예배 안내")</h3>
                    <p class="t">@Day(w.DayOfWeek) @Clock(w.StartTime)</p>
                    <p class="p">@w.Place</p>
                </div>
                @if (w.Address is { } a) { <a class="map" href="https://map.naver.com/p/search/@Uri.EscapeDataString(a)" target="_blank" rel="noopener">지도</a> }
            </div>
        }
    </section>

    <section class="wc2-install" aria-label="앱 설치">
        <a class="wc2-install-btn" href="/install?back=@Uri.EscapeDataString($"/{slug}/welcome")" data-app-install>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M12 8v6M9.5 12l2.5 2.5 2.5-2.5"/></svg>앱으로 설치
        </a>
        <p class="wc2-note">홈 화면에 추가하면 주보를 바로 열 수 있어요</p>
    </section>

    @if (Model.Member)
    {
        <form class="wc2-later" method="post" asp-route-slug="@slug">
            <button type="submit" asp-page-handler="Later">1주일 후 다시 보기</button>
            <button type="submit" asp-page-handler="Never">다시 보지 않기</button>
        </form>
    }

    <footer class="wc2-foot">
        <div class="f1"><b>@Model.Tenant.Current.Name</b><a class="en" href="https://www.saenae.org/" target="_blank" rel="noopener" aria-label="잠실새내교회 홈페이지 (새 창)">JAMSIL SAENAE CHURCH</a></div>
        @if (addr is not null) { <p class="f3">@addr</p> }
    </footer>
</main>
</div>
