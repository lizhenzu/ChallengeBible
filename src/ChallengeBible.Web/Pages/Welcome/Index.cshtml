@page "/{slug}/welcome"
@model ChallengeBible.Web.Pages.Welcome.IndexModel
@using ChallengeBible.Web.Services
@using ChallengeBible.Web.Auth
@inject ChallengeBible.Web.Services.PhotoService Photos
@* 부서 소개(웰컴) 화면 — 2026-11-25 사용자 새 퍼블리시본 「JAMSIL KIDS · 유년부 주보 v2 — 홈」으로 완전 교체(ADR 0140 · 이전 틴트 카드판 대체). 행정업무(교사 · 관리자) 버튼은 /{부서}/office 로 연결. 아래는 이전 설명:  순백 바탕 · 헤어라인 · 검정 헤비 제목 · 컬러 번호 2열 표.
   현재 있는 기능만 연결: 내 정보(계정) · 대표 사진 · 날짜 · 제목 · 예배 줄 · 주보 · 앨범 · 도전!!! 성경말씀으로 가기 · 소개(글 + 예배 안내) · 앱 설치 ·
   (로그인한 사람만) 1주일 후 다시 보기 · 다시 보지 않기. 퍼블리시본의 「이번 주 말씀」 · 「미션북」 칸은 아직 없는 기능이라 연결하지 않았다. *@
@{
    var slug = Model.Tenant.Current.Slug;
    var dept = PlatformTodayService.ShortDept(Model.Tenant.Current.Name);
    var it = Model.Item;
    var first = Model.Worship.FirstOrDefault();
    var addr = Model.Worship.Select(w => w.Address).FirstOrDefault(a => !string.IsNullOrWhiteSpace(a));
    string Clock(TimeOnly t) => $"{(t.Hour < 12 ? "오전" : "오후")} {(t.Hour % 12 == 0 ? 12 : t.Hour % 12)}:{t.Minute:00}";
    string Day(byte d) => d == 0 ? "주일" : new[] { "일", "월", "화", "수", "목", "금", "토" }[d] + "요일";
    var meName = User.UserName();
    var meShow = User.DisplayName();
    var office = ChallengeBible.Web.Pages.Office.IndexModel.CanUse(Model.Tenant);
    var officeShow = office || !Model.Member;   // 손님에게도 보인다 — 누르면 로그인(2026-11-25 사용자)
    var officeHref = Model.Member ? $"/{slug}/office" : "/account/login?returnUrl=" + Uri.EscapeDataString($"/{slug}/office");
    var mePhoto = meName is null ? null : await Photos.FileOfAsync(meName);
    var ko = new System.Globalization.CultureInfo("ko-KR");
    var today = Model.Today.ToString("yyyy년 M월 d일 ", ko) + (Model.Today.DayOfWeek == DayOfWeek.Sunday ? "주일" : Model.Today.ToString("dddd", ko));
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
<link rel="stylesheet" href="~/css/welcome.css" asp-append-version="true" />
@{
    const string ARROW = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4.6 12h14.2\"/><path d=\"M13.2 6.2 19 12l-5.8 5.8\"/></svg>";
}
<div class="wl">
<div class="wl-page">
<main class="wl-screen">

    <header class="wl-topbar">
        <div class="wl-brand">
            <span class="wl-brand__denom">대한예수교장로회</span>
            <a class="wl-brand__name" href="https://www.saenae.org/" target="_blank" rel="noopener" aria-label="잠실새내교회 홈페이지 (새 창)">잠실새내교회</a>
        </div>
        @* 내 정보(2026-11-25 새 퍼블리시본): 로그인한 사람은 사진(없으면 이름 첫 글자) · 손님은 사람 아이콘 = 로그인 *@
        @if (Model.Member)
        {
            <a class="wl-icon-btn" href="/account" aria-label="내 계정 (@Ui.Nim(meShow))">
                @if (mePhoto is { } ph) { <img src="/account/photo?handler=img&amp;v=@ph" alt="" /> }
                else if (meShow.Length > 0) { <b aria-hidden="true">@meShow[..1]</b> }
                else { <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8.4" r="3.4"/><path d="M5.4 20.2c.5-3.3 3.2-5.4 6.6-5.4s6.1 2.1 6.6 5.4"/></svg> }
            </a>
        }
        else
        {
            <a class="wl-icon-btn" href="/account/login" aria-label="로그인"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8.4" r="3.4"/><path d="M5.4 20.2c.5-3.3 3.2-5.4 6.6-5.4s6.1 2.1 6.6 5.4"/></svg></a>
        }
    </header>

    <div class="wl-intro">
        <div class="wl-hero">
            @if (it.PhotoStoredName is not null) { <img src="/@slug/welcome/photo?v=@it.UpdatedUtc.Ticks" alt="@dept 대표 사진" /> }
            else if (Model.Tenant.IsAdmin) { <a class="wl-hero__empty" href="/@slug/admin/intro"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="15" rx="2"/><circle cx="8.4" cy="9.6" r="1.5"/><path d="m20.4 15.6-4.6-4.6L6 20.4"/></svg>단체사진을 올려 주세요</a> }
            else { <div class="wl-hero__empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="15" rx="2"/><circle cx="8.4" cy="9.6" r="1.5"/><path d="m20.4 15.6-4.6-4.6L6 20.4"/></svg>단체사진이 아직 없어요</div> }
        </div>
        <div class="wl-titleblock">
            <p class="wl-kicker">@today</p>
            <h1 class="wl-title">@it.Title</h1>
            <div class="wl-badges">
                <span class="wl-badge wl-badge--1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.6v3M10.6 4h2.8"/><path d="M12 5.8 6.4 9.9v10.5h11.2V9.9z"/><path d="M9.9 20.4v-4.8a2.1 2.1 0 0 1 4.2 0v4.8"/></svg>@Model.Tenant.Current.Name</span>
                @if (first is not null) { <span class="wl-badge wl-badge--2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.6"/><path d="M12 7.4V12l3 2"/></svg>@Day(first.DayOfWeek) @Clock(first.StartTime)</span> }
            </div>
        </div>
    </div>

    <div class="wl-sec-head"><h2>오늘의 안내</h2></div>
    <nav class="wl-grid" aria-label="오늘의 안내">
        <a class="wl-tile wl-tile--1" data-id="bulletin" href="/@slug/bulletin"><span class="wl-tile__row"><span class="wl-tile__num">01</span><span class="wl-tile__go">@Html.Raw(ARROW)</span></span><span class="wl-tile__label">이번 주 주보</span></a>
        <a class="wl-tile wl-tile--2" data-id="word" href="/@slug/word"><span class="wl-tile__row"><span class="wl-tile__num">02</span><span class="wl-tile__go">@Html.Raw(ARROW)</span></span><span class="wl-tile__label">이번 주 말씀</span></a>
        <a class="wl-tile wl-tile--3" data-id="rules" href="/@slug/album"><span class="wl-tile__row"><span class="wl-tile__num">03</span><span class="wl-tile__go">@Html.Raw(ARROW)</span></span><span class="wl-tile__label">@dept 앨범</span></a>
        <a class="wl-tile wl-tile--4" data-id="mission" href="/@slug/welcome?handler=Go"><span class="wl-tile__row"><span class="wl-tile__num">04</span><span class="wl-tile__go">@Html.Raw(ARROW)</span></span><span class="wl-tile__label">도전!!!성경말씀</span></a>
        <div class="wl-tile wl-tile--5 wl-tile--off" data-id="family"><span class="wl-tile__row"><span class="wl-tile__num">05</span><span class="wl-tile__go">@Html.Raw(ARROW)</span></span><span class="wl-tile__label">부모님과 함께하는 미션북</span></div>
        <div class="wl-tile wl-tile--6 wl-tile--off" data-id="about"><span class="wl-tile__row"><span class="wl-tile__num">06</span><span class="wl-tile__go">@Html.Raw(ARROW)</span></span><span class="wl-tile__label">@dept 소개</span></div>
    </nav>

    @* 소개 글 · 예배 안내(시간 · 장소 · 지도)는 이 화면에서 잠시 뺐다 — 나중에 상세 설계(2026-11-24 사용자). 관리의 입력 칸 · 데이터는 그대로 있다. *@

    <div class="wl-actions@(officeShow ? "" : " wl-actions--solo")">
        @if (officeShow)
        {
            <a class="wl-admin" href="@officeHref">
                <span><span class="wl-admin__kicker">ADMIN · 교사 전용</span><span class="wl-admin__label">행정업무</span></span>
                <span class="wl-admin__go">@Html.Raw(ARROW)</span>
            </a>
        }
        <div class="wl-install" data-wl-install>
            <a class="wl-install__btn" href="/install?back=@Uri.EscapeDataString($"/{slug}/welcome")" data-app-install>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6.2" y="2.6" width="11.6" height="18.8" rx="2.6"/><path d="M10.6 18.4h2.8"/><path d="M12 7.4v6.2M9.4 11l2.6 2.6L14.6 11"/></svg>
                앱으로 설치
            </a>
            <p class="wl-install__note">홈 화면에 추가하면 바로가기로 열 수 있어요.</p>
        </div>
    </div>

    <footer class="wl-footer">
        <p>@(addr ?? Model.Tenant.Current.Name)</p>
    </footer>
</main>
</div>
</div>
<script>
    // 이미 설치했으면(이 기기에서 설치 안내를 마쳤거나 앱으로 열었으면) 설치 안내를 숨긴다. 설치 화면(install.js)이 완료를 localStorage(cb-install)에 적어 둔다.
    (() => {
        const box = document.querySelector('[data-wl-install]');
        if (!box) return;
        let done = matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
        try { done = done || JSON.parse(localStorage.getItem('cb-install') || '{}').s === 'done'; } catch { /* 무시 */ }
        if (done) box.hidden = true;
        addEventListener('appinstalled', () => { box.hidden = true; });
    })();
    // 제목 한 줄 맞춤: 넘치면 글자 크기를 1px 씩 줄인다(최소 18px). 화면 폭이 바뀌면 다시 맞춘다.
    (() => {
        const t = document.querySelector('.wl-title');
        if (!t) return;
        const fit = () => { t.style.fontSize = ''; let s = parseFloat(getComputedStyle(t).fontSize); while (t.scrollWidth > t.clientWidth && s > 18) { s -= 1; t.style.fontSize = s + 'px'; } };
        fit();
        addEventListener('resize', fit);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    })();
</script>
