@page
@model IndexModel
@using ChallengeBible.Domain.Time
@* 첫 화면(2026-11-23 사용자 확정: design_handoff_home_b · 시안 B 모노 톤).
   히어로(교회 · 날짜 · 사람 아이콘) → 네 가지 도전 목록 → 오늘의 말씀 + 현황 → 접이식 관리자 로그인 → 저작권.
   로그인한 사람은 이 화면에 머물며 머리말 「000님」과 부서 바로가기를 본다(R-173). *@
@{
    var d = Model.Data;
    var st = d.Stats;
    var ko = new System.Globalization.CultureInfo("ko-KR");
    static string Md(DateOnly x) => x.ToString("M'/'d");
    var weekPeople = st.Week.Sum(w => w.People);
    static string Ro(string w) { var c = w.Length == 0 ? 'a' : w[^1]; var j = c is >= '가' and <= '힣' ? (c - '가') % 28 : 0; return j == 0 || j == 8 ? "로" : "으로"; }
    // 가족팀 화면은 부서가 하나일 때만(그 부서의 family-team). 초대·카드·만들기 카드가 모두 이 주소로 간다.
    var famTo = Model.Me switch
    {
        null => "/account/login",
        { Slug: { } famSlug } => $"/{famSlug}/family-team",
        _ => "/account/tenants",
    };
    // 로그인 전 → 로그인 / 부서 1곳 → 그 부서의 프로그램 / 여러 곳 → 부서 고르기 / 없음 → 참여 신청
    string P(string prog) => Model.Me switch
    {
        null => "/account/login",
        { DeptCount: 1, Slug: { } s } => $"/{s}/{prog}",
        { DeptCount: >= 2 } => "/account/tenants",
        _ => "/join",
    };
}
<link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
<div class="vb">

<header class="vb-hero">
    <img class="vb-clover" src="~/icons/clover.svg" alt="" aria-hidden="true" />
    <div class="vb-hero-in">
        <div class="vb-top">
            <div class="vb-top-l">
                <button type="button" class="vb-burger" aria-label="메뉴 열기" aria-controls="pnav" aria-expanded="false" data-pnav-open>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                </button>
                <a class="church" href="https://www.saenae.org/" target="_blank" rel="noopener" aria-label="잠실새내교회 홈페이지 (새 창)">
                    <small>대한예수교장로회</small>
                    <span>잠실새내교회</span>
                </a>
            </div>
            <div class="vb-top-r">
                <time class="vb-date" datetime="@d.Today.ToString("yyyy-MM-dd")">@d.Today.ToString("M월 d일", ko) <small>@d.Today.ToString("dddd", ko)</small></time>
                @if (Model.Me is { } me)
                {
                    <a class="hmx-me" href="/account" aria-label="내 계정 · @Ui.Nim(me.Name)">
                        <span class="av" aria-hidden="true">@Ui.Initial(me.Name)</span>
                        <b>@Ui.Nim(me.Name)</b>
                    </a>
                }
                else
                {
                    <a class="person-btn" href="/account/login" aria-label="로그인" title="로그인">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20c1.2-3.6 4.1-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/></svg>
                    </a>
                }
            </div>
        </div>

        <div class="vb-hero-row">
            <div class="vb-body">
                <h1 class="brand-title">
                    <span class="bt-1">도전<span class="bt-ex"><i class="e1">!</i><i class="e2">!</i><i class="e3">!</i></span></span>
                    <span class="bt-2">성경말씀</span>
                </h1>
                <p class="vb-tag">4가지 도전, 하나의 말씀.<br />하루 5분, 말씀과 함께 자라요.</p>
                <div class="vb-pills" aria-label="프로그램">
                    <span class="pp1">성경미션</span><span class="pp2">성경통독</span><span class="pp3">성경필사</span><span class="pp4">기도365</span>
                </div>
            </div>
            @* 나의 포인트 링(2026-11-23 사용자 확정 B안 · ADR 0136): 「도전 성경말씀」 오른쪽 빈자리. *@
            @if (Model.Ring is { } ring)
            {
                ViewData["RingSize"] = 92;
                <partial name="_PointRing" model="ring" />
            }
        </div>
    </div>
</header>

<main class="vb-main">

    <div class="vb-sec-h">
        <h2>4가지 도전</h2>
        <p>어느 것부터 해도 좋아요</p>
    </div>

    <nav class="vb-list" aria-label="프로그램">
        <a class="vb-item" href="@P("word-mission")" style="--c: var(--p1); --s: var(--s1);">
            <span class="vb-no">01</span>
            <span class="vb-t">
                <small>도전!!!</small>
                <b>성경미션</b>
                <p>매일 하나씩 주어지는 말씀 미션을 풀어요</p>
            </span>
            <span class="vb-go"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
        <a class="vb-item" href="@P("reading")" style="--c: var(--p2); --s: var(--s2);">
            <span class="vb-no">02</span>
            <span class="vb-t">
                <small>도전!!!</small>
                <b>성경통독</b>
                <p>계획표를 따라 하루 몇 장씩, 끝까지 읽어요</p>
            </span>
            <span class="vb-go"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
        <a class="vb-item" href="@P("copy")" style="--c: var(--p3); --s: var(--s3);">
            <span class="vb-no">03</span>
            <span class="vb-t">
                <small>도전!!!</small>
                <b>성경필사</b>
                <p>말씀을 한 절씩 따라 쓰며 마음에 새겨요</p>
            </span>
            <span class="vb-go"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
        <a class="vb-item" href="@P("prayer365")" style="--c: var(--p4); --s: var(--s4);">
            <span class="vb-no">04</span>
            <span class="vb-t">
                <small>자녀를 위한</small>
                <b>기도365</b>
                <p>매일 한 가지 주제로 자녀를 위해 기도해요</p>
            </span>
            <span class="vb-go"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
    </nav>

    <div class="vb-row">
        @if (d.VerseText is { } vt)
        {
            <section class="vb-verse" id="vb-verse" aria-label="오늘의 말씀">
                <h3>오늘의 말씀</h3>
                <blockquote class="serif">“@vt”</blockquote>
                @if (d.VerseRef is not null || d.WordRange is not null)
                {
                    <cite>@d.VerseRef@if (d.WordRange is { } wr) { <text> · @wr</text> }</cite>
                }
                @if (d.ReciteRange is not null || d.PrayerTrait is not null)
                {
                    <div class="vb-meta">
                        @if (d.ReciteRange is { } rr && d.ReciteStart is { } rs && d.ReciteEnd is { } re)
                        {
                            <span>이번 주 암송 <b>@rr</b> <span class="nw">(@Md(rs) ~ @Md(re))</span></span>
                        }
                        @if (d.PrayerTrait is { } pt)
                        {
                            <span>오늘의 기도 <b>@pt</b>@if (d.PrayerRange is { } pr) { <text> · @pr</text> }</span>
                        }
                    </div>
                }
            </section>
        }

        @* 현황 카드는 「나의 도전」 화면으로 옮겼다(2026-11-23 사용자 확정 · ADR 0136). *@
        @if (Model.Card is null)
        {
            <section class="vb-stat" id="vb-stat" aria-label="함께하는 현황">
                <h3>올해 함께 읽은 성경</h3>
                <p class="vb-big num">@st.YearChapters.ToString("N0")<small>장</small></p>
                <div class="vb-three">
                    <div><b class="num">@st.Tenants<small>곳</small></b><span>함께하는 부서</span></div>
                    <div><b class="num">@st.People<small>명</small></b><span>참여하는 사람</span></div>
                    <div><b class="num">@st.TodayPeople<small>명</small></b><span>오늘 함께한 사람</span></div>
                </div>
                <p class="vb-week">최근 7일 참여 <b class="num">@(weekPeople)명</b></p>
            </section>
        }
    </div>

    @* 선물 대상자와 상태(ADR 0134): 「나의 도전」 화면에는 넣지 않고, 홈에 그대로 둔다. 부서 하나뿐인 사람만. *@
    @if (Model.GiftBoard is not null && Model.CardSlug is { } giftSlug)
    {
        <partial name="_GiftTargetCard" model="new GiftTargetCardVm(Model.GiftBoard, giftSlug, false, null)" />
    }

    @* 가족팀(ADR 0132 · 0137): 2026-11-23 사용자 확정 — 첫 화면(/)에서는 「우리 가족팀」 카드를 뺐다.
       초대 배너 → 만들기 유도만 남긴다(팀 점수 · 구성원은 가족팀 화면에서 본다). *@
    @if (Model.FamilyOn)
    {
        if (Model.Invites.Count > 0)
        {
            var first = Model.Invites[0];
            <section class="hmx-inv" aria-label="가족팀 초대">
                <div class="hd">
                    <span class="em" aria-hidden="true">💌</span>
                    <div><b>가족팀 초대가 왔어요!</b>
                        <small>@(Model.Invites.Count > 1 ? $"{first.TeamName} 외 {Model.Invites.Count - 1}팀에서 초대했어요" : $"{Ui.Nim(first.InvitedBy)}이 {first.TeamName}{Ro(first.TeamName)} 초대했어요")</small>
                    </div>
                    <span class="cnt num">@(Model.Invites.Count)개</span>
                </div>
                <div class="row">
                    <a class="go" href="@famTo">초대 확인하기</a>
                    <form method="post" asp-page-handler="SnoozeInvites"><button type="submit" class="later">다음에 할래요</button></form>
                </div>
            </section>
        }
        else if (Model.FamilyCanJoin)
        {
            <section class="hmx-make" aria-label="가족팀 · 친구팀 만들기">
                <div class="hd">
                    <span class="em" aria-hidden="true">👨‍👩‍👧</span>
                    <div><b>가족팀 · 친구팀을 만들어 보세요</b><small>함께 하면 점수가 모여요. 부모님·형제, 친구와 팀을 이뤄요.</small></div>
                </div>
                <div class="row">
                    <a class="go" href="@famTo">가족팀 만들기</a>
                    @if (Model.FamilyIsStudent) { <a class="alt" href="@famTo">친구팀 만들기</a> }
                </div>
            </section>
        }
    }

    <div class="vb-foot">
        <details class="adm">
            <summary class="adm-toggle">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                <span>관리자 · 부서 대표 학생 로그인</span>
                <svg class="chev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="adm-body">
                <div class="adm-tabs" role="tablist" aria-label="로그인 종류">
                    <button type="button" class="on" data-tab="mgr" role="tab" aria-selected="true">부서 관리자</button>
                    <button type="button" data-tab="stu" role="tab" aria-selected="false">대표 학생</button>
                </div>
                <p class="adm-hint">부서를 누르고 비밀번호만 넣어요.</p>
                <h3 class="sr-only">부서 관리자 로그인</h3>
                <div class="adm-grid" data-panel="mgr">
                    @foreach (var da in Model.DeptAdmins)
                    {
                        <a class="lp-adm c@(da.Color)" href="/account/dept-login/@da.Slug"><i></i>@da.Label</a>
                    }
                </div>
                <h3 class="sr-only">부서 대표 학생 로그인</h3>
                <div class="adm-grid" data-panel="stu" hidden>
                    @foreach (var ds in Model.DeptStudents)
                    {
                        <a class="lp-adm c@(ds.Color)" href="/account/student-login/@ds.Slug"><i></i>@ds.Short 학생</a>
                    }
                </div>
                <a class="adm-plat" href="/account/admin-login">
                    플랫폼 관리자 로그인
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
            </div>
        </details>
        <div class="vb-footrow">
            <span class="foot">© @Model.Year 잠실새내 · 주일학교</span>
            <a href="/install">앱으로 설치</a>
        </div>
    </div>

</main>

@if (Model.DrawerTenant is { } drawer)
{
    @* 부서가 하나인 사람: 부서 화면의 기존 ☰ 메뉴판을 그대로 쓴다(2026-11-23 사용자). *@
    <partial name="_TenantDrawer" model="(drawer, (string?)null)" />
}
else
{
    <div class="pdrawer vb-dr" id="pnav" hidden>
        <div class="pd-dim" data-pnav-close></div>
        <aside class="pd-panel" tabindex="-1" role="dialog" aria-modal="true" aria-label="메뉴">
            <div class="vb-dr-head">
                <a class="church" href="https://www.saenae.org/" target="_blank" rel="noopener">
                    <small>대한예수교장로회</small>
                    <span>잠실새내교회</span>
                </a>
                <button type="button" class="vb-dr-x" aria-label="메뉴 닫기" data-pnav-close>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
                </button>
            </div>

            @if (Model.Me is { } dme)
            {
                <a class="vb-dr-login" href="/account">
                    <span class="person-btn" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20c1.2-3.6 4.1-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/></svg></span>
                    <span><b>@Ui.Nim(dme.Name)</b><small>내 계정 · 내 기록 보기</small></span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
            }
            else
            {
                <a class="vb-dr-login" href="/account/login">
                    <span class="person-btn" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20c1.2-3.6 4.1-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/></svg></span>
                    <span><b>로그인해 주세요</b><small>내 부서 · 내 기록 그대로</small></span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
            }

            <p class="vb-dr-cap">4가지 도전</p>
            <nav class="vb-dr-list">
                <a href="@P("word-mission")" style="--s: var(--s1); --c: var(--p1);"><span class="vb-dr-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a1.5 1.5 0 0 0-1.5 1.5v15A1.5 1.5 0 0 0 7 21h10a1.5 1.5 0 0 0 1.5-1.5V7.5z"/><path d="M14 3v4.5h4.5"/><path d="M9 13.5l2 2 4-4.5"/><path d="M8 18h8"/></svg></span>성경미션</a>
                <a href="@P("reading")" style="--s: var(--s2); --c: var(--p2);"><span class="vb-dr-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H14l3.5 3.5V19.5A1.5 1.5 0 0 1 16 21H6.5A1.5 1.5 0 0 1 5 19.5z"/><path d="M14 3v3.5h3.5"/><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4"/></svg></span>성경통독</a>
                <a href="@P("copy")" style="--s: var(--s3); --c: var(--p3);"><span class="vb-dr-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.5 4.5l3 3L9 18l-4 1 1-4z"/><path d="M14.5 6.5l3 3"/><path d="M4 21h16"/></svg></span>성경필사</a>
                <a href="@P("prayer365")" style="--s: var(--s4); --c: var(--p4);"><span class="vb-dr-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-7.5-10A4.2 4.2 0 0 1 12 7.6a4.2 4.2 0 0 1 7.5 2.9c0 5.4-7.5 10-7.5 10z"/><path d="M12 10.5v4M10 12.5h4"/></svg></span>기도365</a>
            </nav>

            <p class="vb-dr-cap">말씀</p>
            <nav class="vb-dr-list plain">
                <a href="#vb-verse">오늘의 말씀</a>
                <a href="#vb-verse">이번 주 암송</a>
                <a href="#vb-stat">함께하는 현황</a>
            </nav>

            <p class="vb-dr-cap">도움</p>
            <nav class="vb-dr-list plain">
                @if (Model.Me is null)
                {
                    <a href="/account/signup">처음 오셨나요? · 가입하기</a>
                }
                else if (Model.Me.DeptCount >= 2)
                {
                    <a href="/account/tenants">부서 고르기</a>
                }
                <a href="/install">앱으로 설치</a>
            </nav>

            <a class="vb-dr-church" href="https://www.saenae.org/" target="_blank" rel="noopener">잠실새내교회 홈페이지 ↗</a>
        </aside>
    </div>
    <script src="~/js/platform-nav.js" asp-append-version="true" defer></script>
}
</div>

<script>
    (function () {
        var panel = document.querySelector('.vb .adm');
        if (!panel) return;
        panel.querySelectorAll('.adm-tabs button').forEach(function (b) {
            b.addEventListener('click', function () {
                panel.querySelectorAll('.adm-tabs button').forEach(function (x) {
                    x.classList.toggle('on', x === b);
                    x.setAttribute('aria-selected', x === b ? 'true' : 'false');
                });
                panel.querySelectorAll('.adm-grid').forEach(function (g) {
                    g.hidden = g.getAttribute('data-panel') !== b.getAttribute('data-tab');
                });
            });
        });
    })();
</script>
