@page
@model IndexModel
@using ChallengeBible.Domain.Rules
@using ChallengeBible.Infrastructure.Data
@* 로그인 전 공통 첫 화면 — 확정 시안 로그인전-첫화면-v2(0061): 밝은 하늘색, 그라데이션 없음.
   오늘의 말씀 = 공용 콘텐츠(없는 날은 카드 숨김), 숫자 = 모든 부서 합계만, 휴대폰 · 가족 예시는 고정 그림, 점수 · 축하 단계는 규칙에서 *@
@{
    var d = Model.Data;
    var r = d.Rules;
    var s = d.Stats;
    var ko = new System.Globalization.CultureInfo("ko-KR");
    int Pts(MissionItem i) => r.Item(i).Points;
    bool On(MissionItem i) => r.Item(i).Enabled;
    var firstCheer = r.Milestones.Count > 0 ? r.Milestones.Min() : 0;
    var fam = r.FamilyMilestones.Where(f => f.Enabled).OrderBy(f => f.Points).FirstOrDefault();
    var famTotal = (fam?.Points ?? 1000) + 236;   // 예시 그림: 첫 가족 단계를 막 넘은 가족
    var famKid = famTotal * 52 / 100;
    var weekMax = Math.Max(1, s.Week.Count == 0 ? 1 : s.Week.Max(w => w.People));
    var otRead = 23;   // 예시 그림: 창세기 23장까지
}
<link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
<div class="ld">
<header class="ld-top gut">
  <div class="wrap">
    <div class="org">
      <small>대한예수교장로회</small>
      <a class="church" href="https://www.saenae.org/" target="_blank" rel="noopener" aria-label="잠실새내교회 홈페이지 (새 창)">잠실새내교회<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a>
    </div>
    <time class="today" datetime="@d.Today.ToString("yyyy-MM-dd")"><small class="yr">@d.Today.ToString("yyyy년", ko)</small> <b>@d.Today.ToString("M월 d일", ko)</b> <small>@d.Today.ToString("dddd", ko)</small></time>
  </div>
</header>

<section class="hero gut">
  <div class="wrap">
    <div>
      <div class="eyebrow">교회 부서와 모임을 위한 말씀 습관</div>
      <h1>하루 5분,<br><em>말씀과 함께</em> 자라요</h1>
      <p class="sub">매일 말씀을 읽고, 기도하고, 퀴즈를 풀고, 이번 주 구절을 외워요. 성경 전체를 내 속도로 읽어 나갈 수도 있어요.</p>
      <div class="brands"><span><i></i>도전!!!성경말씀</span><span class="r"><i></i>도전!!!성경통독</span></div>
      <div class="cta">
        <a class="btn p" href="/account/login">로그인</a>
        <a class="btn s" href="/account/signup">처음이에요 · 가입하기</a>
      </div>
      <p class="hint-in">로그인하면 내가 속한 부서로 바로 들어가요.</p>
    </div>

    <div class="shots" aria-hidden="true">
      <div class="ph a">
        <div class="bar"><span>우리 부서</span><span class="num">@d.Today.ToString("MM.dd")</span></div>
        <div class="t">도전!!!성경말씀</div>
        <div class="rw">
          <svg width="52" height="52" viewBox="0 0 52 52"><circle cx="26" cy="26" r="21" fill="none" stroke="var(--accent-soft)" stroke-width="7"/><circle cx="26" cy="26" r="21" fill="none" stroke="var(--accent)" stroke-width="7" stroke-linecap="round" stroke-dasharray="99 132" transform="rotate(-90 26 26)"/></svg>
          <div><small style="font-size:10px;color:var(--dim)">오늘 3/4 · 올해</small><br><b class="num">124</b><small style="font-size:11px;color:var(--dim)"> 점</small></div>
        </div>
        <div class="tiles">
          <span style="background:var(--word-bg);color:var(--word)">말씀<small>완료</small></span>
          <span style="background:var(--quiz-bg);color:var(--quiz);box-shadow:0 0 0 1.5px currentColor inset">퀴즈<small>할 차례</small></span>
          <span style="background:var(--pray-bg);color:var(--pray)">기도<small>완료</small></span>
          <span style="background:var(--rec-bg);color:var(--rec)">암송<small>이번 주 완료</small></span>
        </div>
      </div>
      <div class="ph b">
        <div class="bar"><span>구약 › 창세기</span><span>1독째</span></div>
        <div class="t t2">창세기 24장</div>
        <div class="vs"><sup>1</sup>아브라함이 나이가 많아 늙었고 여호와께서 그에게 범사에 복을 주셨더라<span class="ck">✓</span></div>
        <div class="vs"><sup>2</sup>아브라함이 자기 집 모든 소유를 맡은 늙은 종에게 이르되…</div>
        <div class="pg"><i></i></div>
        <div style="font-size:10px;color:var(--dim);margin-top:4px">창세기 23 / 50장</div>
      </div>
      <div class="float f1">🔥 <b>5일째</b> 이어 가는 중</div>
      <div class="float f2">📖 오늘 <b>3장</b> 읽음</div>
      @if (firstCheer > 0) { <div class="float f3">🎉 <b>@firstCheer.ToString("N0")점</b> 축하!</div> }
    </div>
  </div>
</section>

@if (d.VerseText is not null)
{
  <section class="word gut" aria-label="오늘의 말씀">
    <div class="wrap">
      <div class="paper">
        <span class="q" aria-hidden="true">“</span>
        <div>
          <div class="k">오늘의 말씀 · @d.Today.ToString("M월 d일 dddd", ko)</div>
          <blockquote>@d.VerseText</blockquote>
          <cite>@d.VerseRef · 오늘 읽을 범위 @d.WordRange</cite>
        </div>
        <div class="side">
          @if (d.ReciteRange is not null) { <div><small>이번 주 암송 <span class="nw">(@d.ReciteStart?.ToString("M'/'d") ~ @d.ReciteEnd?.ToString("M'/'d"))</span></small><b>@d.ReciteRange</b></div> }
          @if (d.PrayerTrait is not null) { <div><small>오늘의 기도</small><b>@d.PrayerTrait@(d.PrayerRange is null ? "" : $" · {d.PrayerRange}")</b></div> }
        </div>
      </div>
    </div>
  </section>
}

<section class="blk gut" aria-labelledby="ms">
  <div class="wrap">
    <div class="eyebrow">도전!!!성경말씀</div>
    <h2 id="ms">하루 네 가지,<br>한 만큼 점수가 쌓여요</h2>
    <p class="lead">눌러 보세요. 미션마다 하는 일과 점수가 달라요.</p>
    <div class="tabs" role="tablist" aria-label="미션 네 가지">
      <button type="button" class="w" role="tab" aria-selected="true" data-p="w"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H2z"/><path d="M22 5h-7a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h8z"/></svg>말씀</button>
      <button type="button" class="q" role="tab" aria-selected="false" data-p="q"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>퀴즈</button>
      <button type="button" class="pr" role="tab" aria-selected="false" data-p="pr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c-1 3-4 5-4 9a4 4 0 0 0 8 0c0-4-3-6-4-9z"/><path d="M12 21v-5"/></svg>기도</button>
      <button type="button" class="rc" role="tab" aria-selected="false" data-p="rc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"/></svg>암송</button>
    </div>
    <div class="pane w" role="tabpanel" data-pane="w">
      <div><h3>말씀</h3><p>오늘 읽을 범위를 읽고, 부모님께도 읽어 드려요. 세 가지 번역으로 나란히 볼 수 있어요.</p></div>
      <ul>@if (On(MissionItem.WordMe)) { <li>내가 읽었어요<b>+@(Pts(MissionItem.WordMe))점</b></li> }@if (On(MissionItem.WordParent)) { <li>부모님께 읽어 드렸어요<b>+@(Pts(MissionItem.WordParent))점</b></li> }</ul>
    </div>
    <div class="pane q" role="tabpanel" data-pane="q" hidden>
      <div><h3>퀴즈</h3><p>오늘 말씀에서 한 문제.@(r.QuizMaxAttempts > 1 ? " 틀려도 다시 도전할 수 있어요." : "")</p></div>
      <ul>@if (On(MissionItem.QuizCorrect)) { <li>정답을 맞혔어요<b>+@(Pts(MissionItem.QuizCorrect))점</b></li> }<li>기회는 하루 @(r.QuizMaxAttempts)번<b>도전</b></li></ul>
    </div>
    <div class="pane pr" role="tabpanel" data-pane="pr" hidden>
      <div><h3>기도</h3><p>날마다 바뀌는 성품 기도로 나와 가족, 친구를 위해 기도해요.</p></div>
      <ul>@if (On(MissionItem.PrayerMe)) { <li>나를 위해 기도했어요<b>+@(Pts(MissionItem.PrayerMe))점</b></li> }@if (On(MissionItem.PrayerOthers)) { <li>다른 사람을 위해 기도했어요<b>+@(Pts(MissionItem.PrayerOthers))점</b></li> }</ul>
    </div>
    <div class="pane rc" role="tabpanel" data-pane="rc" hidden>
      <div><h3>암송</h3><p>이번 주 구절을 외워요. 한 주에 한 번이면 돼요.</p></div>
      <ul>@if (On(MissionItem.Recite)) { <li>이번 주 구절을 외웠어요<b>+@(Pts(MissionItem.Recite))점</b></li> }@if (firstCheer > 0) { <li>@(firstCheer.ToString("N0"))점이 되면<b>🎉 축하</b></li> }</ul>
    </div>
    <div class="day"><b class="num">5분</b><span>네 가지를 다 해도 하루 5분이면 충분해요. 이어서 할수록 연속 기록이 늘어나요.</span></div>
  </div>
</section>

<section class="blk rdb gut" aria-labelledby="rd">
  <div class="wrap">
    <div class="eyebrow">도전!!!성경통독</div>
    <h2 id="rd">성경 1,189장,<br>내 속도로 끝까지</h2>
    <p class="lead">정해진 일정 없이 읽은 만큼 칠해져요. 어른 모임도 함께해요. 아래는 창세기 @(otRead)장까지 읽은 모습이에요.</p>
    <div class="map" aria-label="성경 66권 지도 예시">
      <div class="row"><small><span>구약 39권 · 929장</span><span class="num">@otRead / 929</span></small>
        <div class="strip">@for (var i = 0; i < BibleBooks.Old.Length; i++) { var n = BibleBooks.Old[i].Chapters; <i style="flex:@n" class="@(i == 0 ? (otRead >= n ? "done" : "half") : "")"></i> }</div></div>
      <div class="row"><small><span>신약 27권 · 260장</span><span class="num">0 / 260</span></small>
        <div class="strip">@foreach (var b in BibleBooks.New) { <i style="flex:@b.Chapters"></i> }</div></div>
      <div class="key"><span><i style="background:var(--rd)"></i>다 읽은 권</span><span><i style="background:var(--rd-bar)"></i>읽는 중</span><span><i style="background:var(--bg)"></i>아직</span><span>칸 너비 = 장 수</span></div>
    </div>
    <div class="feat2">
      <div><b>절마다 ✓</b><small>읽은 절을 표시하면 장이 저절로 끝나요</small></div>
      <div><b>번역 3종</b><small>개역개정 · 현대인의성경 · NIV 나란히</small></div>
      <div><b>검색 · 북마크</b><small>말씀을 찾고 ★ 로 모아 둬요</small></div>
      <div><b>몇 독째</b><small>다 읽으면 다음 회차가 시작돼요</small></div>
    </div>
  </div>
</section>

@if (r.Features.FamilyTeam && fam is not null)
{
  <section class="blk gut" aria-labelledby="fm">
    <div class="wrap split">
      <div>
        <div class="eyebrow">가족이 함께</div>
        <h2 id="fm">아이 혼자가 아니라<br>가족이 한 팀이에요</h2>
        <p class="lead">부모님도 함께 미션을 하면 가족 점수가 모여요. 가족 점수가 단계를 넘을 때마다 다 같이 축하해요. 보호자는 아이의 오늘 미션도 볼 수 있어요.</p>
      </div>
      <div class="fam" aria-label="가족팀 예시">
        <div class="tot"><small>가족 총합 점수 · 예시</small><b class="num">@famTotal.ToString("N0")<i> 점</i></b></div>
        <ul>
          <li><span class="av">철</span><span>철수<small>학생 · 오늘 4/4</small></span><em class="num">@famKid.ToString("N0")</em></li>
          <li><span class="av">엄</span><span>엄마<small>엄마 · 오늘 3/4</small></span><em class="num">@((famTotal - famKid).ToString("N0"))</em></li>
        </ul>
      </div>
    </div>
  </section>
}

<section class="blk gut" style="background:var(--soft)" aria-labelledby="nw">
  <div class="wrap">
    <div class="eyebrow">지금 함께하는 사람들</div>
    <h2 id="nw">여러 부서가 매일<br>말씀을 이어 가고 있어요</h2>
    <div class="stats">
      <div style="background:var(--bg)"><b class="num">@s.Tenants.ToString("N0")<i>곳</i></b><small>함께하는 부서 · 모임</small></div>
      <div style="background:var(--bg)"><b class="num">@s.People.ToString("N0")<i>명</i></b><small>참여하는 사람</small></div>
      <div style="background:var(--bg)"><b class="num">@s.TodayPeople.ToString("N0")<i>명</i></b><small>오늘 말씀과 함께한 사람</small></div>
      <div style="background:var(--bg)"><b class="num">@s.YearChapters.ToString("N0")<i>장</i></b><small>올해 함께 읽은 성경</small></div>
    </div>
    <div class="week" style="background:var(--bg)" aria-label="최근 7일 참여 인원">
      @foreach (var w in s.Week)
      {
          var h = w.People == 0 ? 3 : Math.Max(6, (int)Math.Round(w.People * 94.0 / weekMax));
          <div class="@(w.Date == d.Today ? "t" : "")"><span class="num">@w.People</span><i style="height:@(h)px"></i>@(w.Date == d.Today ? "오늘" : w.Date.ToString("M'/'d"))</div>
      }
    </div>
    <p class="fine">최근 7일, 하루에 함께한 사람 수예요. 모든 부서를 합친 숫자이고, 이름이나 부서별 숫자는 보여 주지 않아요.</p>
  </div>
</section>

<section class="blk gut" aria-labelledby="st">
  <div class="wrap split">
    <div>
      <div class="eyebrow">시작하는 방법</div>
      <h2 id="st">세 단계면<br>바로 시작해요</h2>
    </div>
    <ol class="steps">
      <li><div><b>가입하기</b><span>이름 · 이메일 · 비밀번호만 넣어요. 전화번호나 생일은 받지 않아요.</span></div></li>
      <li><div><b>내 부서에 참여 신청</b><span>목록에서 부서를 고르거나 선생님께 받은 부서 코드를 넣어요. 미션에 참여할지, 자녀를 지켜보는 보호자로 함께할지 골라요.</span></div></li>
      <li><div><b>선생님 승인</b><span>부서 선생님이 확인하면 바로 미션과 통독을 시작해요.</span></div></li>
    </ol>
  </div>
</section>

<section class="end gut" aria-labelledby="ed">
  <div class="wrap">
    <h2 id="ed">오늘부터<br>말씀과 함께해요</h2>
    <p>사용 문의는 내 부서 선생님께 해 주세요. 비밀번호를 잊었을 때도 선생님이 도와주세요.</p>
    <div class="cta">
      <a class="btn p" href="/account/signup">처음이에요 · 가입하기</a>
      <a class="btn s" href="/account/login">이미 계정이 있어요 · 로그인</a>
    </div>
  </div>
</section>
<footer class="ld-foot gut">
  <div class="wrap">
    <span class="copy">© @Model.Year 잠실새내 · 주일학교</span>
  </div>
</footer>
</div>
<script src="~/js/landing.js" asp-append-version="true"></script>
