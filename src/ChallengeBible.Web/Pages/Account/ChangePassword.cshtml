@page "/account/change-password"
@model ChallengeBible.Web.Pages.Account.ChangePasswordModel
<partial name="_Top" />
<main class="page gut"><div class="wrap">
    <div>
        <h1>새 비밀번호</h1>
        <p class="sub">@(Model.Forced ? "선생님이 만들어 준 임시 비밀번호로 들어왔어요. 나만 아는 새 비밀번호로 바꿔 주세요." : "새 비밀번호를 정해 주세요.")</p>
    </div>
    <form method="post" class="stack" novalidate>
        <div class="f">
            <label for="pw">새 비밀번호</label>
            <input class="in" id="pw" asp-for="Password" type="password" autocomplete="new-password" placeholder="@(AccountService.MinPassword)자 이상" />
            <p class="hint @(Model.Errors.ContainsKey("Password") ? "bad" : "")">@(Model.Errors.GetValueOrDefault("Password") ?? $"{AccountService.MinPassword}자 이상으로 정해 주세요.")</p>
        </div>
        <div class="f">
            <label for="pw2">새 비밀번호 확인</label>
            <input class="in" id="pw2" asp-for="PasswordConfirm" type="password" autocomplete="new-password" placeholder="한 번 더 입력" />
            <p class="hint bad">@Model.Errors.GetValueOrDefault("PasswordConfirm")</p>
        </div>
        <button type="submit" class="btn p">바꾸기</button>
    </form>
</div></main>
