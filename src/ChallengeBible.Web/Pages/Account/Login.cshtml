@page "/account/login"
@model ChallengeBible.Web.Pages.Account.LoginModel
@* 확정 시안: 로그인-단독시안 (구경하기 없음) *@
<partial name="_Top" />
<main class="page gut"><div class="wrap">
    <div>
        <h1>로그인</h1>
        <p class="sub">로그인하면 내가 속한 부서로 바로 들어가요.</p>
    </div>

    <form method="post" class="stack" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="f">
            <label for="uid">아이디</label>
            <input class="in" id="uid" asp-for="LoginId" autocomplete="username" autocapitalize="off" spellcheck="false" placeholder="아이디"
                   aria-invalid="@(Model.ErrorField == "LoginId" ? "true" : "false")" />
        </div>
        <div class="f">
            <label for="pw">비밀번호</label>
            <input class="in" id="pw" asp-for="Password" type="password" autocomplete="current-password" placeholder="비밀번호"
                   aria-invalid="@(Model.ErrorField == "Password" ? "true" : "false")" />
        </div>
        @if (Model.Error is not null)
        {
            <p class="err" role="alert">@Model.Error</p>
        }
        <button type="submit" class="btn p">로그인</button>
    </form>

    <div class="foot">
        <div>아직 회원이 아니신가요?<a href="/account/signup">회원가입</a></div>
        <div>비밀번호를 잊었으면 부서 선생님께 말해 주세요.</div>
    </div>
</div></main>
