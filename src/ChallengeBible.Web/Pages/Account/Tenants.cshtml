@page "/account/tenants"
@model ChallengeBible.Web.Pages.Account.TenantsModel
@* 확정 시안: 부서고르기-단독시안 (1차 간단판) *@
<partial name="_Top" />
<main class="page gut"><div class="wrap">
    <div>
        <h1>어느 부서로 갈까요?</h1>
        <p class="sub">부서 <b class="num">@(Model.Approved.Count)곳</b>에 함께하고 있어요.</p>
    </div>
    @foreach (var m in Model.Approved)
    {
        <a class="dept" href="/@m.Slug">
            <span class="mk">@Ui.DeptMark(m.TenantName)</span>
            <div><b>@m.TenantName</b>
                <span class="tags">@if (m.MissionEnabled) { <span class="tag">성경말씀</span> }@if (m.ReadingEnabled) { <span class="tag">성경통독</span> }</span>
            </div>
            <span aria-hidden="true">→</span>
        </a>
    }
    @foreach (var w in Model.Waiting)
    {
        <div class="box wait"><p><b>@w.TenantName</b> · 승인 기다리는 중</p></div>
    }
    <a class="btn s" href="/join">+ 다른 부서 참여 신청</a>
    @if (Model.Family is { } f)
    {
        <p class="fam-line">@(f.CurrentOption is { } o ? $"가족과 함께하는 부서는 {o.Name}예요." : "가족과 함께할 부서를 아직 고르지 않았어요.")<a href="/account/family">@(f.Current is null ? "고르기" : "바꾸기")</a></p>
    }
</div></main>
