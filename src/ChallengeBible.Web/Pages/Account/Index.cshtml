@page "/account"
@model ChallengeBible.Web.Pages.Account.IndexModel
@using ChallengeBible.Web.Services
@* 확정 시안: 내계정-단독시안 — 내 정보(이름 바꾸기 · 이메일 보기) → 내 부서 → 비밀번호(지금 비밀번호 확인) → 로그아웃 *@
@{
    string Short(string n) => n.Trim() is { Length: > 0 } t ? t[..1] : "?";   // 이름 첫 글자 한 자(홈 사진과 같게, 2026-11-15 — 긴 이름이 동그라미 밖으로 넘치지 않게)
}
<header class="top gut"><div class="wrap">
    <a class="lnk" href="/">← 돌아가기</a>
    <span class="who"><b>@Model.Name</b>님</span>
</div></header>
<main class="page gut w760 ma"><div class="wrap">
    <h1>내 계정</h1>
    @if (!string.IsNullOrEmpty(Model.OkMessage)) { <p class="okmsg" role="status">@Model.OkMessage</p> }

    <section class="ma-card" aria-labelledby="maInfo">
        <h2 id="maInfo">내 정보</h2>
        @* 0078: 동그라미 · "내 사진 바꾸기" → 내 사진 화면 *@
        <div class="ma-me">@* 확정 시안 홈사진-내계정(2026-11-15): 사진 옆 📷 → 사진 바꾸기 *@<span class="ma-av"><a class="av" href="/account/photo" aria-label="내 사진">@if (Model.Photo is { } ph) { <img src="/account/photo?handler=img&amp;v=@ph" alt="" /> } else { @Short(Model.Name) }</a><a class="cam" href="/account/photo" aria-label="내 사진 바꾸기">📷</a></span>
            <div><b>@Model.Name</b><small>@Model.Email</small></div></div>
        <dl class="ma-kv">
            <dt>이메일</dt><dd>@Model.Email<small>로그인할 때 쓰는 주소라 여기서는 바꿀 수 없어요.</small></dd>
            <dt>가입한 날</dt><dd>@Model.Joined.ToString("yyyy년 M월 d일")</dd>
        </dl>
        <details class="ma-ed" open="@(Model.Open == "name")">
            <summary class="btn s sm">이름 바꾸기</summary>
            <form method="post" asp-page-handler="Name" class="stack" novalidate>
                <div class="f">
                    <label for="nameIn">이름</label>
                    <input class="in" id="nameIn" name="DisplayName" value="@(Model.DisplayName ?? Model.Name)" maxlength="@AccountService.MaxName" autocomplete="name"
                           aria-invalid="@(Model.Errors.ContainsKey("DisplayName") ? "true" : "false")" />
                    <p class="hint @(Model.Errors.ContainsKey("DisplayName") ? "bad" : "")">@(Model.Errors.GetValueOrDefault("DisplayName") ?? "순위 · 가족팀 · 선생님 화면에 이 이름이 보여요. 실명을 써 주세요.")</p>
                </div>
                <div class="row"><button type="submit" class="btn p sm">저장</button><a class="btn s sm" href="/account">취소</a></div>
            </form>
        </details>
    </section>

    @* 0093 시안 C: 생일(월 · 일) · 연락처 두 칸. 부서 관리자 · 선생님만 볼 수 있다 *@
    <section class="ma-card" aria-labelledby="maBd">
        <h2 id="maBd">생일 · 연락처</h2>
        @if (Model.Profile is not { } pf) { <p class="hint">부서에 들어가면 넣을 수 있어요.</p> }
        else
        {
            <dl class="ma-kv">
                <dt>생일</dt><dd>@(pf.BirthMonth is null ? "비어 있음" : PeopleService.BirthdayText(pf.BirthMonth, pf.BirthDay))<small>연도는 받지 않아요.</small></dd>
                <dt>연락처 1</dt><dd>@(pf.Phone1 ?? "비어 있음")</dd>
                <dt>연락처 2</dt><dd>@(pf.Phone2 ?? "비어 있음")</dd>
            </dl>
            <details class="ma-ed" open="@(Model.Open == "bd")">
                <summary class="btn s sm">고치기</summary>
                <form method="post" asp-page-handler="Profile" class="stack" novalidate>
                    @if (Model.Errors.GetValueOrDefault("Profile") is { } pe) { <p class="err" role="alert">@pe</p> }
                    <div class="f"><label>생일</label>
                        <div class="row">
                            <select class="sel" name="month" aria-label="월"><option value="">월</option>@for (var i = 1; i <= 12; i++) { <option value="@i" selected="@(pf.BirthMonth == i)">@(i)월</option> }</select>
                            <select class="sel" name="day" aria-label="일"><option value="">일</option>@for (var i = 1; i <= 31; i++) { <option value="@i" selected="@(pf.BirthDay == i)">@(i)일</option> }</select>
                        </div>
                    </div>
                    <div class="f"><label for="ph1">연락처 1</label><input class="in" id="ph1" name="phone1" value="@pf.Phone1" maxlength="20" inputmode="tel" autocomplete="tel" /></div>
                    <div class="f"><label for="ph2">연락처 2 (선택 · 부모님 번호 등)</label><input class="in" id="ph2" name="phone2" value="@pf.Phone2" maxlength="20" inputmode="tel" placeholder="비어 있음" />
                        <p class="hint">부서 관리자 · 선생님만 볼 수 있어요. 다른 학생 · 학부모는 볼 수 없어요.</p></div>
                    <div class="row"><button type="submit" class="btn p sm">저장</button><a class="btn s sm" href="/account">취소</a></div>
                </form>
            </details>
        }
    </section>

    <section class="ma-card" aria-labelledby="maDept">
        <h2 id="maDept">내 부서</h2>
        @if (Model.Depts.Count == 0) { <p class="hint">아직 들어간 부서가 없어요.</p> }
        <ul class="ma-depts">
            @foreach (var d in Model.Depts)
            {
                <li><span class="mk" style="background:@ChallengeBible.Web.Pages.Platform.TenantsModel.ColorVar(d.ThemeColor)">@Ui.DeptMark(d.Name)</span>
                    <a class="nm" href="/@d.Slug"><b>@d.Name</b><small>@string.Join(" · ", d.Roles.Select(IndexModel.RoleLabel))</small></a></li>
            }
        </ul>
        <div class="ma-links">
            @if (Model.Depts.Count > 1) { <a href="/account/tenants">부서 고르기 →</a> }
            @* 한 사람 한 부서(ADR 0090): 정식 부서에 이미 소속이면 신청할 수 없어 링크를 숨긴다(2026-11-18 사용자) *@
            @if (!Model.Depts.Any(d => !d.IsLobby)) { <a href="/join">다른 부서 참여 신청 →</a> }
        </div>
    </section>

    <section class="ma-card" aria-labelledby="maPw">
        <h2 id="maPw">비밀번호</h2>
        <details class="ma-ed" open="@(Model.Open == "pw")">
            <summary class="btn s sm">비밀번호 바꾸기</summary>
            <form method="post" asp-page-handler="Password" class="stack" novalidate>
                <div class="f">
                    <label for="cur">지금 비밀번호</label>
                    <input class="in" id="cur" name="Current" type="password" autocomplete="current-password" aria-invalid="@(Model.Errors.ContainsKey("Current") ? "true" : "false")" />
                    <p class="hint @(Model.Errors.ContainsKey("Current") ? "bad" : "")">@(Model.Errors.GetValueOrDefault("Current") ?? "내 휴대폰을 다른 사람이 쓰더라도 함부로 바꾸지 못하게 한 번 더 확인해요.")</p>
                </div>
                <div class="f">
                    <label for="pw">새 비밀번호</label>
                    <input class="in" id="pw" name="Password" type="password" autocomplete="new-password" placeholder="@(AccountService.MinPassword)자 이상" />
                    <p class="hint bad">@Model.Errors.GetValueOrDefault("Password")</p>
                </div>
                <div class="f">
                    <label for="pw2">새 비밀번호 확인</label>
                    <input class="in" id="pw2" name="PasswordConfirm" type="password" autocomplete="new-password" placeholder="한 번 더 입력" />
                    <p class="hint bad">@Model.Errors.GetValueOrDefault("PasswordConfirm")</p>
                </div>
                <div class="row"><button type="submit" class="btn p sm">바꾸기</button><a class="btn s sm" href="/account">취소</a></div>
            </form>
        </details>
        <p class="hint">비밀번호를 잊었으면 부서 선생님께 임시 비밀번호를 받아요.</p>
    </section>

    <form method="post" action="/account/logout" asp-antiforgery="true"><button type="submit" class="btn d ma-out">로그아웃</button></form>

    @* 확정 시안 가입연결-탈퇴 ④(2026-11-20): 탈퇴 신청 — 관리자 계정(플랫폼 · 부서)에는 없다 *@
    @if (!Model.IsAdmin)
    {
        <section class="ma-card ma-leave" aria-labelledby="maLeave">
            <h2 id="maLeave">탈퇴</h2>
            @if (Model.LeavePending is { } at)
            {
                <div class="lv-wait" role="status"><b>탈퇴 신청 중</b>
                    <p>· @ChallengeBible.Domain.Time.TenantClock.ToTenantDate(new DateTimeOffset(DateTime.SpecifyKind(at, DateTimeKind.Utc)), "Asia/Seoul").ToString("M/d") 신청 · 승인 기다리는 중</p>
                    <small>승인 전까지 평소처럼 쓸 수 있어요.</small></div>
                <form method="post" asp-page-handler="Stay"><button type="submit" class="btn s">탈퇴 취소</button></form>
            }
            else if (User.ImpersonatorId() is not null)
            {
                @* 가장 중(R-348, 2026-11-20 사용자): 비밀번호 · 확인 글자 · 승인 없이 바로 탈퇴 처리 — 한 번 더 물어보고 지운다 *@
                <p class="lv-warn">가장 중이라 <b>비밀번호 · 승인 없이 바로</b> 탈퇴 처리해요. 계정과 모든 기록(미션 · 통독 · 필사 · 선물 · 쪽지 · 사진 · 출석 · 가족팀)이 지워지고 되돌릴 수 없어요.</p>
                @if (Model.Errors.GetValueOrDefault("Leave") is { } le2) { <p class="hint bad" role="alert">@le2</p> }
                <form method="post" asp-page-handler="LeaveNow" asp-antiforgery="true" onsubmit="return confirm('이 계정을 지금 바로 탈퇴 처리할까요? 되돌릴 수 없어요.');">
                    <button type="submit" class="btn lv-go">탈퇴 처리(가장)</button>
                </form>
            }
            else
            {
                <details class="ma-ed" open="@(Model.Open == "leave")">
                    <summary class="btn s sm">탈퇴하기</summary>
                    <form method="post" asp-page-handler="Leave" class="stack" novalidate>
                        <p class="lv-warn">탈퇴를 신청하면 부서 관리자나 플랫폼 관리자가 승인한 뒤에 계정과 모든 기록(미션 · 통독 · 필사 · 선물 · 쪽지 · 사진 · 출석 · 가족팀)이 지워져요. 되돌릴 수 없어요.</p>
                        <div class="f"><label for="lvpw">비밀번호</label><input class="in" id="lvpw" name="leavePw" type="password" autocomplete="current-password" /></div>
                        <div class="f"><label for="lvw">확인 글자 <small>탈퇴 라고 써 주세요</small></label><input class="in" id="lvw" name="leaveWord" autocomplete="off" placeholder="탈퇴" /></div>
                        @if (Model.Errors.GetValueOrDefault("Leave") is { } le) { <p class="hint bad" role="alert">@le</p> }
                        <button type="submit" class="btn lv-go">탈퇴 신청</button>
                    </form>
                </details>
            }
        </section>
    }
</div></main>
