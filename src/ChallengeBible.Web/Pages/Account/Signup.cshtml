@page "/account/signup"
@model ChallengeBible.Web.Pages.Account.SignupModel
@* 확정 시안: 회원가입-단독시안 (R-137 이름 · 이메일 · 비밀번호만) *@
<partial name="_Top" />
<main class="page gut"><div class="wrap">
    <div>
        <h1>반가워요, 함께해요</h1>
        <p class="sub">이름 · 이메일 · 비밀번호만 있으면 돼요.</p>
    </div>

    <form method="post" class="stack" novalidate>
        @{
            string? E(string f) => Model.ErrorOf(f);
        }
        <div class="f">
            <label for="nm">이름 <small>또는 별명</small></label>
            <input class="in" id="nm" asp-for="DisplayName" autocomplete="nickname" placeholder="예: 김철수" maxlength="20" aria-invalid="@(E("DisplayName") is null ? "false" : "true")" />
            <p class="hint @(E("DisplayName") is null ? "" : "bad")">@(E("DisplayName") ?? "부서 친구들과 선생님께 보이는 이름이에요.")</p>
        </div>
        <div class="f">
            <label for="uid">이메일</label>
            <input class="in" id="uid" asp-for="Email" autocomplete="username" autocapitalize="off" spellcheck="false" placeholder="name@example.com" type="email" inputmode="email" maxlength="254" aria-invalid="@(E("Email") is null ? "false" : "true")" />
            <p class="hint @(E("Email") is null ? "" : "bad")">@(E("Email") ?? "로그인할 때 써요.")</p>
        </div>
        <div class="f">
            <label for="pw">비밀번호</label>
            <input class="in" id="pw" asp-for="Password" type="password" autocomplete="new-password" placeholder="@(AccountService.MinPassword)자 이상" aria-invalid="@(E("Password") is null ? "false" : "true")" />
            <p class="hint @(E("Password") is null ? "" : "bad")">@(E("Password") ?? $"{AccountService.MinPassword}자 이상으로 정해 주세요.")</p>
        </div>
        <div class="f">
            <label for="pw2">비밀번호 확인</label>
            <input class="in" id="pw2" asp-for="PasswordConfirm" type="password" autocomplete="new-password" placeholder="한 번 더 입력" aria-invalid="@(E("PasswordConfirm") is null ? "false" : "true")" />
            <p class="hint bad">@E("PasswordConfirm")</p>
        </div>
        <button type="submit" class="btn p">가입하기</button>
    </form>

    <div class="note"><b>전화번호 · 생일 · 주소는 받지 않아요.</b><br>비밀번호를 잊으면 부서 선생님이 새 임시 비밀번호를 만들어 줄 수 있어요.</div>
    <div class="foot"><div>이미 계정이 있나요?<a href="/account/login">로그인</a></div></div>
</div></main>
