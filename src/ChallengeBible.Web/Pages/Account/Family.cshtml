@page "/account/family"
@model ChallengeBible.Web.Pages.Account.FamilyModel
@using ChallengeBible.Web.Services
@* 확정 시안: 온가족-단독시안(0065) — 온가족 있음(누적 총점 · 구성원, 보기만) · 없음(신청) · 신청 기다림. 시상은 부서 가족팀으로만 *@
@{
    var v = Model.View;
    var me = User.AccountId();
    string Dept(string name) => string.Join(" · ", JoinModel.Split(name) is var s && s.Church.Length > 0 ? new[] { s.Church, s.Dept } : new[] { s.Dept });
}
<header class="top gut"><div class="wrap">
    <a class="lnk" href="/account">← 내 계정</a>
    <span class="who"><b>@User.Identity?.Name</b>님</span>
</div></header>
<main class="page gut ofam"><div class="wrap">
    @if (v.Family is { } f)
    {
        <div>
            <div class="k">온가족</div>
            <h1>@f.Name</h1>
            <p class="sub">부서가 달라도 한 집안 점수를 모아 봐요.</p>
        </div>
        <section class="of-total" aria-label="온가족 총점">
            <small>처음부터 모은 점수</small>
            <b class="num">@f.Total.ToString("N0")<i>점</i></b>
            <span class="meta">@(f.People.Count)명 · 부서 @(f.DeptCount)곳@(FamilyModel.Ago(f.Last, v.Today) is { } ago ? $" · 마지막 참여 {ago}" : "")</span>
        </section>
        <div class="of-note"><span aria-hidden="true">🏅</span><span>온가족 점수는 <b>보기만</b> 해요. 축하 · 선물은 각 부서의 <b>가족팀 점수</b>로 받아요.</span></div>

        <h2>구성원</h2>
        <div class="of-mem">
            @foreach (var p in f.People)
            {
                <div class="of-m @(p.AccountId == me ? "me" : "")">
                    <span class="av" aria-hidden="true">@FamilyModel.Initial(p.Name)</span>
                    <span class="tx"><b>@p.Name<em>@FamilyTeamService.RelationLabel(p.Relation)</em></b><small>@(p.Depts.Count > 0 ? string.Join(" / ", p.Depts.Select(Dept)) : "소속 부서 없음")</small></span>
                    <span class="pt"><b class="num">@p.Points.ToString("N0")</b><small>@(FamilyModel.Ago(p.Last, v.Today) ?? "아직 없음")</small></span>
                </div>
            }
        </div>
        @if (v.IsGuardian)
        {
            <section class="of-mine" aria-label="내 시상 부서">
                <small>내 시상 부서</small>
                <b>@(v.AwardDept ?? "아직 정해지지 않았어요")</b>
                <small>@(v.AwardDept is null ? "플랫폼 관리자가 정하면 그 부서에서 미션 · 가족팀을 함께해요." : "이 부서의 가족팀에서만 축하 · 선물을 받아요. 바꾸려면 플랫폼 관리자에게 말씀해 주세요.")</small>
            </section>
        }
        <p class="of-ghost">구성원을 넣거나 빼려면 플랫폼 관리자에게 말씀해 주세요.</p>
    }
    else if (v.Open is { } r)
    {
        <div>
            <div class="k">온가족</div>
            <h1>확인을 기다리고 있어요</h1>
        </div>
        <section class="of-wait" role="status">
            <span class="tag">신청 · @r.RequestedUtc.ToString("M월 d일")</span>
            <blockquote>@r.Body</blockquote>
            <p>플랫폼 관리자가 확인하면 이 화면에 온가족 점수가 보여요.</p>
            <form method="post" asp-page-handler="Cancel"><button type="submit" class="x">신청 취소하기</button></form>
        </section>
    }
    else
    {
        <div>
            <div class="k">온가족</div>
            <h1>온가족이 아직 없어요</h1>
        </div>
        <div class="of-empty">
            <span class="big" aria-hidden="true">🏡</span>
            <b>부서가 달라도 한 집안으로</b>
            <p>형제자매 · 부모님이 다른 부서에 있어도 온가족으로 묶으면 모두의 점수를 합쳐 볼 수 있어요.</p>
        </div>
        <form method="post" asp-page-handler="Request" class="of-form" novalidate>
            <label for="body">누구와 묶을까요?</label>
            <textarea id="body" name="Body" maxlength="@OnFamilyService.BodyMax" placeholder="예) 김철수 — 잠실새내교회 유년부&#10;김영희 — 잠실새내교회 초등부&#10;이은정(엄마) — 유년부">@Model.Body</textarea>
            <small>이름 · 교회 · 부서를 적어 주세요. 플랫폼 관리자가 확인하고 묶어 드려요.</small>
            @if (Model.Error is not null) { <p class="hint bad" role="alert">@Model.Error</p> }
            <button type="submit" class="btn p">온가족 신청하기</button>
        </form>
        @if (v.IsGuardian)
        {
            <section class="of-mine" aria-label="내 시상 부서">
                <small>내 시상 부서</small>
                <b>@(v.AwardDept ?? "아직 정해지지 않았어요")</b>
                <small>플랫폼 관리자가 정해요. 이 부서의 가족팀에서만 축하 · 선물을 받아요.</small>
            </section>
        }
    }
</div></main>
