@model ChallengeBible.Web.Pages.B2DrawerModel
@using ChallengeBible.Web.Auth
@inject ChallengeBible.Web.Services.PhotoService Photos
@using ChallengeBible.Web.Services
@* 성경통독 · 성경필사 ☰ 메뉴(2026-11-25 사용자 확정, 시안 햄버거-통독필사-통일): 미션 ☰ 메뉴와 같은 모양(로고 · 이름 카드 · 홈으로 · 항목별 아이콘 · 앱 설치 · 로그아웃).
   메뉴 바탕 · 현재 메뉴 색은 그 프로그램 색(--r-*). 넓은 화면에서는 왼쪽 고정 목차(.b2dr)로 그대로 쓰인다. 열고 닫기 · 색 테마 저장은 _ReadingNav · _CopyNav 의 스크립트. *@
@{
    var t = Model.Tenant;
    var back = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
    var meName = User.UserName();
    var mePhoto = meName is null ? null : await Photos.FileOfAsync(meName);
    var meSub = User.IsPlatformAdmin() ? "플랫폼 관리자" : t.IsLobby ? "처음 오신 분" : PlatformTodayService.ShortDept(t.Current.Name) + " · " + (t.IsAdmin ? "관리자" : UserRole.LabelOf(UserRole.KindOf(t.RoleCode)));
    var imp = User.ImpersonatorId() is not null;
}
<div class="b2ov" data-b2close hidden></div>
<nav class="b2dr" id="b2dr" aria-label="@Model.Name.Replace("성경", "성경 ") 메뉴">
    <div class="tdr2-hd">
        <div>
            <div class="tdr2-ttl">도전!!! <span>@Model.Name</span></div>
            <div class="tdr2-sub">GROW IN THE WORD</div>
        </div>
        <button type="button" class="tdr2-x b2dr-x" aria-label="메뉴 닫기" data-b2close>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
        </button>
    </div>
    @DrawerUi.Me(User.DisplayName(), mePhoto, meSub, imp)
    <div class="tdr2-nav">
        @DrawerUi.Line(Model.Home, "home", "홈으로", false)
        <h2 class="tdr2-g">@Model.Name</h2>
        @foreach (var (href, label, icon, key) in Model.Menu)
        {
            @DrawerUi.Line(href, icon, label, Model.CurKey == key)
        }
        @if (Model.Themes is { } themes)
        {
            <h2 class="tdr2-g">색 테마</h2>
            <div class="b2dr-th" role="group" aria-label="색 테마">
                @foreach (var (key, label) in themes)
                {
                    <button type="button" class="sw-@key" data-theme-pick="@key" aria-pressed="@(Model.Theme == key ? "true" : "false")" aria-label="@label" title="@label"></button>
                }
            </div>
        }
    </div>
    @Html.AntiForgeryToken()
    <div class="tdr2-ft">
        <a class="tdr2-b1" href="/install?back=@back" data-app-install>앱 설치</a>
        <form method="post" action="/account/logout" asp-antiforgery="true"><button type="submit" class="tdr2-out">로그아웃</button></form>
    </div>
</nav>
