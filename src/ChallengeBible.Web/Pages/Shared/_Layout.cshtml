@inject ChallengeBible.Web.Tenancy.TenantContext Tenant
@using ChallengeBible.Web.Services
@{
    // 화면 제목은 각 화면 모델(ITitled)에서 읽는다 — ViewBag · TempData 를 쓰지 않는다(X-13).
    var title = (Model as ITitled)?.Title;
    // 부서 화면(0038): 이름은 부서 이름(없으면 기본), 앱 정보는 부서 매니페스트. 부서 밖 화면은 기본 이름.
    var dept = Tenant.Tenant;
    var appName = dept is null ? BrandingService.DefaultName : Tenant.AppName;
    // 대표 색(0033)은 부서 화면 강조색에. 통독 · 성경 본문 화면은 파랑 그대로(확정: 이름 · 색 적용 범위)
    var path = Context.Request.Path.Value ?? "";
    var blueOnly = dept is not null && (path.StartsWith($"/{dept.Slug}/reading", StringComparison.OrdinalIgnoreCase)
                                        || path.Equals($"/{dept.Slug}/read", StringComparison.OrdinalIgnoreCase));
    var color = dept is null || blueOnly ? "blue" : dept.ThemeColor;
    // 앱 설치 안내로 보내지 않는 화면(ADR 0115 · R-331): 플랫폼 관리 · 설치 안내 자신 · 가장 중
    var noInstall = path.StartsWith("/platform", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/install", StringComparison.OrdinalIgnoreCase)
                    || User.ImpersonatorId() is not null;
}
<!DOCTYPE html>
<html lang="ko" data-color="@color" data-install="@(noInstall ? "off" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="light" />@* 휴대폰 다크 모드와 상관없이 항상 밝게(사용자 2026-11-13, R-265) *@
    @* 데스크탑 전용 화면(주일 출결 보고서 등)은 ViewData["Viewport"] 로 고정 폭을 준다 — 휴대폰에서도 종이 한 장을 줄여 보고 손가락으로 확대 *@
    <meta name="viewport" content="@(ViewData["Viewport"] as string ?? "width=device-width, initial-scale=1.0, viewport-fit=cover")" />
    <title>@(string.IsNullOrEmpty(title) ? appName : $"{title} · {appName}")</title>
    @* 설치 앱은 하나(ADR 0115): 어느 화면에서 설치해도 "도전!!!성경말씀", 열면 첫 화면 → 내 부서 홈 *@
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="@BrandingService.DefaultShortName" />
    @if (dept is not null) { <meta name="theme-color" content="@BrandingService.ColorHex(dept.ThemeColor)" /> }
    <script src="~/js/install-gate.js" asp-append-version="true"></script>
    @* 아이콘 · 카톡 공유 미리보기(0114 「네잎 정돈」): 모든 화면 · 모든 부서가 같은 그림, 제목에만 부서 이름 *@
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="@BrandingService.FaviconSvg" />
    <link rel="apple-touch-icon" href="@BrandingService.AppleTouchIcon" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@BrandingService.DefaultName" />
    <meta property="og:title" content="@BrandingService.OgTitle(appName, dept?.Name)" />
    <meta property="og:description" content="@BrandingService.OgDescription" />
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{BrandingService.OgImage}")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}")" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800;900&family=Noto+Serif+KR:wght@500;700;900&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.ImpersonatorId() is not null)
    {
        @* 가장 중(ADR 0067, 확정 시안 플랫폼-가장): 모든 화면 보라 띠 + [복귀] — 2026-11-17 사용자: 맨 아래에 고정(site.css) *@
        <div class="imp-bar" role="status"><div class="wrap gut">
            <span><b>가장 중</b> · @Ui.Nim(User.DisplayName())으로 보고 있어요</span>
            @* 사람 바꾸기(ADR 0096, 확정 시안 사람바꾸기): 로그아웃 없이 다른 계정으로 *@
            <a class="sw-btn" href="/account/impersonate/switch?back=@Uri.EscapeDataString(path + Context.Request.QueryString)" data-imp-switch>사람 바꾸기</a>
            <form method="post" action="/account/impersonate/stop">@Html.AntiForgeryToken()<button type="submit">복귀</button></form>
        </div></div>
    }
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/pwa.js" asp-append-version="true" defer></script>
    <script src="~/js/wait.js" asp-append-version="true" defer></script>
    @if (User.ImpersonatorId() is not null) { <script src="~/js/imp-switch.js" asp-append-version="true" defer></script> }
</body>
</html>
