@model ChallengeBible.Web.Tenancy.TenantContext
@inject ChallengeBible.Web.Services.PromotionService Promotions
@inject ChallengeBible.Web.Services.FamilyTeamService FamilyTeams
@{
    var slug = Model.Current.Slug;
    var path = Context.Request.Path.Value ?? "";
    // 만든 관리 메뉴만 링크. 나머지는 단계마다 붙인다.
    var home = $"/{slug}/admin";
    var promotionsWaiting = await Promotions.PendingReceivedCountAsync();
    (string Href, string Label, int Count)[] menu =
    [
        (home, "관리 홈", 0),
        ($"/{slug}/admin/members", "소속 관리", 0),
    ];
    // 가족팀: 관리자만, 기본 규칙 "가족팀" 스위치가 켜졌을 때만(0012)
    if (Model.IsAdmin && await FamilyTeams.EnabledAsync()) menu = [.. menu, ($"/{slug}/admin/teams", "가족팀", 0)];
    menu = [.. menu, ($"/{slug}/admin/promotions", "진급", promotionsWaiting)];
    if (Model.IsAdmin) menu = [.. menu, ($"/{slug}/admin/content", "콘텐츠", 0)];
    if (Model.Current.ReadingEnabled) menu = [.. menu, ($"/{slug}/admin/reading", "통독 현황", 0)];
    if (Model.IsAdmin) menu = [.. menu, ($"/{slug}/admin/season", "시즌", 0), ($"/{slug}/admin/branding", "이름 · 색", 0)];
    // 관리 홈 주소는 다른 관리 주소의 앞부분이라 정확히 같을 때만 현재 화면으로 본다
    bool Current(string href) => href == home ? path.TrimEnd('/').Equals(home, StringComparison.OrdinalIgnoreCase) : path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
}
<header class="admintop gut">
    <div class="wrap wide hd">
        <div class="t"><small>@Model.Current.Name</small><b><em>도전!!!</em> 관리</b></div>
        <div class="row-t">
            @if (User.IsPlatformAdmin()) { <a class="back" href="/platform">플랫폼</a> }
            <a class="back" href="/@slug">부서 홈으로</a>
        </div>
    </div>
    <nav class="wrap wide tabs" aria-label="관리 메뉴">
        @foreach (var (href, label, count) in menu)
        {
            <a href="@href" aria-current="@(Current(href) ? "page" : "false")">@label@if (count > 0) { <span class="c num" aria-label="기다리는 요청 @(count)건">@count</span> }</a>
        }
    </nav>
</header>
