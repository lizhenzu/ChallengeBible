@model ChallengeBible.Web.Tenancy.TenantContext
@inject ChallengeBible.Web.Services.PromotionService Promotions
@inject ChallengeBible.Web.Services.FamilyTeamService FamilyTeams
@inject ChallengeBible.Web.Services.PhotoService Photos
@using ChallengeBible.Web.Auth
@{
    var slug = Model.Current.Slug;
    var path = Context.Request.Path.Value ?? "";
    // 만든 관리 메뉴만 링크. 나머지는 단계마다 붙인다.
    var home = $"/{slug}/admin";
    var promotionsWaiting = await Promotions.PendingReceivedCountAsync();
    (string Href, string Label, int Count)[] menu =
    [
        (home, "관리 홈", 0),
        ($"/{slug}/admin/members", "소속 관리", 0),
    ];
    // 생일(ADR 0121): 교사 · 관리자 — 임시 부서는 없음
    if (!Model.IsLobby) menu = [.. menu, ($"/{slug}/birthdays", "생일", 0)];
    // 반: 관리자만(0093 조직 · 반 9)
    if (Model.IsAdmin && !Model.IsLobby) menu = [.. menu, ($"/{slug}/admin/classes", "반", 0)];
    // 가족팀: 관리자만, 기본 규칙 "가족팀" 스위치가 켜졌을 때만(0012)
    if (Model.IsAdmin && await FamilyTeams.EnabledAsync()) menu = [.. menu, ($"/{slug}/admin/teams", "가족팀", 0)];
    // 선물: 관리자만, 임시 부서는 없음(ADR 0094, 확정 시안 관리-선물)
    if (Model.IsAdmin && !Model.IsLobby) menu = [.. menu, ($"/{slug}/admin/gifts", "선물", 0)];
    menu = [.. menu, ($"/{slug}/admin/promotions", "진급", promotionsWaiting)];
    if (Model.IsAdmin) menu = [.. menu, ($"/{slug}/admin/content", "콘텐츠", 0)];
    if (Model.IsAdmin && !Model.IsLobby) menu = [.. menu, ($"/{slug}/admin/prayer365", "365 기도", 0)];   // 자녀를 위한 365 기도 참여자(ADR 0106)
    if (Model.Current.ReadingEnabled) menu = [.. menu, ($"/{slug}/admin/reading", "통독 현황", 0)];
    if (Model.IsAdmin) menu = [.. menu, ($"/{slug}/admin/season", "시즌", 0), ($"/{slug}/admin/branding", "이름 · 색", 0), ($"/{slug}/admin/worship", "예배 안내", 0), ($"/{slug}/admin/todo", "할 일", 0)];   // 할 일 · 누가 보나(ADR 0100)
    // 교사(관리자 아님)는 명부만 쓴다(0093)
    if (!Model.IsAdmin) menu = [($"/{slug}/admin/members", "명부", 0), ($"/{slug}/birthdays", "생일", 0)];
    // 관리 홈 주소는 다른 관리 주소의 앞부분이라 정확히 같을 때만 현재 화면으로 본다
    bool Current(string href) => href == home ? path.TrimEnd('/').Equals(home, StringComparison.OrdinalIgnoreCase) : path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
    // 확정 시안 관리-햄버거(2026-11-16 사용자): 가로 탭 대신 ☰ 메뉴판, 묶음별. 머리말 제목 = 지금 화면
    var now = menu.FirstOrDefault(m => Current(m.Href)).Label ?? "관리";
    string Group(string href) => href == home ? "" : href.EndsWith("/members") || href.EndsWith("/birthdays") || href.EndsWith("/classes") || href.EndsWith("/teams") || href.EndsWith("/promotions") ? "사람"
        : href.EndsWith("/gifts") || href.EndsWith("/content") || href.EndsWith("/prayer365") || href.EndsWith("/reading") || href.EndsWith("/season") ? "선물 · 콘텐츠" : "설정";
    string[] Groups = ["", "사람", "선물 · 콘텐츠", "설정"];
    // 확정 시안 플랫폼관리메뉴(2026-11-18): 항목마다 아이콘 · 색 · 한 줄 설명(주소 끝으로 고른다)
    (string Icon, string Tone, string Desc) Look(string href) =>
        href == home ? ("home", "s", "오늘 챙길 일 · 숫자")
        : href.EndsWith("/members") ? (Model.IsAdmin ? ("people", "g", "승인 · 역할 · 명부") : ("people", "g", "우리 부서 사람들"))
        : href.EndsWith("/birthdays") ? ("cake", "o", "다가오는 · 월별 · 연간")
        : href.EndsWith("/classes") ? ("cls", "b", "반 만들기 · 배정")
        : href.EndsWith("/teams") ? ("family", "p", "팀 · 시상")
        : href.EndsWith("/promotions") ? ("up", "o", "보내기 · 받기")
        : href.EndsWith("/gifts") ? ("gift", "o", "주문 · 처리")
        : href.EndsWith("/content") ? ("word", "g", "우리 부서 말씀 · 퀴즈")
        : href.EndsWith("/prayer365") ? ("pray", "p", "참여자 · 함께 기도")
        : href.EndsWith("/reading") ? ("read", "b", "진도율 · 순위")
        : href.EndsWith("/season") ? ("season", "s", "기간 · 시상")
        : href.EndsWith("/branding") ? ("palette", "v", "앱 이름 · 대표 색 · 보고서")
        : href.EndsWith("/worship") ? ("pin", "b", "예배 시간 · 장소 · 주소")
        : href.EndsWith("/todo") ? ("bell", "s", "누가 어떤 할 일을 보나") : ("rules", "s", "");
    var me = User.UserName();
    var photo = me is null ? null : await Photos.FileOfAsync(me);
    var myRole = Model.IsAdmin ? "부서 관리자" : "교사";
}
<header class="admintop ptop gut">
    <div class="wrap hd at-hd">
        <button type="button" class="pmenu-btn" aria-label="관리 메뉴 열기" aria-controls="pnav" aria-expanded="false" data-pnav-open>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h12"/></svg>
        </button>
        @* 2026-11-20 사용자(확정 시안 소속관리-카드): 한 줄 "도전!!!성경말씀 > 화면 이름" *@
        <div class="t pt-title pt-one"><span class="pt-brand"><em>도전!!!</em>성경말씀</span><span class="pt-sep" aria-hidden="true">&gt;</span><b>@now</b></div>
        <partial name="_MailBadge" />
        <a class="home-txt" href="/@slug">부서 홈으로</a>
    </div>
</header>
<div class="pdrawer tdr" id="pnav" hidden>
    <div class="pd-dim" data-pnav-close></div>
    <aside class="pd-panel" tabindex="-1" role="dialog" aria-modal="true" aria-label="관리 메뉴">
        @DrawerUi.Head(User.DisplayName(), photo, Model.Current.Name + " · " + myRole)
        <nav aria-label="관리 메뉴">
            @{ var last = (string?)null; }
            @foreach (var (href, label, count) in menu.OrderBy(m => Array.IndexOf(Groups, Group(m.Href))))   // 묶음 순서대로(같은 묶음 안은 원래 순서)
            {
                var g = Group(href);
                if (g != last && g.Length > 0) { <h2 class="tdr-g">@g</h2> }
                last = g;
                var (icon, tone, desc) = Look(href);
                @DrawerUi.Row(href, icon, tone, label, desc, Current(href), count: count)
            }
            <h2 class="tdr-g">바로 가기</h2>
            @DrawerUi.Row("/messages", "msg", "v", "쪽지", "받은 · 보낸 쪽지", false)
            @if (User.IsPlatformAdmin()) { @DrawerUi.Row("/platform", "platform", "v", "플랫폼", "모든 부서 관리", false) }
        </nav>
        <div class="tdr-ft">
            <a class="tdr-b1" href="/@slug">🏠 부서 홈</a>
            <form method="post" action="/account/logout" asp-antiforgery="true"><button type="submit" class="tdr-b2">로그아웃</button></form>
        </div>
    </aside>
</div>
<script src="~/js/platform-nav.js" asp-append-version="true" defer></script>
