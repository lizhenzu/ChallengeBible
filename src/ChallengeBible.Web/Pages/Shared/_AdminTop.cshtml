@model ChallengeBible.Web.Tenancy.TenantContext
@inject ChallengeBible.Web.Services.PromotionService Promotions
@inject ChallengeBible.Web.Services.FamilyTeamService FamilyTeams
@inject ChallengeBible.Web.Services.PhotoService Photos
@inject ChallengeBible.Web.Services.LeaveService Leaves
@inject ChallengeBible.Web.Services.IntroService Intro
@using ChallengeBible.Web.Auth
@{
    var slug = Model.Current.Slug;
    var path = Context.Request.Path.Value ?? "";
    // 만든 관리 메뉴만 링크. 나머지는 단계마다 붙인다.
    var home = $"/{slug}/admin";
    var promotionsWaiting = await Promotions.PendingReceivedCountAsync();
    (string Href, string Label, int Count)[] menu =
    [
        (home, "관리 홈", 0),
        ($"/{slug}/admin/members", "사람 관리", 0),
    ];
    // 생일 · 선물은 일반 ☰ 메뉴판 "생일" 묶음으로 옮겼다(2026-11-21 사용자: 관리 메뉴는 진짜 관리자 설정만)
    // 반: 관리자만(0093 조직 · 반 9)
    // 교사 · 임원 및 기타(2026-11-21 사용자, 확정 시안 역할-담임-시안2): 담임 정하기 · 역할 바꾸기를 따로
    if (Model.IsAdmin && !Model.IsLobby) menu = [.. menu, ($"/{slug}/admin/teachers", "교사", 0), ($"/{slug}/admin/officers", "임원 및 기타", 0)];
    if (Model.IsAdmin && !Model.IsLobby) menu = [.. menu, ($"/{slug}/admin/classes", "반", 0)];
    // 가족팀: 관리자만, 기본 규칙 "가족팀" 스위치가 켜졌을 때만(0012)
    if (Model.IsAdmin && await FamilyTeams.EnabledAsync()) menu = [.. menu, ($"/{slug}/admin/teams", "가족팀", 0)];
    menu = [.. menu, ($"/{slug}/admin/promotions", "부서 · 반 이동", promotionsWaiting)];
    // 선물 설정(2026-11-21 사용자, 확정 시안 선물분리): 예전 선물 화면의 탭 4개를 각자 화면으로 — 선물 처리는 일반 ☰
    if (Model.IsAdmin && !Model.IsLobby) menu = [.. menu, ($"/{slug}/admin/gifts/common", "공통 상품", 0), ($"/{slug}/admin/gifts/ours", "부서 상품", 0), ($"/{slug}/admin/gifts/money", "금액 · 점수", 0), ($"/{slug}/admin/gifts/cost", "총비용", 0)];
    // 탈퇴 신청(ADR 0119, 2026-11-20 사용자: 일반 메뉴판에서 관리 메뉴로 옮김): 부서 관리자만, 기다리는 수 뱃지
    if (Model.IsAdmin && !Model.IsLobby) menu = [.. menu, ($"/{slug}/leaves", "탈퇴 신청", await Leaves.CountAsync(User.UserName()!, Model.Current.Id))];
    if (Model.IsAdmin) menu = [.. menu, ($"/{slug}/admin/content", "콘텐츠", 0)];
    if (Model.IsAdmin && !Model.IsLobby) menu = [.. menu, ($"/{slug}/admin/prayer365", "365 기도", 0)];   // 자녀를 위한 365 기도 참여자(ADR 0106)
    if (Model.Current.ReadingEnabled) menu = [.. menu, ($"/{slug}/admin/reading", "통독 현황", 0)];
    if (Model.IsAdmin) menu = [.. menu, ($"/{slug}/admin/season", "시즌", 0), ($"/{slug}/admin/branding", "이름 · 색", 0), ($"/{slug}/admin/worship", "예배 안내", 0), ($"/{slug}/admin/todo", "할 일", 0)];   // 할 일 · 누가 보나(ADR 0100)
    // 부서 소개 화면(ADR 0140): 소개 줄이 있는 부서(유년부)만
    if (Model.IsAdmin && !Model.IsLobby && await Intro.GetAsync(includeHidden: true) is not null) menu = [.. menu, ($"/{slug}/admin/intro", "소개 화면", 0)];
    // 교사(관리자 아님)는 명부만 쓴다(0093)
    if (!Model.IsAdmin) menu = [($"/{slug}/admin/members", "명부", 0)];
    // 관리 홈 주소는 다른 관리 주소의 앞부분이라 정확히 같을 때만 현재 화면으로 본다
    bool Current(string href) => href == home ? path.TrimEnd('/').Equals(home, StringComparison.OrdinalIgnoreCase) : path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
    // 확정 시안 관리-햄버거(2026-11-16 사용자): 가로 탭 대신 ☰ 메뉴판, 묶음별. 머리말 제목 = 지금 화면
    var now = menu.FirstOrDefault(m => Current(m.Href)).Label ?? "관리";
    string Group(string href) => href == home ? "" : href.Contains("/admin/gifts/") ? "선물 설정" : href.EndsWith("/members") || href.EndsWith("/teachers") || href.EndsWith("/officers") || href.EndsWith("/birthdays") || href.EndsWith("/classes") || href.EndsWith("/teams") || href.EndsWith("/promotions") || href.EndsWith("/leaves") ? "사람"
        : href.EndsWith("/gifts") || href.EndsWith("/content") || href.EndsWith("/prayer365") || href.EndsWith("/reading") || href.EndsWith("/season") ? "선물 · 콘텐츠" : "설정";
    string[] Groups = ["", "사람", "선물 설정", "선물 · 콘텐츠", "설정"];
    // 확정 시안 플랫폼관리메뉴(2026-11-18): 항목마다 아이콘 · 색 · 한 줄 설명(주소 끝으로 고른다)
    (string Icon, string Tone, string Desc) Look(string href) =>
        href == home ? ("home", "s", "오늘 챙길 일 · 숫자")
        : href.EndsWith("/members") ? (Model.IsAdmin ? ("people", "g", "명부 · 계정 · 연락처") : ("people", "g", "우리 부서 사람들"))
        : href.EndsWith("/birthdays") ? ("cake", "o", "다가오는 · 월별 · 연간")
        : href.EndsWith("/teachers") ? ("people", "b", "반별 담임 · 부담임")
        : href.EndsWith("/officers") ? ("key", "v", "임원 · 봉사 · 기타 역할")
        : href.EndsWith("/classes") ? ("cls", "b", "반 만들기 · 배정")
        : href.EndsWith("/teams") ? ("family", "p", "팀 · 시상")
        : href.EndsWith("/promotions") ? ("move", "o", "받은 요청 · 이동하기 · 보낸 기록")
        : href.EndsWith("/leaves") ? ("user", "r", "기다리는 탈퇴 · 승인 · 반려")
        : href.EndsWith("/gifts/common") ? ("common", "o", "모든 부서 상품 · 우리 부서에서 숨기기")
        : href.EndsWith("/gifts/ours") ? ("gift", "o", "우리 부서만의 상품 · 등록")
        : href.EndsWith("/gifts/money") ? ("rules", "o", "선물 종류별 금액 범위 · 점수")
        : href.EndsWith("/gifts/cost") ? ("chart", "o", "선물에 든 돈")
        : href.EndsWith("/gifts") ? ("gift", "o", "주문 · 처리")
        : href.EndsWith("/content") ? ("word", "g", "우리 부서 말씀 · 퀴즈")
        : href.EndsWith("/prayer365") ? ("pray", "p", "참여자 · 함께 기도")
        : href.EndsWith("/reading") ? ("read", "b", "진도율 · 순위")
        : href.EndsWith("/season") ? ("season", "s", "기간 · 시상")
        : href.EndsWith("/branding") ? ("palette", "v", "앱 이름 · 대표 색 · 보고서")
        : href.EndsWith("/worship") ? ("pin", "b", "예배 시간 · 장소 · 주소")
        : href.EndsWith("/todo") ? ("bell", "s", "누가 어떤 할 일을 보나") : ("rules", "s", "");
    var me = User.UserName();
    var photo = me is null ? null : await Photos.FileOfAsync(me);
    var myRole = Model.IsAdmin ? "부서 관리자" : "교사";
}
@{
    // 머리줄 표준(기준표 8판, 2026-11-24): ☰ + 「관리 › 화면」 + 오른쪽 이동 버튼(관리 홈 = 홈으로, 그 아래 = 관리홈). 쪽지는 ☰ 메뉴 「바로 가기」로.
    var atHome = path.TrimEnd('/').Equals(home, StringComparison.OrdinalIgnoreCase);
    var vd = new ViewDataDictionary(ViewData) { ["PbOwnDrawer"] = true, ["PbTitle"] = atHome || !Model.IsAdmin ? (Model.IsAdmin ? "관리" : "명부") : now };
    if (Model.IsAdmin && !atHome) { vd["PbParent"] = new[] { "관리", home }; vd["PbButton"] = new[] { "관리홈", home }; }
}
<partial name="_Top" view-data="vd" />
<div class="pdrawer tdr2" id="pnav" hidden>
    <div class="pd-dim" data-pnav-close></div>
    <aside class="pd-panel" tabindex="-1" role="dialog" aria-modal="true" aria-label="관리 메뉴">
        <div class="tdr2-hd">
            <div>
                <div class="tdr2-ttl">도전!!! <span>성경말씀</span></div>
                <div class="tdr2-sub">GROW IN THE WORD</div>
            </div>
            <button type="button" class="tdr2-x" aria-label="메뉴 닫기" data-pnav-close>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
            </button>
        </div>
        @DrawerUi.Me(User.DisplayName(), photo, PlatformTodayService.ShortDept(Model.Current.Name) + " · " + myRole, User.ImpersonatorId() is not null)
        <nav class="tdr2-nav" aria-label="관리 메뉴">
            @if (User.ImpersonatorId() is not null)
            {
                var impBack = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
                <h2 class="tdr2-g">가장 중</h2>
                @DrawerUi.Line($"/account/impersonate/switch?back={impBack}", "people", "사람 바꾸기", false, attr: "data-imp-switch")
                <form method="post" action="/account/impersonate/stop" class="tdr2-back">@Html.AntiForgeryToken()
                    <button type="submit" class="tdr2-r"><i class="tdr2-i" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/></svg></i><span>복귀</span></button>
                </form>
            }
            @DrawerUi.Line($"/{slug}", "home", "홈으로", false)
            @{ var last = (string?)null; }
            @foreach (var (href, label, count) in menu.OrderBy(m => Array.IndexOf(Groups, Group(m.Href))))   // 묶음 순서대로(같은 묶음 안은 원래 순서)
            {
                var g = Group(href);
                if (g != last && g.Length > 0) { <h2 class="tdr2-g">@g</h2> }
                last = g;
                var (icon, tone, desc) = Look(href);
                @DrawerUi.RowD(href, icon, label, desc, Current(href), count)
            }
            <h2 class="tdr2-g">바로 가기</h2>
            @DrawerUi.RowD("/messages", "msg", "쪽지", "받은 · 보낸 쪽지", false)
            @if (User.IsPlatformAdmin()) { @DrawerUi.RowD("/platform", "platform", "플랫폼", "모든 부서 관리", false) }
        </nav>
        <div class="tdr2-ft">
            <a class="tdr2-b1" href="/install?back=@(Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString))" data-app-install>앱 설치</a>
            <form method="post" action="/account/logout" asp-antiforgery="true"><button type="submit" class="tdr2-out">로그아웃</button></form>
        </div>
    </aside>
</div>
<script src="~/js/platform-nav.js" asp-append-version="true" defer></script>
