@model (ChallengeBible.Web.Pages.Copy.CopyPageBase Page, string Title, string? Back, string? Right)
@* 성경필사 머리말(확정 시안 성경필사): 홈은 왼쪽 위 ☰(부서 메뉴판), 다른 화면은 ← 돌아가기 *@
<header class="bc-top gut"><div class="wrap">
    @if (Model.Back is null)
    {
        <button type="button" class="pmenu-btn" aria-label="메뉴 열기" aria-controls="pnav" aria-expanded="false" data-pnav-open>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h12"/></svg>
        </button>
    }
    else
    {
        <a class="bc-back" href="@Model.Back" aria-label="돌아가기"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></a>
    }
    <div class="t"><small><em>도전!!!</em> 성경필사</small><b>@Model.Title</b></div>
    @if (Model.Right is { } r) { <span class="r">@r</span> }
</div></header>
@if (Model.Back is null) { <partial name="_TenantDrawer" model="Model.Page.Tenant" /> }
