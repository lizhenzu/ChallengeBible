@inject ChallengeBible.Web.Tenancy.TenantContext Ten
@inject ChallengeBible.Web.Services.AttendanceService Att
@using ChallengeBible.Web.Pages
@using ChallengeBible.Web.Services
@* 머리줄 표준 = 모든 화면의 단일 머리줄 부품(2026-11-24 확정 · 기준표 6판).
   「도전!!! 성경말씀」 글자는 없다. 왼쪽: 부서 안 화면(승인된 소속)은 ☰ + 「상위 › 현재」, 그 밖은 「‹ 현재」.
   오른쪽: 그 화면 바로 위 단계로 가는 이동 버튼 하나(알약 「쪽지 | 이름」은 첫 화면 · 부서 홈에만). 손님은 반대 이동 링크 하나.
   화면이 바꾸는 값(ViewData): PbTitle(현재 이름) · PbParent(string[]{ 이름, 주소 } — 있으면 부서 이름 대신 이것을 상위로) ·
   PbButton(string[]{ 이름, 주소 } — 오른쪽 버튼) · PbDept(true — 주소에 부서가 없어도 마지막 부서를 쓴다, 예: 쪽지). *@
@{
    var me = User.UserName();
    var title = ViewData["PbTitle"] as string ?? (ViewContext.ViewData.Model as ITitled)?.Title;
    var parent = ViewData["PbParent"] as string[];
    var btn = ViewData["PbButton"] as string[];
    var force = ViewData["PbDept"] as bool? == true;
    var page = ViewContext.RouteData.Values["page"]?.ToString();
    var isLogin = page == "/Account/Login";
    var inDept = Ten.Tenant is not null && (ViewContext.RouteData.Values.ContainsKey("slug") || force);
    var member = me is not null && inDept && Ten.IsApproved && !Ten.IsLobby;
    var hasHome = me is not null && Ten.Tenant is not null && Ten.IsApproved && !Ten.IsLobby;
    var homeHref = hasHome ? $"/{Ten.Current.Slug}" : "/";
    var back = inDept ? $"/{Ten.Current.Slug}" : "/";
    var btnLabel = btn?[0] ?? (hasHome ? "홈으로" : "처음 화면");
    var btnHref = btn?[1] ?? homeHref;
    var b2 = ViewData["PbDrawer"] as string == "b2";   // 통독 · 필사: ☰ 는 그 프로그램 자체 서랍(_ReadingNav · _CopyNav)을 연다
    // 출석 화면(PbDrawer="att"): 관리자 · 새친구반 담당은 하단 탭 대신 출석 전용 ☰ 메뉴(시안 출석-햄버거-메뉴). 반 담임은 부서 ☰ 메뉴.
    var attScope = ViewData["PbDrawer"] as string == "att" && member ? await Att.ScopeAsync(me!) : null;
    var attMenu = attScope?.Newcomers == true;
    var attCare = attMenu && attScope!.Admin ? await Att.CareCountAsync() : 0;
    var imp = User.ImpersonatorId() is not null;
}
<header class="top gut pb@(ViewData["PbClass"] is string pbc ? " " + pbc : "")"><div class="wrap pbw">
    <span class="pb-l">
        @if (b2)
        {
            <button type="button" class="pb-b pb-b2" aria-label="메뉴 열기" aria-controls="b2dr" data-b2open>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
            @if (parent is not null) { <a class="par" href="@parent[1]">@parent[0]</a><span class="sep" aria-hidden="true">›</span> }
            @if (!string.IsNullOrEmpty(title)) { <b class="cur">@title</b> }
        }
        else if (member || ViewData["PbOwnDrawer"] as bool? == true)
        {
            <button type="button" class="pb-b" aria-label="메뉴 열기" aria-controls="pnav" aria-expanded="false" data-pnav-open>
                @if (attCare > 0) { <i class="pb-dot" aria-label="돌봄 알림"></i> }
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
            @if (parent is not null) { <a class="par" href="@parent[1]">@parent[0]</a> }
            else if (string.IsNullOrEmpty(title)) { <a class="par" href="/@Ten.Current.Slug">@PlatformTodayService.ShortDept(Ten.Current.Name)</a> }
            @if (!string.IsNullOrEmpty(title)) { if (parent is not null) { <span class="sep" aria-hidden="true">›</span> } <b class="cur">@title</b> }
        }
        else
        {
            <a class="pb-b" href="@back" aria-label="뒤로" onclick="if (history.length > 1 &amp;&amp; document.referrer) { history.back(); return false; }">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
            </a>
            @if (!string.IsNullOrEmpty(title)) { <b class="cur">@title</b> }
        }
    </span>
    <span class="pb-r">
        @if (me is not null)
        {
            <a class="hb" href="@btnHref"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11 12 3l9 8"/><path d="M5 10v10h14V10"/></svg>@btnLabel</a>
            @* 가장 중(R-366): ☰ 메뉴가 없는 화면은 여기 [복귀] *@
            @if (imp && !member) { <form method="post" action="/account/impersonate/stop" class="imp-top">@Html.AntiForgeryToken()<button type="submit" class="pb-imp">복귀</button></form> }
        }
        else if (isLogin)
        {
            <a class="lnk" href="/account/signup">가입하기</a>
        }
        else
        {
            <a class="lnk" href="/account/login">로그인</a>
        }
    </span>
</div></header>
@if (member && !b2 && ViewData["PbOwnDrawer"] as bool? != true) { if (attMenu) { <partial name="_AttDrawer" model="(Ten, attScope!.Admin, attCare)" /> } else { <partial name="_TenantDrawer" model="(Ten, (string?)null)" /> } }
