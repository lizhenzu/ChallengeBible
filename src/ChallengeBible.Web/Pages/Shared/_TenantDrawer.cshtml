@model (ChallengeBible.Web.Tenancy.TenantContext Tenant, string? Photo)
@using ChallengeBible.Web.Auth
@using ChallengeBible.Web.Services
@* 부서 화면 왼쪽 위 ☰ 메뉴판(확정 시안 부서메뉴, 2026-11-18 사용자: 그룹 · 아이콘 · 한 줄 설명). 여는 버튼은 data-pnav-open, 동작은 platform-nav.js.
   보이는 조건(역할 · 켠 프로그램)은 예전 그대로. 프로그램 아이콘 색은 네잎과 같게(미션 초록 · 통독 파랑 · 필사 주황 · 기도 분홍) *@
@{
    var t = Model.Tenant;
    var c = t.Current;
    var s = c.Slug;
    var name = User.DisplayName() ?? "";
    var here = (Context.Request.Path.Value ?? "").TrimEnd('/');
    var lobby = t.IsLobby;
    var teacher = !lobby && t.IsApproved && UserRole.KindOf(t.RoleCode) == UserRoleKind.Teacher;
    var role = !t.IsApproved ? "" : t.IsAdmin ? "부서 관리자" : UserRole.LabelOf(UserRole.KindOf(t.RoleCode));
    bool Cur(string href) => here.Equals(href.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
    var back = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
}
<div class="pdrawer tdr" id="pnav" hidden>
    <div class="pd-dim" data-pnav-close></div>
    <aside class="pd-panel" tabindex="-1" role="dialog" aria-modal="true" aria-label="메뉴">
        @DrawerUi.Head(name, Model.Photo, c.Name, role.Length > 0 ? role : null, t.IsAdmin && t.IsApproved, "내 계정 · 사진 변경 ›")   @* 소속 두 줄(교회 · 부서 / 역할 딱지) · 내 계정 입구는 여기 한 곳(2026-11-21, 확정 시안 메뉴판-정리) *@
        <nav aria-label="메뉴">
            @* 2026-11-21 사용자: "도전!!!성경말씀" 묶음(성경미션 · 통독 · 필사 · 365 기도)과 "부서 홈" 항목은 메뉴판에서 뺐다 — 프로그램은 부서 홈 카드로, 홈으로 가는 길은 각 화면 머리말 [홈으로] *@
            @if (!lobby && (t.IsStaff || t.IsAdmin || teacher))
            {
                <h2 class="tdr-g">섬김 · 교사</h2>
                @if (t.IsStaff || t.IsAdmin) { @DrawerUi.Row($"/{s}/todo", "todo", "g", "오늘 할 일", "승인 · 선물 · 생일 챙기기", Cur($"/{s}/todo")) }   @* ADR 0100 *@
                @if (t.IsStaff) { @DrawerUi.Row($"/{s}/attendance", "att", "b", "출석", "주일 출석 체크 · 보고서", Cur($"/{s}/attendance")) }
                @if (ChallengeBible.Web.Pages.ClassBook.IndexModel.CanUse(t)) { @DrawerUi.Row($"/{s}/classbook", "book", "g", "교적부", "반별 아이 정보 보기", Cur($"/{s}/classbook")) }   @* R-361: 교사 · 관리자만 *@
                @if (ChallengeBible.Web.Pages.People.IndexModel.CanUse(t)) { @DrawerUi.Row($"/{s}/people", "search", "b", "인명 검색", "이름 · 아이디로 찾기 · 전화 · 문자 · 쪽지", Cur($"/{s}/people")) }   @* R-358: [부서 관리] · [명부] 바로 위 *@
                @if (!t.IsAdmin && teacher) { @DrawerUi.Row($"/{s}/admin/members", "people", "s", "명부", "우리 부서 사람들", Cur($"/{s}/admin/members")) }
            }
            @if (!lobby && t.IsApproved)
            {
                @* 생일(2026-11-21 사용자, 확정 시안 생일메뉴 · 선물분리): 생일자 보기 = 모두, 선물 처리 = 관리자만 — 나란히 *@
                <h2 class="tdr-g">생일</h2>
                @DrawerUi.Row($"/{s}/birthdays", "cake", "o", "생일자 보기", "다가오는 생일 · 월별 · 연간", Cur($"/{s}/birthdays"))
                @if (t.IsAdmin) { @DrawerUi.Row($"/{s}/admin/gifts", "gift", "o", "선물 처리", "선택 전 · 살 것 · 줄 것", Cur($"/{s}/admin/gifts"), badge: DrawerUi.Admin) }   @* 선물 설정은 관리 ☰(확정 시안 선물분리) *@
            }
            <h2 class="tdr-g">함께하기</h2>
            @DrawerUi.Row("/messages", "msg", "v", "단체쪽지", "받은 쪽지 · 부서 전체에 보내기", Cur("/messages"))   @* 2026-11-21 사용자: 메뉴 이름 "단체쪽지"(R-359) *@
            @if (!lobby) { @DrawerUi.Row($"/{s}/album", "photo", "o", "사진첩", "부서 행사 사진", Cur($"/{s}/album")) }   @* ADR 0118 *@
            @if (!lobby && t.IsAdmin)
            {
                @* 2026-11-21 사용자: [부서 관리]는 맨 아래 "관리" 묶음으로(확정 시안 부서관리-메뉴위치) *@
                <h2 class="tdr-g">관리</h2>
                @DrawerUi.Row($"/{s}/admin", "gear", "s", "부서 관리", "소속 · 반 · 부서 · 반 이동 · 설정", Cur($"/{s}/admin"), badge: DrawerUi.Admin)
            }
            @if (lobby || User.IsPlatformAdmin()) { <h2 class="tdr-g">다른 곳</h2> }   @* "내 정보" 묶음은 없앴다 — 내 계정은 머리에서(2026-11-21) *@
            @if (lobby) { @DrawerUi.Row("/join", "join", "g", "내 부서 참여", "다니는 부서에 참여 신청", Cur("/join")) }
            @if (User.IsPlatformAdmin()) { @DrawerUi.Row("/platform", "platform", "v", "플랫폼", "모든 부서 관리", Cur("/platform")) }
        </nav>
        <div class="tdr-ft">
            @* 앱 설치(ADR 0115) — 설치된 앱 안에서는 숨기고 그 자리에 내 계정 *@
            <a class="tdr-b1" href="/install?back=@back" data-app-install>📲 앱 설치</a>
            <a class="tdr-b1 tdr-inapp" href="/account">내 계정</a>
            <form method="post" action="/account/logout" asp-antiforgery="true"><button type="submit" class="tdr-b2">로그아웃</button></form>
        </div>
    </aside>
</div>
<script src="~/js/platform-nav.js" asp-append-version="true" defer></script>
