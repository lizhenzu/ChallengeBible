@model (ChallengeBible.Web.Tenancy.TenantContext Tenant, string? Photo)
@using ChallengeBible.Web.Auth
@using ChallengeBible.Web.Services
@* 부서 화면 왼쪽 위 ☰ 메뉴판(확정 시안 부서메뉴, 2026-11-18 사용자: 그룹 · 아이콘 · 한 줄 설명). 여는 버튼은 data-pnav-open, 동작은 platform-nav.js.
   보이는 조건(역할 · 켠 프로그램)은 예전 그대로. 프로그램 아이콘 색은 네잎과 같게(미션 초록 · 통독 파랑 · 필사 주황 · 기도 분홍) *@
@{
    var t = Model.Tenant;
    var c = t.Current;
    var s = c.Slug;
    var name = User.DisplayName() ?? "";
    var here = (Context.Request.Path.Value ?? "").TrimEnd('/');
    var lobby = t.IsLobby;
    var teacher = !lobby && t.IsApproved && UserRole.KindOf(t.RoleCode) == UserRoleKind.Teacher;
    var role = !t.IsApproved ? "" : t.IsAdmin ? "부서 관리자" : UserRole.LabelOf(UserRole.KindOf(t.RoleCode));
    var back = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
    var svg = new Dictionary<string, string>
    {
        ["mission"] = """<path d="M4 5h6a2 2 0 0 1 2 2v12a2 2 0 0 0-2-2H4z"/><path d="M20 5h-6a2 2 0 0 0-2 2v12a2 2 0 0 1 2-2h6z"/><path d="m15 9 1.5 1.5L19 8"/>""",
        ["reading"] = """<path d="M2 6s3-2 10 0 10 0 10 0v13s-3 2-10 0-10 0-10 0z"/><path d="M12 6v13"/>""",
        ["copy"] = """<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>""",
        ["pray"] = """<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z"/>""",
        ["msg"] = """<path d="M4 4h16v12H8l-4 4z"/>""",
        ["todo"] = """<rect x="4" y="4" width="16" height="16" rx="3"/><path d="m8 12 3 3 5-6"/>""",
        ["att"] = """<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/><path d="m9 16 2 2 4-4"/>""",
        ["admin"] = """<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1"/>""",
        ["people"] = """<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M21.5 20a6.5 6.5 0 0 0-4-6"/>""",
        ["platform"] = """<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>""",
        ["user"] = """<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>""",
        ["home"] = """<path d="M3 11 12 3l9 8"/><path d="M5 10v10h14V10"/>""",
        ["join"] = """<circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/>""",
    };
}
@functions {
    // 한 줄: 아이콘(색 g · m · o · p · v · s) + 이름 + 설명. 지금 보고 있는 화면이면 옅게 칠한다
    private Microsoft.AspNetCore.Html.IHtmlContent Row(Dictionary<string, string> svg, string here, string href, string icon, string tone, string title, string desc, bool dj = false, string? attr = null)
    {
        var cur = here.Equals(href.TrimEnd('/'), StringComparison.OrdinalIgnoreCase) ? " aria-current=\"page\"" : "";
        var t = dj ? $"<em class=\"pd-pg\">도전!!!</em> {System.Net.WebUtility.HtmlEncode(title)}" : System.Net.WebUtility.HtmlEncode(title);
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<a class=\"tdr-r\" href=\"{href}\"{cur}{(attr is null ? "" : " " + attr)}><i class=\"tdr-i t-{tone}\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{svg[icon]}</svg></i>"
            + $"<span><b>{t}</b><small>{System.Net.WebUtility.HtmlEncode(desc)}</small></span><u aria-hidden=\"true\">›</u></a>");
    }
}
<div class="pdrawer tdr" id="pnav" hidden>
    <div class="pd-dim" data-pnav-close></div>
    <aside class="pd-panel" tabindex="-1" role="dialog" aria-modal="true" aria-label="메뉴">
        <div class="tdr-hd">
            <a class="tdr-av" href="/account" aria-label="내 계정">@if (Model.Photo is { } ph) { <img src="/account/photo?handler=img&amp;v=@ph" alt="" /> } else { <span aria-hidden="true">@(name.Length > 0 ? name[..1] : "?")</span> }</a>
            <div class="tdr-who">
                <b>@Ui.Nim(name)</b>
                <small class="pd-dept">@c.Name@(role.Length > 0 ? " · " + role : "")</small>
                <a href="/account">내 정보 · 사진 변경 ›</a>
            </div>
            <button type="button" class="pd-x" aria-label="메뉴 닫기" data-pnav-close>✕</button>
        </div>
        <nav aria-label="메뉴">
            @if (!lobby)
            {
                <h2 class="tdr-g"><em>도전!!!</em> 프로그램</h2>
                @* 켠 것만 · 성경미션 → 성경통독 → 성경필사(2026-11-16), 365 기도는 학생 · 새친구에게 없음(ADR 0106) *@
                @if (c.MissionEnabled) { @Row(svg, here, $"/{s}/word-mission", "mission", "g", "성경미션", "말씀 · 퀴즈 · 기도 · 암송, 매일 점수", true) }
                @if (c.ReadingEnabled) { @Row(svg, here, $"/{s}/reading", "reading", "b", "성경통독", "하루 몇 장, 내 진도율", true) }
                @if (c.CopyEnabled) { @Row(svg, here, $"/{s}/copy", "copy", "o", "성경필사", "말씀 따라 쓰기 · 완필 선물", true) }
                @if (t.IsApproved && !Prayer365Service.IsStudentRole(t.RoleCode)) { @Row(svg, here, $"/{s}/prayer365", "pray", "p", "자녀를 위한 365 기도", "부모가 매일 한 가지씩 기도") }
            }
            <h2 class="tdr-g">함께하기</h2>
            @Row(svg, here, $"/{s}", "home", "s", "부서 홈", "오늘 미션 · 점수 · 선물")
            @Row(svg, here, "/messages", "msg", "v", "쪽지", "선생님 · 친구와 주고받기")
            @if (!lobby && (t.IsStaff || t.IsAdmin || teacher))
            {
                <h2 class="tdr-g">섬김 · 교사</h2>
                @if (t.IsStaff || t.IsAdmin) { @Row(svg, here, $"/{s}/todo", "todo", "g", "오늘 할 일", "승인 · 선물 · 생일 챙기기") }   @* ADR 0100 *@
                @if (t.IsStaff) { @Row(svg, here, $"/{s}/attendance", "att", "b", "출석", "주일 출석 체크 · 보고서") }
                @if (t.IsAdmin) { @Row(svg, here, $"/{s}/admin", "admin", "s", "관리", "명부 · 규칙 · 선물 · 이름 · 색") }
                else if (teacher) { @Row(svg, here, $"/{s}/admin/members", "people", "s", "명부", "우리 부서 사람들") }
            }
            <h2 class="tdr-g">내 정보</h2>
            @Row(svg, here, "/account", "user", "s", "내 계정", "이름 · 비밀번호 · 가족")
            @if (lobby) { @Row(svg, here, "/join", "join", "g", "내 부서 참여", "다니는 부서에 참여 신청") }
            @if (User.IsPlatformAdmin()) { @Row(svg, here, "/platform", "platform", "v", "플랫폼", "모든 부서 관리") }
        </nav>
        <div class="tdr-ft">
            @* 앱 설치(ADR 0115) — 설치된 앱 안에서는 숨기고 그 자리에 내 계정 *@
            <a class="tdr-b1" href="/install?back=@back" data-app-install>📲 앱 설치</a>
            <a class="tdr-b1 tdr-inapp" href="/account">내 계정</a>
            <form method="post" action="/account/logout" asp-antiforgery="true"><button type="submit" class="tdr-b2">로그아웃</button></form>
        </div>
    </aside>
</div>
<script src="~/js/platform-nav.js" asp-append-version="true" defer></script>
