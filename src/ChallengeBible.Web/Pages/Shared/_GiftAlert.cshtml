@model GiftTargetCardVm
@* 「오늘의 말씀」 바로 아래 한 줄 선물 알림(2026-11-23 사용자 확정 B안 · ADR 0138).
   시안 docs/design/시안/선물알림-오늘의말씀아래-3안.html — 🎁 타일 + 두 줄 문장 + 오른쪽 3칸 눈금.
   홈에서는 사람 이름을 꺼내지 않는다(한 줄 유지). 자세한 것은 누르면 `/{slug}/gift-status`. *@
@{
    var b = Model.Board;
    var rest = b is null ? 0 : Math.Max(0, b.Total - b.Delivered);
}
@if (Model.Guest)
{
    <a class="vb-galert guest" href="@(Model.LoginTo ?? "/account/login")">
        <span class="ic" aria-hidden="true">🎁</span>
        <span class="tx"><b>로그인하면 선물 준비 상태가 보여요</b><span>누가 · 무엇을 · 어디까지 준비했는지</span></span>
        <span class="go" aria-hidden="true">›</span>
    </a>
}
else if (b is { Total: > 0 })
{
    <a class="vb-galert" href="/@Model.Slug/gift-status" aria-label="선물 대상자 @(b.Total)명 — 자세히 보기">
        <span class="ic" aria-hidden="true">🎁</span>
        <span class="tx">
            <b>선물 <span class="num">@b.Total</span>명</b>
            <span>받았어요 <span class="num">@b.Delivered</span>명 · 준비 중 <span class="num">@rest</span>명</span>
        </span>
        <span class="mdots" aria-hidden="true">
            <u class="on"></u>
            <u class="@(b.Delivered > 0 || b.Purchased > 0 ? "on" : "")"></u>
            <u class="@(b.Delivered > 0 ? "on" : "")"></u>
        </span>
        <span class="go" aria-hidden="true">›</span>
    </a>
}
