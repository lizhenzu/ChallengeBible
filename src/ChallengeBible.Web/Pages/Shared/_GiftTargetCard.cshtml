@using ChallengeBible.Web.Services
@model GiftTargetCardVm
@* 홈 "선물 대상자와 상태" 카드(2026-11-23 사용자 확정 C안 · ADR 0134 · 시안 docs/design/시안/홈-선물대상자-상태카드-단독시안.html).
   사람마다 한 칸, 그 안에 3단계 눈금(골랐어요 → 샀어요 → 받았어요). 가격 없음(R-297), 받은 선물은 받은 지 30일까지.
   부서 홈(`/{slug}`)과 첫 화면(`/`)이 같은 부품을 쓴다. *@
@{
    var b = Model.Board;
}
<section class="vb-stat vb-gifts" id="vb-gifts" aria-labelledby="vbGift">
    <div class="vb-stat-h">
        <h3 id="vbGift">선물 대상자와 상태</h3>
        @if (Model.MoreHref is { } more)
        {
            <a class="vb-more" href="@more">더보기
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </a>
        }
    </div>

    @if (Model.Guest)
    {
        <div class="vb-guest">
            <b>로그인하면 선물 준비 상태가 보여요</b>
            <span>누가 · 무엇을 · 어디까지 준비했는지</span>
            <a href="@(Model.LoginTo ?? "/account/login")">로그인</a>
        </div>
    }
    else if (Model.Empty)
    {
        <p class="vb-gift-empty"><b>아직 선물 대상자가 없어요</b><span>미션 · 생일 · 완독 선물이 생기면 여기에 보여요</span></p>
    }
    else if (b is not null)
    {
        <div class="vb-giftlist" role="list" aria-label="선물 대상자">
            @foreach (var r in b.Rows)
            {
                <div class="vb-gift@(r.Step == 3 ? " done" : "")" role="listitem">
                    <span class="pic" aria-hidden="true">@if (r.HasImage && r.ItemId is int iid) { <img src="/images/AwardItem/@(iid).jpg" alt="" loading="lazy" onerror="this.remove()" /> } else { <text>🎁</text> }</span>
                    <span class="t">
                        <span class="hd"><b>@r.Who</b><span class="st s@(r.Step)">@r.StateText</span></span>
                        <small><span class="k k-@r.KindTone">@r.KindText</span>@r.ItemName</small>
                        <span class="dots" aria-hidden="true">
                            <u class="on"></u><u class="@(r.Step >= 2 ? "on" : "")"></u><u class="@(r.Step >= 3 ? "on" : "")"></u>
                        </span>
                        <span class="lbl"><span>골랐어요</span><span>샀어요</span><span>줬어요</span></span>
                    </span>
                </div>
            }
        </div>
        @if (b.Total > b.Rows.Count && Model.MoreHref is { } all)
        {
            <a class="vb-giftfoot" href="@all">선물 대상자 @(b.Total)명 전체 보기 ›</a>
        }
    }
</section>
