@page "/platform/gifts/edit/{id:int?}"
@model ChallengeBible.Web.Pages.Platform.GiftEditModel
@using ChallengeBible.Infrastructure.Data
@using ChallengeBible.Web.Services
@* 확정 시안: 플랫폼-선물상품-단독시안 "등록 · 수정"(2026-11-14, 고침: 사진 함께 저장 · 점수 칸 뺌) — 사진(정사각형 자르기) | 이름 · 가격 · 쿠팡 링크 · 설명 → 저장 → 내리기 · 삭제 *@
@{
    var i = Model.Item;
    var back = $"/platform/gifts?s={i?.Status ?? GiftItemStatus.Active}";
}
<partial name="_PlatformTop" />
<main class="admin gut gf"><div class="wrap">
    <a class="gf-back" href="@back">← 공통 상품</a>
    <h1 class="gf-h">@Model.Title
        @if (i is not null) { <small class="num">@i.Id · @(i.TenantId is null ? "공통" : Model.TenantName) · 고른 기록 @Model.Picked@(Model.SharedByName is { } sn ? $" · {sn}가 올림" : "")</small> }
    </h1>
    @if (Model.Message is not null) { <p class="ok-box" role="status">@Model.Message</p> }
    @if (Model.Error is not null) { <p class="err" role="alert">@Model.Error</p> }
    @if (i?.Status == GiftItemStatus.Review) { <p class="gf-warn">삭제 대상(@GiftCatalogService.ReasonText(i.ReviewReason)) — 아이에게 보이지 않아요. 쿠팡 링크를 넣어 저장하면 판매 중으로 살아나요.</p> }
    @if (i?.Status == GiftItemStatus.Retired) { <p class="gf-warn">목록에서 내린 상품이에요 — 아이에게 보이지 않아요.</p> }

    <partial name="_GiftItemForm" model="new ChallengeBible.Web.Services.GiftItemFormView(i, Model.Input, Model.Errors, back)" />

    @if (i is not null)
    {
        <hr class="gf-hr" />
        <div class="gf-acts">
            @if (i.Status == GiftItemStatus.Retired)
            {
                <form method="post" asp-page-handler="Restore"><button class="btn s" type="submit">다시 올리기</button></form>
            }
            else
            {
                <form method="post" asp-page-handler="Retire" onsubmit="return confirm('목록에서 내릴까요? 아이에게 보이지 않아요.')"><button class="btn d" type="submit">목록에서 내리기</button></form>
            }
            @if (Model.Picked == 0)
            {
                <form method="post" asp-page-handler="Delete" onsubmit="return confirm('상품과 사진을 지울까요? 되돌릴 수 없어요.')"><button class="btn d" type="submit">삭제(상품 + 사진)</button></form>
            }
        </div>
        <p class="gf-note">고른 기록이 있으면 <b>삭제 대신 "목록에서 내리기"</b>만 돼요(이름 · 사진 · 금액은 이력과 총비용에 남아요). 고른 기록이 없으면 삭제하면 상품과 서버 사진이 지워져요.</p>
    }
</div></main>
<script src="~/js/photo.js" asp-append-version="true"></script>
