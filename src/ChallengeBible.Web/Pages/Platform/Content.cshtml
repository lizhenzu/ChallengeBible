@page "/platform/content/{kind}"
@model ChallengeBible.Web.Pages.Platform.ContentModel
@using ChallengeBible.Infrastructure.Data
@using ChallengeBible.Web.Pages.Platform
@using ChallengeBible.Web.Services
@{
    var ko = new System.Globalization.CultureInfo("ko-KR");
    var i = Model.Input;
    string? E(string f) => Model.Errors.GetValueOrDefault(f);
    var kindLabel = ContentModel.Kinds.First(x => x.Key == Model.Kind).Label;
    var published = Model.Status == ContentStatus.Published;
}
<partial name="_PlatformTop" />
<main class="admin gut"><div class="wrap wide">
    <h1>공용 콘텐츠</h1>
    @if (!string.IsNullOrEmpty(Model.OkMessage)) { <p class="okmsg" role="status">@Model.OkMessage</p> }
    @if (Model.Notice is not null) { <p class="note-block">@Model.Notice</p> }

    <nav class="seg" aria-label="종류">
        @foreach (var (key, label, _) in ContentModel.Kinds) { <a href="@Model.Link(kind: key)" aria-current="@(key == Model.Kind ? "page" : "false")">@label</a> }
    </nav>
    <div class="tools">
        <a class="btn s sm" href="@Model.Link(month: Model.First.AddMonths(-1))" aria-label="이전 달">‹</a>
        <b class="num">@Model.First.ToString("yyyy년 M월")</b>
        <a class="btn s sm" href="@Model.Link(month: Model.First.AddMonths(1))" aria-label="다음 달">›</a>
        <span class="cnt">
            @foreach (var g in Model.Days.GroupBy(d => d.Status)) { <span class="@ContentModel.StatusClass(g.Key)">@ContentModel.StatusLabel(g.Key) @g.Count()</span> }
        </span>
    </div>

    <div class="csplit">
        <form method="post" asp-page-handler="Bulk" asp-route-month="@Model.First.ToString("yyyy-MM")" class="days">
            <ul>
                @foreach (var d in Model.Days)
                {
                    var on = d.Date == Model.Date;
                    <li class="@(on ? "on" : "")">
                        <input type="checkbox" name="dates" value="@d.Date.ToString("yyyy-MM-dd")" disabled="@(d.Status != ContentStatus.Draft)" aria-label="@d.Date.ToString("M월 d일") 고르기" />
                        <a href="@Model.Link(d.Date)">
                            <span class="d num @(d.Date.DayOfWeek == DayOfWeek.Sunday ? "sun" : "")">@(Model.Kind == "recite" ? $"{d.Date.Day}일 ~" : $"{d.Date.Day}일")<small>@(Model.Kind == "recite" ? $"{d.Date.AddDays(6):M'/'d}까지" : d.Date.ToString("ddd", ko))</small></span>
                            <span class="tt @(d.Title is null ? "none" : "")">@(d.Title ?? "비어 있어요")</span>
                            <span class="tag @ContentModel.StatusClass(d.Status)">@ContentModel.StatusLabel(d.Status)</span>
                        </a>
                    </li>
                }
            </ul>
            <button type="submit" class="btn p sm">고른 초안 공개</button>
        </form>

        <section class="editor">
            @if (Model.Date is null)
            {
                <p class="empty">왼쪽에서 날짜를 고르세요.</p>
            }
            else
            {
                <div class="h"><b>@Model.Date.Value.ToString("M월 d일 (ddd)", ko) @kindLabel</b><span class="tag @ContentModel.StatusClass(Model.Status)">@ContentModel.StatusLabel(Model.Status)</span></div>
                @if (Model.Status == "None") { <p class="note-block">이날은 @(kindLabel)@Ui.IGa(kindLabel) 없어요. 이대로 두면 아이들 화면에 "오늘은 없음"으로 보여요(R-122).</p> }
                @if (E("Status") is { } st) { <p class="err">@st</p> }
                @if (E("Date") is { } dt) { <p class="err">@dt</p> }
                <form method="post" asp-page-handler="Save" asp-route-month="@Model.First.ToString("yyyy-MM")" asp-route-date="@Model.Date.Value.ToString("yyyy-MM-dd")" class="stack" novalidate>
                    @if (Model.Kind != "quiz")
                    {
                        <div class="f"><label>성경 범위 <small>@(E("Range") is null ? "" : "")</small></label>
                            <div class="range">
                                <select class="sel" name="Input.Book" aria-label="책">
                                    @foreach (var b in BibleBooks.All()) { <option value="@b.Id" selected="@(b.Id == i.Book)">@b.Name</option> }
                                </select>
                                <input class="in sm num" type="number" name="Input.StartChapter" value="@i.StartChapter" min="1" aria-label="시작 장" /><span>:</span>
                                <input class="in sm num" type="number" name="Input.StartVerse" value="@i.StartVerse" min="1" aria-label="시작 절" /><span>~</span>
                                <input class="in sm num" type="number" name="Input.EndChapter" value="@i.EndChapter" min="1" aria-label="끝 장" /><span>:</span>
                                <input class="in sm num" type="number" name="Input.EndVerse" value="@i.EndVerse" min="1" aria-label="끝 절" />
                            </div>
                            <p class="hint @(E("Range") is null ? "" : "bad")">@(E("Range") ?? "예: 창세기 24:1 ~ 24:9")</p></div>
                    }
                    @switch (Model.Kind)
                    {
                        case "word":
                            <div class="f"><label for="t">제목</label><input class="in" id="t" name="Input.Title" value="@i.Title" maxlength="100" /><p class="hint bad">@E("Title")</p></div>
                            <div class="f"><label for="s">오늘 이야기 <small>아이들 눈높이로 3 ~ 5문장</small></label><textarea class="in ta" id="s" name="Input.Summary">@i.Summary</textarea><p class="hint bad">@E("Summary")</p></div>
                            <div class="f"><label for="c">해설 <small>있으면</small></label><textarea class="in ta" id="c" name="Input.Commentary">@i.Commentary</textarea></div>
                            break;
                        case "prayer":
                            <div class="grid2">
                                <div class="f"><label for="tn">성품 이름</label><input class="in" id="tn" name="Input.TraitName" value="@i.TraitName" maxlength="30" /><p class="hint bad">@E("TraitName")</p></div>
                                <div class="f"><label for="te">영어 이름</label><input class="in" id="te" name="Input.TraitNameEn" value="@i.TraitNameEn" maxlength="40" /></div>
                            </div>
                            <div class="f"><label for="pp">기도문 <small>{이름} 자리에 아이 이름이 들어가요 · 한 줄이 한 문단</small></label><textarea class="in ta" id="pp" name="Input.Paragraphs">@i.Paragraphs</textarea><p class="hint bad">@E("Paragraphs")</p></div>
                            break;
                        case "quiz":
                            <div class="f"><label for="q">문제</label><input class="in" id="q" name="Input.Question" value="@i.Question" maxlength="1000" /><p class="hint bad">@E("Question")</p></div>
                            <div class="f"><label for="bg">배경 <small>있으면</small></label><input class="in" id="bg" name="Input.Background" value="@i.Background" /></div>
                            <div class="f"><label>형식</label>
                                <div class="rl"><label><input type="radio" name="Input.Format" value="@QuizFormat.Choice" checked="@(i.Format == QuizFormat.Choice)" />객관식</label><label><input type="radio" name="Input.Format" value="@QuizFormat.Text" checked="@(i.Format == QuizFormat.Text)" />주관식</label></div></div>
                            <div class="f"><label>보기 <small>객관식 · 정답에 동그라미</small></label>
                                <div class="opts">
                                    @for (var k = 0; k < 4; k++)
                                    {
                                        <div class="opt"><input type="radio" name="Input.CorrectIndex" value="@k" checked="@(i.CorrectIndex == k)" aria-label="@(k + 1)번이 정답" /><input class="in sm" name="Input.Choices[@k]" value="@(k < i.Choices.Count ? i.Choices[k] : "")" maxlength="300" aria-label="보기 @(k + 1)" /></div>
                                    }
                                </div><p class="hint bad">@E("Choices")</p></div>
                            <div class="f"><label for="aa">맞는 답 <small>주관식 · 한 줄에 하나(띄어쓰기 · 대소문자는 무시)</small></label><textarea class="in ta sm2" id="aa" name="Input.AcceptedAnswers">@i.AcceptedAnswers</textarea><p class="hint bad">@E("AcceptedAnswers")</p></div>
                            <div class="f"><label for="ex">해설 <small>끝난 뒤 보여 줘요</small></label><textarea class="in ta sm2" id="ex" name="Input.Explanation">@i.Explanation</textarea></div>
                            break;
                        default:
                            <div class="f"><label for="rt">제목(질문)</label><input class="in" id="rt" name="Input.Title" value="@i.Title" maxlength="200" /><p class="hint bad">@E("Title")</p></div>
                            <div class="grid2">
                                <div class="f"><label for="ln">과 번호</label><input class="in" id="ln" type="number" name="Input.LessonNo" value="@i.LessonNo" /></div>
                                <div class="f"><label for="ls">공과 요약</label><input class="in" id="ls" name="Input.LessonSummary" value="@i.LessonSummary" maxlength="200" /></div>
                            </div>
                            <div class="f"><label for="lp">배울 점</label><textarea class="in ta sm2" id="lp" name="Input.LessonPoint">@i.LessonPoint</textarea></div>
                            <div class="f"><label for="la">이렇게 살아요</label><textarea class="in ta sm2" id="la" name="Input.LessonApply">@i.LessonApply</textarea></div>
                            break;
                    }
                    @if (published) { <p class="hint">이미 공개됐어요. 고쳐도 이미 한 아이들의 기록 · 점수는 그대로예요(R-124).</p> }
                    <div class="acts">
                        @if (!published) { <button type="submit" class="btn s sm" name="publish" value="false">초안으로 저장</button> }
                        <button type="submit" class="btn p sm" name="publish" value="true">@(published ? "고친 내용 공개" : "공개")</button>
                    </div>
                </form>
            }
        </section>
    </div>
</div></main>
