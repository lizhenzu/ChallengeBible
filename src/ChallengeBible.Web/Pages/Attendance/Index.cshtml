@page "/{slug}/attendance"
@model ChallengeBible.Web.Pages.Attendance.IndexModel
@* 확정 시안 A-출석부-오늘(ADR 0093 출석, 유년부 출석부 "오늘"과 같은 동작): 이름 누르면 저장 · 초성 검색 · 반 바로가기 · 지난 4주 점 · 3주 결석 테두리 *@
@{
    var slug = Model.Tenant.Current.Slug;
    // 위쪽 글자: 유년부 › 관리자전용 › 출석부(R-271). 부서 이름은 마지막 낱말만("잠실새내교회 유년부" → "유년부")
    var dn = Model.Tenant.Current.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? Model.Tenant.Current.Name;
}
<main class="att gut attw"><div class="wrap">@* attw: 데스크톱에서 유년부처럼 760px(R-270) *@
    @if (!Model.Scope.Any)
    {
        <div class="top"><div class="crumb"><span><a href="/@slug">@dn</a> › 관리자전용 › 출석부</span><a href="/@slug">홈으로</a></div><h1>출석</h1></div>
        <p class="none">아직 맡은 반이 없어요. 부서 관리자가 반 선생님으로 넣으면 출석부가 보여요.</p>
    }
    else
    {
        var b = Model.Board;
        var isThis = b.Sunday == b.ThisSunday;
        var pct = b.Total == 0 ? 0 : b.Present * 100 / b.Total;
        var done = b.Groups.Count(g => g.Kids.Any(k => k.Present));
        <div class="top">
            <div class="crumb"><span><a href="/@slug">@dn</a> › @if (Model.Tenant.IsAdmin) { <a href="/@slug/admin">관리자전용</a> } else { <text>관리자전용</text> } › 출석부</span><a href="/@slug">홈으로</a></div>
            @{ var prevD = b.Sunday.AddDays(-7); var nextD = b.Sunday.AddDays(7); var nextOk = nextD <= b.ThisSunday; }
            <div class="nvB">
                <div class="h"><h1>@b.Sunday.ToString("M월 d일") 주일</h1><span class="@(isThis ? "now" : "")">@(isThis ? "이번 주일" : "지난 주일 · 고치는 중")</span></div>
                <nav class="strip" aria-label="주일 이동">
                    <a class="c" href="?D=@prevD.ToString("yyyy-MM-dd")"><b>@($"{prevD.Month}/{prevD.Day}")</b><small>전주</small></a>
                    <span class="c on" aria-current="date"><b>@($"{b.Sunday.Month}/{b.Sunday.Day}")</b><small>@(isThis ? "이번 주일" : "보는 주")</small></span>
                    @if (nextOk) { <a class="c" href="?D=@nextD.ToString("yyyy-MM-dd")"><b>@($"{nextD.Month}/{nextD.Day}")</b><small>@(nextD == b.ThisSunday ? "차주 · 이번 주일" : "차주")</small></a> }
                    else { <span class="c no" aria-disabled="true"><b>@($"{nextD.Month}/{nextD.Day}")</b><small>차주 · 아직</small></span> }
                </nav>
            </div>
            <div class="prog"><b id="presentN">@b.Present</b> / @(b.Total)명 출석 · 남은 아이 <span id="leftN">@(b.Total - b.Present)</span></div>
            <div class="bar"><i id="barFill" style="width:@(pct)%"></i></div>
            @* 확정 시안 A(사용자 2026-11-13, R-263): 바로가기 2칸 타일(관리자) · 흰 안내 카드 · 성경 검색 같은 검색칸 *@
            @if (Model.Tenant.IsAdmin)
            {
                <nav class="tdTiles" aria-label="바로가기">
                    <a class="tdTile" href="/@slug/attendance/report?sunday=@b.Sunday.ToString("yyyy-MM-dd")"><i aria-hidden="true">▤</i><b>주일 출결 보고서</b><small>종이 출력지와 동일 →</small></a>
                    <a class="tdTile" href="/@slug/attendance/dashboard/all?date=@b.Sunday.ToString("yyyy-MM-dd")"><i aria-hidden="true">▦</i><b>전체반 대시보드</b><small>반별 출석률 한눈에 →</small></a>
                </nav>
            }
            <div class="tdTip"><i aria-hidden="true">✓</i><p>아래 <b>아이 이름을 누르면</b> 바로 출석 체크돼요.<br />잘못 눌렀다면 한 번 더 누르면 취소돼요.</p></div>
        </div>
        @Html.AntiForgeryToken()
        <div class="tdSform" role="search"><input id="q" type="search" autocomplete="off" placeholder="이름 검색 · 초성도 돼요 (ㅈㅎ)" aria-label="이름 검색" /><button type="button" id="qClear" class="hidden" aria-label="검색어 지우기">✕</button><button type="button" id="qGo" class="go">검색 →</button></div>
        <div class="seg2" role="tablist" aria-label="보기"><button type="button" data-f="all" class="on">전체 <b id="cAll">@b.Total</b></button><button type="button" data-f="left">미출석/미체크 아이 <b id="cLeft">@(b.Total - b.Present)</b></button></div>
        @if (b.Groups.Count == 0) { <p class="none">반에 든 아이가 없어요. 부서 관리자가 반에 아이를 넣으면 보여요.</p> }
        else
        {
            {
                <div class="jh" id="jumpH"><span class="a @(b.Groups.Count == done ? "hidden" : "")">체크 안 한 반 <b id="jTodo">@(b.Groups.Count - done)</b></span><span class="z @(b.Groups.Count == done ? "hidden" : "")">체크한 반 <em id="jDone">@done</em></span><span class="all @(b.Groups.Count == done ? "" : "hidden")">✓ 모든 반 체크 완료</span></div>
                <nav class="jump" aria-label="반으로 이동">
                    @for (var i = 0; i < b.Groups.Count; i++)
                    {
                        var g = b.Groups[i];
                        var d = g.Kids.Any(k => k.Present);
                        <a href="#g-@g.ClassId" data-g="@g.ClassId" data-ord="@i" class="@(d ? "done" : "todo")" style="order:@(d ? 1000 + i : i)">@g.Name</a>
                    }
                </nav>
            }
            <div id="board" data-slug="@slug" data-sunday="@b.Sunday.ToString("yyyy-MM-dd")">
                @foreach (var g in b.Groups)
                {
                    <section class="grp" id="g-@g.ClassId" data-g="@g.ClassId">
                        <div class="gh"><b>@g.Name@if (g.Mine) { <span class="tag my">내 반</span> }</b><span>@(string.IsNullOrEmpty(g.Teacher) ? "" : g.Teacher + " · ")<em class="gc" style="font-style:normal">@g.Kids.Count(k => k.Present)/@g.Kids.Count</em></span></div>
                        <div class="kids">
                            @foreach (var k in g.Kids)
                            {
                                <button type="button" class="kid @(k.Present ? "on" : "") @(k.AbsentStreak >= ChallengeBible.Web.Services.AttendanceService.AbsentAlert ? "w" : "")"
                                        data-id="@k.PersonId" data-name="@k.Name" data-p="@(k.Present ? "1" : "0")" aria-pressed="@(k.Present ? "true" : "false")"
                                        title="@(k.AbsentStreak >= 3 ? $"{k.AbsentStreak}주 연속 결석" : "")"><b>@k.Name</b><small>@g.Name@(k.Newcomer ? " · 새친구" : "")</small><span class="kd" aria-hidden="true">@foreach (var r in k.Recent) { <i class="@(r ? "" : "o")"></i> }</span></button>
                            }
                        </div>
                    </section>
                }
                <p class="none hidden" id="noHit">찾는 아이가 없어요.</p>
            </div>
            <p class="foot">이름 아래 점 = 지난 4주 출석 · 빨간 테두리 = 3주 이상 결석@(Model.Scope.Admin ? " · 부서 관리자는 모든 반이 보여요" : "")</p>
        }
        <div class="toast hidden" id="toast" role="alert"></div>
    }
</div></main>
<partial name="_AttTabs" model='(slug, "a", Model.Scope.Newcomers)' />
<script src="~/js/attendance.js" asp-append-version="true"></script>
