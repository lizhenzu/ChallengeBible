@page "/{slug}/attendance/dashboard/all"
@model ChallengeBible.Web.Pages.Attendance.DashboardAllModel
@using ChallengeBible.Web.Pages.Attendance
@* 전체반 출석현황(확정 시안 B, 사용자 2026-11-13, R-261): 흰 바탕 · 주일 ‹ › · 정렬 3칸 · 파란 요약 카드 · 반마다 한 줄 목록(누르면 그 반 출석체크) *@
@{
    var slug = Model.Tenant.Current.Slug;
    var r = Model.Rep;
    var dateStr = r.Sunday.ToString("yyyy-MM-dd");
    var cards = r.Classes.Where(c => c.Id > 0).Select(c => new { c, T = c.Kids.Count, P = c.Kids.Count(k => k.Present) }).ToList();
    int total = cards.Sum(x => x.T), present = cards.Sum(x => x.P), todo = cards.Count(x => x.P == 0);
    var allRate = DashboardModel.Rate(present, total);
    bool atLatest = r.Sunday >= r.ThisSunday;
    string Self(DateOnly d) => $"/{slug}/attendance/dashboard/all?date={d:yyyy-MM-dd}";
}
<div class="yb ybd ybda">
    <div class="dbTop flow">@* 위 덩어리는 화면에 고정하지 않는다(R-260) *@
        <div class="sh">
            <div class="hdTop"><a href="/@slug/attendance/more">더보기</a><a href="/@slug">부서 홈으로</a></div>
            <h1 class="daT">전체반 출석현황</h1>
            <p class="daSub">반마다 출석률 · 체크 안 한 반 먼저</p>
            <form class="daCtl" method="get" action="/@slug/attendance/dashboard/all">
                <a class="daNav" href="@Self(r.Sunday.AddDays(-7))" aria-label="지난 주일">‹</a>
                <label class="daDate"><span>기준</span><input type="date" name="date" value="@dateStr" max="@r.ThisSunday.ToString("yyyy-MM-dd")" onchange="this.form.submit()" aria-label="주일 고르기" /></label>
                @if (atLatest) { <span class="daNav off" aria-hidden="true">›</span> } else { <a class="daNav" href="@Self(r.Sunday.AddDays(7))" aria-label="다음 주일">›</a> }
            </form>
            <div class="daSeg" role="tablist" aria-label="보기">
                <button type="button" data-m="todo" class="on" aria-pressed="true">미체크 먼저</button>
                <button type="button" data-m="rate" aria-pressed="false">출석률 순</button>
                <button type="button" data-m="only" aria-pressed="false">미체크만<em>@todo</em></button>
            </div>
            <section class="daSum" aria-label="전체 요약">
                <div class="big"><b>@allRate%</b><span>전체 출석률</span></div>
                <div class="bar"><i style="width:@(allRate)%"></i></div>
                <div class="nums"><div><b>@cards.Count</b>반</div><div><b>@total</b>총원</div><div><b>@present</b>출석</div><div class="x"><b>@todo</b>미체크 반</div></div>
            </section>
            <a class="daGo" href="/@slug/attendance/trend?date=@dateStr">최근 전체 출석현황 (3주) <em aria-hidden="true">→</em></a>
        </div>
    </div>

    <main class="sh">
        <div class="daH"><b>반별 출석</b><span>줄을 누르면 출석체크</span></div>
        @if (cards.Count == 0)
        {
            <div class="none">표시할 반이 없습니다.</div>
        }
        else
        {
            <section class="daList" id="grid" aria-label="반 목록">
                @foreach (var x in cards)
                {
                    bool ok = x.P > 0;
                    var rate = DashboardModel.Rate(x.P, x.T);
                    var href = x.T > 0 ? $"/{slug}/attendance/class/{x.c.Id}?d={dateStr}" : $"/{slug}/attendance/dashboard?date={dateStr}&classId={x.c.Id}";
                    <a class="daRow cc" href="@href" data-name="@x.c.Name" data-rate="@rate" data-total="@x.T" data-checked="@(ok ? 1 : 0)">
                        <i class="dot2 @(ok ? "" : "todo")" aria-label="@(ok ? "체크됨" : "미체크")"></i>
                        <span class="nm"><b>@x.c.Name</b><small>@(string.IsNullOrWhiteSpace(x.c.Teachers) ? "담당 미지정" : x.c.Teachers) · @x.P/@(x.T)명</small></span>
                        <span class="pc"><b class="@(ok ? "" : "z")">@rate%</b><span class="bar"><i style="width:@(rate)%"></i></span></span>
                        <span class="ar" aria-hidden="true">›</span>
                    </a>
                }
            </section>
            <p class="daHint">반 대시보드는 <a href="/@slug/attendance/dashboard?date=@dateStr">반 대시보드 화면</a>에서 반을 골라 열어요</p>
        }
    </main>
</div>
<partial name="_AttTabs" model='(slug, "more", true)' />
<script>
(function () {
    const grid = document.getElementById('grid');
    if (!grid) return;
    const rows = Array.from(grid.querySelectorAll('.cc'));
    const num = (el, k) => Number(el.dataset[k] || 0);
    const btns = Array.from(document.querySelectorAll('.daSeg button'));
    function apply(mode) {
        btns.forEach(b => { const on = b.dataset.m === mode; b.classList.toggle('on', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
        rows.sort((a, b) => {
            const n = a.dataset.name.localeCompare(b.dataset.name, 'ko');
            return mode === 'rate' ? (num(b, 'rate') - num(a, 'rate')) || (num(b, 'total') - num(a, 'total')) || n
                                   : (num(a, 'checked') - num(b, 'checked')) || n;
        }).forEach(c => { c.hidden = mode === 'only' && c.dataset.checked === '1'; grid.appendChild(c); });
    }
    btns.forEach(b => b.addEventListener('click', () => apply(b.dataset.m)));
    apply('todo');
})();
</script>
