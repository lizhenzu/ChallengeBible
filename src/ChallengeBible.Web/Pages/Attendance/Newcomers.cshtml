@page "/{slug}/attendance/newcomers"
@model ChallengeBible.Web.Pages.Attendance.NewcomersModel
@using ChallengeBible.Web.Services
@* 확정 시안 K1 새친구 홈(2026-11-12): 메뉴 3개 · 4주 관리 중(주황) · 4주 관리 완료(초록). 주일 이동 없음 *@
@{
    var slug = Model.Tenant.Current.Slug;
    var h = Model.Home;
    string Short(DateOnly d) => $"{d.Month}/{d.Day}";
}
<main class="att gut"><div class="wrap">
    <div class="hd2"><a class="back" href="/@slug/attendance">← 출석</a><h1>새친구</h1><p>무엇을 할까요?</p></div>
    @if (Model.Ok == "add") { <p class="okmsg" role="status">새친구를 등록했어요 · 첫 방문 출석도 체크했어요</p> }
    @if (Model.Ok == "del") { <p class="okmsg" role="status">새친구를 지웠어요</p> }
    <nav class="menu" aria-label="새친구 메뉴">
        <a class="main" href="/@slug/attendance/newcomers/today"><i aria-hidden="true">✓</i><span><b>오늘 출석 체크</b><small>이번 주일 @h.ThisSunday.ToString("M월 d일")</small></span><em aria-hidden="true">›</em></a>
        <a href="/@slug/attendance/newcomers/past"><i aria-hidden="true">🗓</i><span><b>기존 출석 변경</b><small>지난 주일 출석 고치기</small></span><em aria-hidden="true">›</em></a>
        <a href="/@slug/attendance/newcomers/new"><i aria-hidden="true">＋</i><span><b>새친구 등록</b><small>처음 온 친구 올리기</small></span><em aria-hidden="true">›</em></a>
    </nav>

    <section class="zone z-on" aria-labelledby="zOn">
        <h2 id="zOn">4주 관리 중 <small>@(h.Active.Count)명 · 28일 + 출석 4번이면 끝</small></h2>
        @if (h.Active.Count == 0) { <p class="none">관리 중인 새친구가 없어요.</p> }
        @foreach (var a in h.Active)
        {
            var how = a.Voluntary == false ? (string.IsNullOrEmpty(a.Evangelist) ? "누가 데려옴" : $"{a.Evangelist}이(가) 데려옴") : "스스로 옴";
            <a class="nc-card" href="/@slug/attendance/newcomers/detail?id=@a.PersonId">
                <div class="r1"><b>@a.Name</b>@if (a.PresentThisSunday) { <span class="ok">이번 주일 출석</span> } else { <span class="st">출석 @(a.Visits)/@AttendanceService.CareVisits@(a.PastDays ? " · 28일 지남" : "")</span> }</div>
                <small>@a.ClassName · 첫 방문 @a.FirstVisit.ToString("M월 d일") · @how</small>
                <div class="nc-bar" aria-label="출석 @(a.Visits) / 4">@for (var i = 0; i < AttendanceService.CareVisits; i++) { <i class="@(i < a.Visits ? "on" : "")"></i> }</div>
            </a>
        }
    </section>

    <section class="zone z-done" aria-labelledby="zDone">
        <h2 id="zDone">4주 관리 완료 <small>@(h.Done.Count)명 · 기록은 그대로 남아요</small></h2>
        @if (h.Done.Count == 0) { <p class="none">아직 관리를 마친 새친구가 없어요.</p> }
        @for (var i = 0; i < h.Done.Count; i++)
        {
            var d = h.Done[i];
            <a class="nc-card @(i >= NewcomersModel.DoneShown ? "more hidden" : "")" href="/@slug/attendance/newcomers/detail?id=@d.PersonId">
                <div class="r1"><b>@d.Name</b><span class="st done">완료 @d.DoneOn.ToString("M월 d일")</span></div>
                <small>@d.ClassName · 첫 방문 @d.FirstVisit.ToString("M월 d일") · 출석 @(d.Visits)번</small>
                <div class="ncwk">@foreach (var w in d.Weeks) { <span class="@(w.Present ? "on" : "")"><b>@(w.Present ? "●" : "○")</b>@Short(w.Sunday)</span> }</div>
            </a>
        }
        @if (h.Done.Count > NewcomersModel.DoneShown)
        {
            <button type="button" class="nc-more" id="ncMore">@(h.Done.Count - NewcomersModel.DoneShown)명 더 보기 ▾</button>
        }
    </section>
</div></main>
<partial name="_AttTabs" model='(slug, "n", true)' />
<script>
    document.getElementById('ncMore')?.addEventListener('click', function () {
        document.querySelectorAll('.nc-card.more').forEach(c => c.classList.remove('hidden'));
        this.remove();
    });
</script>
