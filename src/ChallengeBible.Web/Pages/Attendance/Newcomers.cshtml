@page "/{slug}/attendance/newcomers"
@model ChallengeBible.Web.Pages.Attendance.NewcomersModel
@* 확정 시안 B-새친구(ADR 0093 출석 7 · 8, 반 규칙 2): 관리 중인 새친구 · [출석]은 반 출석부와 한 번만 센다 *@
@{
    var slug = Model.Tenant.Current.Slug;
    var isThis = Model.Sunday == Model.ThisSunday;
}
<main class="att gut"><div class="wrap">
    <div class="top">
        <div class="crumb"><span>@Model.Tenant.Current.Name › 출석 › 새친구</span><a href="/@slug">부서 홈으로</a></div>
        <div class="dnav">
            <a href="?D=@Model.Sunday.AddDays(-7).ToString("yyyy-MM-dd")" aria-label="지난 주일">‹</a>
            <h1>@Model.Sunday.ToString("M월 d일") 주일<small class="@(isThis ? "" : "past")">@(isThis ? "이번 주일" : "지난 주일 · 고치는 중")</small></h1>
            @if (isThis) { <span class="off" aria-hidden="true">›</span> } else { <a href="?D=@Model.Sunday.AddDays(7).ToString("yyyy-MM-dd")" aria-label="다음 주일">›</a> }
        </div>
        @if (Model.Ok == "add") { <p class="okmsg" role="status">새친구를 등록했어요 · 첫 방문 출석도 체크했어요</p> }
        <p class="help">관리 중인 새친구예요. [출석]을 누르면 반 출석부에도 함께 체크돼요(한 번만 세요). 첫 방문 뒤 28일이 지나고 출석 4번이 되면 이 목록에서 빠지고 담임만 체크해요.</p>
    </div>
    @Html.AntiForgeryToken()
    <div class="pp-add"><a class="btn p sm" href="/@slug/attendance/newcomers/new">+ 새친구 등록</a></div>
    @if (Model.Rows.Count == 0) { <p class="none">관리 중인 새친구가 없어요.</p> }
    else
    {
        <ul class="ncl" id="board" data-slug="@slug" data-sunday="@Model.Sunday.ToString("yyyy-MM-dd")">
            @foreach (var r in Model.Rows)
            {
                var how = r.Voluntary == false ? (string.IsNullOrEmpty(r.Evangelist) ? "누가 데려옴" : $"{r.Evangelist}이(가) 데려옴") : "스스로 옴";
                <li class="@(r.PresentToday ? "on" : "")" data-id="@r.PersonId" data-name="@r.Name" data-p="@(r.PresentToday ? "1" : "0")">
                    <span class="w2"><b>@r.Name</b><small>@r.ClassName · 첫 방문 @r.FirstVisit.ToString("M월 d일") · @how@(r.PastDays ? " · 28일 지남" : "")</small></span>
                    <span class="st">출석 @(r.Visits)/@ChallengeBible.Web.Services.AttendanceService.CareVisits</span>
                    <button type="button" class="ck" aria-label="@r.Name 출석">@(r.PresentToday ? "✓ 출석" : "출석")</button>
                </li>
            }
        </ul>
        <p class="foot">생일 · 연락처는 부서 관리자 · 교사가 명부에서 고쳐요</p>
    }
    <div class="toast hidden" id="toast" role="alert"></div>
</div></main>
<partial name="_AttTabs" model='(slug, "n", true)' />
<script src="~/js/attendance.js" asp-append-version="true"></script>
