@page "/{slug}/attendance/matrix"
@model ChallengeBible.Web.Pages.Attendance.MatrixModel
@using System.Globalization
@* 유년부 출석부 "아이별 주별 출석표(52주)"(Views/Attendance/AdminStudentMatrixWeeks)와 같은 모양. 이름은 왼쪽 고정 · 옆으로 밀어 지난 주일 *@
@{
    var slug = Model.Tenant.Current.Slug;
    var m = Model.M;
    var sundays = m.Sundays;
    int weeks = sundays.Count;
    var end = m.Rep.Sunday;
    string Key(DateOnly d) => d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var kidsAll = m.Rep.Classes.SelectMany((c, ci) => c.Kids.Select(k => (k, c, ci))).ToList();
    var rows = kidsAll.Select(x => new { x.k, x.c, x.ci, P = sundays.Count(s => m.Present.Contains((x.k.PersonId, s))) }).ToList();
    var weekTotals = sundays.Select(s => kidsAll.Count(x => m.Present.Contains((x.k.PersonId, s)))).ToList();
    int maxWeek = Math.Max(1, weekTotals.DefaultIfEmpty(0).Max());
    int kids = rows.Count;
    int Pct(int p) => (int)Math.Round(p * 100.0 / weeks);
    int avg = kids == 0 ? 0 : (int)Math.Round(rows.Average(x => x.P) * 100.0 / weeks);
    int perfect = rows.Count(x => x.P >= weeks);
    var groups = m.Rep.Classes.Select(c => c.Group).Distinct().ToList();
    var months = new List<(int Col, int Span, string Label)>();
    for (int i = 0; i < weeks; i++)
    {
        if (i == 0 || sundays[i].Month != sundays[i - 1].Month)
        {
            int span = 1;
            while (i + span < weeks && sundays[i + span].Month == sundays[i].Month) span++;
            months.Add((i + 1, span, $"{sundays[i].Month}월"));
        }
    }
    bool MonthStart(int i) => i > 0 && sundays[i].Month != sundays[i - 1].Month;
    string Url(int w) => $"/{slug}/attendance/matrix?date={Key(end)}&weeks={w}";
}
<div class="yb ybt ybc ybk ybm" style="--wk:@weeks">
    <header class="sh">
        <div class="hdTop"><a href="/@slug/attendance/more">더보기</a><a href="/@slug">부서 홈으로</a></div>
        <div class="hdK">RECORD · @end.Year</div>
        <h1 class="hdT">아이별 주별 출석표(52주)</h1>
        <div class="mxDn">
            <span>@sundays[0].ToString("M.d") ~ @end.ToString("M.d") · @(weeks)주</span>
            <span>·</span>
            <a href="@Url(4)" class="@(weeks == 4 ? "on" : "")">최근 4주</a>
            <a href="@Url(13)" class="@(weeks == 13 ? "on" : "")">13주</a>
            <a href="@Url(26)" class="@(weeks == 26 ? "on" : "")">26주</a>
            <a href="@Url(52)" class="@(weeks == 52 ? "on" : "")">52주</a>
        </div>
        <div class="st2">
            <div>아이<b>@kids</b></div>
            <div>평균 출석률<b>@(avg)%</b></div>
            <div class="k">개근<b>@perfect</b></div>
        </div>
    </header>

    <div class="sh">
        <div class="wkChart">
            <div class="t"><span>주일별 출석 수</span><span>가장 많은 주 @(maxWeek)명</span></div>
            <div class="mxGrid bars">
                @for (int i = 0; i < weeks; i++)
                {
                    var h = (int)Math.Round(weekTotals[i] * 60.0 / maxWeek);
                    <a href="/@slug/attendance/report?sunday=@Key(sundays[i])" class="js-roster @(i == weeks - 1 ? "now" : "")" data-mobile="/@slug/attendance/sunday?sunday=@Key(sundays[i])"
                       style="height:@(h)px" title="@sundays[i].ToString("M/d", CultureInfo.InvariantCulture) · @(weekTotals[i])명 출석"></a>
                }
            </div>
            <div class="mxGrid mxMo">
                @foreach (var mo in months) { <span style="grid-column:@mo.Col / span @mo.Span">@mo.Label</span> }
            </div>
        </div>
    </div>

    <div class="mxTools">
        <div class="sh">
            @if (groups.Count > 1)
            {
                <div class="tRow">
                    <div class="rkChips" aria-label="학년">
                        <button type="button" data-g="" class="on">전체</button>
                        @foreach (var g in groups) { <button type="button" data-g="@g">@g</button> }
                    </div>
                </div>
            }
            <div class="tRow">
                <input class="srch" id="q" type="search" placeholder="이름 찾기" aria-label="이름 찾기" />
                <div class="mxSeg" aria-label="정렬">
                    <button type="button" data-s="class" class="on">반</button>
                    <button type="button" data-s="name">이름</button>
                    <button type="button" data-s="rate">출석률</button>
                </div>
            </div>
        </div>
    </div>

    <main class="shW">
        <div class="hint">
            <span>← 밀면 지난 주일 · 날짜 누르면 명단</span>
            <span class="lg"><i class="p"></i>출석<i></i>결석<i class="x3"></i>연속 결석</span>
        </div>
        <div class="mxW" id="mxW">
            <table class="mxT">
                <thead>
                    <tr class="r1">
                        <th class="nm" rowspan="3">이름 · 출석률</th>
                        @foreach (var mo in months) { <th class="mh @(mo.Col > 1 ? "m1" : "")" colspan="@mo.Span">@mo.Label</th> }
                    </tr>
                    <tr class="r2">
                        @for (int i = 0; i < weeks; i++)
                        {
                            <th class="dh @(MonthStart(i) ? "m1" : "") @(i == weeks - 1 ? "now" : "")"><a href="/@slug/attendance/report?sunday=@Key(sundays[i])" class="js-roster" data-mobile="/@slug/attendance/sunday?sunday=@Key(sundays[i])" title="@sundays[i].ToString("M월 d일") 명단">@sundays[i].ToString("M/d", CultureInfo.InvariantCulture)</a></th>
                        }
                    </tr>
                    <tr class="r3">
                        @for (int i = 0; i < weeks; i++) { <th class="tn @(MonthStart(i) ? "m1" : "") @(i == weeks - 1 ? "now" : "")">@(weekTotals[i])명</th> }
                    </tr>
                </thead>
                <tbody id="list">
                    @foreach (var x in rows)
                    {
                        int pct = Pct(x.P);
                        int tail = 0; for (int i = weeks - 1; i >= 0 && !m.Present.Contains((x.k.PersonId, sundays[i])); i--) tail++;
                        <tr class="@(pct < 50 ? "lo" : "")" data-g="@x.c.Group" data-class="@x.ci" data-name="@x.k.Name" data-rate="@pct">
                            <td class="nm" title="@x.k.Name · @x.c.Name · @x.P/@weeks"><b>@x.k.Name</b><small>@x.c.Name · <em>@(pct)%</em></small></td>
                            @for (int i = 0; i < weeks; i++)
                            {
                                bool ok = m.Present.Contains((x.k.PersonId, sundays[i]));
                                bool x3 = !ok && tail >= 3 && i >= weeks - tail;
                                <td class="c @(MonthStart(i) ? "m1" : "") @(i == weeks - 1 ? "now" : "")"><i class="@(ok ? "p" : "") @(x3 ? "x3" : "")" title="@sundays[i].ToString("M/d", CultureInfo.InvariantCulture) @(ok ? "출석" : "결석")"></i></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="none hidden" id="noHit">찾는 아이가 없어요.</div>
        <div class="ft"><span>칸 하나 = 주일 하나 · 맨 오른쪽(색칠된 줄)이 가장 최근 주일</span></div>
    </main>
</div>
<partial name="_AttTabs" model='(slug, "more", true)' />
<script>
(function () {
    let grade = '', sort = 'class', dir = 1, q = '';
    const list = document.getElementById('list');
    const cmp = (a, b) => {
        const n = (x, k) => parseInt(x.dataset[k] || '0', 10), s = (x) => x.dataset.name || '';
        if (sort === 'name') return s(a).localeCompare(s(b), 'ko') * dir || n(a, 'class') - n(b, 'class');
        if (sort === 'rate') return (n(a, 'rate') - n(b, 'rate')) * dir || s(a).localeCompare(s(b), 'ko');
        return (n(a, 'class') - n(b, 'class')) * dir || s(a).localeCompare(s(b), 'ko');
    };
    function apply() {
        let hits = 0;
        Array.from(list.children).sort(cmp).forEach(el => {
            const show = (grade === '' || el.dataset.g === grade) && (!q || (el.dataset.name || '').includes(q));
            el.classList.toggle('hidden', !show);
            if (show) hits++;
            list.appendChild(el);
        });
        document.getElementById('noHit').classList.toggle('hidden', hits > 0);
    }
    document.querySelectorAll('.rkChips button').forEach(b => b.addEventListener('click', () => {
        grade = b.dataset.g; document.querySelectorAll('.rkChips button').forEach(x => x.classList.toggle('on', x === b)); apply();
    }));
    document.querySelectorAll('[data-s]').forEach(b => b.addEventListener('click', () => {
        if (sort === b.dataset.s) dir = -dir; else { sort = b.dataset.s; dir = sort === 'rate' ? -1 : 1; }
        document.querySelectorAll('[data-s]').forEach(x => { x.classList.toggle('on', x === b); x.textContent = x.textContent.replace(/ [▲▼]$/, ''); });
        b.textContent += dir === 1 ? ' ▲' : ' ▼';
        apply();
    }));
    document.getElementById('q').addEventListener('input', e => { q = e.target.value.trim(); apply(); });
    if (window.matchMedia('(max-width: 759px)').matches)
        document.querySelectorAll('.js-roster').forEach(a => { a.href = a.dataset.mobile; });
    apply();
    const w = document.getElementById('mxW'); w.scrollLeft = w.scrollWidth;
})();
</script>
