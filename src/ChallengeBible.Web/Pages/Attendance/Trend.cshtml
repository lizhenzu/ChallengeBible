@page "/{slug}/attendance/trend"
@model ChallengeBible.Web.Pages.Attendance.TrendModel
@using ChallengeBible.Web.Pages.Attendance
@using System.Globalization
@* 유년부 출석부 "최근 전체 출석현황(3주)"(Views/Attendance/AdminTrend3Weeks)과 같은 모양 *@
@{
    var slug = Model.Tenant.Current.Slug;
    var asc = Model.Weeks;
    var desc = asc.AsEnumerable().Reverse().ToList();
    var now = desc[0];
    var sunday = now.Sunday;
    bool atLatest = sunday >= now.ThisSunday;
    string Self(DateOnly d) => $"/{slug}/attendance/trend?date={d:yyyy-MM-dd}";
    const double LowRate = 70;
    var ko = new CultureInfo("ko-KR");
    var (nt, np) = TrendModel.Count(now);
    var nr = TrendModel.Rate(np, nt);
    var (pt, pp) = TrendModel.Count(desc[1]);
    var diff = nr - TrendModel.Rate(pp, pt);
    string Label(int i) => i == 0 ? "이번 주" : i == 1 ? "지난주" : $"{i}주 전";
}
@* 위쪽은 확정 시안 A(사용자 2026-11-13, R-266): 주일 3칸(오늘 화면과 같음) · 파란 요약 카드 · 3주 막대 *@
@{ var prevD = sunday.AddDays(-7); var nextD = sunday.AddDays(7); var nextOk = nextD <= now.ThisSunday; var inv = CultureInfo.InvariantCulture; }
<div class="yb ybt ybda">
    <header class="sh">
        <div class="hdTop"><a href="/@slug/attendance/more">더보기</a><a href="/@slug">부서 홈으로</a></div>
        <h1 class="daT">최근 전체 출석현황</h1>
        <p class="daSub">주일 4번 출석률 · 지난주와 비교</p>
        <div class="daWk">
            <div class="h"><b>@sunday.ToString("M월 d일") 주일</b><span class="@(atLatest ? "now" : "")">@(atLatest ? "이번 주일" : "지난 주일")</span></div>
            <nav class="strip" aria-label="주일 이동">
                <a class="c" href="@Self(prevD)"><b>@($"{prevD.Month}/{prevD.Day}")</b><small>전주</small></a>
                <span class="c on" aria-current="date"><b>@($"{sunday.Month}/{sunday.Day}")</b><small>@(atLatest ? "이번 주일" : "보는 주")</small></span>
                @if (nextOk) { <a class="c" href="@Self(nextD)"><b>@($"{nextD.Month}/{nextD.Day}")</b><small>@(nextD == now.ThisSunday ? "차주 · 이번 주일" : "차주")</small></a> }
                else { <span class="c no" aria-disabled="true"><b>@($"{nextD.Month}/{nextD.Day}")</b><small>차주 · 아직</small></span> }
            </nav>
        </div>
        <section class="trSum" aria-label="이 주일 요약">
            <div class="top">
                <div><div class="trBig">@TrendModel.Pct(nr)<small>%</small></div><div class="trK">@(atLatest ? "이번 주" : "보는 주") 출석률</div></div>
                <span class="delta @(diff < 0 ? "dn" : diff == 0 ? "eq" : "")">@(diff > 0 ? "▲" : diff == 0 ? "―" : "▼") @(diff == 0 ? "지난주와 같아요" : $"{TrendModel.Pct(Math.Abs(diff))}%p 지난주보다")</span>
            </div>
            <div class="bar"><i style="width:@(Math.Clamp(nr, 0, 100).ToString(inv))%"></i></div>
            <div class="nums"><div><b>@nt</b>총원</div><div><b>@np</b>출석</div><div class="x"><b>@(nt - np)</b>결석</div></div>
        </section>
    </header>

    <main class="sh">
        <section class="trChart" role="img" aria-label="최근 4주 출석률 막대그래프">
            <h3>4주 출석률 <span>@(LowRate)% 미만은 빨강</span></h3>
            <div class="trCols">
                @for (int i = 0; i < asc.Count; i++)
                {
                    var (t, p) = TrendModel.Count(asc[i]);
                    var r = TrendModel.Rate(p, t);
                    bool isNow = i == asc.Count - 1;
                    <div class="trCl @(isNow ? "now" : "") @(r < LowRate ? "lo" : "")">
                        <em>@TrendModel.Pct(r)%</em>
                        <div class="trBar"><i style="height:@(Math.Clamp(r, 0, 100).ToString(inv))%"></i></div>
                        <small>@($"{asc[i].Sunday.Month}/{asc[i].Sunday.Day}")@if (isNow) { <br /><b>@(atLatest ? "이번 주" : "보는 주")</b> }</small>
                    </div>
                }
            </div>
        </section>

        <section class="sec">
            <div class="secH"><div><div class="secK">BY WEEK</div><div class="secT">주별 자세히</div></div><span class="secN">@(LowRate)% 미만은 빨간 막대</span></div>
            <div class="wk2">
                @for (int i = 0; i < desc.Count; i++)
                {
                    var w = desc[i];
                    var (t, p) = TrendModel.Count(w);
                    var r = TrendModel.Rate(p, t);
                    var sp = w.Sunday.ToString("yyyy-MM-dd");
                    @* 확정 시안(2026-11-13): 주마다 카드 하나. 반별 출석과 명단을 합쳐(R-269) 누르면 그 주일 반별 명단, 아래는 PC 보고서 한 줄 *@
                    <article class="w o@(desc.Count - i) @(i == 0 ? "now" : "") @(r < LowRate ? "lo" : "")">
                        <a class="main" href="/@slug/attendance/sunday?sunday=@sp">
                            <div class="top"><span class="chip">@Label(i)</span><b class="d">@w.Sunday.ToString("M월 d일 (ddd)", ko)</b><span class="p">@TrendModel.Pct(r)<small>%</small></span></div>
                            <div class="bar"><i style="width:@(Math.Clamp(r, 0, 100).ToString(CultureInfo.InvariantCulture))%"></i></div>
                            <div class="m"><span>총 @t</span><span class="a">출석 @p</span><span class="x">결석 @(t - p)</span><em>반별 명단 ›</em></div>
                        </a>
                        <div class="sub one"><a href="/@slug/attendance/report?sunday=@sp">주일 출결 보고서 (PC)</a></div>
                    </article>
                }
            </div>
        </section>
        <section class="sec">
            <div class="secH"><div><div class="secK">MORE</div><div class="secT">더 보기</div></div></div>
            <a class="mo" href="/@slug/attendance/rank?date=@sunday.ToString("yyyy-MM-dd")"><span class="moTx"><span class="moL">아이별 출석 등수</span><span class="moD">올해 누적</span></span><span class="moA" aria-hidden="true">→</span></a>
            <a class="mo" href="/@slug/attendance/matrix?date=@sunday.ToString("yyyy-MM-dd")"><span class="moTx"><span class="moL">아이별 주별 출석표</span><span class="moD">아이 × 주일 · 1월 ~ 이번 달</span></span><span class="moA" aria-hidden="true">→</span></a>
        </section>
        <div class="ft"><span>총원은 지금 반 편성 기준 · 출석률 = 출석 ÷ 총원</span></div>
    </main>
</div>
<partial name="_AttTabs" model='(slug, "more", true)' />
