@page "/{slug}/weekly-word"
@model ChallengeBible.Web.Pages.WeeklyWord.IndexModel
@{
    var slug = Model.Tenant.Current.Slug;
    var it = Model.Item;
    var ko = new System.Globalization.CultureInfo("ko-KR");
    ViewData["PbHomeL"] = true; ViewData["PbHomeHref"] = $"/{slug}/welcome"; ViewData["PbHomeLabel"] = "메인"; ViewData["PbTitle"] = "이번 주 말씀";
}
@* 이번 주 말씀 보기(ADR 0142, 2026-11-27 사용자): 부서가 직접 입력한 주일 날짜 · 제목 · 설교 내용. 7일이 지나면 준비중 *@
<partial name="_Top" />
<main class="gut w760"><div class="wrap" style="padding-block:20px 48px">
    @if (it is null)
    {
        <p style="text-align:center;padding:48px 0;color:var(--dim)">이번 주 말씀은 준비중이에요.</p>
    }
    else
    {
        <span style="display:inline-block;background:var(--accent);color:var(--on-accent,#fff);border-radius:99px;padding:2px 12px;font-size:12px;font-weight:800">@it.SundayDate.ToString("M월 d일", ko) 주일 설교</span>
        <h1 style="margin:12px 0 0;font-size:26px;line-height:1.3;letter-spacing:-.03em">@it.Title</h1>
        <div style="margin-top:16px;font-size:16px;line-height:1.85;white-space:pre-line;overflow-wrap:anywhere">@it.Body</div>
    }
</div></main>
