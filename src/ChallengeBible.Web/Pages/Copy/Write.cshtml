@page "/{slug}/copy/write/{book:int}/{chapter:int}"
@model ChallengeBible.Web.Pages.Copy.WriteModel
@* 확정 시안 성경필사 ②(2026-11-16): 번역 고르기 → 절 칸 → 본문(맞은 글자 초록 · 틀린 글자 빨강 · 남은 글자 회색) → 따라 치는 칸 → 앞 절 · 다음 절. 다 맞게 치면 저절로 저장 · 다음 절(R-305 · R-306) *@
@{
    var d = Model.Data!;
    var unit = d.BookId == 19 ? "편" : "장";
}
<link rel="stylesheet" href="~/css/copy.css" asp-append-version="true" />
<div class="bc">
@{ var bcTop = ((ChallengeBible.Web.Pages.Copy.CopyPageBase)Model, Model.Title, $"/{Model.Slug}/copy", $"{d.Done.Count} / {d.Lines.Count}절"); }
<partial name="_CopyTop" model="bcTop" />
<main class="bc-main gut"><div class="wrap" data-bc-write data-save="/@Model.Slug/copy/write/@d.BookId/@d.Chapter?handler=Save">
    @Html.AntiForgeryToken()
    <script type="application/json" data-bc-data>@Html.Raw(Model.Json)</script>
    <div class="bc-chips" role="group" aria-label="번역" data-bc-tr></div>
    <div class="bc-dots" role="group" aria-label="절 고르기" data-bc-dots></div>
    <div class="bc-card"><p class="bc-verse" data-bc-verse aria-live="polite"></p></div>
    <textarea class="bc-ta" data-bc-input rows="4" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="본문을 따라 써요"></textarea>
    <p class="bc-hint">띄어쓰기 · 문장 부호는 틀려도 괜찮아요. <b>빨간 글자</b>만 고치면 돼요. 다 맞게 치면 저절로 다음 절로 넘어가요.</p>
    <p class="bc-err" data-bc-err hidden></p>
    <div class="bc-btns"><button type="button" class="bc-btn" data-bc-prev>← 앞 절</button><button type="button" class="bc-btn" data-bc-next disabled>다음 절</button></div>
    <div class="bc-done" data-bc-done hidden><b></b><p></p></div>
    <div class="bc-btns" style="grid-template-columns:minmax(0,1fr) minmax(0,1fr)">
        @if (Model.Prev is { } pv) { <a class="bc-btn" href="@Model.WriteUrl(pv.Book, pv.Chapter)">← @ChallengeBible.Infrastructure.Data.BibleBooks.NameOf(pv.Book) @(pv.Chapter)@(pv.Book == 19 ? "편" : "장")</a> } else { <span></span> }
        @if (Model.Next is { } nx) { <a class="bc-btn" href="@Model.WriteUrl(nx.Book, nx.Chapter)" data-bc-nextch>@ChallengeBible.Infrastructure.Data.BibleBooks.NameOf(nx.Book) @(nx.Chapter)@(nx.Book == 19 ? "편" : "장") →</a> }
    </div>
    <a class="bc-btn" href="/@Model.Slug/copy/books?b=@d.BookId#b@(d.BookId)">장 고르기</a>
</div></main>
</div>
<script src="~/js/copy.js" asp-append-version="true" defer></script>
