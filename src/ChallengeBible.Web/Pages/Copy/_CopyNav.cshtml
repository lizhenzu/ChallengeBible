@model (ChallengeBible.Web.Pages.Copy.CopyPageBase Page, string Key, string Title, string? Right)
@* 성경필사 공통 틀(확정 시안 필사-통독틀, ADR 0105): 성경통독(_ReadingNav)과 같은 모양 — 넓은 화면 = 왼쪽 고정 목차 / 좁은 화면 = ☰ 서랍. 색은 필사 테마(data-theme="copy") *@
@{
    var p = Model.Page;
    var s = p.Slug;
    string On(string key) => Model.Key == key ? "on" : "";
    (string Href, string Label, string Key)[] menu =
    [
        ($"/{s}/copy", "대시보드", "home"),
        ($"/{s}/copy/books?t=ot", "구약 쓰기", "ot"),
        ($"/{s}/copy/books?t=nt", "신약 쓰기", "nt"),
        ($"/{s}/copy/participants", "참여자 현황", "participants"),
    ];
    if (p.Tenant.IsLobby) menu = menu.Where(m => m.Key != "participants").ToArray();   // 임시 부서는 참여자 현황 없음(0064)
    var resume = p.Resume;
}
<script>document.currentScript.closest('.rp').dataset.theme = 'copy';</script>
<div class="b2ov" data-b2close hidden></div>
<nav class="b2dr" id="b2dr" aria-label="성경 필사 메뉴">
    <div class="b2dr-hd"><a href="/@s/copy">도전!!!성경필사</a><button type="button" class="b2dr-x" data-b2close aria-label="메뉴 닫기">✕</button></div>
    <div class="b2lbl">목차</div>
    @foreach (var (href, label, key) in menu)
    {
        <a href="@href" class="b2it @On(key)" aria-current="@(Model.Key == key ? "page" : "false")">@label</a>
    }
    <div class="b2lbl">빠른 이동</div>
    <div class="b2q">
        @if (resume is { } r) { <a href="@p.WriteUrl(r.BookId, r.Chapter, r.Verse)">이어 쓰기<small>@r.Name @(r.Chapter)@(r.BookId == 19 ? "편" : "장")</small></a> }
        <a href="@p.WriteUrl(1, 1)">창세기<small>1장</small></a>
        <a href="@p.WriteUrl(40, 1)">마태복음<small>1장</small></a>
        <a href="@p.WriteUrl(19, 23)">시편<small>23편</small></a>
        @if (resume is null) { <a href="@p.WriteUrl(43, 3)">요한복음<small>3장</small></a> }
    </div>
    <div class="b2ft"><a href="/@s">← 부서 홈으로</a></div>
</nav>
@if (!string.IsNullOrEmpty(Model.Title)) { <header class="b2top"><button type="button" class="b2hb" data-b2open aria-label="메뉴 열기" aria-controls="b2dr">☰</button><b>@Model.Title</b>@if (Model.Right is { } rt) { <span class="b2r-right">@rt</span> }</header> }
<script>
    // ☰ 서랍 열기 · 닫기(좁은 화면) — 성경통독과 같다
    (() => {
        const dr = document.getElementById('b2dr'), ov = document.querySelector('.b2ov');
        const set = (open) => { dr.classList.toggle('open', open); ov.hidden = !open; };
        document.addEventListener('click', (e) => {
            if (e.target.closest('[data-b2open]')) set(true);
            else if (e.target.closest('[data-b2close]')) set(false);
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    })();
</script>
