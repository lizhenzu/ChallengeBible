@model (ChallengeBible.Web.Pages.Copy.CopyPageBase Page, string Key, string Title, string? Right)
@* 성경필사 공통 틀(확정 시안 필사-통독틀, ADR 0105): 성경통독(_ReadingNav)과 같은 모양 — 넓은 화면 = 왼쪽 고정 목차 / 좁은 화면 = ☰ 서랍. 색은 필사 테마(data-theme="copy") *@
@{
    var p = Model.Page;
    var s = p.Slug;
    string On(string key) => Model.Key == key ? "on" : "";
    (string Href, string Label, string Icon, string Key)[] menu =
    [
        ($"/{s}/copy", "대시보드", "platform", "home"),
        ($"/{s}/copy/books?t=ot", "구약 쓰기", "copy", "ot"),
        ($"/{s}/copy/books?t=nt", "신약 쓰기", "copynt", "nt"),
        ($"/{s}/copy/participants", "참여자 현황", "people", "participants"),
    ];
    if (p.Tenant.IsLobby) menu = menu.Where(m => m.Key != "participants").ToArray();   // 임시 부서는 참여자 현황 없음(0064)
}
<script>document.currentScript.closest('.rp').dataset.theme = 'copy';</script>
@{ var b2m = new ChallengeBible.Web.Pages.B2DrawerModel(p.Tenant, "성경필사", $"/{s}", Model.Key, menu, null, null); }
<partial name="_B2Drawer" model="b2m" />
@if (!string.IsNullOrEmpty(Model.Title))
{
    var vd = new ViewDataDictionary(ViewData) { ["PbDrawer"] = "b2", ["PbTitle"] = Model.Key == "home" ? "성경필사" : Model.Title };
    if (Model.Key != "home") { vd["PbParent"] = new[] { "성경필사", $"/{s}/copy" }; vd["PbButton"] = new[] { "필사홈", $"/{s}/copy" }; }
<partial name="_Top" view-data="vd" />
}
<script>
    // ☰ 서랍 열기 · 닫기(좁은 화면) — 성경통독과 같다
    (() => {
        const dr = document.getElementById('b2dr'), ov = document.querySelector('.b2ov');
        const set = (open) => { dr.classList.toggle('open', open); ov.hidden = !open; };
        document.addEventListener('click', (e) => {
            if (e.target.closest('[data-b2open]')) set(true);
            else if (e.target.closest('[data-b2close]')) set(false);
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    })();
</script>
