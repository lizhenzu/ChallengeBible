@page "/{slug}/reading/list"
@model ChallengeBible.Web.Pages.Reading.ListModel
@using ChallengeBible.Web.Pages.Reading
@using ChallengeBible.Web.Services
@using ChallengeBible.Infrastructure.Data
@* 확정 시안: 「구약 읽기 (책 펼침)」 360px(2026-11-28). 신약은 같은 화면에서 데이터와 색만 다르다. 값은 reading-home.css 의 .rl-* · .rh-*.
   구약 · 신약 탭 → 요약 카드(링) → 책 4열 → 누른 책이 있는 줄 바로 아래에 가로 전체 패널(이어 읽기 · 장 6열 · 범례 · 이미 읽은 장 표시하기).
   「이미 읽은 장 표시하기」는 기존 다 읽음 표시(?mode=mark, R-151): 장 칸을 눌러 바로 완료 · 해제 *@
@{
    var d = Model.Data;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    ViewData["PbClass"] = "rhtop";
    ViewData["FontsLite"] = true;   // Noto Sans KR 400 / 500 / 700 만 불러온다(디자인 기준표)
    var ot = Model.T == "ot";
    var read = ot ? d.OtRead : d.NtRead;
    var total = ot ? ReadingSummary.OtTotal : ReadingSummary.NtTotal;
    var pct = ReadingSummary.Percent(read, total);
    var ringToken = ot ? "--rh-ot" : "--rh-nt";
    var label = ot ? "구약" : "신약";
    var r = d.Resume;
    var books = d.Books.Where(x => ReadingPageBase.TestamentOf(x.BookId) == Model.T).ToList();
    // 펼친 책의 패널은 그 책이 있는 줄(4칸) 끝 바로 뒤에 끼운다. 이후 책들은 패널 아래로 이어진다
    var selIdx = books.FindIndex(x => x.BookId == Model.B);
    var panelAfter = selIdx < 0 ? -1 : Math.Min(books.Count - 1, selIdx - selIdx % 4 + 3);
}
<link rel="stylesheet" href="~/css/reading.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/reading-b2.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/reading-home.css" asp-append-version="true" />
<div class="rp b2 rhp">
@await Html.PartialAsync("_ReadingNav", new ReadingNav(Model, Model.T, ot ? "구약 읽기" : "신약 읽기"))
<div class="b2main"><main class="rh rl" data-reading-list>
    <section class="rh-top">
        @await Html.PartialAsync("_RhTabs", (ot, Model.ListUrl("ot"), Model.ListUrl("nt")))

        <div class="rh-card rl-sum">
            @await Html.PartialAsync("_RhRing", (label, ringToken, read, pct))
            <div>
                <div class="rl-k">@label 전체</div>
                <div class="rl-n"><span>@read</span><span>장 읽음</span></div>
                <div class="rl-t">@(total.ToString("N0", inv))장 중 · @(ot ? 39 : 27)권</div>
            </div>
        </div>

        <div class="rh-books">
            @for (var i = 0; i < books.Count; i++)
            {
                var b = books[i];
                var open = Model.B == b.BookId;
                <a id="b@(b.BookId)" class="@(open ? "sel" : b.Done ? "dn" : b.Read > 0 ? "ing" : "")" href="@(open ? Model.ListUrl(Model.T) : Model.ListUrl(Model.T, b.BookId, Model.MarkMode))" aria-expanded="@(open ? "true" : "false")" title="@b.Name @b.Read/@b.Total"><div class="n">@b.Name</div><div class="c">@b.Read/@b.Total@(b.Done ? " ✓" : "")</div></a>
                if (i == panelAfter)
                {
                    var sb = books[selIdx];
                    var done = Model.DoneOf(sb.BookId);
                    var here = r.BookId == sb.BookId ? r.Chapter : (short)0;
                    var go = here > 0 ? here : (short)Math.Max(1, Enumerable.Range(1, sb.Total).FirstOrDefault(c => !done.Contains((short)c)));
                    var bp = sb.Total == 0 ? 0 : done.Count * 100 / sb.Total;
                    <div class="rl-panel" data-book="@sb.BookId">
                        <div class="rl-ph"><span class="rl-pn">@sb.Name</span><span data-panel-count>@done.Count / @(sb.Total)장 · @(bp)%</span></div>
                        <div class="rl-bar"><div data-panel-bar style="width:@(bp)%"></div></div>
                        <a class="rl-go" href="@Model.ReadUrl(sb.BookId, go)">@(done.Count == 0 ? "읽기 시작" : "이어 읽기") @(go)@(sb.BookId == 19 ? "편" : "장") <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16M13 5l7 7-7 7"></path></svg></a>
                        <div class="rl-hint">@(Model.MarkMode ? "장을 누르면 다 읽음으로 표시하거나 취소해요. 종이 성경으로 읽었을 때 써요." : "다른 장을 읽으려면 숫자를 누르세요.")</div>
                        <div class="rl-chs">
                            @for (short c = 1; c <= sb.Total; c++)
                            {
                                var cls = (done.Contains(c) ? "done" : "") + (c == go ? " here" : "");
                                if (Model.MarkMode)
                                {
                                    <button type="button" class="ch @cls" data-ch="@c" aria-pressed="@(done.Contains(c) ? "true" : "false")" aria-label="@(c)장 다 읽음">@c</button>
                                }
                                else
                                {
                                    <a class="ch @cls" href="@Model.ReadUrl(sb.BookId, c)" aria-label="@(c)장 읽기">@c</a>
                                }
                            }
                        </div>
                        <div class="rh-lgn"><span><i class="on"></i>읽음</span><span><i class="cur"></i>보던 곳</span><span><i class="todo"></i>아직</span></div>
                        <a class="rl-mark" href="@Model.ListUrl(Model.T, sb.BookId, !Model.MarkMode)" aria-pressed="@(Model.MarkMode ? "true" : "false")"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>@(Model.MarkMode ? "표시 끝내기" : "이미 읽은 장 표시하기")</a>
                    </div>
                }
            }
        </div>
    </section>
</main></div>
</div>
@Html.AntiForgeryToken()
<p id="toast" class="toast" role="status" hidden></p>
<script src="~/js/reading.js" asp-append-version="true"></script>
