@page "/{slug}/reading/list"
@model ChallengeBible.Web.Pages.Reading.ListModel
@using ChallengeBible.Web.Pages.Reading
@using ChallengeBible.Web.Services
@using ChallengeBible.Infrastructure.Data
@* 확정 시안: 통독-옛Bible2-나머지화면 "목록"(0071) — 옛 Bible2 List 배치: 구약 · 신약 탭 → 전체 % → 책 칸 한 판 → 누른 책 아래 장 번호 칸(다 읽음 · 보던 곳 · 아직)
   "읽으러 가기"면 장을 누르면 본문으로, "다 읽음 표시"면 눌러 바로 완료 · 해제(R-151, 종이 성경으로 읽은 사람) *@
@{
    var d = Model.Data;
    var ko = ReadingPageBase.Ko;
    var ot = Model.T == "ot";
    var read = ot ? d.OtRead : d.NtRead;
    var total = ot ? ReadingSummary.OtTotal : ReadingSummary.NtTotal;
    var pct = ReadingSummary.Percent(read, total);
    var r = d.Resume;
}
<link rel="stylesheet" href="~/css/reading.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/reading-b2.css" asp-append-version="true" />
<div class="rp b2">
@await Html.PartialAsync("_ReadingNav", new ReadingNav(Model, Model.T, ot ? "구약 읽기" : "신약 읽기"))
<div class="b2main"><main class="b2b" data-reading-list>
    <nav class="seg" aria-label="구약 · 신약">
        <a href="@Model.ListUrl("ot")" aria-current="@(ot ? "true" : "false")">구약</a>
        <a href="@Model.ListUrl("nt")" aria-current="@(!ot ? "true" : "false")">신약</a>
    </nav>
    <div class="lsum">
        <div><div class="k" style="margin:0">@(ot ? "구약" : "신약") 전체</div><div class="big num">@(pct.ToString("0.0"))<small>%</small></div></div>
        <div class="r num">@(read)장 읽음<br />@(total.ToString("N0"))장 중 · @(ot ? 39 : 27)권</div>
    </div>
    <div class="pg all"><i style="width:@(pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></i></div>

            <div class="books lbooks">
                @foreach (var b in d.Books.Where(x => ReadingPageBase.TestamentOf(x.BookId) == Model.T))
                {
                    var open = Model.B == b.BookId;
                    <a id="b@(b.BookId)" class="@(open ? "sel" : "")@(b.Done ? " dn" : "")" href="@(open ? Model.ListUrl(Model.T) : Model.ListUrl(Model.T, b.BookId, Model.MarkMode))" aria-expanded="@(open ? "true" : "false")">
                        @b.Name<small class="num">@b.Read/@b.Total</small>@if (b.Read > 0) { <i style="width:@(b.Read * 100 / b.Total)%"></i> }
                    </a>
                    if (open)
                    {
                        var done = Model.DoneOf(b.BookId);
                        var here = r.BookId == b.BookId ? r.Chapter : (short)0;
                        var go = here > 0 ? here : (short)Math.Max(1, Enumerable.Range(1, b.Total).FirstOrDefault(c => !done.Contains((short)c)));
                        <div class="rp-panel" data-book="@b.BookId">
                            <div class="ph"><strong>@b.Name</strong><span class="num" data-panel-count>@done.Count / @(b.Total)장 · @(b.Total == 0 ? 0 : done.Count * 100 / b.Total)%</span></div>
                            <div class="seg" role="group" aria-label="누르면">
                                <a href="@Model.ListUrl(Model.T, b.BookId)" aria-current="@(!Model.MarkMode ? "true" : "false")">읽으러 가기</a>
                                <a href="@Model.ListUrl(Model.T, b.BookId, mark: true)" aria-current="@(Model.MarkMode ? "true" : "false")">다 읽음 표시</a>
                            </div>
                            <p class="hint">@(Model.MarkMode ? "장을 누르면 다 읽음으로 표시하거나 취소해요. 종이 성경으로 읽었을 때 써요." : "장을 누르면 그 장 본문으로 가요.")</p>
                            <div class="chs">
                                @for (short c = 1; c <= b.Total; c++)
                                {
                                    var cls = (done.Contains(c) ? "done" : "") + (c == here ? " here" : "");
                                    if (Model.MarkMode)
                                    {
                                        <button type="button" class="ch @cls" data-ch="@c" aria-pressed="@(done.Contains(c) ? "true" : "false")" aria-label="@(c)장 다 읽음">@c</button>
                                    }
                                    else
                                    {
                                        <a class="ch @cls" href="@Model.ReadUrl(b.BookId, c)" aria-label="@(c)장 읽기">@c</a>
                                    }
                                }
                            </div>
                            <div class="lg"><span><i class="done"></i>다 읽음</span><span><i class="here"></i>보던 곳</span><span><i></i>아직</span></div>
                            <div class="acts">
                                <a class="close" href="@Model.ListUrl(Model.T)">닫기</a>
                                <a class="go" href="@Model.ReadUrl(b.BookId, go)">@(done.Count == 0 ? "읽기 시작" : "이어 읽기") @(go)@(b.BookId == 19 ? "편" : "장") →</a>
                            </div>
                        </div>
                    }
                }
            </div>
</main></div>
</div>
@Html.AntiForgeryToken()
<script>
    // 옛 Bible2 List: 장 번호 칸은 누른 책이 있는 줄의 끝(맨 오른쪽 칸 뒤)에서 펼쳐진다 — 그 줄이 끊기지 않게 옮긴다
    (() => {
        const grid = document.querySelector('.lbooks'), panel = grid?.querySelector('.rp-panel');
        const sel = grid?.querySelector('a.sel');
        if (!panel || !sel) return;
        const cells = [...grid.querySelectorAll(':scope > a')];
        let last = sel;
        for (let i = cells.indexOf(sel) + 1; i < cells.length; i++) {
            if (cells[i].offsetTop !== sel.offsetTop) break;
            last = cells[i];
        }
        last.after(panel);
    })();
</script>
<p id="toast" class="toast" role="status" hidden></p>
<script src="~/js/reading.js" asp-append-version="true"></script>
