@page "/{slug}/reading/rounds"
@model ChallengeBible.Web.Pages.Reading.RoundsModel
@using ChallengeBible.Web.Pages.Reading
@using ChallengeBible.Web.Services
@* 확정 시안: 통독-옛Bible2-나머지화면 "회차 기록"(0071) — 옛 Bible2 ResetProgress 모양: 파란 머리(나의 성경 통독 · 회차 기록) → 지금 N회차 → 새 N+1회차
   → 읽은 장 · 시작한 날 → 진도 막대 → 안내 → [새 회차 시작](확인 뒤) → 지난 회차(완독 · 중간에 닫음). 기록은 지우지 않는다(옛 화면과 다름) *@
@{
    var now = Model.Now;
    var past = Model.Past.ToList();
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string W(double pct) => Math.Max(1, pct).ToString("0.#", inv) + "%";
    var completed = past.Count(r => r.State == RoundState.Completed);
}
<link rel="stylesheet" href="~/css/reading.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/reading-b2.css" asp-append-version="true" />
<div class="rp b2">
@await Html.PartialAsync("_ReadingNav", new ReadingNav(Model, "rounds", "회차 기록"))
<div class="b2main"><main class="b2b">
    <header class="rdk">
        <div class="k">나의 성경 통독</div>
        <h1 class="T">회차 기록<br /><em>@(completed > 0 ? $"완독 {completed}번" : "완독을 향해 가요")</em></h1>
        <div class="who">지금 @(now.RoundNo)회차 · @RoundsModel.Ymd(now.Started) 시작</div>
    </header>
    @if (Model.Started is int s) { <p class="rr-ok" role="status">@(s)회차를 시작했어요. 지난 회차 기록은 그대로 남아요.</p> }

    <div class="rbig">
        <div>지금<b class="num">@now.RoundNo</b>회차</div>
        <i aria-hidden="true">→</i>
        <div class="to">새 회차<b class="num">@(now.RoundNo + 1)</b>회차</div>
    </div>
    <div class="rrows">
        <div><span>읽은 장</span><b class="num">@now.Read.ToString("N0") / @ReadingSummary.Total.ToString("N0")장</b></div>
        <div><span>남은 장</span><b class="num">@((ReadingSummary.Total - now.Read).ToString("N0"))장</b></div>
    </div>
    <div class="bar2"><span>지금 진도</span><b class="num">@now.Percent.ToString("0.0")%</b></div>
    <div class="pg all"><i style="width:@W(now.Percent)"></i></div>

    @if (Model.Ask && now.Read > 0)
    {
        <form method="post" class="rwarn" role="alert">
            <b>새 회차를 시작할까요?</b>
            <ol>
                <li>@(now.RoundNo)회차는 <b>중간에 닫음</b>(@now.Percent.ToString("0.0")%)으로 남아요. 읽은 기록은 지워지지 않아요.</li>
                <li>@(now.RoundNo + 1)회차가 0%부터 시작돼요.</li>
                <li>성경 읽음 표시 · 책갈피는 그대로예요.</li>
            </ol>
            <div class="racts"><a class="rbtn s" href="/@Model.Slug/reading/rounds">아니요</a><button type="submit" class="rbtn">새 회차 시작</button></div>
        </form>
    }
    else if (now.Read > 0)
    {
        <div class="rwarn"><b>새 회차를 시작하면</b><ol><li>지금 회차 기록은 <b>그대로 남아요</b>(아래 지난 회차)</li><li>창세기 1장부터 새로 읽어요</li></ol></div>
        <a class="rbtn" href="/@Model.Slug/reading/rounds?ask=true">@(now.RoundNo + 1)회차 새로 시작하기</a>
    }
    else
    {
        <p class="rp-note">아직 이번 회차에 읽은 장이 없어요. 읽기 시작하면 새 회차도 시작할 수 있어요.</p>
    }
    <a class="rback" href="/@Model.Slug/reading">대시보드로 돌아가기</a>

    <div class="lbl"><span>지난 회차</span>@if (past.Count > 0) { <small class="num">@(past.Count)번</small> }</div>
    @if (past.Count == 0)
    {
        <p class="rp-note" style="margin:0">아직 지난 회차가 없어요. 1,189장을 다 읽으면 여기에 완독 기록이 남아요.</p>
    }
    else
    {
        <ul class="rhist">
            @foreach (var r in past)
            {
                var done = r.State == RoundState.Completed;
                <li>
                    <span><b>@(r.RoundNo)회차</b> <span class="rr-tag @(done ? "ok" : "cl")">@(done ? "완독" : "중간에 닫음")</span><br />
                        <small>@RoundsModel.Ymd(r.Started) ~ @(r.Ended is { } e ? RoundsModel.Ymd(e) : "")@(r.Days is int d ? $" · {d}일 걸림" : "")</small></span>
                    <span class="r"><b class="num">@r.Percent.ToString("0.0")%</b><small class="num">@(r.Read.ToString("N0"))장</small></span>
                </li>
            }
        </ul>
    }
    <p class="rp-note">1,189장을 모두 읽으면 그 회차는 완독으로 끝나고 다음 회차가 저절로 시작돼요. 통독에는 점수가 없어요.</p>
</main></div>
</div>
