@page "/{slug}/reading"
@model ChallengeBible.Web.Pages.Reading.IndexModel
@using ChallengeBible.Web.Pages.Reading
@using ChallengeBible.Web.Services
@* 확정 시안: 성경통독 메인 「현재 화면 (모바일 구현본)」 360px(2026-11-28). 값은 시안 그대로 — wwwroot/css/reading-home.css.
   위에서 아래: 머리줄 · 나의 성경 통독(링 3 · 통독 히트맵 · 연속 읽기 띠) · 이어 읽기 · 최근 4주 · 책별 진도. 점수 · 순위 없음(R-157) *@
@{
    var d = Model.Data;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    ViewData["PbClass"] = "rhtop";
    ViewData["FontsLite"] = true;   // Noto Sans KR 400 / 500 / 700 만 불러온다(디자인 기준표)
    string F(double v, string f = "0.##") => v.ToString(f, inv);
    string Unit(byte book) => book == 19 ? "편" : "장";
    string DayWord(DateOnly day) => day == d.Today ? "오늘" : day == d.Today.AddDays(-1) ? "어제" : day.ToString("M'/'d");

    // 링 3개(_RhRing): 색은 토큰 이름
    var rings = new[]
    {
        (Name: "전체", Token: "--rh-green", Read: d.ReadChapters, Total: ReadingSummary.Total),
        (Name: "구약", Token: "--rh-ot", Read: d.OtRead, Total: ReadingSummary.OtTotal),
        (Name: "신약", Token: "--rh-nt", Read: d.NtRead, Total: ReadingSummary.NtTotal),
    };

    // 통독 히트맵: 10개 구간(장 수 비례) + 읽은 범위(1,189장 기준 %)
    var tot = (double)ReadingSummary.Total;
    int[] secs = [187, 249, 243, 183, 67, 89, 28, 87, 34, 22];
    var ranges = d.ReadRanges ?? Array.Empty<(int Start, int Count)>();

    // 연속 읽기 띠: 이번 주(일 ~ 토)
    var weekStart = d.Today.AddDays(-(int)d.Today.DayOfWeek);
    string[] dows = ["일", "월", "화", "수", "목", "금", "토"];

    // 이어 읽기
    var r = d.Resume;
    var book = d.Books.First(b => b.BookId == r.BookId);
    var bookPct = book.Total == 0 ? 0 : book.Read * 100 / book.Total;
    var fresh = d.ReadChapters == 0 && r.VersesRead == 0;
    string resumeSub = d.LastRead is { } lr
        ? $"{DayWord(lr.Day)} {(lr.BookId == r.BookId ? "" : ReadingPageBase.BookName(lr.BookId) + " ")}{lr.Chapter}{Unit(lr.BookId)}까지 읽었어요"
        : $"{r.Verse}절부터 · {r.VerseCount}절 중 {r.VersesRead}절 읽음";

    // 최근 4주: 일요일 시작 4줄, 오늘 뒤는 빈 칸
    var gridStart = d.Today.AddDays(-(int)d.Today.DayOfWeek - 21);
    var maxDay = Math.Max(1, d.Daily.Count == 0 ? 1 : d.Daily.Values.Max());

    var nt = Model.Tab == "nt";
    var books = d.Books.Where(b => b.Testament == (nt ? "NT" : "OT")).ToList();
}
<link rel="stylesheet" href="~/css/reading.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/reading-b2.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/reading-home.css" asp-append-version="true" />
<div class="rp b2 rhp">
@await Html.PartialAsync("_ReadingNav", new ReadingNav(Model, "home", "대시보드"))
<div class="b2main"><div class="rh">
    @if (Model.ReadingGifts.Count > 0) { <div class="gk-rdwrap">@await Html.PartialAsync("/Pages/Mission/_BirthdayGiftCard.cshtml", (Model.Slug, Model.ReadingGifts))</div> }   @* 완독 선물(ADR 0094 E, 확정 시안 완독-선물 ①) *@
    <section class="rh-top" aria-label="나의 성경 통독">
        <h1 class="rh-h">나의 성경 통독 · <a href="/@Model.Slug/reading/rounds" title="회차 기록">@(d.RoundNo)회차</a></h1>

        <div class="rh-rings">
            @foreach (var g in rings)
            {
                <div class="rh-ring">
                    @await Html.PartialAsync("_RhRing", (g.Name, g.Token, g.Read, ReadingSummary.Percent(g.Read, g.Total)))
                    <div class="rh-nm">@g.Name</div>
                    <div class="rh-ct">@g.Read.ToString("N0", inv) / @g.Total.ToString("N0", inv)장</div>
                </div>
            }
        </div>

        <div class="rh-card rh-map">
            <div class="rh-mt">
                <span class="rh-h2">통독 히트맵</span>
                <span class="rh-lg"><span><i class="on"></i>읽음</span><span><i class="off"></i>안 읽음</span></span>
            </div>
            <div class="rh-bar" role="img" aria-label="성경 전체 읽은 범위">
                @{ var acc = 0; }
                @for (var i = 0; i < secs.Length; i++)
                {
                    <div class="rh-tk @(i % 2 == 1 ? "b" : "")" style="left:@(F(acc / tot * 100 + 0.15, "0.00"))%;width:@(F(secs[i] / tot * 100 - 0.3, "0.00"))%"></div>
                    acc += secs[i];
                }
                @foreach (var (start, count) in ranges)
                {
                    <div class="rh-rd" style="left:@(F(start / tot * 100, "0.00"))%;width:@(F(count / tot * 100, "0.00"))%"></div>
                }
            </div>
            <div class="rh-ax"><span style="left:0">구약</span><span style="left:78.1%">신약</span></div>
        </div>

        <div class="rh-streak">
            <div class="rh-sr">
                <div class="rh-sn"><b>@d.Streak</b><span>@(d.Streak > 0 ? "일 연속 읽는 중" : "일 연속")</span></div>
                <div class="rh-sd">읽은 날 @(d.DaysRead)일<br>@d.Today.ToString("M'/'d") @d.Today.ToString("dddd", ReadingPageBase.Ko)</div>
            </div>
            <div class="rh-wk">
                @for (var i = 0; i < 7; i++)
                {
                    var day = weekStart.AddDays(i);
                    var cls = day == d.Today ? "t" : day < d.Today && d.Daily.GetValueOrDefault(day) > 0 ? "o" : "x";
                    <div><span>@dows[i]</span><i class="@cls">@(day == d.Today ? "오늘" : day.Day.ToString())</i></div>
                }
            </div>
        </div>
    </section>

    <a class="rh-resume" href="@Model.ReadUrl(r.BookId, r.Chapter, r.Verse)">
        <div class="rh-rk"><svg width="16" height="16" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"></path></svg>@(fresh ? "읽기 시작" : "이어 읽기")</div>
        <div class="rh-rm">
            <div>
                <div class="rh-rt">@ReadingPageBase.BookName(r.BookId) @(r.Chapter)@Unit(r.BookId)</div>
                <div class="rh-rs">@resumeSub</div>
            </div>
            <span class="rh-go"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2F5A3A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16M13 5l7 7-7 7"></path></svg></span>
        </div>
        <div class="rh-rp">
            <div class="rh-rtrk"><div style="width:@(bookPct)%"></div></div>
            <div class="rh-rl"><span>@ReadingPageBase.BookName(r.BookId) @book.Read / @(book.Total)@Unit(r.BookId)</span><span>@(bookPct)%</span></div>
        </div>
    </a>

    <section class="rh-cal" aria-label="최근 4주">
        <div class="rh-ct2"><span class="rh-h2">최근 4주</span><span class="rh-cd">@d.Today.ToString("M'/'d") 오늘</span></div>
        <div class="rh-dow">@foreach (var w in dows) { <span>@w</span> }</div>
        <div class="rh-grid" role="img" aria-label="최근 4주 읽은 날">
            @for (var i = 0; i < 28; i++)
            {
                var day = gridStart.AddDays(i);
                var n = d.Daily.GetValueOrDefault(day);
                var lv = n == 0 ? "" : n * 3 <= maxDay ? "l1" : n * 3 <= maxDay * 2 ? "l2" : "l3";
                var dw = i % 7 == 0 ? "su" : i % 7 == 6 ? "sa" : "";
                if (day > d.Today) { <span class="f"></span> }
                else { <span class="@dw @lv@(day == d.Today ? " t" : "")" title="@day.ToString("M'/'d") @(n)장">@day.Day</span> }
            }
        </div>
        <div class="rh-lgd">적음<i class="a"></i><i class="b"></i><i class="c"></i><i class="d"></i>많음</div>
    </section>

    <section class="rh-bk" aria-label="책별 진도">
        <div class="rh-bt"><span class="rh-h2">책별 진도</span><a href="@Model.ListUrl(nt ? "nt" : "ot")">@(nt ? "신약" : "구약") 목록 →</a></div>
        @await Html.PartialAsync("_RhTabs", (!nt, "?Tab=ot", "?Tab=nt"))
        <div class="rh-books">
            @foreach (var b in books)
            {
                <a href="@Model.ListUrl(ReadingPageBase.TestamentOf(b.BookId), b.BookId)" class="@(b.Done ? "dn" : b.Read > 0 ? "ing" : "")" title="@b.Name @b.Read/@b.Total"><div class="n">@b.Name</div><div class="c">@b.Read/@b.Total@(b.Done ? " ✓" : "")</div></a>
            }
        </div>
    </section>
</div></div>
</div>
