@page "/{slug}/reading"
@model ChallengeBible.Web.Pages.Reading.IndexModel
@using ChallengeBible.Web.Pages.Reading
@using ChallengeBible.Web.Services
@* 확정 시안: 통독-옛Bible2-대시보드(0071) — 옛 Bible2 Index 배치: [나의 성경 통독 | 이어 읽기] → [다음에 읽을 곳 · 오늘의 말씀 · 통독 진도 | 최근 8주] → 책별 진도.
   색은 지금 통독 색. 점수 · 순위 없음(R-157) *@
@{
    var d = Model.Data;
    var ko = ReadingPageBase.Ko;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var pct = ReadingSummary.Percent(d.ReadChapters, ReadingSummary.Total);
    var r = d.Resume;
    var gridStart = d.Today.AddDays(-(int)d.Today.DayOfWeek - 49);
    var maxDay = Math.Max(1, d.Daily.Count == 0 ? 1 : d.Daily.Values.Max());
    var nt = Model.Tab == "nt";
    var books = d.Books.Where(b => b.Testament == (nt ? "NT" : "OT")).ToList();
    string Unit(byte book) => book == 19 ? "편" : "장";
}
<link rel="stylesheet" href="~/css/reading.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/reading-b2.css" asp-append-version="true" />
<div class="rp b2">
@await Html.PartialAsync("_ReadingNav", new ReadingNav(Model, "home", "대시보드"))
<div class="b2main"><div class="b2b">
    <div class="g2">
        <section aria-label="나의 성경 통독">
            <div class="k">나의 성경 통독 · <a href="/@Model.Slug/reading/rounds" title="회차 기록">@(d.RoundNo)회차@(d.CompletedRounds > 0 ? $" · 완독 {d.CompletedRounds}번" : "")</a></div>
            <div class="ring">
                <div class="c" style="--p:@pct.ToString("0.0", inv)" role="img" aria-label="진도율 @(pct.ToString("0.0"))%"><span class="num">@(pct.ToString("0.0"))%</span></div>
                <div><b class="num">@d.ReadChapters.ToString("N0") / @ReadingSummary.Total.ToString("N0")장</b>
                    <small class="num">구약 @d.OtRead / @(ReadingSummary.OtTotal)장<br>신약 @d.NtRead / @(ReadingSummary.NtTotal)장</small></div>
            </div>
            <div class="cells">
                <div><b class="num">@d.Streak</b>일 연속</div>
                <div><b class="num">@d.DaysRead</b>일 읽음</div>
                <div><b class="num">@d.Today.ToString("M'/'d")</b>@d.Today.ToString("dddd", ko)</div>
            </div>
            @if (d.Streak > 0) { <div class="streak">@(d.Streak)일째 이어 읽고 있어요 · 오늘도 이어 가요</div> }
        </section>
        <section aria-label="이어 읽기">
            <a class="cta" href="@Model.ReadUrl(r.BookId, r.Chapter, r.Verse)">
                <div>
                    <div class="kk">@(d.ReadChapters == 0 && r.VersesRead == 0 ? "읽기 시작" : "이어 읽기")</div>
                    <div class="t">@ReadingPageBase.BookName(r.BookId) @(r.Chapter)@Unit(r.BookId)</div>
                    @if (Model.ResumeText is not null) { <p>“@Model.ResumeText”</p> }
                    <small class="num">@(r.Verse)절부터 · @(r.VerseCount)절 중 @(r.VersesRead)절 읽음@(r.ViewedUtc is DateTime at ? " · " + TenantClockText(at) : "")</small>
                </div>
                <em aria-hidden="true">→</em>
            </a>
        </section>
    </div>

    <div class="g2">
        <div>
            <div class="lbl">다음에 읽을 곳</div>
            @if (d.Next.Count > 0)
            {
                <div class="next">
                    @foreach (var (book, ch) in d.Next) { <a href="@Model.ReadUrl(book, ch)">@ReadingPageBase.BookName(book)<small class="num">@(ch)@Unit(book)</small></a> }
                </div>
            }
            else { <div class="empty"><b>성경 전체 통독을 마쳤어요</b>하나님의 말씀을 모두 읽으셨습니다</div> }

            @if (Model.VerseText is not null)
            {
                <div class="lbl">오늘의 말씀</div>
                <div class="vod"><p>@Model.VerseText</p><small>@Model.VerseRef</small></div>
            }

            <div class="lbl">통독 진도</div>
            @foreach (var (label, read, total) in new[] { ("전체", d.ReadChapters, ReadingSummary.Total), ("구약", d.OtRead, ReadingSummary.OtTotal), ("신약", d.NtRead, ReadingSummary.NtTotal) })
            {
                var p = ReadingSummary.Percent(read, total);
                <div class="bar2"><span>@label</span><b class="num">@read.ToString("N0") / @total.ToString("N0") · @(p.ToString("0.0"))%</b></div>
                <div class="pg @(label == "전체" ? "all" : "")"><i style="width:@(p.ToString("0.#", inv))%"></i></div>
            }
        </div>
        <div>
            <div class="lbl">최근 8주<small>@d.Today.ToString("M'/'d") 오늘</small></div>
            <div class="dow">@foreach (var w in new[] { "일", "월", "화", "수", "목", "금", "토" }) { <span>@w</span> }</div>
            <div class="heat" role="img" aria-label="최근 8주 읽은 날">
                @for (var i = 0; i < 56; i++)
                {
                    var day = gridStart.AddDays(i);
                    var n = d.Daily.GetValueOrDefault(day);
                    var lv = day > d.Today ? "f" : n == 0 ? "" : n * 3 <= maxDay ? "l1" : n * 3 <= maxDay * 2 ? "l2" : "l3";
                    <span class="@lv@(day == d.Today ? " t" : "")" title="@day.ToString("M'/'d") @(n)장">@(day > d.Today ? "" : day.Day.ToString())</span>
                }
            </div>
            <div class="legend">적음<i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i>많음</div>
        </div>
    </div>

    <div class="lbl">책별 진도<a href="@Model.ListUrl(nt ? "nt" : "ot")">@(nt ? "신약" : "구약") 목록 →</a></div>
    <nav class="seg" style="margin:0 0 10px" aria-label="구약 · 신약">
        <a href="?Tab=ot" aria-current="@(!nt ? "true" : "false")">구약 39권</a>
        <a href="?Tab=nt" aria-current="@(nt ? "true" : "false")">신약 27권</a>
    </nav>
    <div class="books">
        @foreach (var b in books)
        {
            <a href="@Model.ListUrl(ReadingPageBase.TestamentOf(b.BookId), b.BookId)" class="@(b.Done ? "dn" : "")" title="@b.Name @b.Read/@b.Total">
                @b.Name<small class="num">@b.Read/@b.Total</small>@if (b.Read > 0) { <i style="width:@(b.Read * 100 / b.Total)%"></i> }
            </a>
        }
    </div>
</div></div>
</div>
@functions {
    string TenantClockText(DateTime utc)
    {
        var tz = TimeZoneInfo.FindSystemTimeZoneById(Model.Tenant.Current.TimeZoneId);
        var local = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), tz);
        var day = DateOnly.FromDateTime(local);
        return (day == Model.Data.Today ? "오늘" : day == Model.Data.Today.AddDays(-1) ? "어제" : local.ToString("M'/'d")) + " " + local.ToString("HH:mm");
    }
}
