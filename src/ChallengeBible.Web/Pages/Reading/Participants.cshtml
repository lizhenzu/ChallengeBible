@page "/{slug}/reading/participants"
@model ChallengeBible.Web.Pages.Reading.ParticipantsModel
@using ChallengeBible.Web.Pages.Reading
@* 확정 시안: 통독-옛Bible2-나머지화면 "참여자 현황"(0071) — 옛 Bible2 Participants 배치: 함께 읽는 말씀 · 참여자 현황 → 숫자 4칸 → 완독자 명예의 전당 → 이름 찾기 · 진도율순 · 최근순 → 참여자 카드("나" 표시).
   사진 대신 이름 글자. 부서가 공개를 끄면 관리자 · 교사만 본다(R-159). 점수 없음(R-157) *@
@{
    var b = Model.Board;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Given(string name) => name.Length > 2 ? name[1..] : name;
}
<link rel="stylesheet" href="~/css/reading.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/reading-b2.css" asp-append-version="true" />
<div class="rp b2">
@await Html.PartialAsync("_ReadingNav", new ReadingNav(Model, "participants", "참여자 현황"))
<div class="b2main"><main class="b2b">
    <div class="k">함께 읽는 말씀</div>
    <h1 class="T">참여자 현황</h1>
    @if (!b.CanSee)
    {
        <div class="empty"><b>참여자 현황을 공개하지 않아요</b>내 진도는 <a href="/@Model.Slug/reading" style="margin:0">통독 홈</a>에서 볼 수 있어요.</div>
    }
    else
    {
        <div class="cells c4">
            <div><b class="num">@b.Readers</b>참여자</div>
            <div><b class="num">@b.Finishers</b>완독자</div>
            <div><b class="num">@(b.AvgPercent.ToString("0.0"))%</b>평균 진도</div>
            <div><b class="num">@b.TotalCompleted</b>누적 완독</div>
        </div>
        @if (!b.Public) { <p class="rp-note">공개가 꺼져 있어서 관리자 · 교사에게만 보이는 화면이에요.</p> }

        <div class="lbl">완독자 명예의 전당<small class="num">@(b.HallOfFame.Count)명</small></div>
        @if (b.HallOfFame.Count == 0)
        {
            <p class="rp-note" style="margin:0">아직 완독한 사람이 없어요. 1,189장을 다 읽으면 여기에 이름이 올라가요!</p>
        }
        else
        {
            <ul class="hall">@foreach (var m in b.HallOfFame) { <li><span class="av">@Given(m.Name)</span><b>@m.Name</b><small class="num">@(m.Completed)독</small></li> }</ul>
        }

        <div class="lbl">성경통독 참여자<small class="num">@(Model.Rows.Count)명</small></div>
        <form class="pctrl" method="get" role="search">
            <input type="hidden" name="sort" value="@Model.Sort" />
            <input type="search" name="q" value="@Model.Q" placeholder="이름 검색" aria-label="이름 검색" />
            <a href="?sort=progress&q=@Uri.EscapeDataString(Model.Q ?? "")" aria-current="@(Model.Sort != "recent" ? "true" : "false")">진도율순</a>
            <a href="?sort=recent&q=@Uri.EscapeDataString(Model.Q ?? "")" aria-current="@(Model.Sort == "recent" ? "true" : "false")">최근순</a>
        </form>
        <ul class="pcards">
            @foreach (var m in Model.Rows)
            {
                <li class="@(m.Me ? "me" : "")@(m.Completed > 0 ? " dn" : "")">
                    @if (m.Completed > 0) { <span class="tag num">@(m.Completed)독</span> }
                    @if (m.Me) { <span class="mine">나</span> }
                    <span class="ring" style="--p:@m.Percent.ToString("0.0", inv)"><span class="av">@Given(m.Name)</span></span>
                    <b>@m.Name</b>
                    <span class="pc num">@(m.Percent.ToString("0.0"))<small>%</small></span>
                    <span class="bd">@m.Badge</span>
                    <small class="mm">@Model.LastText(m)</small>
                    <span class="bar"><i style="width:@(Math.Max(m.Percent, 0).ToString("0.#", inv))%"></i></span>
                </li>
            }
        </ul>
        <p class="pfoot">말씀을 읽는 것이 복입니다 — 요한계시록 1:3</p>
    }
</main></div>
</div>
