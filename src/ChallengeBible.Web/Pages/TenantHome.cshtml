@page "/{slug:regex(^[a-z0-9-]{{2,40}}$)}/{view:regex(^today$)?}"
@model TenantHomeModel
@using ChallengeBible.Infrastructure.Data
@using ChallengeBible.Web.Auth
@using ChallengeBible.Web.Services
@* 2026-11-22 사용자 확정(ADR 0127): 부서 홈을 dodan 시안 하나로 교체 —
   머리말(☰ · 검색 · 내 계정) → 로고 → 검색 → 프로그램 4칸 → 오늘의 말씀 → 나의 도전 현황 → 작은 링크.
   기존 카드(진행 링 · 예배/주보 · 생일 카드 · 선물 보드 · 가족팀 · 의견 카드)는 홈에서 뺐다.
   임시 부서(로비)의 1단계 안내는 그대로 둔다. *@
@{
    var d = Model.Data;
    var t = Model.Tenant.Current;
    var slug = t.Slug;
    var ko = new System.Globalization.CultureInfo("ko-KR");
    var has = d.Missions.Where(m => m.Has).ToList();
    var done = has.Count(m => m.Done);
    var week = d.Week.Count(w => w.MissionPoints > 0);
    var lobby = Model.Tenant.IsLobby;
    var intro = lobby && !Model.TodayScreen;
    var loginTo = "/account/login?returnUrl=" + Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString);
    static string Ro(string w) { var c = w.Length == 0 ? 'a' : w[^1]; var j = c is >= '가' and <= '힣' ? (c - '가') % 28 : 0; return j == 0 || j == 8 ? "로" : "으로"; }
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<div class="hm @(intro ? "sky" : "hmx")@(lobby ? " lobby" : "")">

@if (intro)
{
    <div class="wl">
        <header class="wl-top gut"><div class="wrap">
            <button type="button" class="pmenu-btn hm-menu" aria-label="메뉴 열기" aria-controls="pnav" aria-expanded="false" data-pnav-open>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h12"/></svg>
            </button>
            <div class="wl-org"><small>대한예수교장로회</small><a class="church" href="https://www.saenae.org/" target="_blank" rel="noopener" aria-label="잠실새내교회 홈페이지 (새 창)">잠실새내교회<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a></div>
            <span class="wl-today"><b>@d.Today.ToString("M월 d일", ko)</b> @d.Today.ToString("dddd", ko)</span>
            <partial name="_MailBadge" />
        </div></header>
        <section class="wl-hi gut" aria-labelledby="wlHi"><div class="wrap">
            <div class="wl-k">환영해요</div>
            <h1 id="wlHi">@Ui.Nim(User.DisplayName()),<br>반가워요!</h1>
            <p class="wl-sub">먼저 내가 참여할 부서를 골라요.</p>
            <div class="wl-card">
                <h2>시작까지 2단계</h2>
                <ol class="wl-steps">
                    <li class="wl-done"><span class="wl-ic" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></span>
                        <div class="wl-tx"><b>가입 <span class="wl-tag wl-done">완료</span></b><span>이름 · 이메일 · 비밀번호만 있으면 돼요</span></div></li>
                    <li class="wl-now"><span class="wl-ic" aria-hidden="true">2</span>
                        <div class="wl-tx"><b>내 부서 참여 <span class="wl-tag wl-now">지금 할 일</span></b><span>목록에서 내 부서를 고르면 바로 시작해요</span></div></li>
                </ol>
                <a class="wl-btn wl-p" href="/join">내 부서 참여 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                <a class="wl-btn wl-s" href="/@slug/today">먼저 미션 해 보기 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                <p class="wl-keep"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>여기서 한 미션 기록 · 점수는 부서로 그대로 옮겨져요.</p>
            </div>
        </div></section>
    </div>
}
else
{
    <main class="gut"><div class="wrap hmx-wrap">

        <div class="hmx-top">
            @if (!Model.Guest)
            {
                <button type="button" class="hmx-ico" aria-label="메뉴 열기" aria-controls="pnav" aria-expanded="false" data-pnav-open>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
            }
            else
            {
                <span class="hmx-ico" aria-hidden="true"></span>
            }
            <div class="hmx-act">
                @if (t.ReadingEnabled)
                {
                    <a class="hmx-ico" href="/@slug/reading/search" aria-label="말씀 찾기">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                    </a>
                }
                @if (Model.Guest)
                {
                    <a class="hmx-login" href="@loginTo">로그인</a>
                }
                else
                {
                    <a class="hmx-ico hmx-prof" href="/account" aria-label="내 계정">
                        @if (Model.MyPhoto is { } ph)
                        {
                            <img src="/account/photo?handler=img&amp;v=@ph" alt="" />
                        }
                        else
                        {
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                        }
                    </a>
                }
            </div>
        </div>

        <section class="hmx-logo" aria-labelledby="hmxT">
            <h1 id="hmxT">도전!!! <span>성경말씀</span></h1>
            <p>하루 5분, 말씀과 함께 자라요.</p>
        </section>

        @if (t.ReadingEnabled)
        {
            <a class="hmx-search" href="/@slug/reading/search" aria-label="말씀 찾기 화면으로">
                <span>성경에서 단어 검색</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1e3a8a" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            </a>
        }

        <nav class="hmx-grid" aria-label="프로그램 바로가기">
            @if (t.MissionEnabled)
            {
                <a class="hmx-item" href="/@slug/word-mission"><span class="hmx-tile"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#3b4a7d" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a1.5 1.5 0 0 0-1.5 1.5v15A1.5 1.5 0 0 0 7 21h10a1.5 1.5 0 0 0 1.5-1.5V7.5z"/><path d="M14 3v4.5h4.5"/><path d="M9 13.5l2 2 4-4.5"/><path d="M8 18h8"/></svg></span><span>도전!!!<br>성경미션</span></a>
            }
            @if (t.ReadingEnabled)
            {
                <a class="hmx-item" href="/@slug/reading"><span class="hmx-tile"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#3b4a7d" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H14l3.5 3.5V19.5A1.5 1.5 0 0 1 16 21H6.5A1.5 1.5 0 0 1 5 19.5z"/><path d="M14 3v3.5h3.5"/><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4"/></svg></span><span>도전!!!<br>성경통독</span></a>
            }
            @if (t.CopyEnabled)
            {
                <a class="hmx-item" href="/@slug/copy"><span class="hmx-tile"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#3b4a7d" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.5 4.5l3 3L9 18l-4 1 1-4z"/><path d="M14.5 6.5l3 3"/><path d="M4 21h16"/></svg></span><span>도전!!!<br>성경필사</span></a>
            }
            @if (Model.PrayerVisible)
            {
                <a class="hmx-item" href="/@slug/prayer365"><span class="hmx-tile"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#3b4a7d" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-7.5-10A4.2 4.2 0 0 1 12 7.6a4.2 4.2 0 0 1 7.5 2.9c0 5.4-7.5 10-7.5 10z"/><path d="M12 10.5v4M10 12.5h4"/></svg></span><span>자녀를 위한<br>기도365</span></a>
            }
        </nav>

        @if (d.VerseText is { } vt)
        {
            <section class="hmx-card" aria-label="오늘의 말씀">
                <h2>오늘의 말씀</h2>
                <div class="hmx-vs">
                    <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#1e3a8a" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6.5C10.2 5 7.6 4.5 5 4.5v13c2.6 0 5.2.5 7 2 1.8-1.5 4.4-2 7-2v-13c-2.6 0-5.2.5-7 2z"/><path d="M12 6.5v13"/><path d="M14.5 4.5v6l1.8-1.4 1.7 1.4v-6"/></svg>
                    <p>“@vt”@if (d.VerseRef is { } vr) { <span class="ref"> (@vr)</span> }</p>
                </div>
            </section>
        }
        else if (d.WordTitle is not null)
        {
            <a class="hmx-card" href="/@slug/word-mission" aria-label="오늘의 말씀 — 미션 홈으로">
                <h2>오늘의 말씀</h2>
                <div class="hmx-vs">
                    <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#1e3a8a" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6.5C10.2 5 7.6 4.5 5 4.5v13c2.6 0 5.2.5 7 2 1.8-1.5 4.4-2 7-2v-13c-2.6 0-5.2.5-7 2z"/><path d="M12 6.5v13"/><path d="M14.5 4.5v6l1.8-1.4 1.7 1.4v-6"/></svg>
                    <p><b>@d.WordTitle</b> <span class="ref">@d.WordRange ›</span></p>
                </div>
            </a>
        }

        <section class="hmx-card" aria-labelledby="hmxSt">
            <div class="hmx-ch">
                <h2 id="hmxSt">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f2b01e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M7 6H4a3 3 0 0 0 3 5M17 6h3a3 3 0 0 1-3 5"/><path d="M12 14v3M8.5 20h7"/></svg>
                    나의 도전 현황
                </h2>
                @if (!Model.Guest)
                {
                    <a class="hmx-more" href="/@slug/points">더보기
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                    </a>
                }
            </div>

            @if (Model.Guest)
            {
                <div class="hmx-guest">
                    <b>로그인하면 내 기록이 보여요</b>
                    <span>오늘 미션 · 이번 주 참여 · 나의 포인트</span>
                    <a href="@loginTo">로그인</a>
                </div>
            }
            else if (d.Participant)
            {
                <div class="hmx-stats">
                    @if (t.MissionEnabled)
                    {
                        <div class="hmx-stat">
                            <div class="lb"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a1.5 1.5 0 0 0-1.5 1.5v15A1.5 1.5 0 0 0 7 21h10a1.5 1.5 0 0 0 1.5-1.5V7.5z"/><path d="M14 3v4.5h4.5"/><path d="M9 13.5l2 2 4-4.5"/></svg>오늘 미션</div>
                            <div class="vl num">@(done)/@(has.Count)</div>
                        </div>
                        <div class="hmx-stat">
                            <div class="lb"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M8 3v4M16 3v4M3.5 10h17"/></svg>이번 주 참여</div>
                            <div class="vl num">@(week)회</div>
                        </div>
                    }
                    <div class="hmx-stat">
                        <div class="lb"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c0-3 2.5-5.5 5.5-5.5s5.5 2.5 5.5 5.5"/><path d="M16 8.5h5M18.5 6v5"/></svg>전체 참여자</div>
                        <div class="vl num">@((d.Dept?.Members ?? 0).ToString("N0"))명</div>
                    </div>
                </div>
                @if (t.MissionEnabled)
                {
                    <div class="hmx-stats detail">
                        <div class="hmx-stat">
                            <div class="lb"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-3-5.4 3 1.1-6L3.2 9.4l6.1-.8z"/></svg>나의 포인트</div>
                            <div class="vl num">@d.SeasonPoints.ToString("N0")점</div>
                        </div>
                        <div class="hmx-stat">
                            <div class="lb"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>순위</div>
                            <div class="vl num">@(Model.MyRank is { } rk ? $"{rk}위" : "—")</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="hmx-stats detail" style="margin-top:0;padding-top:0;border-top:0">
                    <div class="hmx-stat">
                        <div class="lb">전체 참여자</div>
                        <div class="vl num">@((d.Dept?.Members ?? 0).ToString("N0"))명</div>
                    </div>
                    <div class="hmx-stat">
                        <div class="lb">오늘 참여</div>
                        <div class="vl num">@((d.Dept?.TodayPeople ?? 0).ToString("N0"))명</div>
                    </div>
                </div>
            }
        </section>

        @if (lobby)
        {
            if (Model.Waiting.Count == 0)
            {
                <section class="lb-ban lb-go" aria-labelledby="lbT">
                    <p><b id="lbT">아직 내 부서가 없어요</b>내 부서에 참여 신청하면 선생님이 승인해요. 지금 한 미션 · 점수는 그 부서로 옮겨져요.</p>
                    <a class="lb-btn p" href="/join">내 부서 참여 신청하기 →</a>
                </section>
            }
            else
            {
                var depts = string.Join(" · ", Model.Waiting.Select(w => w.StartsWith("잠실새내교회 ") ? w["잠실새내교회 ".Length..] : w));
                <section class="lb-ban lb-wait" aria-labelledby="lbT">
                    <p><b id="lbT"><span class="lb-pill">승인 기다리는 중</span>@depts</b>선생님이 승인하면 바로 @depts@(Ro(depts)) 바뀌어요. 그동안 여기서 미션을 계속해요.</p>
                    <a class="lb-btn s" href="/join">신청 확인 · 바꾸기 →</a>
                </section>
            }
        }

        <div class="hmx-links">
            @if (Model.IsGuardian)
            {
                <a href="/@slug/guardian">자녀 미션 보기</a>
            }
            <a href="/@slug/feedback">의견 보내기</a>
        </div>

    </div></main>
}

@if (Model.BirthdayPopup is { } bp)
{
    <div class="bdh-pop" data-bdh-pop role="dialog" aria-modal="true" aria-labelledby="bdhT">
        <div class="bdh-box">
            <div class="bdh-em" aria-hidden="true">🎂🎁</div>
            <h2 id="bdhT">@(bp.Name.Length > 0 ? bp.Name : User.Identity?.Name)님, 생일 축하해요!</h2>
            <p>@bp.Birthday.ToString("M월 d일") 생일 선물을 골라 주세요.@if (bp.OpenUntil is { } pu) { <br />@($"{pu:M월 d일}까지 고를 수 있어요.") }</p>
            <a class="bdh-pick" href="/@t.Slug/gifts/birthday/@bp.Id">선물 고르러 가기</a>
            <form method="post" asp-page-handler="SnoozeBirthday" asp-route-slug="@slug" class="bdh-later">
                <small>다음에 할래요</small>
                <div><button type="submit" name="days" value="1">내일 다시</button><button type="submit" name="days" value="3">3일 뒤</button><button type="submit" name="days" value="5">5일 뒤</button></div>
            </form>
        </div>
    </div>
}
@if (!Model.Guest) { <partial name="_MsgPopup" model="(Model.NewMessages, Model.NewList, '/' + slug)" /> }

@if (!Model.Guest) { <partial name="_TenantDrawer" model="(Model.Tenant, Model.MyPhoto)" /> }

<footer class="gut"><div class="wrap">
    <p class="foot-copy">© @d.Today.Year 잠실새내 · 주일학교</p>
</div></footer>
</div>
