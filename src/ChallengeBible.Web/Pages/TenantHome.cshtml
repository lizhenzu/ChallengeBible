@page "/{slug:regex(^[a-z0-9-]{{2,40}}$)}/{view:regex(^today$)?}"
@model TenantHomeModel
@using ChallengeBible.Infrastructure.Data
@using ChallengeBible.Web.Auth
@using ChallengeBible.Web.Services
@* 확정 시안: 홈메인-단독시안(0044) — 머리말(부서 ▼ · 날짜) → 인사 → 오늘의 말씀 띠 → 프로그램 두 장 → 우리 가족팀 → 이번 주 나의 기록 → 우리 부서 → 계정 줄.
   확정 8가지: 관리 버튼(머리말) · 보호자 카드 · 가족 부서 안내 유지, 참여자가 아니면 보기만, 꺼진 프로그램은 숨김, 부서 ▼ = 부서 고르기 화면, 계정 줄은 3개, 말씀 없는 날은 띠 숨김 *@
@{
    var d = Model.Data;
    var t = Model.Tenant.Current;
    var slug = t.Slug;
    var ko = new System.Globalization.CultureInfo("ko-KR");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    const double C = 238.8;   // 고리 둘레(r = 38)
    string Dash(double pct) => $"{(C * Math.Clamp(pct, 0, 100) / 100).ToString("0.#", inv)} {C.ToString("0.#", inv)}";
    var has = d.Missions.Where(m => m.Has).ToList();
    var done = has.Count(m => m.Done);
    var left = has.Where(m => !m.Done).ToList();
    var rd = d.Reading;
    var lobby = Model.Tenant.IsLobby;
    var intro = lobby && !Model.TodayScreen;
    // 받침에 맞는 "로 / 으로"(받침 없음 · ㄹ 받침 = 로)
    // 씨앗 단계 그림: 🌰(밤) 대신 완두콩 꼬투리(2026-11-03 사용자 확정 E). 새 이모지는 기기마다 □ 로 깨지므로 그림으로 그린다
    static Microsoft.AspNetCore.Html.IHtmlContent Ico(string e) => e == "🌰"
        ? new Microsoft.AspNetCore.Html.HtmlString("<svg class=\"pea\" viewBox=\"0 0 40 40\"><path d=\"M4 26C10 12 26 8 36 12c-2 12-16 20-30 17z\" fill=\"#6CC04A\"/><path d=\"M7 26c8-1 18-6 26-12\" stroke=\"#4E9A33\" stroke-width=\"1.5\" fill=\"none\"/><circle cx=\"13\" cy=\"23\" r=\"3.6\" fill=\"#A6E07A\"/><circle cx=\"20\" cy=\"20\" r=\"3.8\" fill=\"#A6E07A\"/><circle cx=\"27\" cy=\"16.5\" r=\"3.6\" fill=\"#A6E07A\"/><path d=\"M34 12c1-3 3-4 5-4\" stroke=\"#4E9A33\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/></svg>")
        : new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(e));
    static string Ro(string w) { var c = w.Length == 0 ? 'a' : w[^1]; var j = c is >= '가' and <= '힣' ? (c - '가') % 28 : 0; return j == 0 || j == 8 ? "로" : "으로"; }   // 0068: 임시 부서 `/{slug}` = 1단계(부서 안 고름) · 2단계(승인 기다림), 윗부분만
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<div class="hm sky@(lobby ? " lobby" : "")">
@* 하늘색 머리말(0064 · 0068, 확정 시안: 임시부서-홈-두단계). 일반 부서 홈도 임시 부서 미션 화면(/welcome/today)과 같은 모양(2026-10-31 사용자):
   머리말 → (임시 부서) 1 · 2단계 윗부분만 또는 "← 처음 화면" / (일반 부서) 부서 이름 · 관리 줄 → 흰 말씀 카드 → 아랫부분 *@
    <div class="wl@(intro ? "" : " wl-wide")">
        <header class="wl-top gut"><div class="wrap">
            <div class="wl-org"><small>대한예수교장로회</small><a class="church" href="https://www.saenae.org/" target="_blank" rel="noopener" aria-label="잠실새내교회 홈페이지 (새 창)">잠실새내교회<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a></div>
            <span class="wl-today"><span class="yr">@d.Today.ToString("yyyy년", ko) </span><b>@d.Today.ToString("M월 d일", ko)</b> @d.Today.ToString("dddd", ko)</span>
        </div></header>
        @if (intro)
        {
            var step2 = Model.Waiting.Count > 0;
            <section class="wl-hi gut" aria-labelledby="wlHi"><div class="wrap">
                <div class="wl-k">환영해요</div>
                <h1 id="wlHi">@(User.DisplayName())님,<br>반가워요!</h1>
                <p class="wl-sub">@(step2 ? "신청을 보냈어요. 관리자가 승인하면 그 부서로 옮겨 가요." : "먼저 내가 참여할 부서를 신청해요.")</p>
                <div class="wl-card">
                    <h2>시작까지 3단계</h2>
                    <ol class="wl-steps">
                        <li class="wl-done"><span class="wl-ic" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></span>
                            <div class="wl-tx"><b>가입 <span class="wl-tag wl-done">완료</span></b><span>이름 · 이메일만 받았어요</span></div></li>
                        @if (!step2)
                        {
                            <li class="wl-now"><span class="wl-ic" aria-hidden="true">2</span>
                                <div class="wl-tx"><b>내 부서 참여 <span class="wl-tag wl-now">지금 할 일</span></b><span>목록에서 내 부서를 골라 신청해요</span></div></li>
                            <li class="wl-later"><span class="wl-ic" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
                                <div class="wl-tx"><b>관리자 승인 <span class="wl-tag wl-later">다음 단계</span></b><span>승인되면 그 부서로 바로 옮겨 가요</span></div></li>
                        }
                        else
                        {
                            <li class="wl-done"><span class="wl-ic" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></span>
                                <div class="wl-tx"><b>참여 신청 <span class="wl-tag wl-done">완료</span></b><span>@(string.Join(" · ", Model.Waiting))</span></div></li>
                            <li class="wl-wait"><span class="wl-ic" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
                                <div class="wl-tx"><b>관리자 승인 <span class="wl-tag wl-wait">기다리는 중</span></b><span>승인되면 그 부서로 바로 옮겨 가요</span></div></li>
                        }
                    </ol>
                    @if (!step2)
                    {
                        <a class="wl-btn wl-p" href="/join">내 부서 참여 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                        <a class="wl-btn wl-s" href="/@slug/today">먼저 미션 해 보기 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                    }
                    else
                    {
                        <a class="wl-btn wl-p" href="/@slug/today">미션 수행하러 가기 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                        <a class="wl-btn wl-s" href="/join">신청 보기 <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
                    }
                    <p class="wl-keep"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>여기서 한 미션 기록 · 점수는 부서로 그대로 옮겨져요.</p>
                </div>
            </div></section>
        }
        else if (lobby)
        {
            <nav class="wl-back gut" aria-label="돌아가기"><div class="wrap">
                <a href="/@slug">← 처음 화면</a>@if (Model.Waiting.Count > 0) { <span class="pill">승인 기다리는 중</span> }
            </div></nav>
        }
        @* 일반 부서: 부서 이름 줄은 지웠다(2026-11-03 사용자). 부서 바꾸기 · 관리는 맨 아래 계정 줄 *@
    </div>

@if (!intro)
{
@* 0076 확정 시안(hk.png): 말씀 한 줄 띠 → 인사 카드(나의 점수 성장) → 말씀 찾기 → 성경말씀 카드 → 성경통독 카드 → 가족팀 · 우리 부서 *@
<main class="gut hj"><div class="wrap">
    @* 맨 위 말씀 한 줄 띠는 지웠다(2026-11-03 사용자) *@
    @if (Model.NeedsFamilyChoice)
    {
        <a class="notice" href="/account/family"><b>시상 부서가 아직 정해지지 않았어요</b><span>플랫폼 관리자가 정하면 그 부서에서 부모님도 미션 · 가족팀을 함께해요 →</span></a>
    }

    @{ var name = User.DisplayName(); }
    <section class="hj-card hj-hi" aria-labelledby="hiT">
        <div class="hj-hi-top">
            <div>
                <small>안녕하세요</small>
                <h1 id="hiT">@name <u>님</u></h1>
                @* 교회 이름은 머리말에 있으니 부서 이름만(2026-11-03 사용자): "잠실새내교회 유년부" → "유년부" *@
                <p><b>@(lobby ? "도전!!! 성경말씀에" : (t.Name.StartsWith("잠실새내교회 ") ? t.Name["잠실새내교회 ".Length..] : t.Name) + "에") 오심을 환영해요</b>
                    <span>@(d.Today.DayOfWeek == DayOfWeek.Sunday || d.Today.DayOfWeek == DayOfWeek.Monday ? "새 한 주가 시작됐어요." : "오늘도 반가워요.")</span>
                    <span>오늘 말씀부터 읽어 볼까요?</span></p>
            </div>
            @* 0078: 누르면 내 사진 화면(올리기 · 바꾸기 · 지우기). 사진이 없으면 이름 첫 글자 *@
            <a class="hj-av" href="/account/photo?back=/@slug" aria-label="내 사진 바꾸기">@if (Model.MyPhoto is { } ph)
                { <img src="/account/photo?handler=img&amp;v=@ph" alt="" /> } else { <span aria-hidden="true">@(name.Length > 0 ? name[..1] : "?")</span> }<i class="cam" aria-hidden="true">📷</i></a>
        </div>
        @if (d.Growth is { } g)
        {
            var stages = d.Rules.GrowthStages;
            var cur = stages[g.Stage];
            const double G = 188.5;   // 성장 고리 둘레(r = 30)
            <a class="hj-grow" href="/@slug/points" aria-label="나의 점수 성장일지">
                <span class="hj-ring g" aria-hidden="true">
                    <svg width="76" height="76" viewBox="0 0 76 76"><circle cx="38" cy="38" r="30" fill="none" stroke="var(--hj-green-l)" stroke-width="8" /><circle cx="38" cy="38" r="30" fill="none" stroke="var(--hj-green)" stroke-width="8" stroke-linecap="round" stroke-dasharray="@((G * g.Percent / 100).ToString("0.#", inv)) @G.ToString("0.#", inv)" transform="rotate(-90 38 38)" /></svg>
                    <span><i>@Ico(cur.Emoji)</i>@cur.Name @(g.Percent)%</span>
                </span>
                <span class="hj-gtx"><small>나의 점수</small><b class="num">@d.SeasonPoints.ToString("N0")<u>점</u></b>
                    <em>@(g.Done ? $"{cur.Name}까지 모두 자랐어요" : $"{cur.Name}{Ro(cur.Name)} 자라는 중")</em></span>
                @* 오른쪽 "○○까지 N점"은 지웠다(2026-11-03 사용자) *@
            </a>
            <ol class="hj-stg" aria-label="성장 단계">
                @for (var i = 0; i < stages.Count; i++)
                {
                    var s = stages[i];
                    var state = i < g.Stage || g.Done ? "d" : i == g.Stage ? "c" : "";
                    if (i > 0) { <li class="ln @(i <= g.Stage || g.Done ? "d" : "")" aria-hidden="true"></li> }
                    <li class="st @state" aria-current="@(state == "c" ? "step" : "false")"><span aria-hidden="true">@Ico(s.Emoji)</span><small>@s.Name</small></li>
                }
            </ol>
            <a class="hj-more" href="/@slug/points">@if (d.Streak > 0) { <span>🔥 @(d.Streak)일째 이어 하는 중 · </span> }<b>성장일지 ›</b></a>
        }
    </section>

    @if (t.ReadingEnabled)
    {
        <section class="hj-card hj-sr" aria-label="말씀 찾기">
            <div class="tg"><b>📖 말씀 찾기</b><span>궁금한 단어 하나로 성경 전체를 찾아봐요</span></div>
            @* 홈에서는 입력받지 않고 누르면 검색 화면으로(2026-11-03 사용자) *@
            <a class="sx" href="/@slug/reading/search" aria-label="말씀 찾기 화면으로"><span class="ph"><i aria-hidden="true">🔍</i><em>예) 사랑, 믿음, 소망, 예수… 어떤 말씀이든 찾아봐요</em></span><span class="bt">검색</span></a>
            <div class="kw">@foreach (var k in new[] { "두려워하지 말라", "은혜", "평안", "기도" }) { <a href="/@slug/reading/search?q=@Uri.EscapeDataString(k)">@k</a> }</div>
        </section>
    }

    @if (t.MissionEnabled)
    {
        const double C2 = 188.5;
        var pctToday = has.Count == 0 ? 0 : done * 100.0 / has.Count;
        <section class="hj-card hj-pg m" aria-labelledby="pmT">
            <h2 id="pmT"><a href="/@slug/word-mission">🎯 도전!!! 성경말씀</a>@if (d.Participant) { <b class="num">@d.SeasonPoints.ToString("N0")<u>P</u></b> }</h2>
            <div class="hj-row">
                <span class="hj-ring o" role="img" aria-label="오늘 미션 @(has.Count)개 중 @(done)개 완료">
                    <svg width="76" height="76" viewBox="0 0 76 76" aria-hidden="true"><circle cx="38" cy="38" r="30" fill="none" stroke="var(--hj-org-l)" stroke-width="8" /><circle cx="38" cy="38" r="30" fill="none" stroke="var(--hj-org)" stroke-width="8" stroke-linecap="round" stroke-dasharray="@((C2 * pctToday / 100).ToString("0.#", inv)) @C2.ToString("0.#", inv)" transform="rotate(-90 38 38)" /></svg>
                    <span><b class="num">@done/@has.Count</b>오늘 미션</span>
                </span>
                @* 오늘의 말씀 칸 → 미션홈(2026-11-03 사용자) *@
                <a class="hj-box o" href="/@slug/word-mission">
                    <small>오늘의 말씀</small>
                    @if (d.WordTitle is not null) { <b>@d.WordTitle</b><span>@d.WordRange ›</span> }
                    else { <b>오늘은 말씀이 없어요</b><span>내일 다시 만나요</span> }
                </a>
            </div>
            <div class="hj-m4">
                @foreach (var m in d.Missions)
                {
                    @* 대기 중인 미션은 모두 같은 주황(2026-11-03 사용자) — 예전엔 다음 하나만 주황 *@
                    var cls = !m.Has ? "no" : m.Done ? "ok" : d.Participant ? "cur" : "";
                    <a class="@cls" href="/@slug/@m.Key">@m.Label<small>@(!d.Participant && m.Has ? "보기만" : m.Done || !m.Has ? m.State : m.State + " ›")</small></a>
                }
            </div>
            @if (d.Participant && d.SeasonDay > 0)
            {
                var fp = Math.Clamp(d.FullDays * 100.0 / d.SeasonDay, 0, 100);
                <div class="hj-bar o" aria-hidden="true"><i style="width:@fp.ToString("0.#", inv)%"></i></div>
                <div class="hj-bl"><span>올해 네 가지 다 한 날 @(d.FullDays)일 / @(d.SeasonDay)일</span><b>@((int)fp)%</b></div>
            }
            @* "● 오늘 N명 참여 중" 줄은 지웠다(2026-11-03 사용자) — 아래 "우리 부서 오늘 참여"에 같은 숫자 *@
        </section>
    }

    @if (t.ReadingEnabled)
    {
        <section class="hj-card hj-pg r" aria-labelledby="prT">
            <h2 id="prT"><a href="/@slug/reading">📖 도전!!! 성경통독</a>@if (rd is not null) { <small>@(rd.RoundNo)독째@(rd.TodayChapters > 0 ? $" · 오늘 {rd.TodayChapters}장" : "")</small> }</h2>
            @if (rd is null)
            {
                <a class="hj-box r wide" href="/@slug/reading"><small>아직 시작 전이에요</small><b>통독 시작하기 →</b><span>창세기 1장부터 내 속도로 읽어요 · 점수는 없어요</span></a>
            }
            else
            {
                var pct = ReadingSummary.Percent(rd.ReadChapters, ReadingSummary.Total);
                var book = rd.Books.First(b => b.BookId == rd.Resume.BookId);
                <div class="hj-row">
                    <span class="hj-ring b" role="img" aria-label="전체 진도 @(pct.ToString("0.0"))%">
                        <svg width="76" height="76" viewBox="0 0 76 76" aria-hidden="true"><circle cx="38" cy="38" r="30" fill="none" stroke="var(--hj-blue-l)" stroke-width="8" /><circle cx="38" cy="38" r="30" fill="none" stroke="var(--hj-blue)" stroke-width="8" stroke-linecap="round" stroke-dasharray="@((188.5 * Math.Max(pct, rd.ReadChapters > 0 ? 1 : 0) / 100).ToString("0.#", inv)) 188.5" transform="rotate(-90 38 38)" /></svg>
                        <span><b class="num">@pct.ToString("0.0")</b>%</span>
                    </span>
                    <a class="hj-box r" href="/@slug/reading/read/@rd.Resume.BookId/@rd.Resume.Chapter">
                        <small>이어 읽을 곳</small><b>@book.Name</b><span>@(rd.Resume.Chapter)@(book.BookId == 19 ? "편" : "장") @(rd.Resume.Verse)절 ›</span>
                    </a>
                </div>
                <div class="hj-n3">
                    <div><b class="num">@rd.ReadChapters.ToString("N0")</b><small>읽은 장</small></div>
                    <div><b class="num">@((ReadingSummary.Total - rd.ReadChapters).ToString("N0"))</b><small>남은 장</small></div>
                    <div><b class="num">@ReadingSummary.Total.ToString("N0")</b><small>전체</small></div>
                </div>
            }
        </section>
    }

    @if (t.MissionEnabled && Model.IsGuardian)
    {
        <a class="notice" href="/@slug/guardian"><b>자녀 미션 보기</b><span>연결된 자녀의 오늘 미션 · 점수 →</span></a>
    }

    @if (Model.Family is { } f)
    {
        var span = (f.NextStage ?? f.Total) - f.PrevStage;
        var fpct = f.NextStage is null ? 100 : span <= 0 ? 0 : Math.Clamp((f.Total - f.PrevStage) * 100.0 / span, 1, 100);
        var famHref = d.Rules.Features.Ranking ? $"/{slug}/ranking?t=team" : null;
        <a class="hj-card hj-line" href="@famHref">
            <span class="ic y" aria-hidden="true">👨‍👩‍👧</span>
            <span class="tx"><b>우리 가족팀 · <span class="num">@f.Total.ToString("N0")</span>점</b>
                <small>@f.Name · @(f.NextStage is { } n ? $"다음 가족 축하까지 {n - f.Total:N0}점" : "모든 가족 단계를 넘었어요")</small>
                <span class="pb" aria-hidden="true"><i style="width:@fpct.ToString("0.#", inv)%"></i></span></span>
            <span class="ar" aria-hidden="true">›</span>
        </a>
    }
    @if (Model.OnFamily is { } of)
    {
        <a class="hj-card hj-line" href="/account/family"><span class="ic y" aria-hidden="true">🏡</span><span class="tx"><b>@of.Name · <span class="num">@of.Total.ToString("N0")</span>점</b><small>온가족 · 보기만</small></span><span class="ar" aria-hidden="true">›</span></a>
    }

    @if (d.Dept is { } dp && t.MissionEnabled)
    {
        <div class="hj-two">
            <a class="hj-card hj-mini" href="@(d.Rules.Features.Ranking ? $"/{slug}/ranking" : null)"><small>우리 부서 오늘 참여</small><b class="num">@dp.TodayPeople<u>명</u></b></a>
            <div class="hj-card hj-mini"><small>나는 오늘</small>@if (dp.MyOrderToday is int mo) { <b class="num">@mo<u>번째</u></b> } else { <b>아직</b> }</div>
        </div>
    }
</div></main>
}

<footer class="gut"><div class="wrap">
    <div class="acct">
        <a href="/account">내 계정</a>
        @if (Model.Tenant.IsLobby) { <a href="/join">내 부서 참여</a> } else { <a href="/account/tenants">부서 바꾸기</a> }
        @if (Model.Tenant.IsAdmin) { <a class="adm" href="/@slug/admin">관리</a> }
        @if (User.IsPlatformAdmin()) { <a href="/platform">플랫폼</a> }
        <form method="post" action="/account/logout" asp-antiforgery="true"><button type="submit">로그아웃</button></form>
    </div>
    <p class="copy">© @d.Today.Year 잠실새내 · 주일학교</p>
</div></footer>
</div>
