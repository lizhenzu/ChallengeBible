@page "/{slug:regex(^[a-z0-9-]{{2,40}}$)}/{view:regex(^today$)?}"
@model TenantHomeModel
@using ChallengeBible.Infrastructure.Data
@using ChallengeBible.Web.Auth
@using ChallengeBible.Web.Services
@* 2026-11-23 사용자 확정(design_handoff_home_b): 부서 홈 = 시안 B 모노 톤.
   머리말(☰ · 교회 · 날짜 · 쪽지 · 내 계정) → 로고 → 검색 → 네 가지 도전 목록 → 가족팀/임시 부서 안내 → 링크.
   기능 카드(가족팀 · 임시 부서 1단계 안내 · 생일 · 쪽지)는 그대로 둔다. *@
@{
    var d = Model.Data;
    var t = Model.Tenant.Current;
    var slug = t.Slug;
    var ko = new System.Globalization.CultureInfo("ko-KR");
    var lobby = Model.Tenant.IsLobby;
    var intro = lobby && !Model.TodayScreen;
    var loginTo = "/account/login?returnUrl=" + Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString);
    static string Ro(string w) { var c = w.Length == 0 ? 'a' : w[^1]; var j = c is >= '가' and <= '힣' ? (c - '가') % 28 : 0; return j == 0 || j == 8 ? "로" : "으로"; }
}
<link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<div class="@(intro ? "hm hmx sky" : "vb vb-dept")@(lobby ? " lobby" : "")">

@if (intro)
{
    <div class="wl">
        <header class="wl-top gut"><div class="wrap">
            <button type="button" class="pmenu-btn hm-menu" aria-label="메뉴 열기" aria-controls="pnav" aria-expanded="false" data-pnav-open>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h12"/></svg>
            </button>
            <div class="wl-org"><small>대한예수교장로회</small><a class="church" href="https://www.saenae.org/" target="_blank" rel="noopener" aria-label="잠실새내교회 홈페이지 (새 창)">잠실새내교회<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a></div>
            <span class="wl-today"><b>@d.Today.ToString("M월 d일", ko)</b> @d.Today.ToString("dddd", ko)</span>
            <partial name="_MailBadge" />
        </div></header>
        <section class="wl-hi gut" aria-labelledby="wlHi"><div class="wrap">
            <div class="wl-k">환영해요</div>
            <h1 id="wlHi">@Ui.Nim(User.DisplayName()),<br>반가워요!</h1>
            <p class="wl-sub">먼저 내가 참여할 부서를 골라요.</p>
            <div class="wl-card">
                <h2>시작까지 2단계</h2>
                <ol class="wl-steps">
                    <li class="wl-done"><span class="wl-ic" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></span>
                        <div class="wl-tx"><b>가입 <span class="wl-tag wl-done">완료</span></b><span>이름 · 이메일 · 비밀번호만 있으면 돼요</span></div></li>
                    <li class="wl-now"><span class="wl-ic" aria-hidden="true">2</span>
                        <div class="wl-tx"><b>내 부서 참여 <span class="wl-tag wl-now">지금 할 일</span></b><span>목록에서 내 부서를 고르면 바로 시작해요</span></div></li>
                </ol>
                <a class="wl-btn wl-p" href="/join">내 부서 참여 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                <a class="wl-btn wl-s" href="/@slug/today">먼저 미션 해 보기 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                <p class="wl-keep"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>여기서 한 미션 기록 · 점수는 부서로 그대로 옮겨져요.</p>
            </div>
        </div></section>
    </div>
}
else
{
    <header class="vb-hero">
        <img class="vb-clover" src="~/icons/clover.svg" alt="" aria-hidden="true" />
        <div class="vb-hero-in">
            <div class="vb-top">
                <div class="vb-top-l">
                    @if (!Model.Guest)
                    {
                        <button type="button" class="vb-burger" aria-label="메뉴 열기" aria-controls="pnav" aria-expanded="false" data-pnav-open>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                        </button>
                    }
                    @* 머리줄 표준(2026-11-24 확정 · 기준표 5판): 왼쪽은 ☰ + 소속 이름 하나(교회 홈페이지 링크는 ☰ 메뉴에서도 뺌, 2026-11-25) *@
                    <span class="church"><span>@PlatformTodayService.ShortDept(t.Name)</span></span>
                </div>
                <div class="vb-top-r">
                    @if (Model.Guest)
                    {
                        <a class="person-btn" href="@loginTo" aria-label="로그인" title="로그인">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20c1.2-3.6 4.1-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/></svg>
                        </a>
                    }
                    else
                    {
                        @* 오른쪽 위(2026-11-25 사용자): 날짜(월 일 · 요일) + 검은 동그라미(편지 = 쪽지). 내 계정은 ☰ 맨 아래 프로필 *@
                        <span class="vb-dc">
                            <time class="vb-dd" datetime="@d.Today.ToString("yyyy-MM-dd")">@d.Today.ToString("M월 d일", ko)<small>@d.Today.ToString("dddd", ko)</small></time>
                            <span class="vb-circ"><partial name="_MailBadge" /></span>
                        </span>
                    }
                </div>
            </div>

            <div class="vb-hero-row">
                <div class="vb-body">
                    @if (Model.Guest)
                    {
                        <time class="vb-today" datetime="@d.Today.ToString("yyyy-MM-dd")">@d.Today.ToString("M월 d일 dddd", ko)</time>   @* 날짜는 머리줄에서 본문 위로(기준표 5판) *@
                    }
                    @* 인사말(2026-11-25 사용자 B안): 제목 위 두 줄 — 「안녕하세요」 작게 · 이름 조금 크게 + 「님」 작게. 로그인한 사람에게만 *@
                    @if (!Model.Guest)
                    {
                        <p class="vb-hi"><span class="g">안녕하세요</span><b>@Ui.NameOnly(User.DisplayName())</b><small>님</small></p>
                    }
                    <h1 class="brand-title">
                        <span class="bt-1">도전<span class="bt-ex"><i class="e1">!</i><i class="e2">!</i><i class="e3">!</i></span></span>
                        <span class="bt-2">성경말씀</span>
                    </h1>
                    <p class="vb-tag">@(lobby ? "먼저 미션으로 시작해 보세요." : "하루 5분, 말씀과 함께 자라요.")</p>
                </div>
                @* 나의 포인트 링(2026-11-23 사용자 확정 B안 · ADR 0136): 「도전 성경말씀」 오른쪽 빈자리. 누르면 「나의 도전」 화면. *@
                @if (Model.Ring is { } ring)
                {
                    ViewData["RingSize"] = 92;
                    <partial name="_PointRing" model="ring" />
                }
            </div>
        </div>
    </header>

    <main class="vb-main">

        @if (t.ReadingEnabled)
        {
            <form class="hmx-search" method="get" action="@($"/{slug}/reading/search")" role="search">
                <input type="search" name="q" maxlength="50" placeholder="성경에서 단어 검색" aria-label="성경에서 단어 검색" />
                <button type="submit">검색</button>
            </form>
        }

        <div class="vb-sec-h">
            <h2>4가지 도전</h2>
            <p>어느 것부터 해도 좋아요</p>
        </div>

        <nav class="vb-list" aria-label="프로그램 바로가기">
            @if (t.MissionEnabled)
            {
                <a class="vb-item" href="/@slug/word-mission" style="--c: var(--p1); --s: var(--s1);">
                    <span class="vb-no">01</span>
                    <span class="vb-t"><small>도전!!!</small><b>성경미션</b><p>매일 하나씩 주어지는 말씀 미션을 풀어요</p></span>
                    <span class="vb-go"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                </a>
            }
            @if (t.ReadingEnabled)
            {
                <a class="vb-item" href="/@slug/reading" style="--c: var(--p2); --s: var(--s2);">
                    <span class="vb-no">02</span>
                    <span class="vb-t"><small>도전!!!</small><b>성경통독</b><p>계획표를 따라 하루 몇 장씩, 끝까지 읽어요</p></span>
                    <span class="vb-go"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                </a>
            }
            @if (t.CopyEnabled)
            {
                <a class="vb-item" href="/@slug/copy" style="--c: var(--p3); --s: var(--s3);">
                    <span class="vb-no">03</span>
                    <span class="vb-t"><small>도전!!!</small><b>성경필사</b><p>말씀을 한 절씩 따라 쓰며 마음에 새겨요</p></span>
                    <span class="vb-go"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                </a>
            }
            @if (Model.PrayerVisible)
            {
                <a class="vb-item" href="/@slug/prayer365" style="--c: var(--p4); --s: var(--s4);">
                    <span class="vb-no">04</span>
                    <span class="vb-t"><small>자녀를 위한</small><b>365축복기도</b><p>매일 한 가지 주제로 자녀를 위해 기도해요</p></span>
                    <span class="vb-go"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                </a>
            }
        </nav>

        @* 가족팀(2026-11-22 3차 확정): 초대 배너 → 우리 가족팀 카드 → 둘 다 없으면 만들기 유도. 현황 카드 아래. *@
        @if (!lobby && t.MissionEnabled && d.Rules.Features.FamilyTeam)
        {
            if (Model.Invites.Count > 0)
            {
                var first = Model.Invites[0];
                <section class="hmx-inv" aria-label="가족팀 초대">
                    <div class="hd">
                        <span class="em" aria-hidden="true">💌</span>
                        <div><b>가족팀 초대가 왔어요!</b>
                            <small>@(Model.Invites.Count > 1 ? $"{first.TeamName} 외 {Model.Invites.Count - 1}팀에서 초대했어요" : $"{Ui.Nim(first.InvitedBy)}이 {first.TeamName}{Ro(first.TeamName)} 초대했어요")</small>
                        </div>
                        <span class="cnt num">@(Model.Invites.Count)개</span>
                    </div>
                    <div class="row">
                        <a class="go" href="/@slug/family-team">초대 확인하기</a>
                        <form method="post" asp-page-handler="SnoozeInvites" asp-route-slug="@slug"><button type="submit" class="later">다음에 할래요</button></form>
                    </div>
                </section>
            }
            else if (Model.Family is null && Model.FamilyCanJoin)
            {
                <section class="hmx-make" aria-label="가족팀 · 친구팀 만들기">
                    <div class="hd">
                        <span class="em" aria-hidden="true">👨‍👩‍👧</span>
                        <div><b>가족팀 · 친구팀을 만들어 보세요</b><small>함께 하면 점수가 모여요. 부모님·형제, 친구와 팀을 이뤄요.</small></div>
                    </div>
                    <div class="row">
                        <a class="go" href="/@slug/family-team">가족팀 만들기</a>
                        @if (Model.FamilyIsStudent) { <a class="alt" href="/@slug/family-team">친구팀 만들기</a> }
                    </div>
                </section>
            }
        }

        @if (lobby)
        {
            if (Model.Waiting.Count == 0)
            {
                <section class="lb-ban lb-go" aria-labelledby="lbT">
                    <p><b id="lbT">아직 내 부서가 없어요</b>내 부서에 참여 신청하면 선생님이 승인해요. 지금 한 미션 · 점수는 그 부서로 옮겨져요.</p>
                    <a class="lb-btn p" href="/join">내 부서 참여 신청하기 →</a>
                </section>
            }
            else
            {
                var depts = string.Join(" · ", Model.Waiting.Select(w => w.StartsWith("잠실새내교회 ") ? w["잠실새내교회 ".Length..] : w));
                <section class="lb-ban lb-wait" aria-labelledby="lbT">
                    <p><b id="lbT"><span class="lb-pill">승인 기다리는 중</span>@depts</b>선생님이 승인하면 바로 @depts@(Ro(depts)) 바뀌어요. 그동안 여기서 미션을 계속해요.</p>
                    <a class="lb-btn s" href="/join">신청 확인 · 바꾸기 →</a>
                </section>
            }
        }

        <div class="hmx-links">
            @if (Model.IsGuardian)
            {
                <a href="/@slug/guardian">자녀 미션 보기</a>
            }
            <a href="/@slug/feedback">의견 보내기</a>
        </div>

    </main>
}

@if (Model.BirthdayPopup is { } bp)
{
    <div class="bdh-pop" data-bdh-pop role="dialog" aria-modal="true" aria-labelledby="bdhT">
        <div class="bdh-box">
            <div class="bdh-em" aria-hidden="true">🎂🎁</div>
            <h2 id="bdhT">@(bp.Name.Length > 0 ? bp.Name : User.Identity?.Name)님, 생일 축하해요!</h2>
            <p>@bp.Birthday.ToString("M월 d일") 생일 선물을 골라 주세요.@if (bp.OpenUntil is { } pu) { <br />@($"{pu:M월 d일}까지 고를 수 있어요.") }</p>
            <a class="bdh-pick" href="/@t.Slug/gifts/birthday/@bp.Id">선물 고르러 가기</a>
            <form method="post" asp-page-handler="SnoozeBirthday" asp-route-slug="@slug" class="bdh-later">
                <small>다음에 할래요</small>
                <div><button type="submit" name="days" value="1">내일 다시</button><button type="submit" name="days" value="3">3일 뒤</button><button type="submit" name="days" value="5">5일 뒤</button></div>
            </form>
        </div>
    </div>
}
@if (!Model.Guest) { <partial name="_MsgPopup" model="(Model.NewMessages, Model.NewList, '/' + slug)" /> }

@if (!Model.Guest) { <partial name="_TenantDrawer" model="(Model.Tenant, Model.MyPhoto)" /> }

@if (!intro)
{
    @* 맨 아래 문구는 첫 화면(홈 루트)과 똑같이: 가운데 · 11.5px · 보조색, 오른쪽 「앱으로 설치」(2026-11-24 사용자) *@
    <footer class="vb-main vb-bottom"><div class="vb-foot"><div class="vb-footrow">
        <span class="foot">© @d.Today.Year 잠실새내 · 주일학교</span>
        <a href="/install">앱으로 설치</a>
    </div></div></footer>
}
else
{
    <footer class="gut"><div class="wrap">
        <p class="foot-copy">© @d.Today.Year 잠실새내 · 주일학교</p>
    </div></footer>
}
</div>
