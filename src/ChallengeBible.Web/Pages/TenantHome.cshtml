@page "/{slug:regex(^[a-z0-9-]{{2,40}}$)}/{view:regex(^today$)?}"
@model TenantHomeModel
@using ChallengeBible.Infrastructure.Data
@using ChallengeBible.Web.Auth
@using ChallengeBible.Web.Services
@* 2026-11-23 사용자 확정(design_handoff_home_b): 부서 홈 = 시안 B 모노 톤.
   머리말(☰ · 교회 · 날짜 · 쪽지 · 내 계정) → 로고 → 검색 → 네 가지 도전 목록 → 가족팀/임시 부서 안내 → 링크.
   기능 카드(가족팀 · 임시 부서 1단계 안내 · 생일 · 쪽지)는 그대로 둔다. *@
@{
    var d = Model.Data;
    var t = Model.Tenant.Current;
    var slug = t.Slug;
    var ko = new System.Globalization.CultureInfo("ko-KR");
    var lobby = Model.Tenant.IsLobby;
    var intro = lobby && !Model.TodayScreen;
    string Go(string path) => Model.Guest ? "/account/login?returnUrl=" + Uri.EscapeDataString(path) : path;   // 2026-11-27 사용자: 로그인 안 했으면 누르면 로그인 창으로
    var loginTo = "/account/login?returnUrl=" + Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString);
    static string Ro(string w) { var c = w.Length == 0 ? 'a' : w[^1]; var j = c is >= '가' and <= '힣' ? (c - '가') % 28 : 0; return j == 0 || j == 8 ? "로" : "으로"; }
}
<link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/dept-home.css" asp-append-version="true" />
<div class="@(intro ? "hm hmx sky" : "dh")@(lobby ? " lobby" : "")">

@if (intro)
{
    <div class="wl">
        <header class="wl-top gut"><div class="wrap">
            <button type="button" class="pmenu-btn hm-menu" aria-label="메뉴 열기" aria-controls="pnav" aria-expanded="false" data-pnav-open>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h12"/></svg>
            </button>
            <div class="wl-org"><small>대한예수교장로회</small><a class="church" href="https://www.saenae.org/" target="_blank" rel="noopener" aria-label="잠실새내교회 홈페이지 (새 창)">잠실새내교회<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a></div>
            <span class="wl-today"><b>@d.Today.ToString("M월 d일", ko)</b> @d.Today.ToString("dddd", ko)</span>
            <partial name="_MailBadge" />
        </div></header>
        <section class="wl-hi gut" aria-labelledby="wlHi"><div class="wrap">
            <div class="wl-k">환영해요</div>
            <h1 id="wlHi">@Ui.Nim(User.DisplayName()),<br>반가워요!</h1>
            <p class="wl-sub">먼저 내가 참여할 부서를 골라요.</p>
            <div class="wl-card">
                <h2>시작까지 2단계</h2>
                <ol class="wl-steps">
                    <li class="wl-done"><span class="wl-ic" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></span>
                        <div class="wl-tx"><b>가입 <span class="wl-tag wl-done">완료</span></b><span>이름 · 이메일 · 비밀번호만 있으면 돼요</span></div></li>
                    <li class="wl-now"><span class="wl-ic" aria-hidden="true">2</span>
                        <div class="wl-tx"><b>내 부서 참여 <span class="wl-tag wl-now">지금 할 일</span></b><span>목록에서 내 부서를 고르면 바로 시작해요</span></div></li>
                </ol>
                <a class="wl-btn wl-p" href="/join">내 부서 참여 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                <a class="wl-btn wl-s" href="/@slug/today">먼저 미션 해 보기 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                <p class="wl-keep"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>여기서 한 미션 기록 · 점수는 부서로 그대로 옮겨져요.</p>
            </div>
        </div></section>
    </div>
}
else
{
    <header class="dh-hero">
        @* 머리줄(2026-11-27 사용자 새 퍼블리시본 dojeon-home.html 완전 교체): 왼쪽 교회 이름 · 오른쪽 홈(메인화면) → 쪽지(로그인 전은 사람 아이콘) → 날짜 *@
        <div class="dh-top">
            <a class="dh-church" href="https://www.saenae.org/" target="_blank" rel="noopener" aria-label="잠실새내교회 홈페이지 (새 창)"><small>대한예수교장로회</small><span>잠실새내교회</span></a>
            <div class="dh-top-r">
                @if (Model.Guest)
                {
                    <a class="dh-circ" href="@loginTo" aria-label="로그인" title="로그인">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.2-4.2 4.2-6 8-6s6.8 1.8 8 6"/></svg>
                    </a>
                }
                else
                {
                    <span class="dh-circ"><partial name="_MailBadge" /></span>
                }
                @if (Model.MainOn)
                {
                    <a class="dh-circ" href="/@slug/welcome" aria-label="메인화면으로 이동">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11 12 3l9 8"/><path d="M5 10v10h14V10"/></svg>
                    </a>
                }
            </div>
        </div>

        <div class="dh-hero-row">
            <div class="dh-body">
                @if (!Model.Guest)
                {
                    var nm = Ui.NameOnly(User.DisplayName());
                    <p class="dh-hi"><span class="dh-g">안녕하세요</span><a class="dh-me" href="/account" aria-label="@(nm)님 — 내 계정 열기"><b>@nm</b><small>님</small></a></p>
                }
                <h1 class="dh-title">
                    <span>도전<i class="dh-e1">!</i><i class="dh-e2">!</i><i class="dh-e3">!</i></span>
                    <span>성경말씀</span>
                </h1>
                <p class="dh-tag">@if (lobby) { <text>먼저 미션으로 시작해 보세요.</text> } else { <text>4가지 도전, 하나의 말씀.<br>하루 5분, 말씀과 함께 자라요.</text> }</p>
            </div>
            @* 포인트 링(시안): 둘레 2πr = 260.8, 채움 = 260.8 × (1 − 다음 단계까지 비율). 누르면 「나의 도전」(손님은 로그인) *@
            @if (Model.Ring is { } ring)
            {
                var rOff = (260.8 * (1 - Math.Clamp(ring.Growth.Percent, 0, 100) / 100.0)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                var rN = ring.Points.ToString("N0").Count(char.IsDigit);
                var rCls = rN >= 5 ? " d5" : rN == 4 ? " d4" : "";
                <a class="dh-ring" href="@ring.Href" aria-label="나의 포인트 @(ring.Points.ToString("N0"))점 · @(ring.Growth.Name) 단계 — 나의 도전 열기">
                    <span class="dh-rg">
                        <svg viewBox="0 0 92 92" aria-hidden="true">
                            <circle class="dh-trk" cx="46" cy="46" r="41.5" stroke-width="9"/>
                            <circle class="dh-arc" cx="46" cy="46" r="41.5" stroke-width="9" stroke-dasharray="260.8" stroke-dashoffset="@rOff"/>
                        </svg>
                        <span class="dh-in"><b class="dh-pts@(rCls)">@ring.Points.ToString("N0")<i>점</i></b><span class="dh-stg">@ring.Growth.Name</span></span>
                    </span>
                </a>
            }
        </div>

        @if (t.ReadingEnabled)
        {
            <form class="dh-search" method="get" action="@($"/{slug}/reading/search")" role="search" data-hsearch data-guest="@(Model.Guest ? "true" : "false")">
                <label class="dh-sr" for="dhq">성경에서 단어 검색</label>
                <input id="dhq" type="search" name="q" maxlength="50" placeholder="성경에서 단어 검색" autocomplete="off">
                <button type="submit">검색</button>
            </form>
            <p class="dh-search-err" data-hsearch-err hidden>찾을 단어를 한 글자 이상 넣어 주세요.</p>
        }
    </header>

    <main class="dh-main">
        <div class="dh-sec-h">
            <h2>4가지 도전</h2>
            <p>어느 것부터 해도 좋아요</p>
        </div>
        <nav class="dh-list" aria-label="프로그램">
            @if (t.MissionEnabled)
            {
                <a class="dh-item dh-k1" href="@Go($"/{slug}/word-mission")"><span class="dh-no">01</span><span class="dh-t"><small>도전!!!</small><b>성경미션</b><span>매일 하나씩 주어지는 말씀 미션을 풀어요</span></span><span class="dh-go"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
            }
            @if (t.ReadingEnabled)
            {
                <a class="dh-item dh-k2" href="@Go($"/{slug}/reading")"><span class="dh-no">02</span><span class="dh-t"><small>도전!!!</small><b>성경통독</b><span>계획표를 따라 하루 몇 장씩, 끝까지 읽어요</span></span><span class="dh-go"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
            }
            @if (t.CopyEnabled)
            {
                <a class="dh-item dh-k3" href="@Go($"/{slug}/copy")"><span class="dh-no">03</span><span class="dh-t"><small>도전!!!</small><b>성경필사</b><span>말씀을 한 절씩 따라 쓰며 마음에 새겨요</span></span><span class="dh-go"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
            }
            @if (Model.PrayerVisible)
            {
                <a class="dh-item dh-k4" href="@Go($"/{slug}/prayer365")"><span class="dh-no">04</span><span class="dh-t"><small>자녀를 위한</small><b>365축복기도</b><span>매일 한 가지 주제로 자녀를 위해 기도해요</span></span><span class="dh-go"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
            }
        </nav>

        @if (lobby)
        {
            if (Model.Waiting.Count == 0)
            {
                <section class="lb-ban lb-go" aria-labelledby="lbT">
                    <p><b id="lbT">아직 내 부서가 없어요</b>내 부서에 참여 신청하면 선생님이 승인해요. 지금 한 미션 · 점수는 그 부서로 옮겨져요.</p>
                    <a class="lb-btn p" href="/join">내 부서 참여 신청하기 →</a>
                </section>
            }
            else
            {
                var depts = string.Join(" · ", Model.Waiting.Select(w => w.StartsWith("잠실새내교회 ") ? w["잠실새내교회 ".Length..] : w));
                <section class="lb-ban lb-wait" aria-labelledby="lbT">
                    <p><b id="lbT"><span class="lb-pill">승인 기다리는 중</span>@depts</b>선생님이 승인하면 바로 @depts@(Ro(depts)) 바뀌어요. 그동안 여기서 미션을 계속해요.</p>
                    <a class="lb-btn s" href="/join">신청 확인 · 바꾸기 →</a>
                </section>
            }
        }

        <div class="dh-foot">
            @if (Model.MainOn)
            {
                <a class="dh-fb dh-homec" href="/@slug/welcome">
                    <span class="dh-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11 12 3l9 8"/><path d="M5 10v10h14V10"/></svg></span>
                    <span class="dh-tx"><b>메인화면으로 가기</b></span>
                    <svg class="dh-ar" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
                </a>
            }
            <a class="dh-fb" href="/@slug/feedback">
                <span class="dh-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/><path d="M8.5 9.5h7M8.5 12.5h4.5"/></svg></span>
                <span class="dh-tx"><b>개선사항 · 불편사항 접수</b></span>
                <svg class="dh-ar" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
            </a>
            <div class="dh-inst">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M12 7.5v6.5M9.5 11.5 12 14l2.5-2.5M10.5 18.5h3"/></svg>
                <span class="dh-tx"><b>홈 화면에 바로가기를 만들어요</b><small>앱처럼 한 번에 열 수 있어요</small></span>
                <a href="/install">설치</a>
            </div>
            <p class="dh-addr">서울특별시 송파구 석촌호수로 102</p>
        </div>
    </main>
}

@if (Model.BirthdayPopup is { } bp)
{
    <div class="bdh-pop" data-bdh-pop role="dialog" aria-modal="true" aria-labelledby="bdhT">
        <div class="bdh-box">
            <div class="bdh-em" aria-hidden="true">🎂🎁</div>
            <h2 id="bdhT">@(bp.Name.Length > 0 ? bp.Name : User.Identity?.Name)님, 생일 축하해요!</h2>
            <p>@bp.Birthday.ToString("M월 d일") 생일 선물을 골라 주세요.@if (bp.OpenUntil is { } pu) { <br />@($"{pu:M월 d일}까지 고를 수 있어요.") }</p>
            <a class="bdh-pick" href="/@t.Slug/gifts/birthday/@bp.Id">선물 고르러 가기</a>
            <form method="post" asp-page-handler="SnoozeBirthday" asp-route-slug="@slug" class="bdh-later">
                <small>다음에 할래요</small>
                <div><button type="submit" name="days" value="1">내일 다시</button><button type="submit" name="days" value="3">3일 뒤</button><button type="submit" name="days" value="5">5일 뒤</button></div>
            </form>
        </div>
    </div>
}
@if (!Model.Guest) { <partial name="_MsgPopup" model="(Model.NewMessages, Model.NewList, '/' + slug)" /> }

@if (!Model.Guest) { <partial name="_TenantDrawer" model="(Model.Tenant, Model.MyPhoto)" /> }

@if (intro)
{
    <footer class="gut"><div class="wrap">
        <p class="foot-copy">© @d.Today.Year 잠실새내 · 주일학교</p>
    </div></footer>
}
</div>
<script>
    // 검색(2026-11-27 사용자): 단어 없이 누르면 막고 안내, 로그인 안 했으면 로그인 창으로(로그인한 뒤 검색 결과로 돌아온다)
    (() => {
        const f = document.querySelector('[data-hsearch]'); if (!f) return;
        const err = document.querySelector('[data-hsearch-err]');
        f.addEventListener('submit', (e) => {
            const q = f.querySelector('input').value.trim();
            if (!q) { e.preventDefault(); if (err) err.hidden = false; f.querySelector('input').focus(); f.style.borderColor = '#b42318'; return; }
            if (f.dataset.guest === 'true') { e.preventDefault(); location.href = '/account/login?returnUrl=' + encodeURIComponent(f.getAttribute('action') + '?q=' + encodeURIComponent(q)); }
        });
    })();
</script>
<script>
    // 설치띠(2026-11-27 사용자): 설치를 마친 폰이면 브라우저로 열어도 숨긴다(설치 안내 화면이 localStorage cb-install 에 남기는 기록) · 앱으로 설치되는 순간에도
    (() => {
        const bar = document.querySelector('.dh-inst'); if (!bar) return;
        try { if (JSON.parse(localStorage.getItem('cb-install') || '{}').s === 'done') bar.hidden = true; } catch { /* 무시 */ }
        addEventListener('appinstalled', () => { bar.hidden = true; });
    })();
</script>
