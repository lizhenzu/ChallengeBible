@page "/{slug:regex(^[a-z0-9-]{{2,40}}$)}"
@model TenantHomeModel
@* 홈 메인(0044) 1차 간단판: 프로그램 카드. 가족팀 · 오늘 한 줄은 뒤 단계에서 확정 시안대로 *@
<partial name="_Top" />
<main class="page gut"><div class="wrap">
    <div>
        <p class="sub" style="margin:0">@Model.Tenant.Current.Name</p>
        <h1>@Model.Tenant.AppName</h1>
    </div>
    @if (Model.Tenant.Current.MissionEnabled)
    {
        <a class="dept" href="/@Model.Tenant.Current.Slug/word-mission"><span class="mk">말</span><div><b>도전!!!성경말씀</b><span class="sub" style="margin:0;font-size:13px">오늘의 말씀 · 퀴즈 · 기도 · 암송</span></div><span aria-hidden="true">→</span></a>
    }
    @if (Model.Tenant.Current.MissionEnabled && Model.Tenant.Has(ChallengeBible.Infrastructure.Data.Roles.Guardian))
    {
        <a class="dept" href="/@Model.Tenant.Current.Slug/guardian"><span class="mk">보</span><div><b>자녀 미션 보기</b><span class="sub" style="margin:0;font-size:13px">연결된 자녀의 오늘 미션 · 점수</span></div><span aria-hidden="true">→</span></a>
    }
    @if (Model.Tenant.Current.ReadingEnabled)
    {
        <a class="dept" href="/@Model.Tenant.Current.Slug/reading"><span class="mk">통</span><div><b>도전!!!성경통독</b><span class="sub" style="margin:0;font-size:13px">자유롭게 읽고 장마다 체크 · 진도율</span></div><span aria-hidden="true">→</span></a>
    }
    @if (Model.Tenant.IsAdmin)
    {
        <a class="btn s" href="/@Model.Tenant.Current.Slug/admin/members">관리 · 소속 관리</a>
    }
</div></main>
