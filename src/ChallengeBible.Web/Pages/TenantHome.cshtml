@page "/{slug:regex(^[a-z0-9-]{{2,40}}$)}/{view:regex(^today$)?}"
@model TenantHomeModel
@using ChallengeBible.Infrastructure.Data
@using ChallengeBible.Web.Auth
@using ChallengeBible.Web.Services
@* 확정 시안: 홈메인-단독시안(0044) — 머리말(부서 ▼ · 날짜) → 인사 → 오늘의 말씀 띠 → 프로그램 두 장 → 우리 가족팀 → 이번 주 나의 기록 → 우리 부서 → 계정 줄.
   확정 8가지: 관리 버튼(머리말) · 보호자 카드 · 가족 부서 안내 유지, 참여자가 아니면 보기만, 꺼진 프로그램은 숨김, 부서 ▼ = 부서 고르기 화면, 계정 줄은 3개, 말씀 없는 날은 띠 숨김 *@
@{
    var d = Model.Data;
    var t = Model.Tenant.Current;
    var slug = t.Slug;
    var ko = new System.Globalization.CultureInfo("ko-KR");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    const double C = 238.8;   // 고리 둘레(r = 38)
    string Dash(double pct) => $"{(C * Math.Clamp(pct, 0, 100) / 100).ToString("0.#", inv)} {C.ToString("0.#", inv)}";
    var has = d.Missions.Where(m => m.Has).ToList();
    var done = has.Count(m => m.Done);
    var left = has.Where(m => !m.Done).ToList();
    var rd = d.Reading;
    var lobby = Model.Tenant.IsLobby;
    var intro = lobby && !Model.TodayScreen;
    // 받침에 맞는 "로 / 으로"(받침 없음 · ㄹ 받침 = 로)
    // 씨앗 단계 그림: 🌰(밤) 대신 완두콩 꼬투리(2026-11-03 사용자 확정 E). 새 이모지는 기기마다 □ 로 깨지므로 그림으로 그린다
    static Microsoft.AspNetCore.Html.IHtmlContent Ico(string e) => e == "🌰"
        ? new Microsoft.AspNetCore.Html.HtmlString("<svg class=\"pea\" viewBox=\"0 0 40 40\"><path d=\"M4 26C10 12 26 8 36 12c-2 12-16 20-30 17z\" fill=\"#6CC04A\"/><path d=\"M7 26c8-1 18-6 26-12\" stroke=\"#4E9A33\" stroke-width=\"1.5\" fill=\"none\"/><circle cx=\"13\" cy=\"23\" r=\"3.6\" fill=\"#A6E07A\"/><circle cx=\"20\" cy=\"20\" r=\"3.8\" fill=\"#A6E07A\"/><circle cx=\"27\" cy=\"16.5\" r=\"3.6\" fill=\"#A6E07A\"/><path d=\"M34 12c1-3 3-4 5-4\" stroke=\"#4E9A33\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/></svg>")
        : new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(e));
    static string Ro(string w) { var c = w.Length == 0 ? 'a' : w[^1]; var j = c is >= '가' and <= '힣' ? (c - '가') % 28 : 0; return j == 0 || j == 8 ? "로" : "으로"; }   // 0068: 임시 부서 `/{slug}` = 1단계(부서 안 고름) · 2단계(승인 기다림), 윗부분만
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<style>
    /* 2026-11-22 사용자: 부서 홈 상단 디자인 교체(dodan 시안) — 도전!!! 성경말씀 */
    .dz-hero { text-align:center; padding:18px 0 6px; }
    .dz-hero h1 { font-size:30px; font-weight:900; color:#1e3a8a; letter-spacing:.5px; }
    .dz-hero h1 span { color:#0179dc; }
    .dz-hero .dz-tag { margin-top:8px; font-size:14px; font-weight:500; color:#3b4a7d; }
    .dz-hero .dz-date { margin-top:4px; font-size:12px; color:#8a8f99; }
    .dz-search { display:flex; align-items:center; justify-content:space-between; gap:10px; background:#fff; border:2px solid #1e3a8a; border-radius:999px; padding:13px 18px; margin:14px 0 6px; box-shadow:0 2px 8px rgba(30,58,138,.08); }
    .dz-search span { font-size:14px; color:#9aa0aa; }
    .dz-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:18px 14px; padding:16px 8px 6px; }
    .dz-item { display:flex; flex-direction:column; align-items:center; gap:9px; }
    .dz-item i { width:70px; height:70px; border-radius:18px; background:#fff; border:1px solid #eceef2; box-shadow:0 2px 6px rgba(30,58,138,.07); display:flex; align-items:center; justify-content:center; font-style:normal; }
    .dz-item span { font-size:13px; font-weight:700; color:#222; text-align:center; line-height:1.35; }
    .dz-card { display:block; background:#fff; border:1px solid #eceef2; border-radius:16px; box-shadow:0 2px 8px rgba(30,58,138,.06); padding:18px; margin-top:14px; }
    .dz-card h2 { display:flex; align-items:center; gap:8px; font-size:16px; font-weight:900; color:#222; }
    .dz-card h2::before { content:""; width:4px; height:15px; border-radius:2px; background:#1e3a8a; }
    .dz-verse-body { display:flex; align-items:center; gap:14px; margin-top:12px; }
    .dz-verse-body p { font-size:14px; line-height:1.65; color:#222; font-weight:500; }
    .dz-verse-body .dz-ref { color:#3b4a7d; font-weight:700; }
    .dz-stats { display:grid; grid-template-columns:repeat(2,1fr); margin-top:14px; }
    .dz-stat { display:flex; flex-direction:column; align-items:center; gap:2px; padding:8px 4px; }
    .dz-stat:nth-child(even) { border-left:1px solid #e5e8ee; }
    .dz-stat:nth-child(n+3) { border-top:1px solid #e5e8ee; }
    .dz-stat small { display:flex; align-items:center; gap:4px; font-size:11px; color:#8a8f99; }
    .dz-stat b { font-size:16px; font-weight:800; color:#3b4a7d; }
</style>
<div class="hm sky@(lobby ? " lobby" : "")">
@* 하늘색 머리말(0064 · 0068, 확정 시안: 임시부서-홈-두단계). 일반 부서 홈도 임시 부서 미션 화면(/welcome/today)과 같은 모양(2026-10-31 사용자):
   머리말 → (임시 부서) 1 · 2단계 윗부분만 또는 "← 처음 화면" / (일반 부서) 부서 이름 · 관리 줄 → 흰 말씀 카드 → 아랫부분 *@
    <div class="wl@(intro ? "" : " wl-wide")">
        <header class="wl-top gut"><div class="wrap">
            @* 확정 2026-11-15 사용자: 왼쪽 위 ☰ → 내 계정 · 출석 · 관리 · 플랫폼 · 로그아웃(맨 아래 계정 줄과 같은 조건). 플랫폼 메뉴와 같은 메뉴판(platform-nav.js) *@
            @if (!Model.Guest) {
            <button type="button" class="pmenu-btn hm-menu" aria-label="메뉴 열기" aria-controls="pnav" aria-expanded="false" data-pnav-open>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h12"/></svg>
            </button>
            }
            <div class="wl-org"><small>대한예수교장로회</small><a class="church" href="https://www.saenae.org/" target="_blank" rel="noopener" aria-label="잠실새내교회 홈페이지 (새 창)">잠실새내교회<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a></div>
            <span class="wl-today">@* 연도는 지웠다(2026-11-17 사용자) *@<b>@d.Today.ToString("M월 d일", ko)</b> @d.Today.ToString("dddd", ko)</span>
            @if (!Model.Guest) { <partial name="_MailBadge" /> }   @* 둘러보기(R-336): 오른쪽 위 [로그인]도 지웠다 — 칸을 누르면 로그인으로(2026-11-18 사용자) *@
        </div></header>
        @if (intro)
        {
            <section class="wl-hi gut" aria-labelledby="wlHi"><div class="wrap">
                <div class="wl-k">환영해요</div>
                <h1 id="wlHi">@Ui.Nim(User.DisplayName()),<br>반가워요!</h1>
                <p class="wl-sub">먼저 내가 참여할 부서를 골라요.</p>
                <div class="wl-card">
                    <h2>시작까지 2단계</h2>
                    <ol class="wl-steps">
                        <li class="wl-done"><span class="wl-ic" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></span>
                            <div class="wl-tx"><b>가입 <span class="wl-tag wl-done">완료</span></b><span>이름 · 이메일 · 비밀번호만 있으면 돼요</span></div></li>
                        @* 2026-11-20 사용자: 참여는 승인 없이 바로(R-340) — "관리자 승인" 단계 · 기다림 카드 없음 *@
                        <li class="wl-now"><span class="wl-ic" aria-hidden="true">2</span>
                            <div class="wl-tx"><b>내 부서 참여 <span class="wl-tag wl-now">지금 할 일</span></b><span>목록에서 내 부서를 고르면 바로 시작해요</span></div></li>
                    </ol>
                    <a class="wl-btn wl-p" href="/join">내 부서 참여 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                    <a class="wl-btn wl-s" href="/@slug/today">먼저 미션 해 보기 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                    <p class="wl-keep"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>여기서 한 미션 기록 · 점수는 부서로 그대로 옮겨져요.</p>
                </div>
            </div></section>
        }
        @* 일반 부서: 부서 이름 줄은 지웠다(2026-11-03 사용자). 부서가 둘 이상이면 내 계정 > "부서 고르기 →" *@
    </div>

@if (!intro)
{
@* 0076 확정 시안(hk.png): 말씀 한 줄 띠 → 인사 카드(나의 점수 성장) → 말씀 찾기 → 성경말씀 카드 → 성경통독 카드 → 가족팀 · 우리 부서 *@
<main class="gut hj"><div class="wrap">
    @* 2026-11-22 사용자: 홈 상단을 dodan 시안으로 교체 — 도전!!! 성경말씀 타이틀 · 말씀 찾기 · 프로그램 버튼 · 오늘의 말씀 · 나의 도전 현황. 링크 · 기능 플래그는 기존 그대로 *@
    <section class="dz-hero">
        <h1>도전!!! <span>성경말씀</span></h1>
        <p class="dz-tag">하루 5분, 말씀과 함께 자라요.</p>
        <p class="dz-date">@d.Today.ToString("M월 d일", ko) @d.Today.ToString("dddd", ko)</p>
    </section>

    @if (t.ReadingEnabled)
    {
        <a class="dz-search" href="/@slug/reading/search" aria-label="말씀 찾기 화면으로">
            <span>성경 속 궁금한 단어 검색</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1e3a8a" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
        </a>
    }

    <nav class="dz-grid" aria-label="프로그램 바로가기">
        @if (t.MissionEnabled)
        {
            <a class="dz-item" href="/@slug/word-mission"><i aria-hidden="true"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#3b4a7d" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a1.5 1.5 0 0 0-1.5 1.5v15A1.5 1.5 0 0 0 7 21h10a1.5 1.5 0 0 0 1.5-1.5V7.5z" /><path d="M14 3v4.5h4.5" /><path d="M9 13.5l2 2 4-4.5" /><path d="M8 18h8" /></svg></i><span>도전!!!<br>성경미션</span></a>
        }
        @if (t.ReadingEnabled)
        {
            <a class="dz-item" href="/@slug/reading"><i aria-hidden="true"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#3b4a7d" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H14l3.5 3.5V19.5A1.5 1.5 0 0 1 16 21H6.5A1.5 1.5 0 0 1 5 19.5z" /><path d="M14 3v3.5h3.5" /><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4" /></svg></i><span>도전!!!<br>성경통독</span></a>
        }
        @if (Model.CopyData is not null)
        {
            <a class="dz-item" href="/@slug/copy"><i aria-hidden="true"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#3b4a7d" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 4.5l3 3L9 18l-4 1 1-4z" /><path d="M14.5 6.5l3 3" /><path d="M4 21h16" /></svg></i><span>도전!!!<br>성경필사</span></a>
        }
        @if (Model.PrayerCard is not null)
        {
            <a class="dz-item" href="/@slug/prayer365"><i aria-hidden="true"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#3b4a7d" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.5s-7.5-4.6-7.5-10A4.2 4.2 0 0 1 12 7.6a4.2 4.2 0 0 1 7.5 2.9c0 5.4-7.5 10-7.5 10z" /><path d="M12 10.5v4M10 12.5h4" /></svg></i><span>자녀를 위한<br>기도365</span></a>
        }
    </nav>

    @if (d.VerseText is { } vt)
    {
        <section class="dz-card">
            <h2>오늘의 말씀</h2>
            <div class="dz-verse-body">
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#1e3a8a" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6.5C10.2 5 7.6 4.5 5 4.5v13c2.6 0 5.2.5 7 2 1.8-1.5 4.4-2 7-2v-13c-2.6 0-5.2.5-7 2z" /><path d="M12 6.5v13" /><path d="M14.5 4.5v6l1.8-1.4 1.7 1.4v-6" /></svg>
                <p>"@vt"@if (d.VerseRef is { } vr) { <span class="dz-ref"> (@vr)</span> }</p>
            </div>
        </section>
    }
    else if (d.WordTitle is not null)
    {
        <a class="dz-card" href="/@slug/word-mission">
            <h2>오늘의 말씀</h2>
            <div class="dz-verse-body">
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#1e3a8a" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6.5C10.2 5 7.6 4.5 5 4.5v13c2.6 0 5.2.5 7 2 1.8-1.5 4.4-2 7-2v-13c-2.6 0-5.2.5-7 2z" /><path d="M12 6.5v13" /><path d="M14.5 4.5v6l1.8-1.4 1.7 1.4v-6" /></svg>
                <p><b>@d.WordTitle</b> <span class="dz-ref">@d.WordRange ›</span></p>
            </div>
        </a>
    }

    <section class="dz-card">
        <h2><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f2b01e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4h10v5a5 5 0 0 1-10 0z" /><path d="M7 6H4a3 3 0 0 0 3 5M17 6h3a3 3 0 0 1-3 5" /><path d="M12 14v3M8.5 20h7" /></svg>나의 도전 현황</h2>
        <div class="dz-stats">
            @if (d.Participant)
            {
                <div class="dz-stat"><small><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#3b4a7d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a1.5 1.5 0 0 0-1.5 1.5v15A1.5 1.5 0 0 0 7 21h10a1.5 1.5 0 0 0 1.5-1.5V7.5z" /><path d="M14 3v4.5h4.5" /><path d="M9 13.5l2 2 4-4.5" /></svg>오늘 미션</small><b>@(done)/@(has.Count)</b></div>
                <div class="dz-stat"><small><svg width="12" height="12" viewBox="0 0 24 24" fill="#f2b01e" stroke="#f2b01e" stroke-width="1" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-3-5.4 3 1.1-6L3.2 9.4l6.1-.8z" /></svg>나의 포인트</small><b>@d.SeasonPoints.ToString("N0")점</b></div>
            }
            @if (d.Dept is { } dpS)
            {
                <div class="dz-stat"><small><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#3b4a7d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2" /><path d="M3.5 20c0-3 2.5-5.5 5.5-5.5s5.5 2.5 5.5 5.5" /><path d="M16 8.5h5M18.5 6v5" /></svg>전체 참여자</small><b>@dpS.Members.ToString("N0")명</b></div>
                <div class="dz-stat"><small><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#3b4a7d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="2" /><path d="M8 3v4M16 3v4M3.5 10h17" /></svg>오늘 참여</small><b>@dpS.TodayPeople.ToString("N0")명</b></div>
            }
        </div>
    </section>
    @* 둘러보기 띠("로그인하면 내 기록이 보여요")는 지웠다(2026-11-18 사용자) *@
    @* 맨 위 말씀 한 줄 띠는 지웠다(2026-11-03 사용자) *@
    @if (Model.NewMessages > 0)
    {
        @* 확정 시안 쪽지 ①: 로그인할 때 한 번 "새 쪽지 N개" 띠 *@
        <a class="ms-band" href="/messages">새 쪽지 @(Model.NewMessages)개가 왔어요<span>쪽지함 보기</span></a>
    }
    @if (lobby)
    {
        @* 확정 시안 임시부서-상단버튼 A(2026-11-17): "← 처음 화면" 대신 할 일을 알려 주는 카드 — 신청 전 = 부서 참여 신청, 신청 후 = 승인 기다리는 중 *@
        if (Model.Waiting.Count == 0)
        {
            <section class="lb-ban lb-go" aria-labelledby="lbT">
                <p><b id="lbT">아직 내 부서가 없어요</b>내 부서에 참여 신청하면 선생님이 승인해요. 지금 한 미션 · 점수는 그 부서로 옮겨져요.</p>
                <a class="lb-btn p" href="/join">내 부서 참여 신청하기 →</a>
            </section>
        }
        else
        {
            var depts = string.Join(" · ", Model.Waiting.Select(w => w.StartsWith("잠실새내교회 ") ? w["잠실새내교회 ".Length..] : w));
            <section class="lb-ban lb-wait" aria-labelledby="lbT">
                <p><b id="lbT"><span class="lb-pill">승인 기다리는 중</span>@depts</b>선생님이 승인하면 바로 @depts@(Ro(depts)) 바뀌어요. 그동안 여기서 미션을 계속해요.</p>
                <a class="lb-btn s" href="/join">신청 확인 · 바꾸기 →</a>
            </section>
        }
    }

    @* 받은 가족팀 초대(확정 시안 home-invite, ADR 0084 · R-212): 말씀 찾기 바로 위. 수락 · 거절은 가족팀 화면에서 *@
    @if (Model.Invites.Count > 0)
    {
        var first = Model.Invites[0];
        <section class="hj-card hj-inv" aria-label="가족팀 초대">
            <div class="h"><span class="ic" aria-hidden="true">💌</span>
                <span class="tx"><b>가족팀 초대가 왔어요!</b>
                    <small>@(Model.Invites.Count > 1 ? $"{first.TeamName} 외 {Model.Invites.Count - 1}팀에서 초대했어요" : $"{Ui.Nim(first.InvitedBy)}이 {first.TeamName}{Ro(first.TeamName)} 초대했어요")</small></span></div>
            <div class="ivrow">
                <a class="ivgo" href="/@slug/family-team">초대 확인하기 ›</a>
                <form method="post" asp-page-handler="SnoozeInvites" asp-route-slug="@slug"><button type="submit" class="ivlater">다음에 할래요</button></form>
            </div>
        </section>
    }

    @* 예배 안내(ADR 0116, R-337, 2026-11-18 확정 시안 예배안내): 말씀 찾기 바로 위. 관리 › 예배 안내에서 고친다. 주보 버튼은 올린 주보(ADR 0117)가 있을 때 *@
    @if (Model.Worship.Count > 0)
    {
        var dname = PlatformTodayService.ShortDept(t.Name);
        <section class="hj-card wi" aria-label="예배 안내">
            @foreach (var (w, wi) in Model.Worship.Select((x, i) => (x, i)))
            {
                <div class="wi-row">
                    <div class="wi-tx">
                        <div class="wi-k">⛪ 주일학교 @(w.Title ?? dname + " 예배") 안내</div>
                        <div class="wi-t">@WorshipService.When(w.DayOfWeek, w.StartTime)</div>
                        <div class="wi-p">@w.Place</div>
                        @if (w.Address is { } addr) { <div class="wi-a">@addr <button type="button" class="wi-copy" data-copy="@addr" aria-label="주소 복사">⧉</button></div> }
                    </div>
                    @* 주보(ADR 0117, 2026-11-20 확정 시안): 첫 줄 오른쪽 주황 버튼 — 올린 주보가 있으면 가장 최근 날짜, 없으면 교사 · 관리자에게만 [주보 올리기] *@
                    @if (wi == 0 && Model.BulletinDate is { } jd) { <a class="wi-bt" href="/@t.Slug/bulletin"><b>📋 주보 보기</b><small>@jd.ToString("yyyy년 M월 d일")</small></a> }
                    else if (wi == 0 && Model.CanBulletin) { <a class="wi-bt" href="/@t.Slug/bulletin/edit"><b>📋 주보 올리기</b><small>아직 주보가 없어요</small></a> }
                    else if (w.BulletinUrl is { } bu) { <a class="wi-bt" href="@bu" target="_blank" rel="noopener"><b>📋 주보 보기</b>@if (w.BulletinDate is { } bd) { <small>@bd.ToString("yyyy년 M월 d일")</small> }</a> }
                </div>
            }
        </section>
        <script src="~/js/worship.js" asp-append-version="true" defer></script>
    }

    @* 생일 선물(ADR 0123, R-346, 2026-11-20 확정 시안 생일선물-부서홈-팝업): 예배 안내 카드 바로 아래. 성경미션 홈에서 옮겨 왔다 *@
    @foreach (var bg in Model.Birthdays)
    {
        if (bg.State == "Open")
        {
            <a class="bdh-card" href="/@t.Slug/gifts/birthday/@bg.Id">
                <span class="bdh-ic" aria-hidden="true">🎂</span>
                <span class="bdh-m"><b>생일 선물을 골라요!</b><small>@bg.Birthday.ToString("M월 d일") 생일@(bg.OpenUntil is { } u ? $" · {u:M월 d일}까지 골라요" : "")</small></span>
                <span class="bdh-go">고르기 →</span>
            </a>
        }
        else if (bg.State is "Picked" or "Purchased")
        {
            @* 고른 선물(2026-11-20 확정 시안 고른선물 ①): 다른 카드와 같은 테두리 · 여백. 사진 · 생일 · 상태 · 진행 막대 3칸 *@
            var bdDone = bg.State == "Purchased";
            <a class="hj-card bdh-got" href="/@t.Slug/gifts/birthday/@bg.Id">
                <span class="bdh-pic"><span aria-hidden="true">🎁</span>@if (bg.HasImage && bg.ItemId is int iid) { <img src="/images/AwardItem/@(iid).jpg" alt="" onerror="this.remove()" /> }</span>
                <span class="bdh-m">
                    <span class="bdh-k">🎂 @bg.Birthday.ToString("M월 d일") 생일 선물 <i>@(bdDone ? "준비 끝" : "준비 중")</i></span>
                    <b>@(bg.ItemDescription ?? bg.ItemName)</b>
                    <span class="bdh-bar" aria-hidden="true"><i class="on"></i><i class="@(bdDone ? "on" : null)"></i><i></i></span>
                    <small>@(bdDone ? "선생님이 준비했어요 · 주일에 받아요" : bg.PickedByStaff is not null ? "선생님이 골라 주셨어요 · 준비하고 있어요" : "골랐어요 · 선생님이 준비하고 있어요")</small>
                </span>
                <span class="bdh-ar" aria-hidden="true">›</span>
            </a>
        }
        else
        {
            <div class="hj-card bdh-late"><b>생일 선물을 고르지 못했어요</b><small>선생님께 말씀드리면 다시 열어 줘요</small></div>
        }
    }

    @* 사진첩 카드는 부서 홈에서 뺐다(2026-11-20 사용자) — ☰ 메뉴 "사진첩"으로 들어간다 *@



    @if (t.MissionEnabled)
    {
        const double C2 = 188.5;
        var pctToday = has.Count == 0 ? 0 : done * 100.0 / has.Count;
        <section class="hj-card hj-pg m" aria-labelledby="pmT">
            <h2 id="pmT"><a href="/@slug/word-mission">🎯 도전!!! 성경미션</a>@if (d.Participant) { <b class="num">@d.SeasonPoints.ToString("N0")<u>P</u></b> }</h2>
            <div class="hj-row">
                <span class="hj-ring o" role="img" aria-label="오늘 미션 @(has.Count)개 중 @(done)개 완료">
                    <svg width="76" height="76" viewBox="0 0 76 76" aria-hidden="true"><circle cx="38" cy="38" r="30" fill="none" stroke="var(--hj-org-l)" stroke-width="8" /><circle cx="38" cy="38" r="30" fill="none" stroke="var(--hj-org)" stroke-width="8" stroke-linecap="round" stroke-dasharray="@((C2 * pctToday / 100).ToString("0.#", inv)) @C2.ToString("0.#", inv)" transform="rotate(-90 38 38)" /></svg>
                    <span><b class="num">@done/@has.Count</b>오늘 미션</span>
                </span>
                @* 오늘의 말씀 칸 → 미션홈(2026-11-03 사용자) *@
                <a class="hj-box o" href="/@slug/word-mission">
                    <small>오늘의 말씀</small>
                    @if (d.WordTitle is not null) { <b>@d.WordTitle</b><span>@d.WordRange ›</span> }
                    else { <b>오늘은 말씀이 없어요</b><span>내일 다시 만나요</span> }
                </a>
            </div>
            @* 미션 네 칸(말씀 · 퀴즈 · 기도 · 암송)은 지웠다 — 미션은 미션 홈에 들어가서 한다(2026-11-18 사용자) *@
            @if (d.Participant && d.SeasonDay > 0)
            {
                var fp = Math.Clamp(d.FullDays * 100.0 / d.SeasonDay, 0, 100);
                <div class="hj-bar o" aria-hidden="true"><i style="width:@fp.ToString("0.#", inv)%"></i></div>
                <div class="hj-bl"><span>올해 네 가지 다 한 날 @(d.FullDays)일 / @(d.SeasonDay)일</span><b>@((int)fp)%</b></div>
            }
            @* "● 오늘 N명 참여 중" 줄은 지웠다(2026-11-03 사용자) — 아래 "우리 부서 오늘 참여"에 같은 숫자 *@
        </section>
    }

    @if (t.ReadingEnabled)
    {
        @* 확정 시안 홈-통독필사-0펼침(2026-11-17): 시작 전에도 펼친 모양 · 숫자 0(창세기 1장 1절부터). 홈을 열어도 회차는 만들지 않는다 *@
        var readCh = rd?.ReadChapters ?? 0;
        var pct = ReadingSummary.Percent(readCh, ReadingSummary.Total);
        var (rBook, rCh, rV) = rd is null ? ((byte)1, (short)1, (short)1) : (rd.Resume.BookId, rd.Resume.Chapter, rd.Resume.Verse);
        <section class="hj-card hj-pg r" aria-labelledby="prT">
            <h2 id="prT"><a href="/@slug/reading">📖 도전!!! 성경통독</a><small>@(rd?.RoundNo ?? 1)독째@(rd is { TodayChapters: > 0 } ? $" · 오늘 {rd.TodayChapters}장" : "")</small></h2>
            <div class="hj-row">
                <span class="hj-ring b" role="img" aria-label="전체 진도 @(pct.ToString("0.0"))%">
                        <svg width="76" height="76" viewBox="0 0 76 76" aria-hidden="true"><circle cx="38" cy="38" r="30" fill="none" stroke="var(--hj-blue-l)" stroke-width="8" />@if (readCh > 0) {<circle cx="38" cy="38" r="30" fill="none" stroke="var(--hj-blue)" stroke-width="8" stroke-linecap="round" stroke-dasharray="@((188.5 * Math.Max(pct, 1) / 100).ToString("0.#", inv)) 188.5" transform="rotate(-90 38 38)" />}</svg>
                    <span><b class="num">@pct.ToString("0.0")</b>%</span>
                </span>
                <a class="hj-box r" href="/@slug/reading/read/@rBook/@rCh">
                    <small>이어 읽을 곳</small><b>@BibleBooks.NameOf(rBook)</b><span>@(rCh)@(rBook == 19 ? "편" : "장") @(rV)절 ›</span>
                </a>
            </div>
            <div class="hj-n3">
                <div class="r"><b class="num">@readCh.ToString("N0")</b><small>읽은 장</small></div>
                <div class="l"><b class="num">@((ReadingSummary.Total - readCh).ToString("N0"))</b><small>남은 장</small></div>
                <div class="t"><b class="num">@ReadingSummary.Total.ToString("N0")</b><small>전체</small></div>
            </div>
        </section>
    }

    @if (Model.CopyData is { } cp)
    {
        @* 확정 시안 홈-필사카드(2026-11-16) · 홈-통독필사-0펼침(2026-11-17, 쓴 절 0 이어도 펼침): 성경말씀 · 성경통독 카드와 같은 모양 — 원(전체 진도) · 이어 쓸 곳 · 신약 · 구약 · 쓴 절. 색은 필사 테마(갈색) *@
        var cinv = System.Globalization.CultureInfo.InvariantCulture;
        var spot = $"/{slug}/copy/write/{cp.Resume.BookId}/{cp.Resume.Chapter}?v={cp.Resume.Verse}";
        var unit = cp.Resume.BookId == 19 ? "편" : "장";
        <section class="hj-card hj-pg c" aria-labelledby="pcT">
            <h2 id="pcT"><a href="/@slug/copy">✍️ 도전!!! 성경필사</a>@if (cp.TodayDone > 0) { <small>오늘 @(cp.TodayDone.ToString("N0"))절</small> }</h2>
                <div class="hj-row">
                    <span class="hj-ring c" role="img" aria-label="전체 진도 @(cp.All.ToString("0.0"))%">
                        <svg width="76" height="76" viewBox="0 0 76 76" aria-hidden="true"><circle cx="38" cy="38" r="30" fill="none" stroke="var(--hj-copy-l)" stroke-width="8" />@if (cp.Done > 0) {<circle cx="38" cy="38" r="30" fill="none" stroke="var(--hj-copy)" stroke-width="8" stroke-linecap="round" stroke-dasharray="@((188.5 * Math.Max(cp.All, 1) / 100).ToString("0.#", cinv)) 188.5" transform="rotate(-90 38 38)" />}</svg>
                        <span><b class="num">@cp.All.ToString("0.0")</b>%</span>
                    </span>
                    <a class="hj-box c" href="@spot"><small>이어 쓸 곳</small><b>@cp.Resume.Name</b><span>@(cp.Resume.Chapter)@unit @(cp.Resume.Verse)절부터 ›</span></a>
                </div>
                <div class="hj-n3">
                    <div class="c"><b class="num">@cp.New.ToString("0.0")%</b><small>신약</small></div>
                    <div class="c2"><b class="num">@cp.Old.ToString("0.0")%</b><small>구약</small></div>
                    <div class="t"><b class="num">@cp.Done.ToString("N0")</b><small>쓴 절</small></div>
                </div>
        </section>
    }

    @if (Model.PrayerCard is { } pc)
    {
        @* 365 기도 카드 — 유년부 홈 "오늘의 기도" 카드와 같은 모양(2026-11-17 사용자 A안): 날짜 칩 · 오늘 제목 · 며칠째 막대. 학생 · 새친구에게는 없음 · 점수 없음(ADR 0106) *@
        var tpD = pc.Me.Today;
        var tpNo = Prayer365Service.DayIndex(Prayer365Service.Md(tpD));
        var tpPct = Math.Min(100, (int)Math.Round(tpNo * 100.0 / Prayer365Stats.TotalDays));
        string[] tpDow = ["일", "월", "화", "수", "목", "금", "토"];
        <link rel="stylesheet" href="~/css/prayer365.css" asp-append-version="true" />
        <section class="hj-card tpCard" aria-label="오늘의 기도">
            <div class="tpHd"><span class="tpK">오늘의 기도</span><a class="tpMore" href="/@slug/prayer365" aria-label="자녀를 위한 365 기도 — 기도 전체 보기">기도 전체 ›</a></div>
            <div class="tpT">오늘도 함께 기도해요</div>
            <div class="tpS">매일 사랑하는 자녀를 위해 기도해 주세요</div>
            <div class="tpList">
                <a class="tpRow" href="/@slug/prayer365" aria-label="자녀를 위한 365 기도 — 오늘 기도문">
                    <span class="tpChip cal"><small>@tpD.ToString("yyyy.MM")</small><strong>@tpD.Day</strong><em class="@(tpD.DayOfWeek == DayOfWeek.Sunday ? "sun" : tpD.DayOfWeek == DayOfWeek.Saturday ? "sat" : "")">@(tpDow[(int)tpD.DayOfWeek])요일</em></span>
                    <span class="tpTx">
                        <b class="tpNm">자녀를 위한 365</b>
                        <span class="hl">@pc.Item.Title</span>
                        @if (tpNo > 0) { <span class="tpDay"><i aria-hidden="true"><s style="width:@(tpPct)%"></s></i><em><b>@tpNo</b>일째 · @(Prayer365Stats.TotalDays)일 중</em></span> }
                    </span>
                    <span class="tpG" aria-hidden="true">›</span>
                </a>
            </div>
        </section>
    }

    @if (Model.Guest && !t.IsLobby)
    {
        <section class="hj-card gb-card gb-home" aria-label="누가 선물 받나요">
            <h2>🎁 누가 선물 받나요</h2>
            <p class="gs-hide">받은 친구 이름은 로그인하면 보여요</p>
        </section>
    }
    @if (Model.Board.Total > 0)
    {
        @* 누가 선물 받나요(R-297): 미션 · 개인 선물 통합 카드 — 365 기도 아래 · 우리 부서 위(2026-11-18 사용자 확정 시안) *@
        <section class="hj-card gb-card gb-home" aria-label="누가 선물 받나요">
            <h2>🎁 누가 선물 받나요 <small>최근 순</small></h2>
            @foreach (var r in Model.Board.Rows) { <partial name="/Pages/Mission/_GiftBoardRow.cshtml" model="r" /> }
            @if (Model.Board.Total > Model.Board.Rows.Count) { <a class="gb-more" href="/@slug/gift-board">더 보기(@(Model.Board.Total)명)</a> }
        </section>
    }

    @if (t.MissionEnabled && Model.IsGuardian)
    {
        <a class="notice" href="/@slug/guardian"><b>자녀 미션 보기</b><span>연결된 자녀의 오늘 미션 · 점수 →</span></a>
    }

    @if (Model.Family is { } f)
    {
        var span = (f.NextStage ?? f.Total) - f.PrevStage;
        var fpct = f.NextStage is null ? 100 : span <= 0 ? 0 : Math.Clamp((f.Total - f.PrevStage) * 100.0 / span, 1, 100);
        <a class="hj-card hj-line" href="/@slug/family-team">
            <span class="ic y" aria-hidden="true">👨‍👩‍👧</span>
            <span class="tx"><b>우리 가족팀 · <span class="num">@f.Total.ToString("N0")</span>점</b>
                <small>@f.Name · @(f.NextStage is { } n ? $"다음 가족 축하까지 {n - f.Total:N0}점" : "모든 가족 단계를 넘었어요")</small>
                <span class="pb" aria-hidden="true"><i style="width:@fpct.ToString("0.#", inv)%"></i></span></span>
            <span class="ar" aria-hidden="true">›</span>
        </a>
    }

    @* 개선 · 불편 접수(2026-11-17 사용자): 유년부 홈 맨 아래처럼 상자 하나 — 누르면 /{slug}/feedback 에서 입력(superadmin 에게 쪽지, ADR 0112) *@
    <a class="hcCard" href="/@slug/feedback" aria-label="개선사항 및 불편사항 접수">
        <span class="hcIc" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v12H8l-4 4z" /><path d="M8 9h8M8 12h5" /></svg></span>
        <span class="hcTx"><b>개선사항 · 불편사항 접수</b><small>불편했던 점이나 아이디어를 남겨 주세요</small></span>
        <span class="hcG" aria-hidden="true">›</span>
    </a>
</div></main>
}

@if (Model.BirthdayPopup is { } bp)
{
    @* 생일 팝업(R-346): 홈을 열면 하루 한 번. [다음에 할래요] 내일 · 3일 · 5일 뒤. 고르면 안 뜬다. 기한 하루 전에는 미뤄도 뜬다 *@
    <div class="bdh-pop" data-bdh-pop role="dialog" aria-modal="true" aria-labelledby="bdhT">
        <div class="bdh-box">
            <div class="bdh-em" aria-hidden="true">🎂🎁</div>
            <h2 id="bdhT">@(bp.Name.Length > 0 ? bp.Name : User.Identity?.Name)님, 생일 축하해요!</h2>
            <p>@bp.Birthday.ToString("M월 d일") 생일 선물을 골라 주세요.@if (bp.OpenUntil is { } pu) { <br />@($"{pu:M월 d일}까지 고를 수 있어요.") }</p>
            <a class="bdh-pick" href="/@t.Slug/gifts/birthday/@bp.Id">선물 고르러 가기</a>
            <form method="post" asp-page-handler="SnoozeBirthday" asp-route-slug="@slug" class="bdh-later">
                <small>다음에 할래요</small>
                <div><button type="submit" name="days" value="1">내일 다시</button><button type="submit" name="days" value="3">3일 뒤</button><button type="submit" name="days" value="5">5일 뒤</button></div>
            </form>
        </div>
    </div>
}
@if (!Model.Guest) { <partial name="_MsgPopup" model="(Model.NewMessages, Model.NewList, '/' + slug)" /> }

@if (!Model.Guest) { <partial name="_TenantDrawer" model="(Model.Tenant, Model.MyPhoto)" /> }

<footer class="gut"><div class="wrap">
    @* 맨 아래 계정 줄(출석 · 관리 · 플랫폼 · 로그아웃)은 지웠다 — 왼쪽 위 ☰ 메뉴와 같아서(2026-11-15 사용자) *@
    <p class="foot-copy">© @d.Today.Year 잠실새내 · 주일학교</p>
</div></footer>
</div>
