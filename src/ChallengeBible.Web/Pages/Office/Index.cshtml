@page "/{slug}/office"
@model ChallengeBible.Web.Pages.Office.IndexModel
@using ChallengeBible.Web.Services
@using ChallengeBible.Web.Auth
@* 행정업무 메인(2026-11-25 사용자 시안 「행정업무 HTML」): 도전!!! 성경말씀과 따로. 교사 · 관리자가 이 사람이 볼 수 있는 일만 본다.
   2026-11-27 사용자 새 퍼블리시본으로 완전 교체: 맨 위 「메인화면」 · 날짜 · 이름 첫 글자, 번호 카드, 맨 아래 「도전!!! 성경말씀」. *@
@{
    var ko = new System.Globalization.CultureInfo("ko-KR");
    var s = Model.Slug;
    var dept = PlatformTodayService.ShortDept(Model.Tenant.Current.Name);
}
@if (Model.Denied)
{
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
<link rel="stylesheet" href="~/css/office.css" asp-append-version="true" />
<div class="office">
  <main class="of-main">
    <div class="of-wrap of-deny" role="alert">
      <h1>권한이 없어요</h1>
      <p>행정업무는 교사 · 관리자만 볼 수 있어요.</p>
      <a class="of-deny-btn" href="/@Model.Slug">도전!!! 성경말씀으로 가기</a>
      <a class="of-deny-sub" href="/account/login?returnUrl=@Uri.EscapeDataString($"/{Model.Slug}/office")">교사 계정으로 로그인</a>
    </div>
  </main>
</div>
}
else
{
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
<link rel="stylesheet" href="~/css/office.css" asp-append-version="true" />
<div class="office">
<header class="of-head">
  <div class="of-wrap">
    <div class="of-top">
      <a class="of-back" href="/@s/welcome">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5L12 4l8 6.5"/><path d="M6 9v10a1 1 0 0 0 1 1h3.5v-5.5h3V20H17a1 1 0 0 0 1-1V9"/></svg>
        메인화면
      </a>
      <div class="of-top-right">
        <time class="of-date" datetime="@Model.Today.ToString("yyyy-MM-dd")">@Model.Today.ToString("M월 d일", ko) <small>@Model.Today.ToString("dddd", ko)</small></time>
        <a class="of-avatar" href="/account" title="내 계정" aria-label="내 계정">@Model.Initial</a>
      </div>
    </div>

    <p class="of-cap"><i></i>교사 · 관리자 화면</p>
    <h1>행정업무</h1>
    <p class="of-sub">잠실새내교회 주일학교 · <b>@dept</b> 담당</p>
  </div>
</header>

<main class="of-main">
  <div class="of-wrap">
    <nav class="of-list" aria-label="관리 메뉴">
      @foreach (var it in Model.Items)
      {
          <a class="of-row" href="@it.Href" style="--c:@it.Color; --s:@it.Soft">
            <span class="of-name"><span class="of-no">@it.No</span>@it.Label@if (it.Badge is not null) { <span class="of-badge">@it.Badge</span> }</span>
            <span class="of-go"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
      }
    </nav>

    <a class="of-brand" href="/@s">
      <b>도전<i style="color:#22b35e">!</i><i style="color:#3b7cf0">!</i><i style="color:#f07a22">!</i> 성경말씀</b>
      <span>「4가지 도전」 홈으로 이동</span>
    </a>
  </div>
</main>
</div>
}
