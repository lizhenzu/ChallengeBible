@page "/{slug}/todo/gift/{id:long}"
@model ChallengeBible.Web.Pages.Todo.GiftModel
@using ChallengeBible.Infrastructure.Data
@* 확정 시안 할일타임라인 ②(2026-11-16): 설명 → 정보 → 진행(시각 · 사람) → 실제로 하고 완료. 카드에서는 완료하지 않는다 *@
@{
    var r = Model.Row;
}
<link rel="stylesheet" href="~/css/todo.css" asp-append-version="true" />
<div class="tdo">
<header class="td-top gut"><div class="wrap">
    <div class="t"><small><em>도전!!!</em> 오늘 할 일</small><b>선물 처리</b></div>
    <a class="td-home" href="/@Model.Slug/todo">← 할 일</a>
</div></header>
<main class="gut"><div class="wrap td-main td-work" data-td data-td-url="/@Model.Slug/todo/gift/@r.Id">
    @Html.AntiForgeryToken()
    @if (Model.Msg is { } m) { <p class="td-msg" role="status">@m</p> }
    <h1>🎁 @r.Who@(r.ClassName is null ? "" : $"({r.ClassName})") · @r.KindText 선물</h1>
    <p class="td-why">@Model.Why</p>
    <dl class="td-kv">
        <dt>선물</dt><dd>@(string.IsNullOrEmpty(r.ItemName) ? "아직 안 골랐어요" : r.ItemName)</dd>
        @if (r.Price > 0) { <dt>가격</dt><dd>@r.Price.ToString("N0")원</dd> }
        <dt>받는 사람</dt><dd>@r.Who@(r.ClassName is null ? "" : " · " + r.ClassName)</dd>
        @if (r.OpenUntil is { } ou && r.State == GiftStates.Open) { <dt>기한</dt><dd>@ou.ToString("M월 d일")까지 고르기</dd> }
    </dl>
    <div class="td-lbl">진행</div>
    @{ ViewData["full"] = true; }
    <partial name="_Timeline" model="Model.Steps" view-data="ViewData" />
    <div class="td-acts">
        @if (Model.CanMove && r.State == GiftStates.Picked)
        {
            @if (!string.IsNullOrEmpty(r.CoupangUrl)) { <a class="btn" href="@r.CoupangUrl" target="_blank" rel="noopener noreferrer">쿠팡에서 사기 ↗</a> }
            <form method="post" asp-page-handler="Buy" asp-route-id="@r.Id"><button type="submit" class="btn p">구매 완료</button></form>
        }
        @if (Model.CanMove && r.State == GiftStates.Purchased)
        {
            <form method="post" asp-page-handler="Deliver" asp-route-id="@r.Id"><button type="submit" class="btn ok">전달 완료</button></form>
        }
        @if (Model.CanLink) { <button type="button" class="btn @(r.State == GiftStates.Open ? "p" : "")" data-td-link="@r.Id">링크 복사</button> }
    </div>
    <p class="td-note">구매 완료를 누르면 "전해 주세요"로 바뀌고 산 사람 이름이 모두에게 보여요. 아이에게 건넨 뒤 [전달 완료]를 누르면 할 일에서 사라져요. 취소 · 되돌리기는 관리 › 선물에서 해요.</p>
</div></main>
</div>
<script src="~/js/todo.js" asp-append-version="true" defer></script>
