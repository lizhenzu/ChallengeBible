@model HomeModel
@* 부서 카드 "누가 선물 받나요"(확정 시안 관리-선물처리 ④, R-297): 골랐어요 · 준비했어요 · 받았어요(받은 지 30일까지), 최근 순 3명 + 더 보기. 가격 없음 *@
@{ var (rows, total) = Model.Board; }
<section class="gb-card" aria-label="누가 선물 받나요">
    <h2>누가 선물 받나요 <small>최근 순</small></h2>
    @foreach (var r in rows) { <partial name="_GiftBoardRow" model="r" /> }
    @if (total > rows.Count) { <a class="gb-more" href="/@Model.Slug/gift-board">더 보기(@(total)명)</a> }
</section>
