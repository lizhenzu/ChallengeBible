@model ChallengeBible.Web.Pages.Mission.FamilyTeamModel
@using ChallengeBible.Web.Services
@* 다른 팀 랭킹(2026-11-27 사용자 민트 시안 TeamOthers): 우리 팀(순위 표시)은 맨 위에 고정, 표는 순위 · 팀 이름 · 마지막 수행 · 점수.
   정렬 = 점수순(기본) · 수행날짜순(최신 날짜 기준) · 팀명순, 같은 정렬을 다시 누르면 순서가 반대(화살표). *@
@{
    var slug = Model.Slug;
    var b = Model.Board!;
    var my = Model.MyRank;
}
<link rel="stylesheet" href="~/css/mission-home.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/team-mint.css" asp-append-version="true" />
<div class="mh tv">
<header class="mh-bar">
    <button type="button" class="mh-menu" aria-label="메뉴 열기" aria-controls="pnav" aria-expanded="false" data-pnav-open>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <span>성경미션</span><span class="tv-sep" aria-hidden="true">›</span><b>팀보기</b>
    </button>
    <a class="mh-home" href="/@slug">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 10l9-7 9 7v10a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg>홈으로</a>
</header>
<div class="tv-body">
    <a class="tv-back" href="/@slug/family-team"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>우리 팀 보기</a>
    <h1 class="tv-h1">다른 팀 랭킹</h1>
    <p class="tv-sub">팀 이름, 마지막 수행일, 점수만 볼 수 있어요.</p>

    <div class="tv-sort">
        <span>정렬</span>
        @foreach (var key in new[] { "score", "date", "name" })
        {
            var on = Model.SortKey == key;
            <a href="@Model.SortUrl(key)" aria-current="@(on ? "true" : "false")">@FamilyTeamModel.SortName(key)@(on ? (Model.Asc ? " ↑" : " ↓") : "")</a>
        }
    </div>

    @if (my is not null)
    {
        <div class="tv-mine"><span class="rk">@(my.Rank)위</span><span class="nm">@my.Name <i>우리 팀</i></span><span class="pt num">@my.Points.ToString("N0")점</span></div>
    }

    <section class="tv-table">
        <div class="tv-trow head"><span>순위</span><span>팀 이름</span><span>마지막 수행</span><span class="r">점수</span></div>
        @foreach (var t in Model.Others)
        {
            <div class="tv-trow">
                <span class="rk@(t.Rank <= 3 ? " top" : "")">@(t.Rank)위</span>
                <span class="nm">@t.Name</span>
                <span class="lt">@FamilyTeamModel.LastText(t.Last, b.Today)</span>
                <span class="r pt num">@t.Points.ToString("N0")점</span>
            </div>
        }
        @if (Model.Others.Count == 0) { <p class="tv-empty">아직 다른 팀이 없어요</p> }
    </section>
</div>
</div>
<partial name="_MissionDrawer" model="(Model.Tenant, (string?)null)" />
