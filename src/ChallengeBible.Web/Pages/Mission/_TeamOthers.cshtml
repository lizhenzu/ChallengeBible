@model ChallengeBible.Web.Pages.Mission.FamilyTeamModel
@using ChallengeBible.Web.Services
@* 다른 팀 랭킹(2026-11-27 사용자 민트 시안 TeamOthers): 우리 팀(순위 표시)은 맨 위에 고정, 표는 순위 · 팀 이름 · 마지막 수행 · 점수.
   정렬 = 점수순(기본) · 수행날짜순(최신 날짜 기준) · 팀명순, 같은 정렬을 다시 누르면 순서가 반대(화살표). *@
@{
    var slug = Model.Slug;
    var b = Model.Board!;
    var my = Model.MyRank;
}
<link rel="stylesheet" href="~/css/mission-home.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/team-mint.css" asp-append-version="true" />
<div class="mh tv">
@await Html.PartialAsync("_MissionSubBar", (slug, $"/{slug}/family-team", "다른 팀 랭킹"))
<div class="tv-body">
    <p class="tv-sub">팀 이름, 마지막 수행일, 점수만 볼 수 있어요.</p>

    <div class="tv-sort">
        <span>정렬</span>
        @foreach (var key in new[] { "score", "date", "name" })
        {
            var on = Model.SortKey == key;
            <a href="@Model.SortUrl(key)" aria-current="@(on ? "true" : "false")">@FamilyTeamModel.SortName(key)@(on ? (Model.Asc ? " ↑" : " ↓") : "")</a>
        }
    </div>

    @if (my is not null)
    {
        <div class="tv-mine"><span class="rk">@(my.Rank)위</span><span class="nm">@my.Name <i>우리 팀</i></span><span class="pt num">@my.Points.ToString("N0")점</span></div>
    }

    @if (Model.Others.Count == 0)
    {
        @await Html.PartialAsync("_EmptyState", ("M9 8a3 3 0 1 0 0-.01M16 9a2.5 2.5 0 1 0 0-.01M3 20c.8-3.5 3.4-5.5 6-5.5s5.2 2 6 5.5", "다른 팀이 아직 없어요", "팀이 만들어지면 여기서\n팀 랭킹을 볼 수 있어요.", "우리 팀 보기", $"/{slug}/family-team"))
    }
    else
    {
    <section class="tv-table">
        <div class="tv-trow head"><span>순위</span><span>팀 이름</span><span>마지막 수행</span><span class="r">점수</span></div>
        @foreach (var t in Model.Others)
        {
            <div class="tv-trow">
                <span class="rk@(t.Rank <= 3 ? " top" : "")">@(t.Rank)위</span>
                <span class="nm">@t.Name</span>
                <span class="lt">@FamilyTeamModel.LastText(t.Last, b.Today)</span>
                <span class="r pt num">@t.Points.ToString("N0")점</span>
            </div>
        }
        
    </section>
    }
</div>
</div>

