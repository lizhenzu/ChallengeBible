@model (string Slug, string Back, string Title)
@* 세부 화면 머리줄(2026-11-28 사용자): ← 와 제목을 하나의 터치 영역(높이 44px 이상)으로 묶어 둘 다 눌러도 뒤로 간다.
   같은 줄 오른쪽 끝에 「미션홈」 바로가기(책 아이콘 — 「홈으로」와 구분). 세부 화면에는 하단 탭이 없다. *@
<link rel="stylesheet" href="~/css/sub-bar.css" asp-append-version="true" />
<header class="sbar">
    <a class="sbar-back" href="@Model.Back" aria-label="뒤로 · @Model.Title">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        <b>@Model.Title</b>
    </a>
    <a class="sbar-book" href="/@Model.Slug/word-mission">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6c-1.8-1.4-4-2-8-2v13c4 0 6.2.6 8 2 1.8-1.4 4-2 8-2V4c-4 0-6.2.6-8 2zM12 6v13"/></svg>미션홈</a>
</header>
