@page "/{slug}/word-mission"
@model HomeModel
@using System.Globalization
@using ChallengeBible.Web.Auth
@using ChallengeBible.Web.Services
@using ChallengeBible.Domain.Missions
@* 성경미션 홈 — 2026-11-27 사용자 새 시안(민트 · 「성경미션 홈 최종」 · 별도 시안 방)으로 교체.
   위에서부터: 상단바 → (팀 없고 초대가 오면) 초대 배너 → 환영 카드 → 나의 기록(링 · 올해 포인트 · 최근 7일 막대) → 선물 카드(개인 · 가족팀 · 생일 · 새친구) →
   (팀 없을 때) 팀 만들기 카드 → 오늘의 미션 2×2 → 우리 가족 · 친구팀 → 이달 달력 → 하단 탭(홈 · 선물함 · 팀보기 · 참여자).
   사용자 결정(2026-11-27): 막대 · 달력 날짜를 누르면 그날 미션으로 이동(미래는 미리 보기) · 하루 최대 · 네 칸 숫자 · 축하 카드는 뺌(「n / 4 완료」 막대로 대신) ·
   미션 카드 상태는 「읽기 ›」 · 「완료」만(그 밖의 상태는 알약 없이 흐리게). 점수는 코드에 쓰지 않고 규칙(RuleSet)에서 읽는다. *@
@{
    var d = Model.Data!;
    var r = d.Rules;
    var ko = MissionPageBase.Ko;
    var slug = Model.Slug;
    bool Done(Mission m) => m == Mission.Recite ? d.RecitedThisWeek : d.Done.Any(i => i.Mission() == m);
    int Earned(Mission m) => d.Done.Where(i => i.Mission() == m).Sum(i => r.Item(i).Points);
    int Max(Mission m) => r.Items.Where(x => x.Enabled && x.Item.Mission() == m).Sum(x => x.Points);
    var maxPerDay = Math.Max(1, r.Items.Where(x => x.Enabled).Sum(x => x.Points));
    var quizLeft = d.QuizState.MaxAttempts - d.QuizState.AttemptsUsed;
    var canAct = Model.CanAct;
    var dayWord = Model.IsToday ? "오늘" : "이날";
    var none = $"{dayWord}은 없음";

    // 카드: 키, 번호, 이름, 콘텐츠 있나, 설명 첫 줄 · 둘째 줄, 끝난 상태(퀴즈 모두 틀림), 가기 글자
    (string Key, string No, string Label, Mission M, bool Has, string Sub1, string? Sub2, bool Over, string Go)[] cards =
    [
        ("word", "1", "말씀", Mission.Word, d.Word is not null, d.Word?.Range ?? none, d.Word?.Title, false, "읽기"),
        ("quiz", "2", "퀴즈", Mission.Quiz, d.Quiz is not null,
            d.Quiz is null ? none : d.QuizState.Solved ? "정답을 맞혔어요" : quizLeft > 0 ? $"{dayWord} 말씀에서 한 문제" : $"{d.QuizState.MaxAttempts}번 모두 틀렸어요",
            d.Quiz is null || d.QuizState.Solved || quizLeft <= 0 ? null : $"{quizLeft}번 도전할 수 있어요", d.Quiz is not null && !d.QuizState.Solved && quizLeft <= 0, "풀기"),
        ("prayer", "3", "기도", Mission.Prayer, d.Prayer is not null, d.Prayer?.Trait ?? none, d.Prayer?.Range, false, "기도"),
        ("recite", "4", "암송", Mission.Recite, d.Recite is not null, d.Recite is null ? "이번 주 없음" : d.Recite.Range, d.Recite is null ? null : d.Recite.Title, false, "외우기")
    ];
    var withContent = cards.Where(c => c.Has).ToList();
    var doneN = withContent.Count(c => Done(c.M));
    var total = withContent.Count;
    var circ = 2 * Math.PI * 38;
    string Inv(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
    var ringDash = total == 0 ? 0 : circ * doneN / total;
    var barPct = total == 0 ? 0 : 100 * doneN / total;
    var streakText = Model.UserName is null ? "" : Model.Streak > 0 ? $"{Model.Streak}일째 이어오는 중" : "";
    var weekSum = Model.Week.Sum(w => w.Points);

    var member = Model.Tenant.IsApproved && !Model.Tenant.IsLobby;
    var homeHref = member ? $"/{slug}" : "/";
    var fam = Model.Family;
    var team = Model.Team;
    var noTeam = fam is not null && team is null && fam.PendingTeam is null && Model.FamilyCanJoin;
    string NameOf(string? n) => Ui.NameOnly(n);
        string Last(DateOnly? ld, DateOnly today) => ld is not { } x ? "–" : x == today ? "오늘" : x == today.AddDays(-1) ? "어제" : x.ToString("M월 d일", ko);
    var cellRows = Model.Cells().Chunk(7).Where(w => w.Any(x => x.Month == Model.FirstOfMonth.Month)).ToList();
}
<link rel="stylesheet" href="~/css/mission-home.css" asp-append-version="true" />
<div class="mh" data-slug="@slug">

<header class="mh-bar">
    @if (member)
    {
        <button type="button" class="mh-menu" aria-label="메뉴 열기" aria-controls="pnav" aria-expanded="false" data-pnav-open>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <span>성경미션</span>
        </button>
    }
    else { <span class="mh-menu"><span>성경미션</span></span> }
    <a class="mh-home" href="@homeHref">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 10l9-7 9 7v10a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg>홈으로</a>
</header>

@if (Model.Invites.Count > 0)
{
    var inv = Model.Invites[0];
    <a class="mh-inv" href="/@slug/family-invite/@inv.InviteId">
        <span class="mh-inv-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
        <span class="mh-inv-t"><b>@(inv.Friend ? "친구팀" : "가족팀") 초대가 왔어요</b><small>@(Model.Invites.Count > 1 ? $"{Ui.Nim(inv.InvitedBy)} 외 {Model.Invites.Count - 1}팀에서 초대했어요" : $"{Ui.Nim(inv.InvitedBy)}이 함께하자고 초대했어요")</small></span>
        <span class="mh-inv-go">확인 ›</span>
    </a>
}

<section class="mh-welcome">
    <div class="mh-wk">도전!!! 성경미션</div>
    <p class="mh-wp">"거룩한 습관 만들기" 프로그램에 오심을 환영해요.</p>
    <div class="mh-wl"></div>
    <div class="mh-wr">
        <h1>@Ui.Nim(User.DisplayName()),<br>안녕하세요</h1>
        <span class="mh-wd">@Model.Day.ToString("M월 d일 (ddd)", ko)@if (streakText != "") { <small>@streakText</small> }</span>
    </div>
</section>

@if (d.Today < Model.SeasonStart)
{
    <p class="mh-note">곧 시작해요! @Model.SeasonStart.ToString("M월 d일")부터 미션을 할 수 있어요.</p>   @* 0028 *@
}
@await Html.PartialAsync("_DayCard", (MissionPageBase)Model)

@if (Model.IsGuardian)
{
    <a class="mh-guard" href="/@slug/guardian">
        <span class="mh-guard-t"><b>자녀 미션 보기</b><small>자녀의 미션 기록을 볼 수 있어요</small></span>
        <span class="mh-guard-ar" aria-hidden="true">›</span>
    </a>
}

<section class="mh-rec" id="rec">
    <h2>나의 기록</h2>
    <div class="mh-rec-top">
        <div class="mh-ring" role="img" aria-label="@dayWord 미션 @(total)개 중 @(doneN)개 완료">
            <svg width="92" height="92" viewBox="0 0 92 92" aria-hidden="true"><circle cx="46" cy="46" r="38" fill="none" stroke="#DDF2EC" stroke-width="9"/><circle cx="46" cy="46" r="38" fill="none" stroke="#0D7A68" stroke-width="9" stroke-linecap="round" stroke-dasharray="@Inv(ringDash) @Inv(circ)" transform="rotate(-90 46 46)"/></svg>
            <div class="mh-ring-c"><span>@(total == 0 ? "–" : $"{doneN}/{total}")</span><small>@dayWord 미션</small></div>
        </div>
        <div>
            <div class="mh-pl">올해 총 포인트</div>
            <div class="mh-pv"><span class="num">@d.SeasonPoints.ToString("N0")</span><small>점</small></div>
            <div class="mh-pt">@dayWord <b class="num">+@(d.DayPoints)점</b> 받았어요</div>
        </div>
    </div>
    <div class="mh-hr"></div>
    <div class="mh-wkh">
        <span>최근 7일 <b class="num">@(weekSum)점</b></span>
        <a href="#cal">달력·주간 보기 ›</a>
    </div>
    <div class="mh-bars">
        @foreach (var (date, pts) in Model.Week)
        {
            var kind = date == Model.Day ? "cur" : Model.CompleteDates.Contains(date) ? "all" : "";
            var h = pts <= 0 ? 2 : Math.Max(4, (int)Math.Round(Math.Min(78.0, pts * 78.0 / maxPerDay)));
            <a class="mh-col" href="@Model.HomeUrl(date)" aria-label="@date.ToString("M월 d일") @(pts)점">
                <span class="mh-bv num">@pts</span>
                <span class="mh-b @kind" style="height:@(h)px"></span>
            </a>
        }
    </div>
    <div class="mh-bl">
        @foreach (var (date, pts) in Model.Week)
        {
            <span class="@(date == Model.Day ? "cur" : "")"><small>@(date == d.Today ? "오늘" : date.ToString("ddd", ko))</small><b class="num">@date.Day</b></span>
        }
    </div>
    <div class="mh-lg"><span><i style="background:#0D7A68"></i>보는 날</span><span><i style="background:#6FC2AE"></i>네 가지 다 한 날</span><span><i style="background:#CFEDE5"></i>그 외</span></div>
</section>

@* 선물 알림(개인 · 가족 · 생일 · 새친구): 쓸 수 있는 선물이 있을 때만 보인다. 모양은 민트(가족 선물은 주황)로 mission-home.css 가 맞춘다. *@
@if (Model.Birthdays.Count > 0 || Model.Gift is not null || Model.TeamGifts.Count > 0)
{
    <div class="mh-gifts">
        @if (Model.Birthdays.Count > 0) { @await Html.PartialAsync("_BirthdayGiftCard", (Model.Slug, Model.Birthdays)) }
        @if (Model.Gift is not null) { @await Html.PartialAsync("_GiftCard", Model) }
        @if (Model.TeamGifts.Count > 0) { @await Html.PartialAsync("_TeamGiftCard", (Model.Slug, Model.TeamGifts)) }
    </div>
}

@if (noTeam)
{
    <section class="mh-promo">
        <div class="mh-promo-h">
            <span class="mh-promo-ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0D7A68" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><circle cx="17" cy="9" r="2.5"/><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5M15.5 14.6c2.8-.3 5 1.4 6 4.4"/></svg></span>
            <div><h2>가족·친구팀을 구성해 보세요</h2><p>함께 미션을 하면 서로 응원하며 꾸준히 이어갈 수 있어요. 가족팀과 친구팀 중 하나를 골라 시작하세요.</p></div>
        </div>
        <div class="mh-promo-b@(Model.FamilyIsStudent ? "" : " one")">
            <a class="p" href="/@slug/family-team">가족팀 만들기</a>
            @if (Model.FamilyIsStudent) { <a class="s" href="/@slug/family-team">친구팀 만들기</a> }
        </div>
        <a class="mh-promo-l" href="/@slug/family-team">팀에 참여하기 ›</a>
    </section>
}
else if (fam is { PendingTeam: { } pend })
{
    <section class="mh-promo">
        <div class="mh-promo-h">
            <span class="mh-promo-ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0D7A68" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><circle cx="17" cy="9" r="2.5"/><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5M15.5 14.6c2.8-.3 5 1.4 6 4.4"/></svg></span>
            <div><h2>@pend 합류 신청 중</h2><p>가족이 수락하면 함께해요.</p></div>
        </div>
        <a class="mh-promo-l" href="/@slug/family-team">신청 확인 ›</a>
    </section>
}

<section class="mh-ms">
    <div class="mh-ms-h">
        <h2>@(Model.IsToday ? "오늘의 미션" : "이날의 미션")</h2>
        <span><b>@doneN</b> / @total 완료</span>
    </div>
    <div class="mh-prog"><i style="width:@(barPct)%"></i></div>
    @if (withContent.Count == 0)
    {
        <p class="mh-note flat">@dayWord 미션이 아직 없어요 · 관리자가 콘텐츠를 올리면 여기에 나와요.</p>
    }
    else if (!canAct && Model.UserName is not null && Model.Day <= d.Today)
    {
        <p class="mh-note flat">@Model.BlockReason</p>
    }
    @if (Model.UserName is null) { <p class="mh-note flat">@Model.BlockReason</p> }
    <div class="mh-grid" aria-label="미션">
        @foreach (var c in cards)
        {
            var done = Done(c.M);
            var earned = Earned(c.M);
            var live = c.Has && !c.Over && canAct;
            var dim = !done && !live;
            <a class="mh-m@(done ? " ok" : "")@(dim ? " off" : "")" href="@Model.Link(c.Key)">
                <span class="mh-m-top">
                    <span class="mh-dot">@c.No</span>
                    @if (done) { <span class="mh-pill ok">완료 ✓</span> }
                    else if (live) { <span class="mh-pill">@c.Go ›</span> }
                </span>
                <b>@c.Label</b>
                <span class="mh-sub"><span>@c.Sub1</span>@if (c.Sub2 is not null) { <span>@c.Sub2</span> }</span>
                <span class="mh-pts num">@(!c.Has ? "" : done ? (earned > 0 ? $"+{earned}점" : c.M == Mission.Recite ? "이번 주 완료" : "완료") : $"{Max(c.M)}점")</span>
            </a>
        }
    </div>
</section>

@if (team is not null && fam is not null)
{
    var friend = team.Friend;
    var left = team.NextStage is { } nx ? Math.Max(0, nx - team.Total) : 0;
    <a class="mh-team" href="/@slug/family-team" aria-label="@(friend ? "우리 친구팀" : "우리 가족팀") 팀보기로 이동">
        <div class="mh-team-h">
            <span class="mh-team-chip"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><circle cx="17" cy="9" r="2.5"/><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5M15.5 14.6c2.8-.3 5 1.4 6 4.4"/></svg>@(friend ? "우리 친구팀" : "우리 가족팀")</span>
            @if (fam.Waiting > 0) { <em class="mh-team-badge num" aria-label="기다리는 신청 @(fam.Waiting)건">신청 @fam.Waiting</em> }
        </div>
        <div>
            <div class="mh-team-n">@team.Name</div>
            <div class="mh-team-s"><span class="num">@team.Total.ToString("N0")</span><small>점</small>
                @if (r.Features.Ranking && team.Rank > 0) { <em>@(friend ? "친구" : "가족") 랭킹 @(team.Rank)위</em> }</div>
        </div>
        <div>
            <div class="mh-team-bar"><i style="width:@Inv(fam.Pct)%"></i></div>
            <div class="mh-team-l">
                @if (team.NextStage is { } nxt) { <span>다음 축하까지 <b class="num">@left.ToString("N0")점</b></span><span class="num">목표 @nxt.ToString("N0")</span> }
                else { <span>모든 @(friend ? "친구팀" : "가족") 단계를 넘었어요</span> }
            </div>
        </div>
        <div class="mh-team-m">
            <div class="mh-team-mh">오늘 미션 완료 <b>@(team.TodayPeople)/@(team.Members.Count)명</b></div>
            <div class="mh-team-row@(team.Members.Count >= 4 ? "" : " few")">
                @foreach (var m in team.Members)
                {
                    <div class="mh-tm">
                        <span class="mh-av@(m.Today > 0 ? " on" : "")">@if (m.PhotoUser is { } pu) { <img src="/@slug/photo/@Uri.EscapeDataString(pu)" alt="" loading="lazy" onerror="this.remove()" /> }<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0D7A68" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="9" r="4"/><path d="M4.5 21c1.1-4.2 4-6.2 7.5-6.2s6.4 2 7.5 6.2"/></svg></span>
                        <span class="mh-tm-n">@m.Name</span>
                        <span class="mh-tm-r">@(friend ? "친구" : FamilyTeamService.RelationLabel(m.Relation))</span>
                        <span class="mh-tm-p num">@m.Season.ToString("N0")점</span>
                        <span class="mh-tm-d">@Last(m.LastDay, d.Today)</span>
                    </div>
                }
            </div>
        </div>
    </a>
}

<section class="mh-calw" id="cal">
    <div class="mh-cal">
        <div class="mh-cal-h">
            <h2 class="num">@Model.FirstOfMonth.ToString("yyyy년 M월")</h2>
            <div>
                @if (Model.HasPrevMonth) { <a href="@Model.HomeUrl(Model.Day, Model.FirstOfMonth.AddMonths(-1))#cal" aria-label="이전 달"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#12302A" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></a> } else { <span class="mh-cal-no"></span> }
                @if (Model.HasNextMonth) { <a href="@Model.HomeUrl(Model.Day, Model.FirstOfMonth.AddMonths(1))#cal" aria-label="다음 달"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#12302A" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a> } else { <span class="mh-cal-no"></span> }
            </div>
        </div>
        <div class="mh-cal-wd"><span class="sun">일</span><span>월</span><span>화</span><span>수</span><span>목</span><span>금</span><span>토</span></div>
        <div class="mh-cal-g">
            @foreach (var week in cellRows)
            {
                foreach (var day in week)
                {
                    var inMonth = day.Month == Model.FirstOfMonth.Month;
                    if (!inMonth) { <span class="mh-c mute"><span class="num">@day.Day</span><span class="mh-cp"></span></span>; continue; }
                    var s = Model.ScoreOf(day);
                    var cls = string.Join(" ", new[] { s is { Complete: true } ? "all" : null, day == d.Today ? "today" : null, day > d.Today ? "f" : null, day == Model.Day && day != d.Today ? "cur" : null, day.DayOfWeek == DayOfWeek.Sunday ? "sun" : null }.Where(x => x is not null));
                    var label = day > d.Today ? "미리 보기 · 보기만 가능" : s is null ? "기록 없음" : $"{s.Total}점";
                    @* 오늘 이후 날짜도 눌러서 미리 볼 수 있다(보기만, 2026-11-04) *@
                    <a class="mh-c @cls" href="@Model.HomeUrl(day, Model.FirstOfMonth)" aria-label="@day.ToString("M월 d일") @label"><span class="num">@day.Day</span><span class="mh-cp num@(s is null ? " dash" : "")">@(s is null ? "–" : s.Total.ToString())</span></a>
                }
            }
        </div>
    </div>
</section>

