@page "/{slug}/roster"
@model RosterModel
@using ChallengeBible.Web.Services
@* 참여자(2026-11-27 사용자 민트 시안 「참여자」): 상단바 → 제목 · 오늘 한 사람 수 → 구분 버튼 · 찾기 → 정렬(점수순 · 수행일자순 · 이름순) → 목록.
   폭 720px 이하(콘텐츠 영역 기준, container query)는 한 사람을 두 줄로, 넘으면 열이 맞춰진 표. 「참여자 초대」 버튼은 두지 않는다(사용자). 점수는 순위를 꺼도 보인다(R-214 고침). *@
@{
    var slug = Model.Slug;
    var d = Model.Data;
    var member = Model.Tenant.IsApproved && !Model.Tenant.IsLobby;
    var kinds = new[] { RankKind.Student, RankKind.Parent, RankKind.Teacher };
    var anyFilter = Model.Kind is "student" or "parent" or "teacher";
}
<link rel="stylesheet" href="~/css/mission-home.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/participants.css" asp-append-version="true" />
<div class="mh pt">
@await Html.PartialAsync("_MissionBar", (slug, member, "참여자"))

<div class="pt-in">
    <div class="pt-title">
        <h1>참여자</h1>
        <p>오늘 미션을 한 사람 <b>@(d.DoneToday)명</b> · 전체 @(d.People.Count)명</p>
    </div>

    <div class="pt-tools">
        <nav class="pt-chips" aria-label="구분">
            <a href="@Model.Url(kind: "all")" aria-current="@(anyFilter ? "false" : "true")">전체 @Model.All.Count</a>
            @foreach (var k in kinds)
            {
                <a href="@Model.Url(kind: RosterModel.KindKey(k))" aria-current="@(Model.Kind == RosterModel.KindKey(k) ? "true" : "false")">@RosterModel.KindName(k) @Model.All.Count(p => p.Kind == k)</a>
            }
        </nav>
        <form class="pt-search" method="get" role="search">
            @if (anyFilter) { <input type="hidden" name="f" value="@Model.Kind" /> }
            @if (Model.SortKey != "score") { <input type="hidden" name="s" value="@Model.SortKey" /> }
            @if (Model.Asc != (Model.SortKey == "name")) { <input type="hidden" name="o" value="@(Model.Asc ? "asc" : "desc")" /> }
            <label>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3F665D" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4-4"/></svg>
                <input type="search" name="q" value="@Model.Q" placeholder="이름 · 아이디로 찾기" aria-label="참여자 검색" autocomplete="off" />
            </label>
        </form>
    </div>

    <div class="pt-sort">
        <span>정렬</span>
        @foreach (var key in new[] { "score", "date", "name" })
        {
            var on = Model.SortKey == key;
            <a href="@Model.Url(sort: key)" aria-current="@(on ? "true" : "false")">@RosterModel.SortName(key)@(on ? (Model.Asc ? " ↑" : " ↓") : "")</a>
        }
    </div>

    @if (Model.Shown.Count == 0)
    {
        <section class="pt-card"><p class="pt-empty">@(string.IsNullOrWhiteSpace(Model.Q) && !anyFilter ? "점수를 받은 참여자가 아직 없어요" : "찾는 사람이 없어요")</p></section>
    }
    else
    {
        <section class="pt-card">
            <div class="pt-head"><span>이름 · 아이디</span><span>구분</span><span>마지막 수행일</span><span>오늘</span><span class="r">점수</span></div>
            @foreach (var p in Model.Shown)
            {
                <div class="pt-row">
                    <div class="pt-who">
                        <div class="pt-ava@(p.TodayDone ? " on" : "")" role="img" aria-label="@(p.Name) 프로필 사진">
                            @if (p.HasPhoto) { <img src="/@slug/photo/@Uri.EscapeDataString(p.UserName)" alt="" loading="lazy" onerror="this.remove()" /> }
                            <svg width="44" height="44" viewBox="0 0 54 54" aria-hidden="true"><circle cx="27" cy="21" r="10" fill="#FFFFFF"/><path d="M8 54c2-11 10-17 19-17s17 6 19 17z" fill="#FFFFFF"/></svg>
                        </div>
                        <div class="pt-nm"><div class="n">@p.Name@if (p.Me) { <span class="me">나</span> }</div><div class="i">@p.UserName</div></div>
                    </div>
                    <div class="pt-meta">
                        <span class="k"><b>@RosterModel.KindName(p.Kind)</b>@if (!string.IsNullOrEmpty(p.Detail)) { <text> · @p.Detail</text> }</span>
                        <span class="l">마지막 @RosterModel.LastText(p.LastDay, d.Today)</span>
                        <span class="s@(p.TodayDone ? " on" : "")">@(p.TodayDone ? "오늘 완료" : "아직 안 함")</span>
                    </div>
                    <div class="pt-pts num">@p.Points.ToString("N0")점</div>
                </div>
            }
        </section>
    }
</div>
@if (member) { @await Html.PartialAsync("_MissionTab", (slug, "roster")) }
</div>
@if (member) { <partial name="_MissionDrawer" model="(Model.Tenant, (string?)null)" /> }
