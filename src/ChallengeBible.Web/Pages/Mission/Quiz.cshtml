@page "/{slug}/quiz"
@model QuizModel
@using ChallengeBible.Domain.Missions
@using ChallengeBible.Infrastructure.Data
@* 확정 시안: 말씀-퀴즈미션 — 01 배경 · 02 문제 · 03 정답을 골라요(고른 뒤 답 제출하기) · 04 해설(끝난 뒤). 판정은 서버(R-43) *@
@{
    var d = Model.Data!; var q = d.Quiz; var s = d.QuizState;
    var finished = s.State != QuizState.CanTry;
    var left = s.MaxAttempts - s.AttemptsUsed;
    var pts = d.Rules.Item(MissionItem.QuizCorrect).Points;
    var choice = q?.Format == QuizFormat.Choice;
    var triesText = s.Solved ? "정답!" : left <= 0 ? "오늘은 끝" : s.AttemptsUsed > 0 ? $"{left}번 남았어요" : $"기회 {s.MaxAttempts}번";
    var triesCls = s.Solved ? "ok" : s.AttemptsUsed > 0 ? "warn" : "";
    // 옮겨 온 퀴즈 중에는 배경 칸에 "blank" 라는 글자만 든 것이 있다 — 빈 배경으로 본다
    var bg = (q?.Background?.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? [])
        .Where(x => !x.Equals("blank", StringComparison.OrdinalIgnoreCase)).ToArray();
    // 옛 사이트(DailyMission4 Quiz)와 같게: 배경이 따로 없고 문제 글이 "배경 … Q. 질문" 모양이면 배경과 질문을 가른다
    var question = q?.Question ?? "";
    if (bg.Length == 0 && QuizModel.SplitQuestion(question) is { Bg.Length: > 0 } sp)
    {
        bg = sp.Bg.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        question = sp.Q;
    }
    var no = 0;
    string N() => (++no).ToString("00");
}
@await Html.PartialAsync("_MissionHead", new MissionHead(Model, "오늘의 퀴즈", q is null ? "오늘은 퀴즈가 없어요" : d.Word?.Title ?? "오늘의 말씀 퀴즈", d.Word?.Range))
<main class="mbody gut" data-slug="@Model.Slug" data-date="@Model.Day.ToString("yyyy-MM-dd")"><div class="wrap">
    @if (q is null)
    {
        <p class="empty">이날은 퀴즈가 없어요. 다른 미션을 해 보세요.</p>
    }
    else
    {
        @if (bg.Length > 0)
        {
            <section class="sec done"><h2><span class="n">@N()</span>배경</h2>
                @foreach (var para in bg) { <p class="story qbg">@para</p> }
            </section>
        }
        <section class="sec done"><h2><span class="n">@N()</span>문제 <small class="kind">@(choice ? "객관식" : "주관식")</small></h2>
            <p class="qq">@question</p>
        </section>
        <section class="sec @(s.Solved ? "done" : "")" id="quiz" data-max="@s.MaxAttempts" data-used="@s.AttemptsUsed" data-points="@pts" data-finished="@(finished ? "1" : "0")">
            <h2><span class="n">@N()</span>@(choice ? "정답을 골라요" : "정답을 써요") <small id="tries" class="@triesCls">@triesText</small></h2>
            @if (choice)
            {
                <div class="qopts" role="radiogroup" aria-label="보기">
                    @for (var i = 0; i < q.Choices.Count; i++)
                    {
                        var c = q.Choices[i];
                        var mine = s.MyChoices.Contains(c.Id);
                        var isAns = finished && c.Id == Model.CorrectChoiceId;
                        var cls = isAns ? "ans fixed" : mine ? "bad fixed" : finished ? "dim fixed" : "";
                        var tag = isAns ? (s.Solved ? "정답" : "정답은 이것") : mine ? "내가 고른 답 · 오답" : "";
                        <label class="qopt @cls" data-choice="@c.Id">
                            <input type="radio" name="answer" value="@c.Id" disabled="@(!Model.CanAct || finished || mine)" />
                            <i class="num">@(i + 1)</i><span class="t">@c.Text@if (tag != "") { <small>@tag</small> }</span>
                        </label>
                    }
                </div>
            }
            else
            {
                <input class="in qtext" id="answerText" name="answer" maxlength="200" placeholder="답을 써 주세요" disabled="@(!Model.CanAct || finished)" aria-label="답" />
            }
            @if (!finished && q.Explanation is not null)
            {
                @* 옛 사이트처럼 풀기 전에도 해설을 "힌트"로 펼쳐 볼 수 있다 *@
                <button type="button" class="more" data-fold="qhint" data-more="힌트 보기 ＋" data-less="힌트 닫기 －" aria-expanded="false" aria-controls="qhint">힌트 보기 ＋</button>
                <div class="qhint" id="qhint" hidden>@q.Explanation</div>
            }
            <p class="msg @(s.Solved ? "ok" : "")" id="qmsg" role="status">@(s.Solved ? $"정답! +{pts}점" : finished ? $"오늘은 {s.MaxAttempts}번 도전했어요. 내일 새 퀴즈에 도전해요" : "")</p>
            <button type="button" class="qgo" id="qgo" disabled>
                @if (finished) { @(s.Solved ? "정답을 맞혔어요" : $"오늘은 {s.MaxAttempts}번 도전했어요") <em aria-hidden="true">✓</em> }
                else { <text>답 제출하기 <em aria-hidden="true">→</em></text> }
            </button>
        </section>
        <section class="sec done" id="explain" @(finished && q.Explanation is not null ? "" : "hidden")>
            <h2><span class="n">@N()</span>해설 <small id="resTag" class="@(s.Solved ? "ok" : "warn")">@(s.Solved ? $"정답 +{pts}점" : "점수 없음")</small></h2>
            <p class="story">@q.Explanation</p>
        </section>
    }
</div></main>
@Html.AntiForgeryToken()
@await Html.PartialAsync("_MissionNav", new MissionNav(Model, "quiz"))
