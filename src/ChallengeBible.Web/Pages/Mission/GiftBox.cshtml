@page "/{slug}/gift-box"
@model GiftBoxModel
@using ChallengeBible.Web.Services
@using ChallengeBible.Infrastructure.Data
@* 선물함(2026-11-27 사용자 민트 시안): 위 요약(신청한 선물 · 받은 선물 · 사용한 점수) → [신청한 선물 / 내가 받은 선물] 탭 → 선물 목록(이름 · 점수 · 날짜 · 상태).
   점수는 내 개인 선물만 보이고 가족 · 생일 · 새친구 선물은 종류만 보인다(가격 · 금액 숨김). *@
@{
    var slug = Model.Slug;
    var b = Model.Box;
    var rows = b is null ? [] : Model.Got ? b.Gots : b.Requests;
}
<link rel="stylesheet" href="~/css/mission-home.css" asp-append-version="true" />
<div class="mh gb">
<header class="gb-bar">
    <a class="gb-back" href="/@slug/word-mission" aria-label="미션 홈으로"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#12302A" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></a>
    <h1>선물함</h1>
</header>

@if (b is null)
{
    <p class="mh-note">선물함은 미션에 참여하는 분만 볼 수 있어요.</p>
}
else
{
    <section class="gb-sum">
        <div><span>신청한 선물</span><b class="num">@b.Requested<small>개</small></b></div>
        <div><span>받은 선물</span><b class="num">@b.Received<small>개</small></b></div>
        <div><span>사용한 점수</span><b class="num">@b.PointsUsed.ToString("N0")<small>점</small></b></div>
    </section>

    <nav class="gb-tabs" aria-label="선물함">
        <a href="/@slug/gift-box" aria-current="@(Model.Got ? null : "true")">신청한 선물</a>
        <a href="/@slug/gift-box?tab=got" aria-current="@(Model.Got ? "true" : null)">내가 받은 선물</a>
    </nav>

    <section class="gb-list">
        @foreach (var g in rows)
        {
            <div class="gb-it">
                <span class="gb-pic">@if (g.HasImage && g.ItemId is int iid) { <img src="/images/AwardItem/@(iid).jpg" alt="" onerror="this.remove()" /> } else { <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0D7A68" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M3 12h18M12 8v13M12 8c-1.5-3-5-4-5-1.5S10 8 12 8zM12 8c1.5-3 5-4 5-1.5S14 8 12 8z"/></svg> }</span>
                <span class="gb-m">
                    <span class="gb-n"><b>@g.Name</b><i class="@(g.Received ? "got" : g.Status == "준비 중" ? "prep" : "req")">@g.Status</i></span>
                    <span class="gb-d">@if (g.Points is int p) { <b class="num">@p.ToString("N0")점</b><text> · </text> }else { <b>@Model.KindText(g.Kind) 선물</b><text> · </text> }@Model.When(g.WhenUtc) @(g.Received ? "받음" : "신청")</span>
                </span>
            </div>
        }
        @if (rows.Count == 0)
        {
            <p class="mh-note flat">@(Model.Got ? "아직 받은 선물이 없어요." : "신청한 선물이 없어요. 점수를 모으면 선물을 고를 수 있어요.")</p>
        }
    </section>
}

<nav class="mh-tab" aria-label="주 메뉴">
    <a href="/@slug/word-mission"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 10l9-7 9 7v10a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg>미션홈</a>
    <a href="/@slug/gift-box" aria-current="page"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M3 12h18M12 8v13M12 8c-1.5-3-5-4-5-1.5S10 8 12 8zM12 8c1.5-3 5-4 5-1.5S14 8 12 8z"/></svg>선물함</a>
    <a href="/@slug/family-team"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><circle cx="17" cy="9" r="2.5"/><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5M15.5 14.6c2.8-.3 5 1.4 6 4.4"/></svg>팀보기</a>
    <a href="/@slug/roster"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M3 19c.6-3 2.6-5 5-5s4.4 2 5 5M15 7h6M15 11h6M17 15h4"/></svg>참여자</a>
</nav>
</div>
