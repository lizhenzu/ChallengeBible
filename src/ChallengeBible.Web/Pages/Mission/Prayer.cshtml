@page "/{slug}/prayer"
@model PrayerModel
@using ChallengeBible.Web.Auth
@{ var d = Model.Data!; var p = d.Prayer; }
@await Html.PartialAsync("_MissionHead", new MissionHead(Model, "오늘의 성품기도", p is null ? "오늘은 기도가 없어요" : p.Trait, p?.Range, p?.TraitEn))
<main class="mbody gut" data-slug="@Model.Slug" data-date="@Model.Day.ToString("yyyy-MM-dd")"><div class="wrap">
    @if (p is null)
    {
        <p class="empty">이날은 기도가 없어요. 다른 미션을 해 보세요.</p>
    }
    else
    {
        var hasText = Model.Verses.Count > 0;
        var no2 = hasText ? "02" : "01";
        var no3 = hasText ? "03" : "02";
        if (hasText)
        {
            <section class="sec"><h2><span class="n">01</span>오늘의 성경 본문 <small>@p.Ref.Tail</small></h2>
                <button type="button" class="more" data-fold="bible" data-more="본문 보기 ＋" data-less="본문 접기 －" aria-expanded="false" aria-controls="bible">본문 보기 ＋</button>
                <div class="vlines" id="bible" hidden>
                    @foreach (var line in Model.Verses)
                    {
                        <p><span class="num">@line.Verse</span>@line.Texts.GetValueOrDefault("KRV")</p>
                    }
                    <a class="rdmore" href="/@Model.Slug/read?from=prayer@(Model.IsToday ? "" : "&date=" + Model.Day.ToString("yyyy-MM-dd"))">성경 읽기 화면에서 보기 →</a>
                </div>
            </section>
        }
        <section class="sec done"><h2><span class="n">@no2</span>오늘의 기도문</h2>
            @foreach (var para in PrayerModel.Shown(p.Paragraphs)) { <p class="story">@PrayerModel.Paragraph(para)</p> }
        </section>
        @await Html.PartialAsync("_PickSection", new PickSection(Model, no3, "누구를 위해 기도했나요?", Mission.Prayer, "prayer"))
    }
</div></main>
@Html.AntiForgeryToken()
@await Html.PartialAsync("_MissionNav", new MissionNav(Model, "prayer"))
