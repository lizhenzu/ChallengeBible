@model ChallengeBible.Web.Pages.Mission.FamilyTeamModel
@using ChallengeBible.Web.Services
@* 팀보기(2026-11-27 사용자 민트 시안 TeamB): 내 팀 정보만 — 요약 · 선물 · 멤버별 기록 · 응원하기 · 우리 팀 선물함 · 다른 팀 보기 · 초대 · 관리. *@
@{
    var b = Model.Board!;
    var slug = Model.Slug;
    var s = Model.State.Mine!;
    var open = Model.TeamGifts.Where(g => g.State == "Open").OrderBy(g => g.Stage).ToList();
    var picked = Model.TeamGifts.Where(g => g.State is "Picked" or "Purchased").OrderByDescending(g => g.PickedUtc).ToList();
    var todo = b.Members.Where(m => !m.Me && !m.TodayDone).ToList();
    var until = open.Where(g => g.OpenUntil is not null).Select(g => g.OpenUntil!.Value).DefaultIfEmpty().Min();
    var label = b.Friend ? "친구팀" : "가족팀";
    var wd = new[] { "일", "월", "화", "수", "목", "금", "토" };
    string Role(TeamMemberBoard m) => b.Friend ? "친구" : FamilyTeamService.RelationLabel(m.Relation);
    var sentN = todo.Count(m => Model.CheeredToday.Contains(m.UserName));
}
<link rel="stylesheet" href="~/css/mission-home.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/team-mint.css" asp-append-version="true" />
<div class="mh tv">
<header class="mh-bar">
    <button type="button" class="mh-menu" aria-label="메뉴 열기" aria-controls="pnav" aria-expanded="false" data-pnav-open>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <span>성경미션</span><span class="tv-sep" aria-hidden="true">›</span><b>팀보기</b>
    </button>
    <a class="mh-home" href="/@slug">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 10l9-7 9 7v10a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg>홈으로</a>
</header>

<div class="tv-body">
@await Html.PartialAsync("_JoinBand", (Model.Band, slug, "team"))
@if (Model.Notice is not null) { <p class="tv-ok" role="status">@(Model.Notice)에 들어갔어요</p> }
@if (!string.IsNullOrEmpty(Model.OkMessage)) { <p class="tv-ok" role="status">@Model.OkMessage</p> }
@if (Model.Error is not null) { <p class="tv-err" role="alert">@Model.Error</p> }

<section class="tv-sum">
    <span class="tv-chip">우리 @label</span>
    <div class="tv-sum-r"><h1>@b.Name</h1><span>팀 랭킹 <b>@(b.Rank)위</b></span></div>
    <div class="tv-pts"><span class="num">@b.Total.ToString("N0")</span><small>점@(b.NextStage is { } nx ? $" · 목표 {nx:N0}" : " · 모든 단계를 넘었어요")</small></div>
</section>

<section class="tv-card" aria-label="초대 · 구성원 관리">
    <div class="tv-links">
        @if (!s.Locked && !s.Full) { <a class="tv-link" href="/@slug/family-team?Add=true"><span>팀원 초대하기 <small>이름으로 찾아 초대</small></span><i aria-hidden="true">›</i></a> }
        <a class="tv-link" href="/@slug/family-team/manage"><span>구성원 관리 <small>내보내기 · 방장 넘기기</small></span><i aria-hidden="true">›</i></a>
    </div>
</section>

@if (open.Count > 0)
{
    <section class="tv-card" aria-label="선물 고르기">
        <div class="tv-gh">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0D7A68" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M3 12h18M12 8v13M12 8c-1.5-3-5-4-5-1.5S10 8 12 8zM12 8c1.5-3 5-4 5-1.5S14 8 12 8z"/></svg>
            <h2>우리 팀이 고를 선물이 있어요</h2>
        </div>
        <div class="tv-gift">
            <div><b>@(b.Friend ? "우리 친구팀 선물" : "우리 팀 선물")</b><small>@(open.Count)개를 골라요@(until == default ? "" : $" · {until:M월 d일}까지")</small></div>
            <a class="tv-btn" href="/@slug/gifts/team/@open[0].Id">선물 고르기</a>
        </div>
    </section>
}

<section class="tv-card">
    <div class="tv-h"><h2>멤버별 기록</h2><span>최근 7일 · 연속 수행일</span></div>
    <div class="tv-list">
        @foreach (var m in b.Members)
        {
            <div class="tv-row">
                <div class="tv-ava@(m.TodayDone ? " on" : "")" role="img" aria-label="@m.Name 프로필 사진">
                    @if (m.HasPhoto) { <img src="/@slug/photo/@Uri.EscapeDataString(m.UserName)" alt="" loading="lazy" onerror="this.remove()" /> }
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true"><circle cx="12" cy="8.5" r="4"/><path d="M4 22c0-4.6 3.6-7.5 8-7.5s8 2.9 8 7.5z"/></svg>
                </div>
                <div class="tv-m">
                    <div class="tv-m1"><span class="n">@m.Name <i>@Role(m)</i>@if (m.Me) { <em>나</em> }</span><b class="num">@m.Points.ToString("N0")점</b></div>
                    <div class="tv-m2">
                        <div class="tv-wk">
                            @for (var i = 0; i < b.Days.Count; i++)
                            {
                                <span class="@(m.Week[i] ? "on" : "")@(i == b.Days.Count - 1 ? " today" : "")">@wd[(int)b.Days[i].DayOfWeek]</span>
                            }
                        </div>
                        <small>연속 @(m.Streak)일</small>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@if (todo.Count > 0)
{
    <section class="tv-card">
        <div class="tv-h"><h2>응원하기</h2><span>오늘 아직 안 한 사람</span></div>
        <div class="tv-list">
            @foreach (var m in todo)
            {
                var sent = Model.CheeredToday.Contains(m.UserName);
                <div class="tv-row">
                    <div class="tv-ava" role="img" aria-label="@m.Name 프로필 사진">
                        @if (m.HasPhoto) { <img src="/@slug/photo/@Uri.EscapeDataString(m.UserName)" alt="" loading="lazy" onerror="this.remove()" /> }
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true"><circle cx="12" cy="8.5" r="4"/><path d="M4 22c0-4.6 3.6-7.5 8-7.5s8 2.9 8 7.5z"/></svg>
                    </div>
                    <div class="tv-m"><div class="n">@m.Name</div><small>@Role(m) · 마지막 수행 @FamilyTeamModel.LastText(m.LastDay, b.Today)</small></div>
                    <form method="post" asp-page-handler="Cheer" asp-route-slug="@slug">
                        <input type="hidden" name="target" value="@m.UserName" />
                        <button type="submit" class="tv-cheer@(sent ? " sent" : "")" disabled="@sent">@(sent ? "응원 보냈어요 ✓" : "응원하기")</button>
                    </form>
                </div>
            }
        </div>
        <p class="tv-note">@(sentN > 0 ? $"응원 {sentN}명에게 보냈어요" : "응원은 하루에 한 번 보낼 수 있어요")</p>
    </section>
}

<section class="tv-card" id="box">
    <div class="tv-h"><h2>우리 팀 선물함</h2></div>
    <div class="tv-sum3">
        <div><span>팀 점수</span><b class="num">@b.Total.ToString("N0")점</b></div>
        <div><span>고른 선물</span><b class="num">@(picked.Count)개</b></div>
        <div><span>남은 선택</span><b class="num">@(open.Count)개</b></div>
    </div>
    <div class="tv-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="true" data-tvtab="picked">고른 선물</button>
        <button type="button" role="tab" aria-selected="false" data-tvtab="got">받은 선물</button>
    </div>
    <div data-tvpane="picked">
        @foreach (var g in picked)
        {
            <div class="tv-g"><span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0D7A68" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M3 12h18M12 8v13"/></svg></span>
                <div><b>@g.ItemName</b><small>@(g.PickedBy is { } pb ? $"{Ui.Nim(pb)}이 골랐어요" : "골랐어요") · @Model.When(g.PickedUtc)</small></div><i>@(b.Friend ? "친구팀 선물" : "팀 선물")</i></div>
        }
        @if (picked.Count == 0) { <p class="tv-empty">아직 고른 선물이 없어요</p> }
    </div>
    <div data-tvpane="got" hidden>
        @foreach (var g in Model.Received)
        {
            <div class="tv-g"><span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0D7A68" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M3 12h18M12 8v13"/></svg></span>
                <div><b>@g.Name</b><small>팀 점수 @g.Stage.ToString("N0")점 달성 · @Model.When(g.DeliveredUtc)</small></div><i>@g.Stage.ToString("N0")점</i></div>
        }
        @if (Model.Received.Count == 0) { <p class="tv-empty">아직 받은 선물이 없어요</p> }
    </div>
</section>

<section class="tv-card">
    <a class="tv-link" href="/@slug/family-team/others"><span>다른 팀 보기 <small>팀 랭킹 · 정렬</small></span><i aria-hidden="true">›</i></a>
</section>

<section class="tv-card">
    <h2>팀 설정</h2>
    <div class="tv-links">
        <a class="tv-link" href="/@slug/family-team/manage#rename"><span>팀 이름 바꾸기</span><i aria-hidden="true">›</i></a>
        <a class="tv-link out" href="/@slug/family-team/manage#leave"><span>팀 나가기</span><i aria-hidden="true">›</i></a>
    </div>
    <p class="tv-note l">한 사람은 가족팀이나 친구팀 중 하나에만 들어갈 수 있어요.</p>
</section>
</div>

<nav class="mh-tab" aria-label="주 메뉴">
    <a href="/@slug/word-mission"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 10l9-7 9 7v10a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg>미션홈</a>
    <a href="/@slug/gift-box"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M3 12h18M12 8v13M12 8c-1.5-3-5-4-5-1.5S10 8 12 8zM12 8c1.5-3 5-4 5-1.5S14 8 12 8z"/></svg>선물함</a>
    <a href="/@slug/family-team" aria-current="page"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><circle cx="17" cy="9" r="2.5"/><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5M15.5 14.6c2.8-.3 5 1.4 6 4.4"/></svg>팀보기</a>
    <a href="/@slug/roster"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M3 19c.6-3 2.6-5 5-5s4.4 2 5 5M15 7h6M15 11h6M17 15h4"/></svg>참여자</a>
</nav>
</div>
<partial name="_MissionDrawer" model="(Model.Tenant, (string?)null)" />
<script>
    // 우리 팀 선물함 탭(고른 선물 / 받은 선물)
    document.querySelectorAll('[data-tvtab]').forEach((t) => t.addEventListener('click', () => {
        document.querySelectorAll('[data-tvtab]').forEach((x) => x.setAttribute('aria-selected', String(x === t)));
        document.querySelectorAll('[data-tvpane]').forEach((p) => { p.hidden = p.dataset.tvpane !== t.dataset.tvtab; });
    }));
</script>
