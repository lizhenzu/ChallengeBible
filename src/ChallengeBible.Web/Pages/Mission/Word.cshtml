@page "/{slug}/word"
@model WordModel
@{ var d = Model.Data!; var w = d.Word; }
@await Html.PartialAsync("_MissionHead", new MissionHead(Model, "오늘의 말씀", w?.Title ?? "오늘은 말씀이 없어요", w?.Range))
<main class="mbody gut" data-slug="@Model.Slug" data-date="@Model.Day.ToString("yyyy-MM-dd")"><div class="wrap">
    @if (w is null)
    {
        <p class="empty">이날은 말씀이 없어요. 다른 미션을 해 보세요.</p>   @* R-122 *@
    }
    else
    {
        <section class="sec"><h2><span class="n">01</span>오늘 이야기</h2><p class="story">@w.Summary</p></section>
        <section class="sec"><h2><span class="n">02</span>성경 읽기</h2><p class="hint">@w.Range — 성경 본문 화면은 성경 데이터를 넣은 뒤에 열려요.</p></section>
        @await Html.PartialAsync("_PickSection", new PickSection(Model, "03", "어떻게 읽었나요?", Mission.Word, "word"))
    }
</div></main>
@Html.AntiForgeryToken()
@await Html.PartialAsync("_MissionNav", new MissionNav(Model, "word"))
