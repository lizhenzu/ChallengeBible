@model HomeModel
@* 미션 홈 "내 선물" 카드(확정 시안 2판 말씀-선물고르기 ①, R-285) + 100점 창(② — gift.js, 이 기기에서 처음 보는 단계일 때 한 번).
   학생만 카드, 선생님 · 학부모 · 기타는 창(축하)만(B-8). 이모지 없음. *@
@{
    var w = Model.Gift!;
    var slug = Model.Slug;
    var href = $"/{slug}/gifts";
    var kind = !w.Student ? "clap" : w.Active is not null ? "wait" : w.CanPick ? "pick" : "clap";
    var step = w.Step <= 0 ? 0 : w.YearPoints / w.Step;
}
<span hidden data-gk-pop data-key="gk-step-@slug-@Model.UserName-@w.Year" data-step="@step" data-unit="@w.Step" data-kind="@kind" data-href="@href"></span>
@if (w.Student)
{
    if (w.Active is { } a)
    {
        <a class="gk-card gk-got" href="@href">
            <span class="gk-pic">@if (a.HasImage) { <img src="@GiftsModel.Img(a.ItemId)" alt="" onerror="this.remove()" /> }</span>
            <span class="gk-m"><span class="gk-tag">@(a.State == "Purchased" ? "선생님이 준비했어요" : "준비 중")</span><b>@a.Name</b><small>받으면 다음 선물을 고를 수 있어요</small></span>
            <span class="gk-ar" aria-hidden="true">›</span>
        </a>
    }
    else if (w.CanPick)
    {
        var tag = w.AtCap ? "다 모았어요" : w.December ? "12월 31일까지" : null;
        <a class="gk-card gk-can" href="@href">
            <span class="gk-m">
                @if (tag is not null) { <span class="gk-tag gk-w">@tag</span> } else { <span class="gk-k">내 선물 · 쓸 수 있는 점수</span> }
                <b class="num">@w.Usable.ToString("N0")점</b>
                @if (w.AtCap) { <small>선물을 고르면 다시 모을 수 있어요</small> }
                else if (w.December) { <small>새해가 되면 점수가 0부터 다시 시작해요</small> }
            </span>
            <span class="gk-go">선물 고르기</span>
        </a>
    }
    else
    {
        var pct = w.Step <= 0 ? 0 : Math.Min(100, w.Available * 100 / w.Step);
        <a class="gk-card" href="@href">
            <span class="gk-m"><span class="gk-k">내 선물</span><b>@(w.Step)점이 되면 선물을 골라요</b><small><span class="num">@w.ToFirst</span>점 더 모으면 돼요</small>
                <span class="gk-pb" aria-hidden="true"><i style="width:@pct%"></i></span></span>
            <span class="gk-ar" aria-hidden="true">›</span>
        </a>
    }
}
<script src="~/js/gift.js" asp-append-version="true" defer></script>
