@page "/{slug}/family-team"
@model FamilyTeamModel
@using System.Globalization
@using ChallengeBible.Infrastructure.Data
@using ChallengeBible.Web.Services
@* 확정 시안: family-team-self(ADR 0083) — ② 찾기 ③ 합류 신청 ④ 새 팀 ⑤ 우리 가족팀 / family-invite(ADR 0084) — 가족 초대 · 받은 초대 *@
@{
    var s = Model.State;
    var home = $"/{Model.Slug}/word-mission";
    var self = $"/{Model.Slug}/family-team";
    var inv = CultureInfo.InvariantCulture;
}
<main class="gut fmt"><div class="wrap">
    @if (!string.IsNullOrEmpty(Model.OkMessage)) { <p class="okmsg" role="status">@Model.OkMessage</p> }
    @if (Model.Error is not null) { <p class="err" role="alert">@Model.Error</p> }

    @if (s.UserName is null)
    {
        <div class="fmt-bar"><a href="@home">‹ 미션 홈</a></div>
        <h1>우리 가족팀</h1>
        <p class="fmt-sub">가족팀은 이 부서의 참여자가 함께 꾸려요. 참여자가 되면 팀을 만들거나 합류할 수 있어요.</p>
    }
    else if (s.Mine is not null && Model.Add)
    {
        ViewData["WhoLabel"] = "이 가족의 누구인가요?";
        <div class="fmt-bar"><a href="@self">‹ 우리 가족팀</a></div>
        <h1>가족 초대하기</h1>
        <p class="fmt-sub">같은 부서 참여자 중 아직 가족팀이 없는 분을 찾을 수 있어요.</p>
        <form method="get" action="@self" class="fmt-search" role="search">
            <input type="hidden" name="Add" value="true" />
            <input type="search" name="Q" value="@Model.Q" placeholder="이름" aria-label="초대할 사람의 이름" />
            <button type="submit">찾기</button>
        </form>
        @if (!string.IsNullOrWhiteSpace(Model.Q) && Model.Candidates.Count == 0) { <p class="fmt-note c">찾는 분이 없어요. 아직 참여자가 아니거나 이미 가족팀이 있는 분은 찾을 수 없어요.</p> }
        @if (Model.Candidates.Count > 0)
        {
            <form method="post" asp-page-handler="Invite" asp-route-slug="@Model.Slug" data-fmt-form>
                <input type="hidden" name="Q" value="@Model.Q" />
                <div role="radiogroup" aria-label="초대할 사람">
                    @foreach (var c in Model.Candidates)
                    {
                        var cn = Model.Split(c.Name);
                        <label class="fmt-pick"><input type="radio" name="participant" value="@c.UserName" checked="@(c == Model.Candidates[0])" data-name="@c.Name" /><span>@cn.Before@if (cn.Hit != "") {<mark>@cn.Hit</mark>}@cn.After</span><b aria-hidden="true"></b></label>
                    }
                </div>
                <h2 data-fmt-who="{n}님은 이 가족의 누구인가요?">이 가족의 누구인가요?</h2>
                <partial name="_FamilyWho" model="FamilyRelation.Student" />
                <button type="submit" class="fmt-btn" data-fmt-go="{r} 초대 보내기">초대 보내기</button>
                <p class="fmt-note c">상대가 수락해야 합류돼요.</p>
            </form>
        }
    }
    else if (s.Mine is { } m)
    {
        <div class="fmt-bar"><a href="@home">‹ 미션 홈</a></div>
        <section class="fmt-hero" aria-label="우리 가족팀">
            <div class="n">@m.Name</div>
            <div class="s num">@m.Total.ToString("N0")<small>점</small></div>
            <div class="fmt-prog" aria-hidden="true"><i style="width:@m.Pct.ToString("0.#", inv)%"></i></div>
            <div class="g"><span>이번 시즌 가족 점수</span><span>@(m.Next is { } nx ? $"다음 축하까지 {nx - m.Total:N0}점" : "모든 단계를 넘었어요")</span></div>
        </section>
        <details class="fmt-ask"><summary>이름 바꾸기</summary>
            <form method="post" asp-page-handler="Rename" asp-route-slug="@Model.Slug" class="fmt-inline">
                <input class="fmt-in" name="name" value="@m.RawName" maxlength="50" placeholder="비우면 학생 이름 + 가족" aria-label="팀 이름" />
                <button type="submit" class="fmt-btn sm">저장</button>
            </form>
        </details>

        @if (m.Requests.Count > 0)
        {
            <h2>합류 신청 <i class="num">@m.Requests.Count</i></h2>
            @foreach (var r in m.Requests)
            {
                <div class="fmt-rq">
                    <div class="w">@r.Name<b>@FamilyTeamModel.AsRelation(r.Relation) 신청</b></div>
                    <div class="a">
                        <form method="post" asp-page-handler="Accept" asp-route-slug="@Model.Slug"><input type="hidden" name="request" value="@r.RequestId" /><button type="submit" class="fmt-btn sm">수락</button></form>
                        <form method="post" asp-page-handler="Reject" asp-route-slug="@Model.Slug"><input type="hidden" name="request" value="@r.RequestId" /><button type="submit" class="fmt-btn sm line">거절</button></form>
                    </div>
                </div>
            }
        }

        <h2>구성원 @(m.Members.Count)명</h2>
        <ul class="fmt-mem">
            @foreach (var x in m.Members)
            {
                <li>
                    <u aria-hidden="true">@FamilyTeamModel.Emoji(x.Relation)</u>
                    <div class="m">@x.Name@if (x.Me) {<span class="me">나</span>}
                        <small>@FamilyTeamService.RelationLabel(x.Relation)</small>
                        @if (x.Me)
                        {
                            <details class="fmt-ask"><summary>관계 설정</summary>
                                <form method="post" asp-page-handler="Relation" asp-route-slug="@Model.Slug">
                                    <partial name="_FamilyWho" model="x.Relation" />
                                    <button type="submit" class="fmt-btn sm">저장</button>
                                </form>
                            </details>
                        }
                    </div>
                    <div class="p num">@(x.Points.ToString("N0"))점</div>
                    @if (!x.Me)
                    {
                        <details class="fmt-ask out"><summary>내보내기</summary>
                            <form method="post" asp-page-handler="Kick" asp-route-slug="@Model.Slug">
                                <input type="hidden" name="member" value="@x.MemberId" />
                                <span>@(x.Name)님을 팀에서 내보낼까요? 점수는 지우지 않아요.</span>
                                <button type="submit" class="fmt-btn sm no">내보내기</button>
                            </form>
                        </details>
                    }
                </li>
            }
        </ul>
        <a class="fmt-btn line" href="@self?Add=true">＋ 가족 초대하기</a>
        @if (m.Sent.Count > 0)
        {
            <h2>보낸 초대 <i class="num">@m.Sent.Count</i></h2>
            @foreach (var i in m.Sent)
            {
                <div class="fmt-sent">
                    <div class="m">@i.Name<small>@FamilyTeamModel.AsRelation(i.Relation) 초대 · 수락을 기다리는 중</small></div>
                    <form method="post" asp-page-handler="InviteCancel" asp-route-slug="@Model.Slug"><input type="hidden" name="invite" value="@i.InviteId" /><button type="submit" aria-label="@(i.Name)님 초대 취소">취소</button></form>
                </div>
            }
        }
        <details class="fmt-ask leave"><summary>팀 나가기</summary>
            <form method="post" asp-page-handler="Leave" asp-route-slug="@Model.Slug">
                <span>@(m.Members.Count == 1 ? "마지막 구성원이에요. 나가면 팀이 사라져요." : "내 점수는 그대로이고 팀 점수에서만 빠져요. 다른 팀에 가려면 나온 뒤 신청해요.")</span>
                <button type="submit" class="fmt-btn sm no">나가기</button>
            </form>
        </details>
    }
    else if (Model.New && s.Pending is null)
    {
        <div class="fmt-bar"><a href="@self">‹ 찾기</a></div>
        <h1>새 가족팀 만들기</h1>
        <p class="fmt-sub">재미있는 이름을 지어 보세요. 나중에 바꿀 수 있어요.</p>
        <form method="post" asp-page-handler="Create" asp-route-slug="@Model.Slug" data-fmt-form>
            <input class="fmt-in big" name="name" value="@Model.NameInput" maxlength="50" placeholder="웃음폭탄네" aria-label="팀 이름" />
            <div class="fmt-ex" aria-hidden="true"><span>웃음폭탄네</span><span>김치찌개 패밀리</span><span>말씀 수호대</span><span>우당탕탕 가족</span></div>
            <h2>나는 누구인가요?</h2>
            <partial name="_FamilyWho" model="Model.DefaultRelation" />
            <button type="submit" class="fmt-btn" data-fmt-go="만들고 {r} 시작하기">만들고 시작하기</button>
            <p class="fmt-note c">이름을 비우면 "학생 이름 + 가족"으로 만들어요.</p>
        </form>
    }
    else if (Model.JoinTeam is { } jt && s.Pending is null)
    {
        <div class="fmt-bar"><a href="@self">‹ 찾기</a></div>
        <h1>@jt.Name</h1>
        <p class="fmt-sub">가족 @(jt.Members.Count)명이 있어요. 나는 이 가족의 누구인가요?</p>
        <div class="fmt-chips">@foreach (var x in jt.Members) {<span>@x.Name<b>@FamilyTeamService.RelationLabel(x.Relation)</b></span>}</div>
        <form method="post" asp-page-handler="Request" asp-route-slug="@Model.Slug" data-fmt-form>
            <input type="hidden" name="team" value="@jt.TeamId" />
            <partial name="_FamilyWho" model="Model.DefaultRelation" />
            <button type="submit" class="fmt-btn" data-fmt-go="{r} 합류 신청">합류 신청</button>
            <p class="fmt-note c">팀에 있는 가족이 수락하면 합류돼요.</p>
        </form>
    }
    else
    {
        <div class="fmt-bar"><a href="@home">‹ 미션 홈</a></div>
        <h1>가족팀 찾기</h1>
        <p class="fmt-sub">@(s.Invites.Count > 0 ? "받은 초대가 있어요." : "가족의 이름이나 팀 이름으로 찾아 보세요.")</p>
        @foreach (var i in s.Invites)
        {
            <form method="post" asp-page-handler="InviteAccept" asp-route-slug="@Model.Slug" class="fmt-rq fmt-inv" data-fmt-form>
                <input type="hidden" name="invite" value="@i.InviteId" />
                <div class="h">@i.TeamName</div>
                <p>@(i.InvitedBy)님이 @FamilyTeamModel.AsRelation(i.Relation) 초대했어요. 관계가 다르면 바꿔서 수락하세요.</p>
                <div class="fmt-chips">@foreach (var x in i.Members) {<span>@x.Name<b>@FamilyTeamService.RelationLabel(x.Relation)</b></span>}</div>
                <div class="q">나는 누구인가요?</div>
                <partial name="_FamilyWho" model="i.Relation" />
                <div class="a">
                    <button type="submit" class="fmt-btn sm" data-fmt-go="{r} 수락">수락</button>
                    <button type="submit" class="fmt-btn sm line" asp-page-handler="InviteReject" asp-route-slug="@Model.Slug">거절</button>
                </div>
            </form>
        }
        @if (s.Invites.Count > 0) { <p class="fmt-note c">수락하면 바로 팀에 들어가요. 다른 팀에 낸 합류 신청과 받은 초대는 함께 취소돼요.</p> }
        @if (s.Pending is { } p)
        {
            <div class="fmt-card">
                <b>@p.TeamName · 수락을 기다리는 중</b>
                <small>@FamilyTeamModel.AsRelation(p.Relation) 신청했어요. 다른 팀은 취소한 뒤 신청할 수 있어요.</small>
                <form method="post" asp-page-handler="Cancel" asp-route-slug="@Model.Slug"><button type="submit" class="fmt-btn sm line">신청 취소</button></form>
            </div>
        }
        <form method="get" action="@self" class="fmt-search" role="search">
            <input type="search" name="Q" value="@Model.Q" placeholder="이름이나 팀 이름" aria-label="이름이나 팀 이름으로 찾기" />
            <button type="submit">찾기</button>
        </form>
        @if (!string.IsNullOrWhiteSpace(Model.Q) && Model.Hits.Count == 0) { <p class="fmt-note c">찾는 팀이 없어요. 이름을 다시 확인하거나 새로 만들어 보세요.</p> }
        @foreach (var h in Model.Hits)
        {
            var nm = Model.Split(h.Name);
            <div class="fmt-team">
                <div><span class="n">@nm.Before@if (nm.Hit != "") {<mark>@nm.Hit</mark>}@nm.After</span><span class="c">@(h.Members.Count)명</span></div>
                <div class="fmt-chips">
                    @foreach (var x in h.Members)
                    {
                        var mn = Model.Split(x.Name);
                        <span>@mn.Before@if (mn.Hit != "") {<mark>@mn.Hit</mark>}@mn.After<b>@FamilyTeamService.RelationLabel(x.Relation)</b></span>
                    }
                </div>
                @if (s.Pending is null) { <a class="fmt-btn" href="@self?Join=@h.TeamId">합류 신청</a> }
            </div>
        }
        @if (s.Pending is null)
        {
            <div class="fmt-or">찾는 팀이 없나요?<a class="fmt-btn line" href="@self?New=true">＋ 새 가족팀 만들기</a></div>
        }
    }
</div></main>
<script>
    // 고른 역할을 큰 버튼 글자에 넣는다("학생으로 합류 신청"). 스크립트가 없어도 버튼은 동작한다
    document.querySelectorAll('[data-fmt-form]').forEach((form) => {
        const go = form.querySelector('[data-fmt-go]');
        const who = form.querySelector('[data-fmt-who]');
        const show = () => {
            const on = form.querySelector('input[name="relation"]:checked');
            if (on) go.textContent = go.dataset.fmtGo.replace('{r}', on.dataset.as);
            const person = form.querySelector('input[name="participant"]:checked');
            if (who && person) who.textContent = who.dataset.fmtWho.replace('{n}', person.dataset.name);
        };
        form.addEventListener('change', show);
        show();
    });
</script>
